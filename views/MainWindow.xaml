                    </ui:Button></StackPanel></Border>
              <CheckBox x:Name="ChkGroupEvents" Style="{StaticResource VanillaCheckBoxStyle}" IsChecked="True" Content="Group repeats"
                        VerticalAlignment="Center" Margin="0,0,12,4" FontSize="{StaticResource FontSizeM}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Checked="ChkGroupEvents_Changed" Unchecked="ChkGroupEvents_Changed"
                        ToolTip="Show identical events (same source, ID and level) once, with how many times they occurred"/>
              <CheckBox x:Name="ChkHideHarmless" Style="{StaticResource VanillaCheckBoxStyle}" IsChecked="True" Content="Hide harmless"
                        VerticalAlignment="Center" Margin="0,0,12,4" FontSize="{StaticResource FontSizeM}"
                        Foreground="{DynamicResource TextPrimaryBrush}"
                        Checked="ChkHideHarmless_Changed" Unchecked="ChkHideHarmless_Changed"
                        ToolTip="Hide routine Windows messages that are known to be harmless, so the list starts with what matters"/>
              <Grid Margin="0,0,10,4">
                <TextBox Style="{StaticResource VanillaTextBoxStyle}" x:Name="TxtSearch" Width="240" Height="28" Padding="9,0" VerticalAlignment="Center"
