                        <StackPanel Margin="6,3" VerticalAlignment="Center" ToolTip="{Binding SignTooltip}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="NEW" Margin="6,0,0,0" FontSize="{StaticResource FontSizeXS}" FontWeight="Bold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentBrush}" ToolTip="First time seen on this computer"
                                       Visibility="{Binding IsNew, Converter={StaticResource BoolToVisConv}}"/>
                          </StackPanel>
                          <TextBlock Text="{Binding SubLine}" FontSize="{StaticResource FontSizeXS}" Foreground="{Binding SignColor, Converter={StaticResource ThemeStatusBrush}}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="CPU" Width="150" SortMemberPath="CpuPct">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0">
                          <Grid Width="56" Height="5" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Border CornerRadius="2.5" Background="{DynamicResource BorderBrush2}"/>
                            <Border CornerRadius="2.5" HorizontalAlignment="Left" Width="{Binding CpuBarW}" Background="{Binding CpuBarBrush}"/>
                          </Grid>
                          <TextBlock Text="{Binding CpuDisplay}" FontFamily="{StaticResource NumFont}" FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Memory" Binding="{Binding RamDisplay}" Width="100" SortMemberPath="RamMB" ElementStyle="{StaticResource TableNumCell}"/>
                  <DataGridTextColumn Header="I/O" Binding="{Binding DiskTotalDisplay}" Width="100" SortMemberPath="DiskTotalKBs" ElementStyle="{StaticResource TableNumCell}"/>
                  <DataGridTextColumn Header="Network" Binding="{Binding NetTotalDisplay}" Width="100" SortMemberPath="NetTotalKBs" ElementStyle="{StaticResource TableNumCell}"/>
                  <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="84" SortMemberPath="Pid">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="TextAlignment" Value="Right"/>
                        <Setter Property="Margin" Value="4,0,14,0"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Grid>
          </Border>
        </Grid>

        <!-- ── STARTUP MANAGER ── -->
        <Grid x:Name="PanelStartup" Visibility="Collapsed" Margin="{StaticResource PageMargin}" Style="{StaticResource PageFadeStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- titlu + Apps only / With services + scurtaturi -->
          <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="TxtStartupTitle" Text="Startup Manager" Style="{StaticResource SectionTitleStyle}"/>
              <TextBlock x:Name="TxtStartupSubtitleInfo" Text="What opens when you sign in to Windows" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <Border CornerRadius="8" Background="{DynamicResource SegTrackBrush}" Padding="3" Margin="0,0,8,0"
                      ToolTip="Also list non-Windows auto-start services (e.g. Adobe, Nvidia, TeamViewer). Core Windows services are never shown here — manage those from the Windows Services page.">
                <StackPanel Orientation="Horizontal">
                  <Border x:Name="SegStartupAppsOnly" CornerRadius="6" Padding="10,4" Cursor="Hand" Tag="AppsOnly" MouseLeftButtonUp="StartupShowAllServices_Toggle">
                    <TextBlock x:Name="TxtStartupAppsOnlyLabel" Text="Apps only" VerticalAlignment="Center" FontSize="{StaticResource FontSizeS}"/>
                  </Border>
                  <Border x:Name="SegStartupShowServices" CornerRadius="6" Padding="10,4" Cursor="Hand" Tag="ShowServices" MouseLeftButtonUp="StartupShowAllServices_Toggle">
                    <TextBlock x:Name="TxtStartupShowServicesLabel" Text="With services" VerticalAlignment="Center" FontSize="{StaticResource FontSizeS}"/>
                  </Border>
                </StackPanel>
              </Border>
              <CheckBox Style="{StaticResource VanillaCheckBoxStyle}" x:Name="ChkStartupShowAllServices" Visibility="Collapsed"/>
              <ui:Button x:Name="BtnOpenTaskMgr" Appearance="Secondary" Click="OpenTaskManager_Click" Margin="0,0,8,0" ToolTip="Opens Task Manager">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M6.25,4.5 C5.28,4.5 4.5,5.28 4.5,6.25 L4.5,17.75 C4.5,18.72 5.28,19.5 6.25,19.5 L17.75,19.5 C18.72,19.5 19.5,18.72 19.5,17.75 L19.5,13.75 A0.75,0.75 0 0 1 21,13.75 L21,17.75 C21,19.55 19.54,21 17.75,21 L6.25,21 A3.25,3.25 0 0 1 3,17.75 L3,6.25 C3,4.45 4.46,3 6.25,3 L10.25,3 A0.75,0.75 0 0 1 10.25,4.5 Z M13,3.75 C13,3.34 13.34,3 13.75,3 L20.25,3 C20.66,3 21,3.34 21,3.75 L21,10.25 A0.75,0.75 0 0 1 19.5,10.25 L19.5,5.56 L14.28,10.78 A0.75,0.75 0 0 1 13.22,9.72 L18.44,4.5 L13.75,4.5 A0.75,0.75 0 0 1 13,3.75"/></Canvas></Viewbox><TextBlock Text="Task Manager" VerticalAlignment="Center"/></StackPanel>
                  </ui:Button>
              <ui:Button x:Name="BtnOpenMsconfig" Appearance="Secondary" Click="OpenMsconfig_Click" ToolTip="Opens System Configuration (msconfig)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M6.25,4.5 C5.28,4.5 4.5,5.28 4.5,6.25 L4.5,17.75 C4.5,18.72 5.28,19.5 6.25,19.5 L17.75,19.5 C18.72,19.5 19.5,18.72 19.5,17.75 L19.5,13.75 A0.75,0.75 0 0 1 21,13.75 L21,17.75 C21,19.55 19.54,21 17.75,21 L6.25,21 A3.25,3.25 0 0 1 3,17.75 L3,6.25 C3,4.45 4.46,3 6.25,3 L10.25,3 A0.75,0.75 0 0 1 10.25,4.5 Z M13,3.75 C13,3.34 13.34,3 13.75,3 L20.25,3 C20.66,3 21,3.34 21,3.75 L21,10.25 A0.75,0.75 0 0 1 19.5,10.25 L19.5,5.56 L14.28,10.78 A0.75,0.75 0 0 1 13.22,9.72 L18.44,4.5 L13.75,4.5 A0.75,0.75 0 0 1 13,3.75"/></Canvas></Viewbox><TextBlock Text="msconfig" VerticalAlignment="Center"/></StackPanel>
                  </ui:Button>
            </StackPanel>
          </Grid>
          <TextBlock x:Name="TxtStartupInfo" Visibility="Collapsed" Text="Disabling startup programs does not uninstall them."/>

          <!-- ① Boot time: the last boots, the average, the slowest -->
          <Border x:Name="BootTimeCard" Grid.Row="1" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Margin="0,0,0,12">
            <StackPanel>
              <DockPanel LastChildFill="False" Margin="0,0,0,8">
                <Viewbox DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M3.5,12 A8.5,8.5 0 0 1 20.5,12 A8.5,8.5 0 0 1 3.5,12 M12,2 A10,10 0 0 0 12,22 A10,10 0 0 0 12,2 M12,6.65 A0.75,0.75 0 0 0 10.5,6.75 L10.5,12.85 C10.56,13.22 10.87,13.5 11.25,13.5 L15.35,13.5 A0.75,0.75 0 0 0 15.25,12 L12,12 L12,6.65"/></Viewbox>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtBootTimeTitle" Text="Boot time" Style="{StaticResource DashRowName}"/>
                    <TextBlock x:Name="TxtBootTimeSub" Text="Recent starts" Style="{StaticResource DashRowInlineSub}"/>
                  </StackPanel>
                </StackPanel>
                <ui:Button DockPanel.Dock="Right" x:Name="BtnRefreshBootTime" Appearance="Secondary" Click="RefreshBootTime_Click" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M16.25,5.18 C16,5.51 16.06,5.98 16.39,6.23 A7.24,7.24 0 0 1 12.79,19.21 L13.47,18.53 A0.75,0.75 0 0 0 12.49,17.4 L12.41,17.47 L10.41,19.47 A0.75,0.75 0 0 0 10.34,20.45 L10.41,20.53 L12.41,22.53 A0.75,0.75 0 0 0 13.54,21.55 L13.47,21.47 L12.72,20.72 A8.75,8.75 0 0 0 17.3,5.04 A0.75,0.75 0 0 0 16.25,5.18 M10.53,1.47 C10.23,1.77 10.23,2.24 10.53,2.53 L11.28,3.28 A8.75,8.75 0 0 0 6.43,18.75 A0.75,0.75 0 0 0 7.39,17.59 A7.23,7.23 0 0 1 11.2,4.8 L10.52,5.48 A0.75,0.75 0 1 0 11.58,6.54 L13.58,4.54 C13.88,4.24 13.88,3.77 13.58,3.48 L11.58,1.48 A0.75,0.75 0 0 0 10.52,1.48"/></Canvas></Viewbox><TextBlock x:Name="TxtBtnRefreshBootTime" Text="Refresh" VerticalAlignment="Center"/></StackPanel>
                </ui:Button>
              </DockPanel>
              <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="24"/><ColumnDefinition Width="170"/></Grid.ColumnDefinitions>
                <Grid>
                  <ItemsControl x:Name="ListBootHistory"/>
                  <TextBlock x:Name="TxtBootTimeEmpty" Text="Loading boot history…" Style="{StaticResource CompSub}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                </Grid>
                <StackPanel x:Name="PanelBootTimeSummary" Grid.Column="2" Visibility="Collapsed" VerticalAlignment="Center">
                  <StackPanel Margin="0,0,0,8">
                    <TextBlock x:Name="TxtLabelBootTotal" Text="Last start" Style="{StaticResource CompFootKey}"/>
                    <TextBlock x:Name="TxtBootTotalTime" Text="—" Style="{StaticResource CompFootVal}"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Average" Style="{StaticResource CompFootKey}"/>
                    <TextBlock x:Name="TxtBootAvg" Text="—" Style="{StaticResource CompFootVal}"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,0,8">
                    <TextBlock Text="Slowest" Style="{StaticResource CompFootKey}"/>
                    <TextBlock x:Name="TxtBootSlowest" Text="—" Style="{StaticResource CompFootVal}"/>
                  </StackPanel>
                  <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                      <TextBlock x:Name="TxtLabelBootMainPath" Text="Windows part" Style="{StaticResource CompFootKey}"
                                 ToolTip="Kernel, drivers and boot-critical services. Firmware/POST time before Windows starts is not included — Windows cannot measure it."/>
                      <TextBlock x:Name="TxtBootMainPath" Text="—" Style="{StaticResource CompFootVal}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                      <TextBlock x:Name="TxtLabelBootPostBoot" Text="After sign-in" Style="{StaticResource CompFootKey}"
                                 ToolTip="Services and startup apps still loading after the desktop appears — usually what makes a start feel slow."/>
                      <TextBlock x:Name="TxtBootPostBoot" Text="—" Style="{StaticResource CompFootVal}"/>
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Grid>
              <Border x:Name="BootDegradationBanner" Visibility="Collapsed" Margin="0,0,0,12" CornerRadius="8" Padding="12,8"
                      Background="{DynamicResource BgHoverBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                <TextBlock x:Name="TxtBootDegradationInfo" TextWrapping="Wrap" FontSize="{StaticResource FontSizeM}" Foreground="{DynamicResource StatusWarningBrush}"
                           Text="Windows marked the last start as slower than usual."/>
              </Border>
              <TextBlock x:Name="TxtBootHistoryLegend" Visibility="Collapsed"/>
              <Border Style="{StaticResource CompFootBand}">
                <UniformGrid Columns="4"><Border Style="{StaticResource CompFootCellFirst}"><StackPanel><TextBlock Text="Programs at start" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtStartupFootOn" Text="—" Style="{StaticResource CompFootVal}"/></StackPanel></Border><Border Style="{StaticResource CompFootCell}"><StackPanel><TextBlock Text="High impact" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtStartupFootHigh" Text="—" Style="{StaticResource CompFootVal}"/></StackPanel></Border><Border Style="{StaticResource CompFootCell}"><StackPanel><TextBlock Text="Broken entries" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtStartupFootBroken" Text="—" Style="{StaticResource CompFootVal}"/></StackPanel></Border><Border Style="{StaticResource CompFootCell}"><StackPanel><TextBlock x:Name="TxtLabelBootLast" Text="Last boot" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtBootLastDate" Text="—" Style="{StaticResource CompFootVal}"/></StackPanel></Border></UniformGrid>
              </Border>
            </StackPanel>
          </Border>

          <!-- ② The table | the chosen entry -->
          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition x:Name="ColStartupSide" Width="340"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="0,14,0,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="18,0,18,8" LastChildFill="False">
                  <Viewbox DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M13.06,7.43 A2.5,2.5 0 1 1 16.59,10.97 A2.5,2.5 0 0 1 13.06,7.43 M15.53,8.49 A1,1 0 0 0 14.12,9.91 A1,1 0 0 0 15.53,8.49 M21.51,4.32 A2.8,2.8 0 0 0 19.7,2.52 L19.04,2.31 C16.64,1.56 14.04,2.21 12.26,3.98 L11.26,4.98 A3.5,3.5 0 0 0 6.7,5.3 L5.45,6.55 C5.16,6.84 5.16,7.31 5.45,7.61 L7.05,9.2 L6.87,9.38 C6.18,10.06 6.18,11.17 6.87,11.85 L7.37,12.35 L5.97,13.15 A0.75,0.75 0 0 0 5.81,14.32 L9.7,18.22 A0.75,0.75 0 0 0 10.88,18.06 L11.68,16.66 L12.18,17.16 C12.86,17.84 13.96,17.84 14.65,17.16 L14.82,16.98 L16.42,18.58 C16.71,18.86 17.18,18.86 17.47,18.58 L18.72,17.33 A3.5,3.5 0 0 0 19.04,12.76 L20.04,11.76 A6.8,6.8 0 0 0 21.72,5 Z M19.25,3.94 Q19.87,4.15 20.08,4.77 L20.28,5.43 C20.86,7.29 20.36,9.33 18.98,10.7 L13.58,16.1 C13.48,16.2 13.33,16.2 13.23,16.1 L7.93,10.8 A0.25,0.25 0 0 1 7.93,10.44 L13.33,5.04 A5.3,5.3 0 0 1 18.59,3.74 Z M17.96,13.84 A2,2 0 0 1 17.66,16.27 L16.94,16.98 L15.88,15.92 Z M7.76,6.36 A2,2 0 0 1 10.19,6.06 L8.1,8.14 L7.05,7.08 Z M10.58,15.56 L10.06,16.46 L7.56,13.96 L8.46,13.45 Z M6.69,18.4 A0.75,0.75 0 0 0 5.63,17.34 L3.15,19.82 A0.75,0.75 0 0 0 4.21,20.88 Z M4.75,15.4 C5.04,15.7 5.04,16.17 4.75,16.46 L3.68,17.52 A0.75,0.75 0 0 1 2.62,16.46 L3.68,15.4 C3.98,15.1 4.45,15.1 4.75,15.4 M8.63,20.35 A0.75,0.75 0 1 0 7.57,19.29 L6.51,20.35 A0.75,0.75 0 0 0 7.57,21.41 Z"/></Viewbox>
                  <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Programs at start" Style="{StaticResource DashRowName}"/>
                      <TextBlock x:Name="TxtStartupCount" Text="—" Style="{StaticResource DashRowInlineSub}"/>
                    </StackPanel>
                  </StackPanel>
                  <ui:Button DockPanel.Dock="Right" x:Name="BtnReloadStartup" Appearance="Secondary" Click="LoadStartup_Click" VerticalAlignment="Center" Margin="8,0,0,0" ToolTip="Reload the list">
                    <Viewbox Width="13" Height="13"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M16.25,5.18 C16,5.51 16.06,5.98 16.39,6.23 A7.24,7.24 0 0 1 12.79,19.21 L13.47,18.53 A0.75,0.75 0 0 0 12.49,17.4 L12.41,17.47 L10.41,19.47 A0.75,0.75 0 0 0 10.34,20.45 L10.41,20.53 L12.41,22.53 A0.75,0.75 0 0 0 13.54,21.55 L13.47,21.47 L12.72,20.72 A8.75,8.75 0 0 0 17.3,5.04 A0.75,0.75 0 0 0 16.25,5.18 M10.53,1.47 C10.23,1.77 10.23,2.24 10.53,2.53 L11.28,3.28 A8.75,8.75 0 0 0 6.43,18.75 A0.75,0.75 0 0 0 7.39,17.59 A7.23,7.23 0 0 1 11.2,4.8 L10.52,5.48 A0.75,0.75 0 1 0 11.58,6.54 L13.58,4.54 C13.88,4.24 13.88,3.77 13.58,3.48 L11.58,1.48 A0.75,0.75 0 0 0 10.52,1.48"/></Canvas></Viewbox>
                  </ui:Button>
                  <Grid DockPanel.Dock="Right" Width="200" VerticalAlignment="Center">
                    <TextBox Style="{StaticResource VanillaTextBoxStyle}" x:Name="TxtStartupSearch" Height="30" Padding="9,0,8,0" VerticalContentAlignment="Center" TextChanged="StartupSearch_TextChanged"/>
                    <TextBlock IsHitTestVisible="False" Text="Search…" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="{StaticResource FontSizeM}" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=TxtStartupSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                </DockPanel>
                <Grid Grid.Row="1">
                  <DataGrid Style="{StaticResource VanillaDataGridStyle}" x:Name="StartupGrid" local:CardClipBehavior.Radius="{DynamicResource RadiusCardD}" CanUserResizeColumns="True"
                            AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="True" MinRowHeight="44"
                            IsReadOnly="True" SelectionMode="Single" SelectionChanged="StartupGrid_SelectionChanged" MouseDoubleClick="StartupGrid_DoubleClick"
                            HeadersVisibility="Column" GridLinesVisibility="None" RowHeaderWidth="0" BorderThickness="0">
                    <DataGrid.ContextMenu>
                      <ContextMenu>
                        <MenuItem Header="Enable at start" Click="EnableStartup_Click"/>
                        <MenuItem Header="Disable at start" Click="DisableStartup_Click"/>
                        <MenuItem Header="Open folder" Click="StartupOpenFolder_Click"/>
                        <Separator/>
                        <MenuItem Header="Remove entry" Click="RemoveStartup_Click"/>
                      </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                      <!-- the switch: starts / does not start at sign-in -->
                      <DataGridTemplateColumn Header="On" Width="66" MinWidth="66" SortMemberPath="IsEnabled">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <CheckBox Style="{StaticResource ToggleSwitchSmallStyle}" IsChecked="{Binding IsEnabled, Mode=OneWay}" Tag="{Binding}"
                                      Click="StartupToggle_Click" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" ToolTip="Start with Windows"/>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <DataGridTemplateColumn Header="Program" Width="*" MinWidth="200" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <Grid VerticalAlignment="Center" Margin="4,0">
                              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                              <StackPanel MaxWidth="340">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}"/>
                                <TextBlock Text="{Binding PublisherLine}" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                              </StackPanel>
                              <Grid Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip="{Binding BrokenTooltip}">
                                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
                                  <Style.Triggers><DataTrigger Binding="{Binding IsBroken}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></Grid.Style>
                                <Border CornerRadius="6" Background="{DynamicResource StatusErrorBrush}" Opacity="0.14"/>
                                <TextBlock Text="File not found" Margin="7,2" FontSize="{StaticResource FontSizeXS}" FontWeight="SemiBold" Foreground="{DynamicResource StatusErrorBrush}"/>
                              </Grid>
                              <Grid Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" ToolTip="The program's file appeared in the last 14 days">
                                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
                                  <Style.Triggers><DataTrigger Binding="{Binding AddedRecently}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                  <DataTrigger Binding="{Binding IsBroken}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                </Style></Grid.Style>
                                <Border CornerRadius="6" Background="{DynamicResource AccentBrush}" Opacity="0.14"/>
                                <TextBlock Text="New" Margin="7,2" FontSize="{StaticResource FontSizeXS}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
                              </Grid>
                            </Grid>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <!-- impactul: 3 bare in trepte + cuvantul -->
                      <DataGridTemplateColumn Header="Impact" Width="120" SortMemberPath="ImpactRating">
                        <DataGridTemplateColumn.CellTemplate>
                          <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ToolTip="Estimated from the size of the program that starts">
                              <Border Width="5" Height="6" CornerRadius="1" Margin="0,0,2,0" VerticalAlignment="Bottom" Background="{Binding ImpactColor, Converter={StaticResource ThemeStatusBrush}}" Opacity="{Binding ImpactBar1}"/>
                              <Border Width="5" Height="10" CornerRadius="1" Margin="0,0,2,0" VerticalAlignment="Bottom" Background="{Binding ImpactColor, Converter={StaticResource ThemeStatusBrush}}" Opacity="{Binding ImpactBar2}"/>
                              <Border Width="5" Height="14" CornerRadius="1" Margin="0,0,8,0" VerticalAlignment="Bottom" Background="{Binding ImpactColor, Converter={StaticResource ThemeStatusBrush}}" Opacity="{Binding ImpactBar3}"/>
                              <TextBlock Text="{Binding ImpactText}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                          </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                      </DataGridTemplateColumn>
                      <!-- what Windows itself measured as slowing the start (Diagnostics-Performance), not an estimate -->
                      <DataGridTextColumn Header="Measured delay" Binding="{Binding MeasuredDelayText}" SortMemberPath="MeasuredDelayMs" Width="120">
                        <DataGridTextColumn.ElementStyle>
                          <Style TargetType="TextBlock">
                            <Setter Property="VerticalAlignment" Value="Center"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                            <Setter Property="Foreground" Value="{DynamicResource StatusWarningBrush}"/>
                            <Setter Property="ToolTip" Value="Measured by Windows in the last 30 days: how much later the start ended because of this program"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding MeasuredDelayMs}" Value="0"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="FontWeight" Value="Normal"/></DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                      <DataGridTextColumn Header="Where" Binding="{Binding WhereLabel}" SortMemberPath="Category" Width="170">
                        <DataGridTextColumn.ElementStyle>
                          <Style TargetType="TextBlock">
