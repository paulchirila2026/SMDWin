              <TextBlock Text="PC health" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextPrimaryBrush}" Opacity="0.85" VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </Border>

