                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M4.4,4.55 L4.47,4.47 A0.75,0.75 0 0 1 5.45,4.4 L5.53,4.47 L12,10.94 L18.47,4.47 A0.75,0.75 0 1 1 19.53,5.53 L13.06,12 L19.53,18.47 C19.8,18.74 19.83,19.15 19.6,19.45 L19.53,19.53 A0.75,0.75 0 0 1 18.55,19.6 L18.47,19.53 L12,13.06 L5.53,19.53 A0.75,0.75 0 0 1 4.47,18.47 L10.94,12 L4.47,5.53 A0.75,0.75 0 0 1 4.4,4.55 L4.47,4.47 Z"/></Canvas></Viewbox><TextBlock Text="Error" VerticalAlignment="Center"/></StackPanel>
