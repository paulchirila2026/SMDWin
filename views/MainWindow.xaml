            <Style TargetType="Border">
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
