                            Click="BackupAllDrivers_Click" Margin="6,0,0,0" ToolTip="Export all installed third-party drivers to a folder (for reinstall)">
                      <StackPanel Orientation="Horizontal"><Viewbox Width="13" Height="13" Margin="0,0,8,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M18.25,20.5 A0.75,0.75 0 0 1 18.25,22 L5.25,22 A0.75,0.75 0 0 1 5.25,20.5 Z M11.65,2.01 L11.75,2.01 C12.13,2.01 12.45,2.29 12.49,2.65 L12.5,2.75 L12.5,16.45 L16.22,12.72 A0.75,0.75 0 0 1 17.2,12.65 L17.28,12.72 C17.55,12.99 17.58,13.4 17.35,13.7 L17.28,13.78 L12.28,18.78 A0.75,0.75 0 0 1 11.31,18.85 L11.22,18.78 L6.22,13.78 A0.75,0.75 0 0 1 7.2,12.65 L7.28,12.72 L11,16.43 L11,2.76 C11,2.38 11.28,2.06 11.65,2.01 L11.75,2.01 Z"/></Canvas></Viewbox><TextBlock Text="Back up drivers" VerticalAlignment="Center"/></StackPanel>
                    </ui:Button>
<ui:Button Appearance="Secondary" x:Name="BtnToggleGlobalBlock" Visibility="Collapsed" Height="30" Padding="10,5"
                            Click="ToggleGlobalDriverBlock_Click" Margin="6,0,0,0" ToolTip="Block Windows Update from installing drivers globally"/>
            </StackPanel>
          </Grid>

          <!-- Advanced mode toolbar -->
          <WrapPanel x:Name="DriversAdvancedToolbar"
                     Margin="0,0,0,10" Visibility="Collapsed">
            <ui:Button x:Name="BtnAllDrivers" Appearance="Secondary"
                    Click="LoadAllDrivers_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M3.25,17.5 A1.25,1.25 0 0 1 3.25,20 A1.25,1.25 0 0 1 3.25,17.5 M6.75,18 L21.25,18 A0.75,0.75 0 0 1 21.35,19.5 L6.75,19.5 A0.75,0.75 0 0 1 6.65,18 Z L21.25,18 Z M3.25,11 A1.25,1.25 0 0 1 3.25,13.5 A1.25,1.25 0 0 1 3.25,11 M6.75,11.5 L21.25,11.5 A0.75,0.75 0 0 1 21.35,13 L6.75,13 A0.75,0.75 0 0 1 6.65,11.5 Z L21.25,11.5 Z M3.25,4.5 A1.25,1.25 0 0 1 3.25,7 A1.25,1.25 0 0 1 3.25,4.5 M6.75,5 L21.25,5 A0.75,0.75 0 0 1 21.35,6.5 L6.75,6.5 A0.75,0.75 0 0 1 6.65,5 Z L21.25,5 Z"/></Canvas></Viewbox><TextBlock Text="All drivers" VerticalAlignment="Center"/></StackPanel>
                    </ui:Button>
            <ui:Button x:Name="BtnUnsignedDrivers" Appearance="Secondary"
                    Click="LoadUnsignedDrivers_Click" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M13.5,16 A0.75,0.75 0 0 1 13.5,17.5 L10.5,17.5 A0.75,0.75 0 0 1 10.5,16 Z M16.5,11 A0.75,0.75 0 0 1 16.5,12.5 L7.5,12.5 A0.75,0.75 0 0 1 7.5,11 Z M19.5,6 A0.75,0.75 0 0 1 19.5,7.5 L4.5,7.5 A0.75,0.75 0 0 1 4.5,6 Z"/></Canvas></Viewbox><TextBlock Text="Unsigned" VerticalAlignment="Center"/></StackPanel>
                    </ui:Button>
          </WrapPanel>
          </Grid>

          <!-- ③ Left: the list by categories (or the full table in Advanced) · right: the chosen driver + protection -->
          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" MinWidth="320"/>
              <ColumnDefinition x:Name="DriverDetailColumn" Width="400"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="DriversBasicPanel" Grid.Column="0"
                    Background="Transparent" Padding="0">
              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="DriversBasicList" Margin="0,0,6,0"/>
              </ScrollViewer>
            </Border>

            <Border x:Name="DriversAdvancedPanel" Grid.Column="0"
                    Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="0"
                    Loaded="RoundedClip_Apply" SizeChanged="RoundedClip_Apply"
                    Visibility="Collapsed">
              <DataGrid Style="{StaticResource VanillaDataGridStyle}" x:Name="DriversGrid" CanUserResizeColumns="True" AutoGenerateColumns="False"
                        IsReadOnly="True" CanUserSortColumns="True" SelectionChanged="DriversGrid_SelectionChanged">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Device" Binding="{Binding DisplayName}" Width="*"/>
                  <DataGridTextColumn x:Name="ColDriverVersion" Header="Version" Binding="{Binding Version}" Width="90">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Version}" Value="n/a">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                            <Setter Property="ToolTip" Value="Not reported by this driver"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn x:Name="ColDriverProvider" Header="Provider" Binding="{Binding Provider}" Width="*">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Provider}" Value="n/a">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                            <Setter Property="ToolTip" Value="Not reported by this driver"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Date" Binding="{Binding Date}" SortMemberPath="DateRaw" Width="95">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Date}" Value="n/a">
                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                            <Setter Property="Opacity" Value="0.6"/>
                            <Setter Property="ToolTip" Value="Not reported by this driver"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTemplateColumn Header="Signed" Width="90">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding SignedText}"
                                   Foreground="{Binding SignedColor, Converter={StaticResource ThemeStatusBrush}}"
                                   FontWeight="SemiBold" VerticalAlignment="Center"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Border>


            <ScrollViewer Grid.Column="1" Margin="12,0,0,0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <!-- when no device is chosen -->
                <Border x:Name="DriverDetailPlaceholder" Grid.Row="0" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Margin="0,0,0,12" Padding="18,20" VerticalAlignment="Top">
                  <StackPanel>
                    <TextBlock Text="Selected device" Style="{StaticResource DashRowCaption}"/>
                    <TextBlock Text="Click a device to see its driver, age and actions." TextWrapping="Wrap" Margin="0,6,0,0" Style="{StaticResource CompSub}"/>
                  </StackPanel>
                </Border>
            <Border x:Name="DriverDetailCard" Grid.Row="0"
                    Style="{StaticResource CompCardStyle}" Cursor="Arrow"
                    Margin="0,0,0,12" Padding="0"
                    Visibility="Collapsed">
              <ScrollViewer VerticalScrollBarVisibility="Auto"
                            HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="18,14,18,16">

                  <!-- Card header: icon + name + close button -->
                  <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon categorie -->
                    <Border Grid.Column="0"
                            Width="44" Height="44" CornerRadius="8"
                            Background="{DynamicResource BgInputBrush}"
                            Margin="0,0,10,0">
                      <Viewbox Width="20" Height="20">
                        <Canvas Width="24" Height="24">
                          <Path x:Name="PathDetailIcon" Fill="{DynamicResource TextPrimaryBrush}"/>
                        </Canvas>
                      </Viewbox>
                    </Border>

                    <!-- Nume device -->
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock x:Name="TxtDetailName"
                                 Text="—" FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 TextWrapping="Wrap"/>
                      <TextBlock x:Name="TxtDetailCategory"
                                 Text="—" FontSize="{StaticResource FontSizeM}"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Margin="0,2,0,0"/>
                    </StackPanel>

                    <!-- Close button -->
                    <ui:Button Grid.Column="2"
                            Width="26" Height="26" Appearance="Secondary"
                            FontSize="{StaticResource FontSizeM}" Padding="0"
                            Click="DriverDetailClose_Click"
                            ToolTip="Close the details panel"
                            VerticalAlignment="Top">
                      <Viewbox Width="12" Height="12" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                          <Path Fill="{DynamicResource TextSecondaryBrush}" Data="F1 M4.4,4.55 L4.47,4.47 A0.75,0.75 0 0 1 5.45,4.4 L5.53,4.47 L12,10.94 L18.47,4.47 A0.75,0.75 0 1 1 19.53,5.53 L13.06,12 L19.53,18.47 C19.8,18.74 19.83,19.15 19.6,19.45 L19.53,19.53 A0.75,0.75 0 0 1 18.55,19.6 L18.47,19.53 L12,13.06 L5.53,19.53 A0.75,0.75 0 0 1 4.47,18.47 L10.94,12 L4.47,5.53 A0.75,0.75 0 0 1 4.4,4.55 L4.47,4.47 Z"/>
                        </Canvas>
                      </Viewbox>
                    </ui:Button>
                  </Grid>

                  <!-- ── LED Status (red/yellow/green by age + state) ── -->
                  <Border CornerRadius="8" Padding="10,8" Margin="0,0,0,14"
                          x:Name="DetailStatusBanner"
                          Background="{DynamicResource BgInputBrush}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Ellipse x:Name="DetailLed"
                               Width="12" Height="12" Fill="{DynamicResource StatusSuccessBrush}"
                               VerticalAlignment="Center" Margin="0,0,8,0">
                        <Ellipse.Effect>
                          <DropShadowEffect x:Name="DetailLedGlow"
                                            Color="{DynamicResource ChartGreenColor}" BlurRadius="8"
                                            ShadowDepth="0" Opacity="0.8"
                                            RenderingBias="Quality"/>
                        </Ellipse.Effect>
                      </Ellipse>
                      <TextBlock x:Name="TxtDetailStatusMsg"
                                 Grid.Column="1"
                                 Text="Driver OK" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource StatusSuccessBrush}" VerticalAlignment="Center"/>
                    </Grid>
                  </Border>

                  <!-- ── Main information ── -->
                  <TextBlock x:Name="TxtDriverInfoLabel" Text="INFO" FontSize="{StaticResource FontSizeXS}" FontWeight="SemiBold" Opacity="0.75"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Margin="0,0,0,6"/>

                  <!-- Versiune -->
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtDetailVersionLabel" Text="Version" FontSize="{StaticResource FontSizeM}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDetailVersion" Grid.Column="1"
                               Text="—" FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                  </Grid>

                  <!-- Furnizor -->
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtDetailProviderLabel" Text="Provider" FontSize="{StaticResource FontSizeM}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDetailProvider" Grid.Column="1"
                               Text="—" FontSize="{StaticResource FontSizeL}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </Grid>

                  <!-- The driver date -->
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtDetailDateLabel" Text="Driver Date" FontSize="{StaticResource FontSizeM}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <TextBlock x:Name="TxtDetailDate"
                                 Text="—" FontSize="{StaticResource FontSizeL}"
                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                 VerticalAlignment="Center"/>
                      <!-- The driver age in days -->
                      <Border x:Name="DetailAgeBadge"
                              CornerRadius="4" Padding="5,1"
                              Margin="6,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="TxtDetailAge"
                                   Text="" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"/>
                      </Border>
                    </StackPanel>
                  </Grid>

                  <!-- Status -->
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Status" FontSize="{StaticResource FontSizeM}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDetailStatus" Grid.Column="1"
                               Text="—" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                  </Grid>

                  <!-- Semnat digital -->
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtDetailSignedLabel" Text="Digitally Signed" FontSize="{StaticResource FontSizeM}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDetailSigned" Grid.Column="1"
                               Text="—" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                  </Grid>

                  <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Device ID" FontSize="{StaticResource FontSizeM}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDetailHwId" Grid.Column="1"
                               Text="—" FontSize="{StaticResource FontSizeM}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource MonoFont}"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                  </Grid>
                  <ui:Button
                          HorizontalAlignment="Left" Height="26" Margin="0,0,0,4" Appearance="Secondary"
                          FontSize="{StaticResource FontSizeM}" Padding="10,0"
                          Click="CopyDeviceId_Click"
                          ToolTip="Copy Device ID to clipboard">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                          <Canvas Width="24" Height="24">
                            <Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M8.5,8.5 L5.25,8.5 C4.28,8.5 3.5,9.28 3.5,10.25 L3.5,18.75 C3.5,19.72 4.28,20.5 5.25,20.5 L11.25,20.5 C12.22,20.5 13,19.72 13,18.75 L13,18 L14.5,18 L14.5,18.75 C14.5,20.55 13.04,22 11.25,22 L5.25,22 A3.25,3.25 0 0 1 2,18.75 L2,10.25 C2,8.45 3.46,7 5.25,7 L8.5,7 Z M18.75,2 C20.55,2 22,3.46 22,5.25 L22,13.75 C22,15.55 20.54,17 18.75,17 L12.75,17 A3.25,3.25 0 0 1 9.5,13.75 L9.5,5.25 C9.5,3.45 10.96,2 12.75,2 Z M12.75,3.5 C11.78,3.5 11,4.28 11,5.25 L11,13.75 C11,14.72 11.78,15.5 12.75,15.5 L18.75,15.5 C19.72,15.5 20.5,14.72 20.5,13.75 L20.5,5.25 C20.5,4.28 19.72,3.5 18.75,3.5 Z"/>
                          </Canvas>
                        </Viewbox>
                        <TextBlock Text="Copy" VerticalAlignment="Center"/>
                      </StackPanel>
                  </ui:Button>

                  <!-- Separator -->
                  <Border Height="1"
                          Background="{DynamicResource BorderBrush2}"
                          Margin="0,12,0,12" Opacity="0.4"/>

                  <!-- ── Profil energie + consum estimat ── -->
                  <TextBlock x:Name="TxtDriverEnergyLabel" Text="ENERGY" FontSize="{StaticResource FontSizeXS}" FontWeight="SemiBold" Opacity="0.75"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Margin="0,0,0,8"/>

                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtDetailPowerProfileLabel" Text="Power Profile" FontSize="{StaticResource FontSizeM}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDetailPowerProfile" Grid.Column="1"
                               Text="Normal" FontSize="{StaticResource FontSizeL}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                  </Grid>

                  <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="110"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtDetailPowerEstLabel" Text="Estimated Power" FontSize="{StaticResource FontSizeM}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDetailPowerEst" Grid.Column="1"
                               Text="—" FontSize="{StaticResource FontSizeL}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>
                  </Grid>

                  <!-- Separator -->
                  <Border Height="1"
                          Background="{DynamicResource BorderBrush2}"
                          Margin="0,0,0,12" Opacity="0.4"/>

                  <!-- ── Quick actions ── -->
                  <TextBlock x:Name="TxtDriverActLabel" Text="ACTIONS" FontSize="{StaticResource FontSizeXS}" FontWeight="SemiBold" Opacity="0.75"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             Margin="0,0,0,10"/>

                  <!-- Backup + Repair -->
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="6"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:Button x:Name="BtnDetailBackup" Grid.Column="0" Appearance="Secondary"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Height="32" FontSize="{StaticResource FontSizeM}"
                            Click="DetailBackup_Click"
                            ToolTip="Export current driver as backup">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M18.25,3.51 A0.75,0.75 0 0 0 18.25,2.01 L5.25,2.01 A0.75,0.75 0 0 0 5.25,3.51 Z M11.65,22 L11.75,22 C12.13,22 12.45,21.72 12.49,21.36 L12.5,21.26 L12.5,7.56 L16.22,11.28 C16.49,11.55 16.9,11.57 17.2,11.35 L17.28,11.28 A0.75,0.75 0 0 0 17.35,10.3 L17.28,10.22 L12.28,5.22 A0.75,0.75 0 0 0 11.31,5.15 L11.22,5.22 L6.22,10.22 A0.75,0.75 0 0 0 7.2,11.35 L7.28,11.28 L11,7.58 L11,21.25 C11,21.63 11.28,21.95 11.65,22"/></Canvas></Viewbox><TextBlock Text="Backup" VerticalAlignment="Center"/></StackPanel>
                    </ui:Button>
                    <ui:Button x:Name="BtnDetailRepair" Grid.Column="2" Appearance="Secondary"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Height="32" FontSize="{StaticResource FontSizeM}"
                            Click="DetailRepair_Click"
                            ToolTip="Open Device Manager to reinstall the driver">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M11,7.5 A5.5,5.5 0 0 1 18.66,2.44 A0.75,0.75 0 0 1 18.9,3.66 L16.3,6.25 L17.74,7.69 L20.33,5.1 A0.75,0.75 0 0 1 21.55,5.34 A5.49,5.49 0 0 1 15.2,12.84 L6.9,21.16 A2.87,2.87 0 1 1 2.83,17.1 L11.14,8.79 Q11,8.16 11,7.5 M16.5,3.5 A4,4 0 0 0 12.7,8.77 C12.8,9.04 12.73,9.34 12.52,9.54 L3.9,18.16 A1.37,1.37 0 0 0 5.84,20.1 L14.47,11.48 C14.67,11.28 14.97,11.21 15.23,11.3 A4,4 0 0 0 20.48,7.08 L18.63,8.93 C18.15,9.41 17.35,9.41 16.87,8.93 L15.07,7.13 A1.25,1.25 0 0 1 15.07,5.37 L16.92,3.52 Z"/></Canvas></Viewbox><TextBlock x:Name="TxtBtnRepairDriver" Text="Repair" VerticalAlignment="Center"/></StackPanel>
                    </ui:Button>
                  </Grid>

                  <!-- Search online -->
                  <ui:Button x:Name="BtnDetailSearchOnline" Appearance="Secondary"
                          Height="32" FontSize="{StaticResource FontSizeM}"
                          HorizontalAlignment="Stretch"
                          Click="DetailSearchOnline_Click"
                          Margin="0,0,0,8"
                          ToolTip="Search driver on DRP.su or Google (configured in Settings)">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M12,2 A10,10 0 0 1 12,22 A10,10 0 0 1 12,2 M14.94,16.5 L9.06,16.5 C9.71,18.91 10.85,20.5 12,20.5 C13.15,20.5 14.29,18.91 14.94,16.5 M7.51,16.5 L4.79,16.5 A8.5,8.5 0 0 0 8.88,19.91 Q8.09,18.66 7.61,16.89 Z M19.21,16.5 L16.5,16.5 C16.18,17.83 15.71,19 15.13,19.91 A8.5,8.5 0 0 0 19.03,16.78 Z M7.1,10 L3.74,10 L3.74,10.02 A8.5,8.5 0 0 0 4.04,15 L7.22,15 A20,20 0 0 1 7.09,10 M15.39,10 L8.6,10 A19,19 0 0 0 8.74,15 L15.26,15 A19,19 0 0 0 15.4,10 M20.27,10 L16.92,10 A21,21 0 0 1 16.79,15 L19.97,15 A8.5,8.5 0 0 0 20.27,10 M8.88,4.09 L8.86,4.09 A8.5,8.5 0 0 0 4.25,8.49 L7.3,8.5 C7.61,6.75 8.16,5.22 8.88,4.09 M12,3.49 L11.88,3.5 C10.62,3.62 9.4,5.62 8.83,8.5 L15.17,8.5 C14.61,5.63 13.39,3.63 12.13,3.5 Z M15.12,4.09 L15.22,4.26 A13,13 0 0 1 16.7,8.5 L19.75,8.5 A8.5,8.5 0 0 0 15.41,4.21 Z"/></Canvas></Viewbox><TextBlock x:Name="TxtBtnSearchDriver" Text="Search Online" VerticalAlignment="Center"/></StackPanel>
                    </ui:Button>

