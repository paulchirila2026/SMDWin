              </ScrollViewer>
            </Border>


                <!-- driver protection: the buttons are in the top bar; the card stays hidden for the state read by code -->
                <Border Grid.Row="2" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Visibility="Collapsed">
                  <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,8">
                      <Viewbox DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M3,5.75 C3,5.34 3.34,5 3.75,5 Q7.74,5 11.55,2.15 C11.82,1.95 12.18,1.95 12.45,2.15 Q16.26,5 20.25,5 C20.66,5 21,5.34 21,5.75 L21,11 C21,16 18.04,19.68 12.27,21.95 A0.8,0.8 0 0 1 11.73,21.95 C5.96,19.68 3,16 3,11 Z M4.5,6.48 L4.5,11 C4.5,15.26 6.95,18.38 12,20.44 C17.05,18.38 19.5,15.26 19.5,11 L19.5,6.48 A14.4,14.4 0 0 1 12,3.68 A14.4,14.4 0 0 1 4.5,6.48"/></Viewbox>
                      <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                        <TextBlock Text="Driver protection" Style="{StaticResource DashRowName}" ToolTip="Keep a driver in place"/>
                      </StackPanel>
                    </DockPanel>
                    <TextBlock Text="Useful after installing a specific driver (for example the GPU one) that Windows Update keeps replacing."
                               TextWrapping="Wrap" Style="{StaticResource CompSub}" Margin="0,0,0,10"/>
          <!-- Blocked devices list (collapsed by default) -->
          <Border x:Name="BlockedDevicesCard" Padding="0" Margin="0,4,0,10" Visibility="Collapsed">
            <StackPanel>
              <ItemsControl x:Name="BlockedDevicesList">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Background="{DynamicResource BgInputBrush}" CornerRadius="8"
                            Padding="10,6" Margin="0,2">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="Auto"/>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="" FontSize="{StaticResource FontSizeS}" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                          <TextBlock Text="{Binding DeviceName}" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                          <TextBlock Text="{Binding HardwareId}" FontSize="{StaticResource FontSizeS}"
                                     Foreground="{DynamicResource TextSecondaryBrush}"
                                     Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ui:Button Grid.Column="2" Appearance="Secondary"
                                Tag="{Binding Index}"
                                Click="UnblockDriver_Click"
                                Padding="8,4" Height="26" FontSize="{StaticResource FontSizeS}"
                                ToolTip="Permite din nou auto-update">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="11" Height="11" Margin="0,0,4,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M18.75,1 A4.75,4.75 0 0 1 23.5,5.75 L23.5,6.25 A0.75,0.75 0 0 1 22,6.25 L22,5.75 A3.25,3.25 0 0 0 15.5,5.75 L15.5,8 L16.75,8 C18.55,8 20,9.46 20,11.25 L20,18.75 C20,20.55 18.54,22 16.75,22 L7.25,22 A3.25,3.25 0 0 1 4,18.75 L4,11.25 C4,9.45 5.46,8 7.25,8 L14,8 L14,5.75 A4.75,4.75 0 0 1 18.75,1 M7.25,9.5 C6.28,9.5 5.5,10.28 5.5,11.25 L5.5,18.75 C5.5,19.72 6.28,20.5 7.25,20.5 L16.75,20.5 C17.72,20.5 18.5,19.72 18.5,18.75 L18.5,11.25 C18.5,10.28 17.72,9.5 16.75,9.5 Z M12,13.75 A1.25,1.25 0 0 1 12,16.25 A1.25,1.25 0 0 1 12,13.75"/></Canvas></Viewbox>
                            <TextBlock Text="Unblock" VerticalAlignment="Center"/>
                          </StackPanel>
                        </ui:Button>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock x:Name="TxtNoBlockedDrivers"
                         Text="No blocked drivers currently."
                         FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"
                         Opacity="0.6" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>
                    <Border Style="{StaticResource CompFootBand}">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource CompFootCellFirst}">
                          <StackPanel><TextBlock Text="Windows Update" Style="{StaticResource CompFootKey}"/>
                            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="LedBlockStatus" Width="8" Height="8" Fill="{DynamicResource StatusSuccessBrush}"
                       VerticalAlignment="Center" Margin="0,2,7,0">
                <Ellipse.Effect>
                  <DropShadowEffect Color="{DynamicResource ChartGreenColor}" BlurRadius="6" ShadowDepth="0"
                                    Opacity="0.7" RenderingBias="Quality"/>
                </Ellipse.Effect>
              </Ellipse>
                              <TextBlock x:Name="TxtGlobalBlockStatus" Text="Auto-update ON" Style="{StaticResource CompFootVal}"/>
                            </StackPanel>
                          </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource CompFootCell}">
                          <StackPanel><TextBlock Text="Blocked" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtBlockedCount" Text="0 blocked" Style="{StaticResource CompFootVal}"/></StackPanel>
                        </Border>
                      </Grid>
                    </Border>
                  </StackPanel>
                </Border>
              </Grid>
            </ScrollViewer>
          </Grid>
        </Grid>

        <!-- ── DISK / SSD ── -->
        <!-- the page is in views/Pages/StoragePage.xaml -->
        <pages:StoragePage x:Name="PageStorage"/>

        <!-- ── RAM ── -->
        <!-- the page is in views/Pages/RamPage.xaml -->
        <pages:RamPage x:Name="PageRam"/>

        <!-- ── NETWORK (the connection chain + traffic + adapters + tools) ── -->
        <!-- the page is in views/Pages/NetworkPage.xaml -->
        <pages:NetworkPage x:Name="PageNetwork"/>

        <!-- ── APPS ── -->
        <Grid x:Name="PanelApps" Visibility="Collapsed" Margin="{StaticResource PageMargin}" Style="{StaticResource PageFadeStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>
          <!-- titlu + actiuni -->
          <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="TxtAppsTitle" Text="Applications" Style="{StaticResource SectionTitleStyle}"/>
              <TextBlock x:Name="TxtAppsSubtitle" Text="Installed programs · size, age and what you may not need" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
              <ui:Button x:Name="BtnAddRemove" Appearance="Secondary" Click="OpenAddRemovePrograms_Click" Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M6.25,4.5 C5.28,4.5 4.5,5.28 4.5,6.25 L4.5,17.75 C4.5,18.72 5.28,19.5 6.25,19.5 L17.75,19.5 C18.72,19.5 19.5,18.72 19.5,17.75 L19.5,13.75 A0.75,0.75 0 0 1 21,13.75 L21,17.75 C21,19.55 19.54,21 17.75,21 L6.25,21 A3.25,3.25 0 0 1 3,17.75 L3,6.25 C3,4.45 4.46,3 6.25,3 L10.25,3 A0.75,0.75 0 0 1 10.25,4.5 Z M13,3.75 C13,3.34 13.34,3 13.75,3 L20.25,3 C20.66,3 21,3.34 21,3.75 L21,10.25 A0.75,0.75 0 0 1 19.5,10.25 L19.5,5.56 L14.28,10.78 A0.75,0.75 0 0 1 13.22,9.72 L18.44,4.5 L13.75,4.5 A0.75,0.75 0 0 1 13,3.75"/></Canvas></Viewbox>
                  <TextBlock Text="Programs &amp; Features" VerticalAlignment="Center"/>
                </StackPanel>
              </ui:Button>
              <ui:Button x:Name="BtnReloadApps" Appearance="Secondary" Click="LoadApps_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M16.25,5.18 C16,5.51 16.06,5.98 16.39,6.23 A7.24,7.24 0 0 1 12.79,19.21 L13.47,18.53 A0.75,0.75 0 0 0 12.49,17.4 L12.41,17.47 L10.41,19.47 A0.75,0.75 0 0 0 10.34,20.45 L10.41,20.53 L12.41,22.53 A0.75,0.75 0 0 0 13.54,21.55 L13.47,21.47 L12.72,20.72 A8.75,8.75 0 0 0 17.3,5.04 A0.75,0.75 0 0 0 16.25,5.18 M10.53,1.47 C10.23,1.77 10.23,2.24 10.53,2.53 L11.28,3.28 A8.75,8.75 0 0 0 6.43,18.75 A0.75,0.75 0 0 0 7.39,17.59 A7.23,7.23 0 0 1 11.2,4.8 L10.52,5.48 A0.75,0.75 0 1 0 11.58,6.54 L13.58,4.54 C13.88,4.24 13.88,3.77 13.58,3.48 L11.58,1.48 A0.75,0.75 0 0 0 10.52,1.48"/></Canvas></Viewbox>
                  <TextBlock Text="Reload" VerticalAlignment="Center"/>
                </StackPanel>
              </ui:Button>
            </WrapPanel>
          </Grid>

          <!-- ① Summary: 4 figures + search -->
          <Border Grid.Row="1" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="18,14,18,14" Margin="0,0,0,12">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock x:Name="TxtAppsStatCount" Text="—" Style="{StaticResource CompChartValue}" FontSize="26"/>
                <TextBlock Text="installed programs" Style="{StaticResource CompSub}"/>
              </StackPanel>
              <Border Grid.Column="1" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0" Padding="18,0,20,0">
                <StackPanel>
                  <TextBlock x:Name="TxtAppsStatSize" Text="—" Style="{StaticResource CompChartValue}" FontSize="26"/>
                  <TextBlock Text="used on disk" Style="{StaticResource CompSub}"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0" Padding="18,0,20,0">
                <StackPanel>
                  <TextBlock x:Name="TxtAppsStatRecent" Text="—" Style="{StaticResource CompChartValue}" FontSize="26" Foreground="{DynamicResource AccentBrush}"/>
                  <TextBlock Text="installed in the last 30 days" Style="{StaticResource CompSub}"/>
                </StackPanel>
              </Border>
              <Border Grid.Column="3" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0" Padding="18,0,20,0">
                <StackPanel>
                  <TextBlock x:Name="TxtAppsStatBloat" Text="—" Style="{StaticResource CompChartValue}" FontSize="26" Foreground="{DynamicResource StatusWarningBrush}"/>
                  <TextBlock Text="possibly unwanted" Style="{StaticResource CompSub}"/>
                </StackPanel>
              </Border>
              <Grid Grid.Column="5" Width="280" VerticalAlignment="Center">
                <TextBox Style="{StaticResource VanillaTextBoxStyle}" x:Name="TxtAppSearch" Height="32" Padding="9,0,26,0" VerticalContentAlignment="Center"
                         TextChanged="AppSearch_TextChanged"/>
                <TextBlock x:Name="TxtAppSearchPlaceholder" IsHitTestVisible="False" Text="Search name or publisher"
                           VerticalAlignment="Center" Margin="10,0,0,0" FontSize="{StaticResource FontSizeM}"
                           Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=TxtAppSearch}" Value="">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
                <Button x:Name="BtnClearAppSearch" Content="✕" Width="20" Height="20" Padding="0"
                        HorizontalAlignment="Right" Margin="0,0,5,0" Click="ClearAppSearch_Click" ToolTip="Clear search">
                  <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GhostButtonStyle}">
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text.Length, ElementName=TxtAppSearch}" Value="0">
                          <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Button.Style>
                </Button>
              </Grid>
            </Grid>
          </Border>

          <!-- ② Quick filters + sort order -->
          <DockPanel Grid.Row="2" Margin="0,0,0,10" LastChildFill="False">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
              <Border Style="{StaticResource SegmentTrackStyle}" Tag="SegTrack" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><ui:Button x:Name="BtnAppFilterAll" Content="All" Appearance="Secondary" Background="{DynamicResource SelBtnBg}" BorderBrush="{DynamicResource SelBtnBorderBrush}" BorderThickness="1" FontWeight="SemiBold" Tag="All" Click="AppFilter_Click" Padding="10,4" Margin="0,0,2,0"/>
              <ui:Button x:Name="BtnAppFilterLarge" Content="Large (1 GB+)" Appearance="Secondary" Tag="Large" Click="AppFilter_Click" Padding="10,4" Margin="0,0,2,0"/>
              <ui:Button x:Name="BtnAppFilterRecent" Content="Recent" Appearance="Secondary" Tag="Recent" Click="AppFilter_Click" Padding="10,4" Margin="0,0,2,0"
                         ToolTip="Installed in the last 30 days"/>
              <ui:Button x:Name="BtnAppFilterBloat" Content="Possibly unwanted" Appearance="Secondary" Tag="Bloat" Click="AppFilter_Click" Padding="10,4"
                         ToolTip="Common preinstalled trials, vendor utilities and promo apps — a hint for the technician, not a rule"/></StackPanel></Border>
            </StackPanel>
            <TextBlock x:Name="TxtAppsCount" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource CompSub}"/>
          </DockPanel>

          <!-- ③ The table | the chosen program -->
          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition x:Name="ColAppsSide" Width="340"/></Grid.ColumnDefinitions>

            <Border Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="0,14,0,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="18,0,18,8">
                  <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M8.75,13 C9.99,13 11,14 11,15.25 L11,18.75 C11,19.99 10,21 8.75,21 L5.25,21 C4.01,21 3,20 3,18.75 L3,15.25 C3,14.01 4,13 5.25,13 Z M18.75,13 C19.99,13 21,14 21,15.25 L21,18.75 C21,19.99 20,21 18.75,21 L15.25,21 C14.01,21 13,20 13,18.75 L13,15.25 C13,14.01 14,13 15.25,13 Z M8.75,14.5 L5.25,14.5 A0.75,0.75 0 0 0 4.5,15.25 L4.5,18.75 C4.5,19.16 4.84,19.5 5.25,19.5 L8.75,19.5 C9.16,19.5 9.5,19.16 9.5,18.75 L9.5,15.25 A0.75,0.75 0 0 0 8.75,14.5 M18.75,14.5 L15.25,14.5 A0.75,0.75 0 0 0 14.5,15.25 L14.5,18.75 C14.5,19.16 14.84,19.5 15.25,19.5 L18.75,19.5 C19.16,19.5 19.5,19.16 19.5,18.75 L19.5,15.25 A0.75,0.75 0 0 0 18.75,14.5 M8.75,3 C9.99,3 11,4 11,5.25 L11,8.75 C11,9.99 10,11 8.75,11 L5.25,11 C4.01,11 3,10 3,8.75 L3,5.25 C3,4.01 4,3 5.25,3 Z M18.75,3 C19.99,3 21,4 21,5.25 L21,8.75 C21,9.99 20,11 18.75,11 L15.25,11 C14.01,11 13,10 13,8.75 L13,5.25 C13,4.01 14,3 15.25,3 Z M8.75,4.5 L5.25,4.5 A0.75,0.75 0 0 0 4.5,5.25 L4.5,8.75 C4.5,9.16 4.84,9.5 5.25,9.5 L8.75,9.5 C9.16,9.5 9.5,9.16 9.5,8.75 L9.5,5.25 A0.75,0.75 0 0 0 8.75,4.5 M18.75,4.5 L15.25,4.5 A0.75,0.75 0 0 0 14.5,5.25 L14.5,8.75 C14.5,9.16 14.84,9.5 15.25,9.5 L18.75,9.5 C19.16,9.5 19.5,9.16 19.5,8.75 L19.5,5.25 A0.75,0.75 0 0 0 18.75,4.5"/></Viewbox>
                  <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Installed" Style="{StaticResource DashRowName}"/>
                      <TextBlock x:Name="TxtAppsTableSub" Text="—" Style="{StaticResource DashRowInlineSub}"/>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
                <DataGrid Grid.Row="1" Style="{StaticResource VanillaDataGridStyle}" x:Name="AppsGrid" local:CardClipBehavior.Radius="{DynamicResource RadiusCardD}"
                          CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" MinRowHeight="44"
                          CanUserSortColumns="True" SelectionChanged="AppsGrid_SelectionChanged"
                          GridLinesVisibility="None" BorderThickness="0">
                  <DataGrid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="Uninstall" Click="UninstallApp_Click"/>
                      <MenuItem Header="Change / Repair" Click="AppModify_Click"/>
                      <MenuItem Header="Open folder" Click="AppOpenFolder_Click"/>
                      <Separator/>
                      <MenuItem Header="Copy details" Click="AppCopyDetails_Click"/>
                      <MenuItem Header="Open in Registry Editor" Click="AppOpenRegistry_Click"/>
                      <MenuItem Header="Search online" Click="AppSearchOnline_Click"/>
                      <MenuItem Header="Check for a newer version" Click="AppCheckUpdate_Click"/>
                      <Separator/>
                      <MenuItem Header="Programs &amp; Features" Click="OpenAddRemovePrograms_Click"/>
                    </ContextMenu>
                  </DataGrid.ContextMenu>
                  <DataGrid.Columns>
                    <!-- iconita + nume / producator + pastile (New / Possibly unwanted) -->
                    <DataGridTemplateColumn Header="Application" Width="*" MinWidth="220" SortMemberPath="Name">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Grid VerticalAlignment="Center" Margin="4,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid Width="26" Height="26" Margin="0,0,10,0" VerticalAlignment="Center">
                              <Border CornerRadius="6" Background="{DynamicResource BgHoverBrush}"/>
                              <!-- without its own icon (or while it loads): a square in the program colour, with its initial -->
                              <Border CornerRadius="6" Background="{Binding TileBrush}">
                                <Border.Style>
                                  <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                      <DataTrigger Binding="{Binding Source, ElementName=AppRowIcon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                    </Style.Triggers>
                                  </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding Initial}" Foreground="White" FontWeight="SemiBold" FontSize="{StaticResource FontSizeM}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                              </Border>
                              <Image x:Name="AppRowIcon" Source="{Binding Icon, IsAsync=True}" Width="20" Height="20" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" MaxWidth="360">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                              <TextBlock Text="{Binding PublisherLine}" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                              <Grid Margin="8,0,0,0" VerticalAlignment="Center">
                                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
                                  <Style.Triggers><DataTrigger Binding="{Binding IsRecent}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></Grid.Style>
                                <Border CornerRadius="6" Background="{DynamicResource AccentBrush}" Opacity="0.14"/>
