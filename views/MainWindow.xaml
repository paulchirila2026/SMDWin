              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0" Fill="{DynamicResource StatusWarningBrush}"/>
