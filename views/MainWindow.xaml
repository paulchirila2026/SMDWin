<Window x:Class="SMDWin.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:SMDWin.Views"
        xmlns:pages="clr-namespace:SMDWin.Views.Pages"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title=""
        Icon="/Assets/smdwin.ico"
        Height="1120" Width="1780" MinWidth="900" MinHeight="640"
        Loaded="MainWindow_Loaded"
        FontFamily="Segoe UI"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResizeWithGrip"
        ShowInTaskbar="True"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome GlassFrameThickness="-1,-1,-1,-1"
                            CaptionHeight="32"
                            ResizeBorderThickness="6"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
      <BooleanToVisibilityConverter x:Key="BoolToVisConv"/>
      <local:StringToBrushConverter x:Key="StringToBrushConv"/>
      <local:BoolToOnOffConverter x:Key="BoolToOnOffConv"/>
      <local:FractionWidthConverter x:Key="FractionWidthConv"/>
      <!-- Stil buton caption (minimize/maximize/close) -->
      <Style x:Key="CaptionBtnStyle" TargetType="Button">
        <Setter Property="Width" Value="46"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="IsTabStop" Value="False"/>
        <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}">
                <!-- An explicit TextBlock with FontFamily and TextOptions for correct rendering -->
                <TextBlock Text="{TemplateBinding Content}"
                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol"
                           FontSize="{StaticResource FontSizeS}"
                           Foreground="{TemplateBinding Foreground}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextOptions.TextFormattingMode="Ideal"
                           TextOptions.TextRenderingMode="Grayscale"
                           UseLayoutRounding="True"
                           SnapsToDevicePixels="True"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource NavActiveBrush}"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
      <Style x:Key="CaptionCloseBtnStyle" TargetType="Button" BasedOn="{StaticResource CaptionBtnStyle}">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Button">
              <Border x:Name="Bd" Background="{TemplateBinding Background}">
                <TextBlock x:Name="CloseGlyph" Text="{TemplateBinding Content}"
                           FontFamily="Segoe MDL2 Assets, Segoe Fluent Icons, Segoe UI Symbol"
                           FontSize="{StaticResource FontSizeS}"
                           Foreground="{TemplateBinding Foreground}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           TextOptions.TextFormattingMode="Ideal"
                           TextOptions.TextRenderingMode="Grayscale"
                           UseLayoutRounding="True"
                           SnapsToDevicePixels="True"/>
              </Border>
              <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CloseHoverBrush}"/>
                  <Setter TargetName="CloseGlyph" Property="Foreground" Value="White"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                  <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ClosePressedBrush}"/>
                  <Setter TargetName="CloseGlyph" Property="Foreground" Value="White"/>
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">

      <!-- The page background: an opaque page colour (AuroraBaseBrush, from ThemeManager — nothing from the desktop shows through
           Mica, on Dark and on Light), and on Dark the soft lights, drawn as one picture in MainWindow.Aurora.cs at the screen's
           exact pixel size, with dithering so the gradients show no steps. -->
      <Grid x:Name="AuroraLayer" IsHitTestVisible="False" ClipToBounds="True"
            Loaded="AuroraLayer_Loaded" SizeChanged="AuroraLayer_SizeChanged">
        <Rectangle Fill="{DynamicResource AuroraBaseBrush}"/>
        <Image x:Name="AuroraImage" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        <!-- the same picture with the main light turned red; its opacity is raised very slowly while something is critical (MainWindow.Aurora.cs) -->
        <Image x:Name="AuroraAlertImage" Stretch="Fill" Opacity="0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
      </Grid>

      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

      <!-- ══════════════════════ SIDEBAR ══════════════════════ -->
      <!-- Outer container: transparent so inner card truly floats on page background -->
      <Border Grid.Column="0" x:Name="SidebarBorder" Background="Transparent" VerticalAlignment="Stretch"
              Width="232"
              Margin="0">
        <!-- Docked sidebar: attached to the left, full height, no floating card (no margin/corner/shadow). The background is
             semi-transparent (SidebarAcrylicBrush, computed in C# with a tint of the accent) — on Win11 Mica shows through it; on
             Win10 it falls back to a solid colour with the tint. -->
        <Border x:Name="SidebarInnerCard" Margin="0" CornerRadius="0"
                VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                BorderBrush="{DynamicResource SidebarBorderBrush}" BorderThickness="0,0,1,0"
                Background="{DynamicResource SidebarAcrylicBrush}"
                ClipToBounds="False" Panel.ZIndex="0">
        <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="0,28,0,0">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- Logo -->
            <RowDefinition Height="Auto"/>  <!-- Hamburger + Search -->
            <RowDefinition Height="*"/>     <!-- Nav -->
            <RowDefinition Height="Auto"/>  <!-- Bottom (widget toggle) -->
          </Grid.RowDefinitions>
          <Border x:Name="SidebarAccentGlow" CornerRadius="0" Grid.RowSpan="4"
                  IsHitTestVisible="False" Panel.ZIndex="0"
                  Background="Transparent"/>

            <!-- ── Row 0: Logo centered ── -->
            <Button x:Name="BtnAbout" Grid.Row="0" Background="Transparent" BorderThickness="0"
                    Cursor="Hand" Padding="0" HorizontalAlignment="Center"
                    Margin="0,8,0,4" IsTabStop="False"
                    shell:WindowChrome.IsHitTestVisibleInChrome="True"
                    FocusVisualStyle="{x:Null}"
                    Click="BtnAbout_Click">
              <Button.Template>
                <ControlTemplate TargetType="Button">
                  <Border x:Name="ABd" Background="Transparent" CornerRadius="8" Padding="8,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <!-- the logo: lit up to the orange segments at rest, up to red while a test runs (MainWindow.Logo.cs) -->
                      <local:SmdLogo x:Name="ImgSidebarLogo" Width="24" Height="24" Level="12"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                      <local:SmdWordmark x:Name="TxtSidebarTitle" FontSize="{StaticResource FontSizeXL}"
                                         Foreground="{DynamicResource SidebarTextPrimaryBrush}"
                                         VerticalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="ABd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </Button.Template>
            </Button>

            <!-- Admin LED moved to the bottom of the sidebar — an invisible stub kept for code compatibility -->
            <Ellipse x:Name="AdminLed" Grid.Row="0" Width="0" Height="0" Visibility="Collapsed"
                     Fill="{DynamicResource StatusWarningBrush}">
              <Ellipse.ToolTip><ToolTip>
                  <StackPanel>
                    <TextBlock x:Name="TxtAdminLedTitle" Text="User Mode" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBlock x:Name="TxtAdminLedBody" TextWrapping="Wrap" MaxWidth="230" FontSize="{StaticResource FontSizeS}">
                      <Run x:Name="RunAdminLedDesc" Text="Some features require Administrator privileges:"/>
                      <LineBreak/>
                      <Run x:Name="RunFeature1" Text="• CPU/GPU sensor temperatures"/>
                      <LineBreak/>
                      <Run x:Name="RunFeature2" Text="• SMART disk health details"/>
                      <LineBreak/>
                      <Run x:Name="RunFeature3" Text="• Hardware performance counters"/>
                      <LineBreak/><LineBreak/>
                      <Run x:Name="RunAdminLedAction" Text="Click to restart as Administrator →" Foreground="{DynamicResource StatusInfoBrush}"/>
                    </TextBlock>
                    <Border Height="1" Background="{DynamicResource BorderBrush2}" Margin="0,8,0,8"/>
                    <TextBlock FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}">
                      <Run Text="Sensors: "/>
                      <Run x:Name="RunSensorBackend" Text="WMI / PerformanceCounter" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </TextBlock>
                  </StackPanel>
              </ToolTip></Ellipse.ToolTip>
            </Ellipse>

            <!-- ── Row 1: hamburger + search ── -->
            <Border Grid.Row="1" Padding="0,4,0,4">
              <Grid Margin="18,0,10,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Hamburger button — always visible, first column; centred on the menu icons (MainWindow.UX.cs SidebarToggleLeft) -->
                <Button x:Name="BtnSidebarCollapse" Grid.Column="0"
                        Background="Transparent" BorderThickness="0"
                        Cursor="Hand" Width="36" Height="36" Margin="0,0,6,0"
                        Click="BtnSidebarCollapse_Click"
                        ToolTip="Toggle icons-only mode">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Width="36" Height="36">
                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" HorizontalAlignment="Center">
                          <Canvas Width="24" Height="24">
                            <Path x:Name="CollapseIcon" Fill="{DynamicResource SidebarTextBrush}" Data="F1 M2.75,18 L21.25,18 A0.75,0.75 0 0 1 21.35,19.5 L2.75,19.5 A0.75,0.75 0 0 1 2.65,18 Z L21.25,18 Z M2.75,11.5 L21.25,11.5 A0.75,0.75 0 0 1 21.35,13 L2.75,13 A0.75,0.75 0 0 1 2.65,11.5 Z L21.25,11.5 Z M2.75,5 L21.25,5 A0.75,0.75 0 0 1 21.35,6.5 L2.75,6.5 A0.75,0.75 0 0 1 2.65,5.01 Z L21.25,5 Z"/>
                          </Canvas>
                        </Viewbox>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                          <Setter TargetName="Bd" Property="Opacity" Value="0.6"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
                <!-- Search box (hidden when collapsed) -->
                <Border x:Name="SidebarSearchBox" Grid.Column="1" Height="32"
                        CornerRadius="8" Background="{DynamicResource BgInputBrush}"
                        BorderThickness="1">
                  <Border.Style>
                    <Style TargetType="Border">
                      <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource Self}}" Value="True">
                          <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </Border.Style>
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Viewbox Width="10" Height="10" Margin="7,0,3,0" VerticalAlignment="Center" Opacity="0.4">
                      <Canvas Width="24" Height="24"><Path Fill="{DynamicResource TextPrimaryBrush}" Data="F1 M16.1,17.16 A8,8 0 1 1 17.16,16.1 L21.78,20.72 A0.75,0.75 0 1 1 20.72,21.78 Z M17.5,11 A6.5,6.5 0 0 0 4.5,11 A6.5,6.5 0 0 0 17.5,11"/></Canvas>
                    </Viewbox>
                    <TextBox Style="{StaticResource VanillaTextBoxBareStyle}" x:Name="TxtSidebarSearch" Grid.Column="1"
                             Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             FontSize="{StaticResource FontSizeS}" Padding="0,0" VerticalContentAlignment="Center"
                             FocusVisualStyle="{x:Null}"
                             GotKeyboardFocus="SidebarSearch_GotKeyboardFocus"
                             PreviewKeyDown="SidebarSearch_PreviewKeyDown"
                             TextChanged="SidebarSearch_TextChanged"/>
                    <TextBlock x:Name="SidebarSearchHint" Grid.Column="1" Text="Search…"
                               FontSize="{StaticResource FontSizeS}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6"
                               IsHitTestVisible="False"/>
                    <Button x:Name="BtnSidebarSearchClear" Grid.Column="2"
                            Width="18" Height="18" Margin="0,0,3,0"
                            Background="Transparent" BorderThickness="0"
                            Cursor="Hand" Visibility="Collapsed"
                            Click="SidebarSearchClear_Click">
                      <TextBlock Text="✕" FontSize="{StaticResource FontSizeXS}" VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                  </Grid>
                </Border>
              </Grid>
            </Border>

            <!-- Stub: SidebarHeaderExtra kept for code-behind compatibility -->
            <StackPanel x:Name="SidebarHeaderExtra" Visibility="Collapsed"/>

            <ScrollViewer x:Name="NavScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto"
                          VerticalAlignment="Stretch" ClipToBounds="False">
              <StackPanel x:Name="NavStackPanel" Margin="10,0"
                          PreviewMouseLeftButtonDown="NavStackPanel_PreviewMouseLeftButtonDown">
                <Grid Margin="10,3,10,2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock x:Name="NavCatPrincipal" Text="PRINCIPAL" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                             Foreground="{DynamicResource NavCatFgBrush}" VerticalAlignment="Center"
                             Opacity="0.75" Margin="0,0,6,0"/>
                  <Border Grid.Column="1" Height="1" VerticalAlignment="Center"
                          Background="{DynamicResource NavCatFgBrush}" Opacity="0.30"/>
                </Grid>

                <!-- Dashboard -->
                <Button x:Name="BtnDashboard" Click="NavBtn_Click"
                        Style="{DynamicResource NavButtonActiveStyle}" Tag="Dashboard" Margin="0,0"
                        HorizontalContentAlignment="Stretch"
                        ToolTip="System overview: CPU, RAM, GPU, storage, health score">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="28" VerticalAlignment="Center" Margin="0,0,8,0"
                          ClipToBounds="False" Panel.ZIndex="10">
                      <Viewbox x:Name="IcoDashboard" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality">
                        <Canvas Width="24" Height="24">
                          <Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M7.93,16.07 A0.75,0.75 0 1 1 6.87,17.13 A7.25,7.25 0 0 1 13.67,4.94 A0.75,0.75 0 1 1 13.33,6.4 A5.75,5.75 0 0 0 7.93,16.07 M17.89,9.14 C18.28,9 18.71,9.21 18.84,9.6 A7.3,7.3 0 0 1 17.13,17.13 A0.75,0.75 0 1 1 16.07,16.07 A5.8,5.8 0 0 0 17.43,10.1 A0.75,0.75 0 0 1 17.89,9.14 M15.88,6.67 A0.63,0.63 0 0 1 16.84,7.43 L16.71,7.68 A355,355 0 0 1 13.69,13.35 C13.57,13.55 13.45,13.75 13.37,13.85 A1.88,1.88 0 0 1 10.43,11.52 Q10.57,11.36 10.84,11.1 L11.52,10.47 A154,154 0 0 1 15.67,6.85 Z M22,12 A10,10 0 0 1 2,12 A10,10 0 0 1 22,12 M3.5,12 A8.5,8.5 0 0 0 20.5,12 A8.5,8.5 0 0 0 3.5,12"/>
                        </Canvas>
                      </Viewbox>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="Dashboard" VerticalAlignment="Center"/>
                  </Grid>
                </Button>

                <!-- System Information -->
                <Button x:Name="BtnSysInfo" Click="NavBtn_Click"
                        Style="{DynamicResource NavButtonStyle}" Tag="SysInfo" Margin="0,0"
                        HorizontalContentAlignment="Stretch"
                        ToolTip="Hardware and Windows details, component by component">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="28" VerticalAlignment="Center" Margin="0,0,8,0"
                          ClipToBounds="False" Panel.ZIndex="10">
                      <Viewbox x:Name="IcoSysInfo" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality">
                        <Canvas Width="24" Height="24">
                          <Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M6.75,22 A0.75,0.75 0 0 1 6.65,20.5 L8.5,20.5 L8.5,18 L4.25,18 C3.05,18 2.08,17.08 2.01,15.9 L2,15.76 L2,5.25 C2,4.05 2.93,3.08 4.1,3.01 L4.25,3 L19.75,3 C20.94,3 21.91,3.93 21.99,5.1 L21.99,15.75 C21.99,16.95 21.07,17.92 19.9,18 L15.5,18 L15.5,20.5 L17.25,20.5 A0.75,0.75 0 0 1 17.35,22 L6.75,22 M14,18 L10,18 L10,20.5 L14,20.5 Z M19.75,4.5 L4.25,4.5 C3.87,4.5 3.55,4.78 3.51,5.15 L3.5,5.25 L3.5,15.75 C3.5,16.13 3.78,16.45 4.15,16.5 L19.75,16.5 C20.13,16.5 20.45,16.22 20.49,15.85 L20.49,5.25 C20.49,4.87 20.22,4.55 19.85,4.51 Z"/>
                        </Canvas>
                      </Viewbox>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="System Info" VerticalAlignment="Center"/>
                  </Grid>
                </Button>

                <!-- Temp & Stress -->
                <Button x:Name="BtnStress" Click="NavBtn_Click"
                        Style="{DynamicResource NavButtonStyle}" Tag="Stress" Margin="0,0"
                        HorizontalContentAlignment="Stretch"
                        ToolTip="Real-time temperatures, stress test and CPU benchmark">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Width="28" VerticalAlignment="Center" Margin="0,0,8,0"
                          ClipToBounds="False" Panel.ZIndex="10">
                      <Viewbox x:Name="IcoStress" Width="18" Height="18" VerticalAlignment="Center" Margin="0,0,8,0" RenderOptions.BitmapScalingMode="HighQuality">
                        <Canvas Width="24" Height="24">
                          <Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M12,2 A3.25,3.25 0 0 1 15.24,5.07 L15.25,5.25 L15.25,13.2 L15.33,13.27 A5,5 0 0 1 16.97,16.49 L16.99,16.75 L17,17 A5,5 0 1 1 8.49,13.44 L8.67,13.27 L8.75,13.2 L8.75,5.25 A3.25,3.25 0 0 1 11.63,2.02 L11.82,2.01 Z M12,3.5 C11.08,3.5 10.33,4.2 10.26,5.1 L10.25,5.25 L10.25,13.95 L9.95,14.17 A3.5,3.5 0 1 0 14.22,14.3 L14.06,14.17 L13.76,13.95 L13.75,5.25 C13.75,4.28 12.97,3.5 12,3.5 M12,8 C12.41,8 12.75,8.34 12.75,8.75 L12.75,14.61 A2.5,2.5 0 1 1 11.25,14.61 L11.25,8.75 C11.25,8.34 11.59,8 12,8"/>
                        </Canvas>
                      </Viewbox>
                      <Ellipse x:Name="SidebarStressThrottleDot" Width="8" Height="8"
                               Fill="{DynamicResource ActionRedBrush}" Stroke="{DynamicResource SidebarBgBrush}" StrokeThickness="1.5"
                               Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                               Margin="0,0,-2,-2" Panel.ZIndex="20"
                               ToolTip="CPU throttling detected — see Temp &amp; Stress"/>
                      <Border x:Name="BadgeTemp" Width="9" Height="9" CornerRadius="4.5" Padding="0"
                              Background="{DynamicResource StatusCritBrush}" BorderThickness="1.5" BorderBrush="{DynamicResource SidebarBgBrush}"
                              Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
                              Margin="0,-1,5,0" Panel.ZIndex="20">
                        <TextBlock Visibility="Collapsed" x:Name="TxtBadgeTemp" Text="!" FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                                   Foreground="White" FontFamily="{DynamicResource MonoFont}"
                                   HorizontalAlignment="Center" LineHeight="11"/>
                      </Border>
                    </Grid>
                    <TextBlock Grid.Column="1" Text="Temp &amp; Stress" VerticalAlignment="Center"/>
                    <Grid x:Name="TaskBadgeStress" Grid.Column="1" Width="12" Height="12"
                          HorizontalAlignment="Right" VerticalAlignment="Center"
                          Margin="0,0,11,0" Visibility="Collapsed"
                          ToolTip="A test is currently running">
                      <Ellipse x:Name="TaskBadgeStressDot" Width="8" Height="8" Fill="{DynamicResource AccentBrush}"/>
                      <local:TaskBadgeSquares x:Name="TaskBadgeStressSquares" Width="12" Height="12" Visibility="Collapsed"/>
                      <Viewbox x:Name="TaskBadgeStressRing" Width="12" Height="12" Visibility="Collapsed"
                               RenderTransformOrigin="0.5,0.5">
                        <Viewbox.RenderTransform><RotateTransform x:Name="TaskBadgeStressRingRotate"/></Viewbox.RenderTransform>
                        <Canvas Width="24" Height="24">
                          <Path Data="M12,3 A9,9 0 1 1 4.2,7.5" Stroke="{DynamicResource AccentBrush}"
                                StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="Transparent"/>
                        </Canvas>
                      </Viewbox>
                      <Viewbox x:Name="TaskBadgeStressHourglass" Width="12" Height="12" Visibility="Collapsed">
                        <Canvas Width="24" Height="24">
                          <Path Fill="{DynamicResource AccentBrush}" Data="F1 M4,4.75 A2.75,2.75 0 0 1 6.75,2 L17.25,2 A2.75,2.75 0 0 1 20,4.75 L20,5.17 C20,7.19 18.94,9.06 17.2,10.1 L15.4,11.19 A0.75,0.75 0 0 0 15.36,12.45 L17.48,13.89 A5.8,5.8 0 0 1 20,18.65 L20,19.25 A2.75,2.75 0 0 1 17.25,22 L6.75,22 A2.75,2.75 0 0 1 4,19.25 L4,18.65 C4,16.75 4.94,14.96 6.52,13.89 L8.64,12.45 A0.75,0.75 0 0 0 8.6,11.19 L6.8,10.1 A5.8,5.8 0 0 1 4,5.17 Z M6.75,3.5 C6.06,3.5 5.5,4.06 5.5,4.75 L5.5,5.17 C5.5,6.67 6.28,8.05 7.56,8.81 L9.37,9.9 C10.78,10.74 10.84,12.77 9.48,13.69 L7.36,15.13 A4.3,4.3 0 0 0 5.5,18.65 L5.5,19.25 C5.5,19.94 6.06,20.5 6.75,20.5 L17.25,20.5 C17.94,20.5 18.5,19.94 18.5,19.25 L18.5,18.65 C18.5,17.24 17.8,15.92 16.64,15.13 L14.52,13.69 A2.25,2.25 0 0 1 14.62,9.9 L16.44,8.81 A4.3,4.3 0 0 0 18.5,5.17 L18.5,4.75 C18.5,4.06 17.94,3.5 17.25,3.5 Z"/>
                        </Canvas>
                      </Viewbox>
                      <Viewbox x:Name="TaskBadgeStressBolt" Width="12" Height="12" Visibility="Collapsed">
                        <Canvas Width="24" Height="24">
