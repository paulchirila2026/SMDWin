                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="11" Height="11" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M9.14,3.7 A3.25,3.25 0 0 1 14.86,3.7 L21.6,16.2 A3.25,3.25 0 0 1 18.74,21 L5.25,21 A3.25,3.25 0 0 1 2.39,16.2 Z M13.54,4.42 A1.75,1.75 0 0 0 10.46,4.42 L3.7,16.92 A1.75,1.75 0 0 0 5.24,19.5 L18.74,19.5 A1.75,1.75 0 0 0 20.27,16.92 Z M12,15 A1,1 0 0 1 12,17 A1,1 0 0 1 12,15 M12,7.5 C12.41,7.5 12.75,7.84 12.75,8.25 L12.75,12.75 A0.75,0.75 0 0 1 11.25,12.75 L11.25,8.25 C11.25,7.84 11.59,7.5 12,7.5"/></Canvas></Viewbox><TextBlock Text="Critical" VerticalAlignment="Center"/></StackPanel>
