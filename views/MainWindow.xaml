                Background="Transparent"
                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                ToolTip="Running in Portable Mode — settings are saved next to the .exe file, not in AppData. Safe to run from USB or Desktop.">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
                </Trigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel x:Name="PortableStatusContent" Orientation="Horizontal" VerticalAlignment="Center">
