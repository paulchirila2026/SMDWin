                ToolTip="PawnIO isn't installed — CPU/GPU sensor readings are unavailable. Click to retry installation.">
          <Border.Style>
            <Style TargetType="Border">
              <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                  <Setter Property="Background" Value="#33F59E0B"/>
