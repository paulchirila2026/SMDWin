                              </Grid>
                              <Grid Margin="6,0,0,0" VerticalAlignment="Center" ToolTip="Commonly preinstalled or promotional software — check whether the user needs it">
                                <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/>
                                  <Style.Triggers><DataTrigger Binding="{Binding IsBloat}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                </Style></Grid.Style>
                                <Border CornerRadius="6" Background="{DynamicResource StatusWarningBrush}" Opacity="0.14"/>
