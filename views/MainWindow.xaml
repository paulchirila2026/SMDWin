                           VerticalAlignment="Center" Margin="9,0,0,0" FontSize="{StaticResource FontSizeM}"
                           Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.5">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
          </WrapPanel>


          <!-- Chart: how many errors (red) and warnings (orange) per hour / day, in the chosen interval. Built in code. -->
          <Border Grid.Row="2" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Margin="0,0,0,12" Padding="18,12,18,10">
            <StackPanel>
              <DockPanel LastChildFill="False" Margin="0,0,0,8">
                <Viewbox DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M8.46,6.8 L11.75,20.43 C11.92,21.16 12.95,21.2 13.19,20.48 L16.45,10.36 L17.03,12.46 C17.13,12.78 17.42,13 17.75,13 L21.25,13 A0.75,0.75 0 0 0 21.25,11.5 L18.32,11.5 L17.22,7.55 A0.75,0.75 0 0 0 15.78,7.52 L12.58,17.48 L9.23,3.58 C9.04,2.82 7.97,2.81 7.77,3.56 L5.67,11.5 L2.75,11.5 A0.75,0.75 0 0 0 2.75,13 L6.25,13 C6.59,13 6.88,12.77 6.97,12.44 Z"/></Viewbox>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtEvTimelineCaption" Text="Over time" Style="{StaticResource DashRowName}"/>
                    <TextBlock x:Name="TxtEvTimelineSub" Text="Press Scan to load the event log" Style="{StaticResource DashRowInlineSub}"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <Border Width="14" Height="3" CornerRadius="1.5" Background="{DynamicResource StatusCritBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBlock Text="critical / error" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                  <Border Width="14" Height="3" CornerRadius="1.5" Background="{DynamicResource StatusWarningBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBlock Text="warning" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
              </DockPanel>
              <UniformGrid x:Name="EvTimelineBars" Rows="1" Height="64"/>
              <!-- the label of each bar ("Mo 28", "14:00"), centred under it — MainWindow.EventsKb.cs → DrawEventsTimelineLabels -->
              <Canvas x:Name="EvTimelineLabels" Height="16" Margin="0,4,0,0"/>
            </StackPanel>
          </Border>

          <Grid Grid.Row="3">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.7*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="320"/></Grid.ColumnDefinitions>

            <!-- The table (grouped: the same event = one row with ×N) -->
            <Border Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="0,14,0,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="18,0,18,8">
                  <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M8.75,11.5 A0.75,0.75 0 0 0 8.75,13 L15.25,13 A0.75,0.75 0 0 0 15.25,11.5 Z M8.75,14.25 A0.75,0.75 0 0 0 8.75,15.75 L15.25,15.75 A0.75,0.75 0 0 0 15.25,14.25 Z M8.75,17 A0.75,0.75 0 0 0 8.75,18.5 L15.25,18.5 A0.75,0.75 0 0 0 15.25,17 Z M13.59,2.59 L19.4,8.4 A2,2 0 0 1 20,9.83 L20,20 A2,2 0 0 1 18,22 L6,22 A2,2 0 0 1 4,20 L4,4 C4,2.9 4.9,2 6,2 L12.17,2 C12.69,2 13.22,2.22 13.59,2.59 M18,20.5 A0.5,0.5 0 0 0 18.5,20 L18.5,10 L14,10 A2,2 0 0 1 12,8 L12,3.5 L6,3.5 A0.5,0.5 0 0 0 5.5,4 L5.5,20 C5.5,20.27 5.72,20.5 6,20.5 Z M17.38,8.5 L13.5,4.62 L13.5,8 C13.5,8.28 13.72,8.5 14,8.5 Z"/></Viewbox>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Events" Style="{StaticResource DashRowCaption}"/>
                    <TextBlock x:Name="TxtEvTableSub" Text="Newest first" Style="{StaticResource DashRowSub}"/>
                  </StackPanel>
                </StackPanel>
                <Grid Grid.Row="1">
                <DataGrid Style="{StaticResource VanillaDataGridStyle}" x:Name="EventsGrid" local:CardClipBehavior.Radius="{DynamicResource RadiusCardD}" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserSortColumns="True" SelectionChanged="EventsGrid_SelectionChanged" MinRowHeight="40"
                          EnableRowVirtualization="True" EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True">
                  <DataGrid.Columns>
                    <DataGridTemplateColumn x:Name="ColEvLevel" Header="Level" Width="118" SortMemberPath="Level">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                            <Ellipse Width="8" Height="8" Fill="{Binding LevelColor, Converter={StaticResource ThemeStatusBrush}}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                            <TextBlock Text="{Binding LevelDisplay}" Foreground="{Binding LevelColor, Converter={StaticResource ThemeStatusBrush}}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="ColEvTime" Header="When"
                                        Binding="{Binding TimeCreated, StringFormat=\{0:dd.MM HH:mm\}}" Width="100">
                      <DataGridTextColumn.ElementStyle>
                        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
                      </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <!-- first what it means (the title from the SMD Win database or the first sentence of the Windows message), below it,
                         small, the technical source -->
                    <DataGridTemplateColumn x:Name="ColEvMsg" Header="What happened" Width="*" MinWidth="220" SortMemberPath="Headline">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <StackPanel VerticalAlignment="Center" Margin="0,3" ToolTip="{Binding MessageSingleLine}">
                            <StackPanel.Style>
                              <Style TargetType="StackPanel">
                                <Style.Triggers>
                                  <!-- Windows routine messages: dimmed -->
                                  <DataTrigger Binding="{Binding IsHarmless}" Value="True"><Setter Property="Opacity" Value="0.55"/></DataTrigger>
                                </Style.Triggers>
                              </Style>
                            </StackPanel.Style>
                            <TextBlock Text="{Binding Headline}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding SourceLine}" FontSize="{StaticResource FontSizeXS}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextSecondaryBrush}"/>
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- how many times; a width with a reserve, so the scroll bar does not cover the number -->
                    <DataGridTemplateColumn Header="" Width="74" SortMemberPath="Count">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <TextBlock Text="{Binding CountDisplay}" FontFamily="{StaticResource NumFont}" FontWeight="SemiBold" HorizontalAlignment="Right"
                                     VerticalAlignment="Center" Margin="0,0,22,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- the source now has its own small line in "What happened"; the column stays only for sorting from code -->
                    <DataGridTextColumn x:Name="ColEvSource" Header="Source" Binding="{Binding Source}" Width="0" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="ColEvLog" Header="Log" Binding="{Binding LogName}" Width="0" Visibility="Collapsed"/>
                    <DataGridTextColumn x:Name="ColEvId" Header="EventID" Binding="{Binding EventId}" Width="0" Visibility="Collapsed"/>
                  </DataGrid.Columns>
                </DataGrid>
            <!-- Empty state — icon + text, replaces plain placeholder -->
            <StackPanel x:Name="TxtEventsPlaceholderPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,20,0,0" Visibility="Visible">
              <Viewbox Width="40" Height="40" Margin="0,0,0,12" Opacity="0.35">
                <Canvas Width="24" Height="24">
                  <Path Fill="{DynamicResource TextSecondaryBrush}" Data="F1 M8.75,11.5 A0.75,0.75 0 0 0 8.75,13 L15.25,13 A0.75,0.75 0 0 0 15.25,11.5 Z M8.75,14.25 A0.75,0.75 0 0 0 8.75,15.75 L15.25,15.75 A0.75,0.75 0 0 0 15.25,14.25 Z M8.75,17 A0.75,0.75 0 0 0 8.75,18.5 L15.25,18.5 A0.75,0.75 0 0 0 15.25,17 Z M13.59,2.59 L19.4,8.4 A2,2 0 0 1 20,9.83 L20,20 A2,2 0 0 1 18,22 L6,22 A2,2 0 0 1 4,20 L4,4 C4,2.9 4.9,2 6,2 L12.17,2 C12.69,2 13.22,2.22 13.59,2.59 M18,20.5 A0.5,0.5 0 0 0 18.5,20 L18.5,10 L14,10 A2,2 0 0 1 12,8 L12,3.5 L6,3.5 A0.5,0.5 0 0 0 5.5,4 L5.5,20 C5.5,20.27 5.72,20.5 6,20.5 Z M17.38,8.5 L13.5,4.62 L13.5,8 C13.5,8.28 13.72,8.5 14,8.5 Z"/>
                </Canvas>
              </Viewbox>
              <TextBlock x:Name="TxtEventsPlaceholder" Style="{StaticResource EmptyStateTextStyle}"
                         Text="Press Scan to load events from the Event Log."/>
            </StackPanel>
                </Grid>
              </Grid>
            </Border>

            <!-- The chosen event: what it means (from the event database) + what to do + the full message -->
            <Border Grid.Column="2" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="18,14,18,14">
              <Grid>
                <StackPanel x:Name="EvDetailEmpty" VerticalAlignment="Top">
                  <TextBlock Text="Selected event" Style="{StaticResource DashRowCaption}"/>
                  <TextBlock Text="Scan the event log, then pick an event to see what it means and what to do about it." TextWrapping="Wrap" Margin="0,6,0,0" Style="{StaticResource CompSub}"/>
                </StackPanel>
                <ScrollViewer x:Name="EventDetailPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <DockPanel LastChildFill="False" Margin="0,0,0,10">
                      <StackPanel DockPanel.Dock="Left">
                        <TextBlock x:Name="TxtEvDetTitle" Text="—" Style="{StaticResource DashRowName}" TextWrapping="Wrap" TextTrimming="None"/>
                        <TextBlock x:Name="TxtEvDetSource" Text="" Style="{StaticResource DashRowSub}"/>
                      </StackPanel>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                      <Ellipse x:Name="EvDetDot" Width="8" Height="8" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,7,0"/>
                      <TextBlock x:Name="TxtEvDetCount" Text="" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border x:Name="EvDetMeaningBox" Background="{DynamicResource BgHoverBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                      <StackPanel>
                        <TextBlock Text="What it means" Style="{StaticResource DashRowCaption}"/>
                        <TextBlock x:Name="TxtEvDetMeaning" Text="" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="{StaticResource FontSizeM}"/>
                        <TextBlock x:Name="TxtEvDetStepsCaption" Text="What to do" Style="{StaticResource DashRowCaption}" Margin="0,10,0,0"/>
                        <TextBlock x:Name="TxtEvDetSteps" Text="" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="{StaticResource FontSizeM}"/>
                      </StackPanel>
                    </Border>
                    <WrapPanel Margin="0,0,0,12">
                      <ui:Button x:Name="BtnEvDetPage" Appearance="Primary" Click="EvDetPage_Click" Margin="0,0,6,6" Visibility="Collapsed"/>
                      <ui:Button Appearance="Secondary" Click="EvDetSearch_Click" Margin="0,0,6,6" Content="Search online"/>
                      <ui:Button Appearance="Secondary" Click="EvDetCopy_Click" Margin="0,0,6,6" Content="Copy"/>
                    </WrapPanel>
                    <TextBlock Text="Full message" Style="{StaticResource DashRowCaption}" Margin="0,0,0,4"/>
                    <TextBox Style="{StaticResource VanillaTextBoxBareStyle}" x:Name="TxtEventDetail" FontSize="{StaticResource FontSizeS}" TextWrapping="Wrap"
                             Foreground="{DynamicResource TextSecondaryBrush}" IsReadOnly="True"
                             BorderThickness="0" Background="Transparent" IsReadOnlyCaretVisible="True" Cursor="IBeam"/>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
            </Border>
          </Grid>

          <Grid Visibility="Collapsed" MaxHeight="0">
            <Border x:Name="EventsPerfmonCard">
              <StackPanel>
                <Canvas x:Name="PerfmonCpuCanvas"/>
                <TextBlock x:Name="PerfmonCpuLabel"/>
                <Canvas x:Name="PerfmonNetCanvas"/>
                <TextBlock x:Name="PerfmonNetLabel"/>
              </StackPanel>
            </Border>
            <TextBlock x:Name="TxtRecentEventsLabel"/>
            <DataGrid Style="{StaticResource VanillaDataGridStyle}" x:Name="DashEventsGrid" AutoGenerateColumns="False">
              <DataGrid.Columns>
                <DataGridTextColumn x:Name="ColDashTime" Header="Time"/>
                <DataGridTemplateColumn x:Name="ColDashLevel" Header="Level"/>
                <DataGridTextColumn x:Name="ColDashSource" Header="Source"/>
                <DataGridTextColumn x:Name="ColDashEventId" Header="EventID"/>
                <DataGridTextColumn x:Name="ColDashMsg" Header="Message"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>
        </Grid>

        <!-- ── CRASH / BSOD ── -->
        <Grid x:Name="PanelCrash" Visibility="Collapsed" Margin="{StaticResource PageMargin}" Style="{StaticResource PageFadeStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*" MinHeight="200"/>
          </Grid.RowDefinitions>
          <!-- titlu + actiuni -->
          <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="TxtCrashTitle" Text="BSOD / Crash" Style="{StaticResource SectionTitleStyle}"/>
              <TextBlock x:Name="TxtCrashSubtitle" Text="Stability over the last 30 days · blue screens · minidump analysis" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
            <ui:Button x:Name="BtnOpenMiniDump" Appearance="Secondary" 
                    Click="OpenMiniDumpFolder_Click" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path x:Name="IconStorageTabFiles" Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M3.5,6.25 L3.5,8 L8.13,8 Q8.44,8 8.66,7.78 L10.19,6.25 L8.66,4.72 A0.8,0.8 0 0 0 8.13,4.5 L5.25,4.5 C4.28,4.5 3.5,5.28 3.5,6.25 M2,6.25 C2,4.45 3.46,3 5.25,3 L8.13,3 C8.73,3 9.3,3.24 9.72,3.66 L11.56,5.5 L18.75,5.5 C20.55,5.5 22,6.96 22,8.75 L22,17.75 C22,19.55 20.54,21 18.75,21 L5.25,21 A3.25,3.25 0 0 1 2,17.75 Z M3.5,9.5 L3.5,17.75 C3.5,18.72 4.28,19.5 5.25,19.5 L18.75,19.5 C19.72,19.5 20.5,18.72 20.5,17.75 L20.5,8.75 C20.5,7.78 19.72,7 18.75,7 L11.56,7 L9.72,8.84 C9.3,9.26 8.72,9.5 8.12,9.5 Z"/></Canvas></Viewbox>
                <TextBlock Text="Minidump folder" VerticalAlignment="Center"/>
              </StackPanel>
            </ui:Button>
            <ui:Button x:Name="BtnWinDbg" Appearance="Secondary" Click="OpenWinDbg_Click" Margin="0,0,8,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M15.05,1.5 A0.75,0.75 0 0 1 16.45,2 L8.95,22.5 A0.75,0.75 0 0 1 7.55,22 Z M6.2,6.22 A0.75,0.75 0 0 1 7.28,7.26 L2.8,12 L7.3,16.73 A0.75,0.75 0 0 1 6.22,17.77 L1.22,12.52 A0.75,0.75 0 0 1 1.22,11.48 Z M16.72,6.2 A0.75,0.75 0 0 1 17.78,6.22 L22.78,11.47 C23.06,11.77 23.06,12.22 22.78,12.51 L17.78,17.76 A0.75,0.75 0 0 1 16.7,16.72 L21.2,12 L16.7,7.27 A0.75,0.75 0 0 1 16.72,6.21"/></Canvas></Viewbox>
                <TextBlock x:Name="TxtBtnWinDbg" Text="Analyze with WinDbg" VerticalAlignment="Center"/>
              </StackPanel>
            </ui:Button>
            <ui:Button x:Name="BtnReloadCrashes" Appearance="Primary" Click="LoadCrashes_Click" Margin="0,0,0,0">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M16.25,5.18 C16,5.51 16.06,5.98 16.39,6.23 A7.24,7.24 0 0 1 12.79,19.21 L13.47,18.53 A0.75,0.75 0 0 0 12.49,17.4 L12.41,17.47 L10.41,19.47 A0.75,0.75 0 0 0 10.34,20.45 L10.41,20.53 L12.41,22.53 A0.75,0.75 0 0 0 13.54,21.55 L13.47,21.47 L12.72,20.72 A8.75,8.75 0 0 0 17.3,5.04 A0.75,0.75 0 0 0 16.25,5.18 M10.53,1.47 C10.23,1.77 10.23,2.24 10.53,2.53 L11.28,3.28 A8.75,8.75 0 0 0 6.43,18.75 A0.75,0.75 0 0 0 7.39,17.59 A7.23,7.23 0 0 1 11.2,4.8 L10.52,5.48 A0.75,0.75 0 1 0 11.58,6.54 L13.58,4.54 C13.88,4.24 13.88,3.77 13.58,3.48 L11.58,1.48 A0.75,0.75 0 0 0 10.52,1.48"/></Canvas></Viewbox>
                <TextBlock Text="Reload" VerticalAlignment="Center"/>
              </StackPanel>
            </ui:Button>
            </WrapPanel>
          </Grid>

          <!-- ① Stability over 30 days (Reliability Monitor) — LoadStabilityAsync -->
          <Border Grid.Row="1" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Margin="0,0,0,12">
            <StackPanel>
              <DockPanel LastChildFill="False" Margin="0,0,0,8">
                <Viewbox DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M3,5.75 C3,5.34 3.34,5 3.75,5 Q7.74,5 11.55,2.15 C11.82,1.95 12.18,1.95 12.45,2.15 Q16.26,5 20.25,5 C20.66,5 21,5.34 21,5.75 L21,11 C21,16 18.04,19.68 12.27,21.95 A0.8,0.8 0 0 1 11.73,21.95 C5.96,19.68 3,16 3,11 Z M4.5,6.48 L4.5,11 C4.5,15.26 6.95,18.38 12,20.44 C17.05,18.38 19.5,15.26 19.5,11 L19.5,6.48 A14.4,14.4 0 0 1 12,3.68 A14.4,14.4 0 0 1 4.5,6.48"/></Viewbox>
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                  <TextBlock Text="Stability · last 30 days" Style="{StaticResource DashRowName}" ToolTip="Last 30 days"/>
                </StackPanel>
                <Border x:Name="StabilityVerdictPill" DockPanel.Dock="Right" Background="Transparent" Padding="0" VerticalAlignment="Center">
                  <TextBlock x:Name="TxtStabilityVerdict" Text="Checking…" Style="{StaticResource CompStatusText}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
              </DockPanel>
              <local:StabilityChart x:Name="StabilityChartCtl" Height="84" MouseMove="StabilityChart_MouseMove"
                                    ToolTipService.InitialShowDelay="100"/>
              <WrapPanel x:Name="StabilityCounters" Margin="0,10,0,6"/>
            </StackPanel>
          </Border>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*" MinWidth="340"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition x:Name="CrashMainRow" Height="*"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

            <!-- ② Blue screens (minidumps); without any, the card becomes a single full-width row (UpdateCrashEmptyState) -->
            <Border x:Name="CrashListCard" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="0,14,0,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="18,0,18,8">
                  <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M12,2 A10,10 0 0 1 12,22 A10,10 0 0 1 12,2 M12,3.5 A8.5,8.5 0 0 0 12,20.5 A8.5,8.5 0 0 0 12,3.5 M15.45,8.4 L15.53,8.47 C15.8,8.74 15.83,9.15 15.6,9.45 L15.53,9.53 L13.06,12 L15.53,14.47 C15.8,14.74 15.83,15.15 15.6,15.45 L15.53,15.53 A0.75,0.75 0 0 1 14.55,15.6 L14.47,15.53 L12,13.06 L9.53,15.53 A0.75,0.75 0 0 1 8.55,15.6 L8.47,15.53 A0.75,0.75 0 0 1 8.4,14.55 L8.47,14.47 L10.94,12 L8.47,9.53 A0.75,0.75 0 0 1 8.4,8.55 L8.47,8.47 A0.75,0.75 0 0 1 9.45,8.4 L9.53,8.47 L12,10.94 L14.47,8.47 A0.75,0.75 0 0 1 15.45,8.4"/></Viewbox>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Blue screens" Style="{StaticResource DashRowCaption}"/>
                    <TextBlock x:Name="TxtCrashListSub" Text="From C:\Windows\Minidump · click one to see what happened" Style="{StaticResource DashRowSub}"/>
                  </StackPanel>
                </StackPanel>
                <Grid Grid.Row="1">
              <DataGrid Style="{StaticResource VanillaDataGridStyle}" x:Name="CrashGrid" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                        MouseDoubleClick="CrashGrid_DoubleClick" SelectionChanged="CrashGrid_SelectionChanged" MinRowHeight="42" local:CardClipBehavior.Radius="{DynamicResource RadiusCardD}">
                <DataGrid.Columns>
                  <DataGridTextColumn x:Name="ColCrashDate" Header="Data Crash"
                                      Binding="{Binding CrashTime, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="130"/>
                  <DataGridTextColumn x:Name="ColCrashFile" Header="File" Binding="{Binding FileName}" Width="Auto" MinWidth="140">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="ToolTip" Value="{Binding FileName}"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn x:Name="ColCrashStopCode" Header="Stop Code" Binding="{Binding StopCode}" Width="1.3*" MinWidth="180">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="ToolTip" Value="{Binding BugcheckParams}"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <!-- the probable cause appears in "What happened" (TxtCrDetModule); the column is hidden so the list fits without
                       horizontal scrolling -->
                  <DataGridTextColumn x:Name="ColCrashModule" Header="Likely cause" Binding="{Binding FaultingModule}" Width="*" MinWidth="160" Visibility="Collapsed"/>
                  <!-- A short interpretation (BsodAdvisor) — details + steps in the "More Info" dialog (double click) -->
                  <DataGridTemplateColumn Header="What it means" Width="1.4*" MinWidth="170">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock Text="{Binding AdviceArea}" FontWeight="SemiBold" FontSize="{StaticResource FontSizeS}"
                                     Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding AdviceSummary}" FontSize="{StaticResource FontSizeXS}" TextTrimming="CharacterEllipsis"
                                     Foreground="{DynamicResource TextSecondaryBrush}" ToolTip="{Binding AdviceSummary}"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <DockPanel x:Name="CrashEmptyState" Visibility="Collapsed" Margin="18,2,18,16" VerticalAlignment="Top">
                <ui:Button x:Name="BtnCrashEmptyOpenFolder" DockPanel.Dock="Right" Appearance="Secondary" VerticalAlignment="Center" Click="OpenMiniDumpFolder_Click">
                  <TextBlock x:Name="TxtCrashEmptyBtn" Text="Open minidump folder"/>
                </ui:Button>
                <Ellipse x:Name="CrashEmptyDot" Width="8" Height="8" Margin="2,0,12,0" VerticalAlignment="Center" Fill="{DynamicResource StatusGoodBrush}"/>
                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock x:Name="TxtCrashEmptyTitle" Text="No blue screens" FontWeight="SemiBold" FontSize="{StaticResource FontSizeM}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                  <TextBlock x:Name="TxtCrashEmptyDetail" Text="Windows hasn't recorded any blue screens in the last 30 days." Style="{StaticResource CompSub}" TextWrapping="Wrap"/>
                </StackPanel>
              </DockPanel>
                </Grid>
              </Grid>
            </Border>

            <!-- ③ Other problems (not blue screens): shutdowns, app crashes, hardware errors -->
            <Border Grid.Row="2" Grid.ColumnSpan="3" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="18,14,18,12">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M8.75,11.5 A0.75,0.75 0 0 0 8.75,13 L15.25,13 A0.75,0.75 0 0 0 15.25,11.5 Z M8.75,14.25 A0.75,0.75 0 0 0 8.75,15.75 L15.25,15.75 A0.75,0.75 0 0 0 15.25,14.25 Z M8.75,17 A0.75,0.75 0 0 0 8.75,18.5 L15.25,18.5 A0.75,0.75 0 0 0 15.25,17 Z M13.59,2.59 L19.4,8.4 A2,2 0 0 1 20,9.83 L20,20 A2,2 0 0 1 18,22 L6,22 A2,2 0 0 1 4,20 L4,4 C4,2.9 4.9,2 6,2 L12.17,2 C12.69,2 13.22,2.22 13.59,2.59 M18,20.5 A0.5,0.5 0 0 0 18.5,20 L18.5,10 L14,10 A2,2 0 0 1 12,8 L12,3.5 L6,3.5 A0.5,0.5 0 0 0 5.5,4 L5.5,20 C5.5,20.27 5.72,20.5 6,20.5 Z M17.38,8.5 L13.5,4.62 L13.5,8 C13.5,8.28 13.72,8.5 14,8.5 Z"/></Viewbox>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Other problems" Style="{StaticResource DashRowCaption}"/>
                    <TextBlock Text="Not blue screens · newest first" Style="{StaticResource DashRowSub}"/>
                  </StackPanel>
                </StackPanel>
              <StackPanel x:Name="StabilityRecentPanel" Visibility="Collapsed">
                <StackPanel x:Name="StabilityRecentList"/>
                <TextBlock x:Name="TxtStabilityTopApps" Text="" FontSize="{StaticResource FontSizeS}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/>
                <!-- The pattern across all BSODs (the same driver / the same area) — UpdateCrashPattern -->
                <TextBlock x:Name="TxtCrashPattern" Visibility="Collapsed" Text="" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                           TextWrapping="Wrap" Foreground="{DynamicResource StatusWarningBrush}" Margin="0,8,0,0"/>
              </StackPanel>
                <TextBlock x:Name="TxtOtherProblemsNone" Text="No other problems recorded." Style="{StaticResource CompSub}" Visibility="Collapsed"/>
              </StackPanel>
            </Border>

            <!-- ④ What happened (the chosen blue screen), next to the list and at the same height; "Other problems" is below, full width -->
            <Border x:Name="CrashDetailCard" Grid.Column="2" Grid.Row="0" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="18,14,6,14">
              <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,12,0">
              <Grid>
                <StackPanel x:Name="CrashDetailEmpty">
                  <TextBlock Text="What happened" Style="{StaticResource DashRowCaption}"/>
                  <TextBlock Text="Click a blue screen to see what it means, what to try and the technical details." TextWrapping="Wrap" Margin="0,6,0,0" Style="{StaticResource CompSub}"/>
                </StackPanel>
                <ScrollViewer x:Name="CrashDetailPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                  <StackPanel>
                    <TextBlock x:Name="TxtCrDetTitle" Text="—" Style="{StaticResource DashRowName}" TextWrapping="Wrap" TextTrimming="None"/>
                    <TextBlock x:Name="TxtCrDetWhen" Text="" Style="{StaticResource DashRowSub}" Margin="0,0,0,10"/>
                    <TextBlock x:Name="TxtCrDetSummary" Text="" TextWrapping="Wrap" FontSize="{StaticResource FontSizeM}" Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource BgHoverBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,10">
                      <StackPanel>
                        <TextBlock Text="What to try" Style="{StaticResource DashRowCaption}"/>
                        <TextBlock x:Name="TxtCrDetSteps" Text="" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="{StaticResource FontSizeM}"/>
                      </StackPanel>
                    </Border>
                    <WrapPanel Margin="0,0,0,12">
                      <ui:Button x:Name="BtnCrDetPage" Appearance="Primary" Click="CrDetPage_Click" Margin="0,0,6,6" Visibility="Collapsed"/>
                      <ui:Button Appearance="Secondary" Click="CrDetSearch_Click" Margin="0,0,6,6" Content="Search online"/>
            <ui:Button x:Name="BtnCrashMoreInfo" Appearance="Secondary"
                    Click="CrashMoreInfo_Click" Margin="0,0,6,6">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M20.25,5 Q16.26,5 12.45,2.15 A0.75,0.75 0 0 0 11.55,2.15 Q7.74,5 3.75,5 A0.75,0.75 0 0 0 3,5.75 L3,11 C3,16 5.96,19.68 11.73,21.95 Q12,22.05 12.27,21.95 C18.04,19.68 21,16 21,11 L21,5.75 A0.75,0.75 0 0 0 20.25,5 M4.5,6.48 A14.4,14.4 0 0 0 12,3.68 A14.4,14.4 0 0 0 19.5,6.48 L19.5,11 C19.5,15.26 17.05,18.38 12,20.44 C6.95,18.38 4.5,15.26 4.5,11 Z M12.74,7.65 A0.75,0.75 0 0 0 11.25,7.75 L11.25,14.35 A0.75,0.75 0 0 0 12.75,14.25 L12.75,7.65 M12,18 A1,1 0 0 0 12,16 A1,1 0 0 0 12,18"/></Canvas></Viewbox>
                <TextBlock Text="More Info" VerticalAlignment="Center"/>
              </StackPanel>
            </ui:Button>
                    </WrapPanel>
                    <!-- the technical details: each on its own line (the parameters are long — they do not fit in a footer) -->
                    <TextBlock Text="Technical details" Style="{StaticResource DashRowCaption}" Margin="0,0,0,6"/>
                    <Grid x:Name="CrDetFacts" TextElement.FontSize="{StaticResource FontSizeS}">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="110"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <TextBlock Grid.Row="0" Text="Stop code" Style="{StaticResource CompFootKey}" Margin="0,0,0,6"/>
                      <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtCrDetCode" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"/>
                      <TextBlock Grid.Row="1" Text="Likely cause" Style="{StaticResource CompFootKey}" Margin="0,0,0,6"/>
                      <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtCrDetModule" TextWrapping="Wrap" FontWeight="SemiBold" Margin="0,0,0,6"/>
                      <TextBlock Grid.Row="2" Text="Parameters" Style="{StaticResource CompFootKey}" Margin="0,0,0,6"/>
                      <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtCrDetParams" Style="{StaticResource VanillaTextBoxBareStyle}" IsReadOnly="True" TextWrapping="Wrap"
                               BorderThickness="0" Background="Transparent" Padding="0" Margin="0,0,0,6" FontFamily="{DynamicResource MonoFont}"/>
                      <TextBlock Grid.Row="3" Text="File" Style="{StaticResource CompFootKey}" Margin="0,0,0,6"/>
                      <TextBlock Grid.Row="3" Grid.Column="1" x:Name="TxtCrDetFile" TextWrapping="Wrap" Margin="0,0,0,6"/>
                      <TextBlock Grid.Row="4" Text="Same cause" Style="{StaticResource CompFootKey}"/>
                      <TextBlock Grid.Row="4" Grid.Column="1" x:Name="TxtCrDetSame" TextWrapping="Wrap"/>
                    </Grid>
                  </StackPanel>
                </ScrollViewer>
              </Grid>
              </ScrollViewer>
            </Border>
          </Grid>
        </Grid>

        <!-- ── DRIVERS (problems first, the list, the chosen driver, protection) ── -->
        <Grid x:Name="PanelDrivers" Visibility="Collapsed" Margin="{StaticResource PageMargin}"
              Style="{StaticResource PageFadeStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- 0: titlu + actiuni -->
            <RowDefinition Height="Auto"/>   <!-- 1: NEEDS ATTENTION -->
            <RowDefinition Height="Auto"/>   <!-- 2: filtre + cautare -->
            <RowDefinition Height="*"/>      <!-- 3: the list | the chosen driver + protection -->
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <TextBlock x:Name="TxtDriversTitle" Cursor="Arrow"
                         MouseLeftButtonUp="DriversTitle_MouseLeftButtonUp"
                         Text="Drivers" Style="{StaticResource SectionTitleStyle}"/>
              <TextBlock x:Name="TxtDriversSubtitle" Text="Devices and their drivers · problems first" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" VerticalAlignment="Center">
              <Border CornerRadius="8" Background="{DynamicResource SegTrackBrush}" Padding="3" Margin="0,0,6,0"
                      ToolTip="Basic: simplified view by category. Advanced: all installed .sys files.">
                <StackPanel Orientation="Horizontal">
                  <Border x:Name="SegDriverBasic" CornerRadius="6" Padding="10,4" Cursor="Hand" Tag="Basic" MouseLeftButtonUp="DriverMode_Click">
                    <TextBlock x:Name="TxtDriverModeBasicLabel" Text="Basic" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeS}"/>
                  </Border>
                  <Border x:Name="SegDriverAdvanced" CornerRadius="6" Padding="10,4" Cursor="Hand" Tag="Advanced" MouseLeftButtonUp="DriverMode_Click">
                    <TextBlock x:Name="TxtDriverModeAdvancedLabel" Text="Advanced" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeS}"/>
                  </Border>
                </StackPanel>
              </Border>
              <CheckBox Style="{StaticResource VanillaCheckBoxStyle}" x:Name="ChkDriverMode" Visibility="Collapsed"/>
              <ui:Button x:Name="BtnDeviceManager" Appearance="Secondary"
                      Click="OpenDeviceManager_Click"
