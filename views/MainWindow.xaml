            </Border></Grid>
              <Grid x:Name="ToolsActivityCell" Grid.Row="2" Grid.Column="4"><Border Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="18,14,18,8">
              <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,6">
                  <Viewbox DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M2,5.75 C2,5.34 2.34,5 2.75,5 L18.25,5 A0.75,0.75 0 0 1 18.25,6.5 L2.75,6.5 A0.75,0.75 0 0 1 2,5.75 M2,18.75 C2,18.34 2.34,18 2.75,18 L13.25,18 A0.75,0.75 0 0 1 13.25,19.5 L2.75,19.5 A0.75,0.75 0 0 1 2,18.75 M2.75,11.5 A0.75,0.75 0 0 0 2.75,13 L21.25,13 A0.75,0.75 0 0 0 21.25,11.5 Z"/></Viewbox>
                  <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Recent activity" Style="{StaticResource DashRowName}" ToolTip="What was run from this page"/>
                  </StackPanel>
                  
                </DockPanel>
                <StackPanel x:Name="ToolActivityList"/>
                <TextBlock x:Name="TxtToolActivityNone" Text="Nothing run from here yet." Style="{StaticResource CompSub}" Margin="0,4,0,8"/>
              </StackPanel>
            </Border></Grid>
            </Grid>

            <!-- ══ PowerShell Quick Actions — hidden. The elements stay for the existing code. ══ -->
            <Grid Margin="0,0,0,12" Visibility="Collapsed">
              <!-- Stub controls to satisfy code-behind references -->
              <StackPanel x:Name="UsbDeviceList" Visibility="Collapsed"/>
              <Button x:Name="BtnUsbScan" Visibility="Collapsed" Click="UsbScan_Click"/>
              <Button x:Name="BtnUsbExportCsv" Visibility="Collapsed" Click="UsbExportCsv_Click"/>
              <TextBlock x:Name="TxtUsbEmpty" Visibility="Collapsed"/>

              <!-- PowerShell Quick Actions (compact) -->
              <Border Style="{StaticResource CardStyle}" Padding="0">
                <StackPanel local:CardClipBehavior.Radius="{DynamicResource RadiusCardD}">
                  <Border Background="{DynamicResource BgHoverBrush}" CornerRadius="{DynamicResource RadiusCardTop}" Padding="12,7">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <StackPanel Orientation="Horizontal">
                        <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{DynamicResource TextPrimaryBrush}" Data="F1 M6.78,10.98 C7.02,10.74 7.38,10.74 7.62,10.98 L10.02,13.38 A0.6,0.6 0 0 1 10.02,14.22 L7.62,16.62 A0.6,0.6 0 0 1 6.78,15.78 L8.75,13.8 L6.78,11.82 A0.6,0.6 0 0 1 6.78,10.98 M17.4,15.6 L11.4,15.6 A0.6,0.6 0 0 0 11.4,16.8 L17.4,16.8 A0.6,0.6 0 0 0 17.4,15.6 M3.6,6.6 A3,3 0 0 1 6.6,3.6 L17.4,3.6 A3,3 0 0 1 20.4,6.6 L20.4,17.4 A3,3 0 0 1 17.4,20.4 L6.6,20.4 A3,3 0 0 1 3.6,17.4 Z M19.2,7.2 L19.2,6.6 C19.2,5.6 18.38,4.8 17.4,4.8 L6.6,4.8 C5.6,4.8 4.8,5.6 4.8,6.6 L4.8,7.2 Z M4.8,8.4 L4.8,17.4 C4.8,18.4 5.6,19.2 6.6,19.2 L17.4,19.2 C18.38,19.2 19.2,18.4 19.2,17.4 L19.2,8.4 Z"/></Canvas></Viewbox>
                        <TextBlock x:Name="TxtPsQuickActionsHeader" Text="PowerShell Quick Actions" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                      </StackPanel>
                      <ui:Button x:Name="BtnPsToggleEditor" Grid.Column="1" Appearance="Secondary" 
                              Click="PsToggleEditor_Click" Padding="8,4" Height="26">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M20.95,3.05 A3.6,3.6 0 0 0 15.89,3.05 L3.94,15 C3.54,15.4 3.24,15.92 3.12,16.48 L2.02,21.08 A0.75,0.75 0 0 0 2.92,21.98 L7.52,20.88 A3,3 0 0 0 9,20.07 L20.95,8.11 A3.6,3.6 0 0 0 20.95,3.05 M16.95,4.11 A2.08,2.08 0 1 1 19.89,7.05 L19,7.94 L16.06,5 Z M15,6.06 L17.94,9 L7.94,19 A1.6,1.6 0 0 1 7.18,19.43 L3.76,20.23 L4.58,16.83 Q4.68,16.38 5,16.06 Z"/></Canvas></Viewbox><TextBlock Text="Edit" VerticalAlignment="Center"/></StackPanel>
                    </ui:Button>
                    </Grid>
                  </Border>
                  <StackPanel Margin="14,12,14,14">
                    <!-- Hidden DataGrid for code compatibility -->
                    <DataGrid Style="{StaticResource VanillaDataGridStyle}" x:Name="PsCommandsGrid" Visibility="Collapsed" Height="0"
                              AutoGenerateColumns="False" IsHitTestVisible="False"
                              SelectionChanged="PsCommandsGrid_SelectionChanged"/>
                    <StackPanel Orientation="Horizontal">
                      <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{DynamicResource TextPrimaryBrush}" Data="F1 M8.75,11.5 A0.75,0.75 0 0 0 8.75,13 L15.25,13 A0.75,0.75 0 0 0 15.25,11.5 Z M8.75,14.25 A0.75,0.75 0 0 0 8.75,15.75 L15.25,15.75 A0.75,0.75 0 0 0 15.25,14.25 Z M8.75,17 A0.75,0.75 0 0 0 8.75,18.5 L15.25,18.5 A0.75,0.75 0 0 0 15.25,17 Z M13.59,2.59 L19.4,8.4 A2,2 0 0 1 20,9.83 L20,20 A2,2 0 0 1 18,22 L6,22 A2,2 0 0 1 4,20 L4,4 C4,2.9 4.9,2 6,2 L12.17,2 C12.69,2 13.22,2.22 13.59,2.59 M18,20.5 A0.5,0.5 0 0 0 18.5,20 L18.5,10 L14,10 A2,2 0 0 1 12,8 L12,3.5 L6,3.5 A0.5,0.5 0 0 0 5.5,4 L5.5,20 C5.5,20.27 5.72,20.5 6,20.5 Z M17.38,8.5 L13.5,4.62 L13.5,8 C13.5,8.28 13.72,8.5 14,8.5 Z"/></Canvas></Viewbox>
                      <TextBlock x:Name="TxtPsCommandsLabel" Text="Saved commands"
                               FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0,0,0,8"/>
                    </StackPanel>
                    <!-- Quick-action tiles (rebuilt in code via RebuildQuickButtons) -->
                    <WrapPanel x:Name="PsQuickButtonsPanel" Margin="0,0,0,4"/>
                    <!-- Inline editor (hidden by default) -->
                    <Grid x:Name="PsEditorPanel" Visibility="Collapsed" Margin="0,8,0,0">
                      <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                      </Grid.RowDefinitions>
                      <TextBox Style="{StaticResource VanillaTextBoxStyle}" x:Name="TxtPsCmdName" Grid.Row="0" Height="28" Padding="6,4"
                               FontSize="{StaticResource FontSizeM}" Margin="0,0,0,6" VerticalContentAlignment="Center"
                               ToolTip="Command name (shown on tile)"/>
                      <TextBox Style="{StaticResource VanillaTextBoxStyle}" x:Name="TxtPsCommand" Grid.Row="1" Height="60" Padding="6,5"
                               FontSize="{StaticResource FontSizeS}" AcceptsReturn="True" TextWrapping="Wrap"
                               FontFamily="Consolas" Margin="0,0,0,6"
                               Text="# Write PowerShell command here&#x0a;"/>
                      <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,6">
                        <ui:Button Appearance="Secondary"
                                Click="PsSave_Click" Padding="10,5" Height="28" Margin="0,0,8,0">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M3,5.75 A2.75,2.75 0 0 1 5.75,3 L15.71,3 C16.58,3 17.41,3.34 18.01,3.95 L20.05,6 C20.65,6.6 21,7.43 21,8.3 L21,18.26 A2.75,2.75 0 0 1 18.25,21 L5.75,21 A2.75,2.75 0 0 1 3,18.25 Z M5.75,4.5 C5.06,4.5 4.5,5.06 4.5,5.75 L4.5,18.25 C4.5,18.94 5.06,19.5 5.75,19.5 L6,19.5 L6,14.25 C6,13.01 7,12 8.25,12 L15.75,12 C16.99,12 18,13 18,14.25 L18,19.5 L18.25,19.5 C18.94,19.5 19.5,18.94 19.5,18.25 L19.5,8.29 C19.5,7.82 19.32,7.38 18.99,7.05 L16.95,5 Q16.55,4.6 16,4.51 L16,7.24 C16,8.48 15,9.49 13.75,9.49 L9.25,9.49 C8.01,9.5 7,8.5 7,7.25 L7,4.5 Z M16.5,19.5 L16.5,14.25 A0.75,0.75 0 0 0 15.75,13.5 L8.25,13.5 A0.75,0.75 0 0 0 7.5,14.25 L7.5,19.5 Z M8.5,4.5 L8.5,7.25 C8.5,7.66 8.84,8 9.25,8 L13.75,8 C14.16,8 14.5,7.66 14.5,7.25 L14.5,4.5 Z"/></Canvas></Viewbox>
                            <TextBlock Text="Save" VerticalAlignment="Center"/>
                          </StackPanel>
                        </ui:Button>
                        <ui:Button x:Name="BtnPsRun" Appearance="Secondary"
                                Click="PsRun_Click" Padding="10,5" Height="28" Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Viewbox Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M7.6,4.61 A0.75,0.75 0 0 0 6.5,5.27 L6.5,18.73 C6.5,19.29 7.1,19.66 7.6,19.38 L19.97,12.66 A0.75,0.75 0 0 0 19.97,11.34 Z M5,5.27 C5,3.57 6.83,2.48 8.33,3.3 L20.69,10.02 A2.25,2.25 0 0 1 20.69,13.98 L8.33,20.7 A2.25,2.25 0 0 1 5,18.73 Z"/></Canvas></Viewbox><TextBlock Text="Run" VerticalAlignment="Center"/></StackPanel>
                    </ui:Button>
                        <ui:Button Appearance="Secondary"
                                Click="PsDelete_Click" Padding="10,5" Height="28">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M10,5 L14,5 A2,2 0 0 0 10,5 M8.5,5 A3.5,3.5 0 0 1 15.5,5 L21.25,5 A0.75,0.75 0 0 1 21.25,6.5 L19.93,6.5 L18.76,18.61 A3.75,3.75 0 0 1 15.03,22 L8.97,22 A3.75,3.75 0 0 1 5.24,18.61 L4.07,6.5 L2.75,6.5 A0.75,0.75 0 0 1 2.75,5 Z M10.5,9.75 A0.75,0.75 0 0 0 9,9.75 L9,17.25 A0.75,0.75 0 0 0 10.5,17.25 Z M14.25,9 C14.66,9 15,9.34 15,9.75 L15,17.25 A0.75,0.75 0 0 1 13.5,17.25 L13.5,9.75 C13.5,9.34 13.84,9 14.25,9 M6.73,18.47 A2.25,2.25 0 0 0 8.97,20.5 L15.03,20.5 C16.18,20.5 17.15,19.62 17.27,18.47 L18.42,6.5 L5.58,6.5 Z"/></Canvas></Viewbox>
                            <TextBlock Text="Delete" VerticalAlignment="Center"/>
                          </StackPanel>
                        </ui:Button>
                      </StackPanel>
                    </Grid>
                    <!-- Compact status bar -->
                    <Border x:Name="PsOutputBar" Visibility="Collapsed" Margin="0,6,0,0"
                            Background="{DynamicResource BgInputBrush}" CornerRadius="6" Padding="8,5">
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="TxtPsStatus" FontSize="{StaticResource FontSizeS}" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <ui:Button Appearance="Transparent" Grid.Column="1" Content="" Width="20" Height="20" FontSize="{StaticResource FontSizeS}" Padding="0"
                                Click="PsStatusClose_Click"/>
                      </Grid>
                    </Border>
                    <!-- Full output panel -->
                    <Border x:Name="PsFullOutputPanel" Visibility="Collapsed" Margin="0,4,0,0"
                            Background="{DynamicResource BgInputBrush}" CornerRadius="6" Padding="8,6">
                      <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                          <TextBlock Text="Output" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                          <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <ui:Button Appearance="Transparent" Content="" Width="22" Height="22" FontSize="{StaticResource FontSizeS}" Padding="0"
                                    Click="PsClear_Click" ToolTip="Clear output"/>
                            <ui:Button Appearance="Transparent" Content="" Width="22" Height="22" FontSize="{StaticResource FontSizeS}" Padding="0"
                                    Click="PsOutputClose_Click"/>
                          </StackPanel>
                        </Grid>
                        <TextBlock x:Name="TxtPsOutput" Grid.Row="1" FontFamily="Consolas" FontSize="{StaticResource FontSizeS}"
                                   TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}"/>
                      </Grid>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </StackPanel>
        </ScrollViewer>

        <!-- ── BATTERY ── -->
        <!-- the page is in views/Pages/PowerPage.xaml -->
        <pages:PowerPage x:Name="PagePower"/>

        <!-- ── POWERSHELL RUNNER — moved into Tools panel above ── -->
        <Grid x:Name="PanelPowerShell" Visibility="Collapsed" Margin="{StaticResource PageMargin}">
        </Grid>

        <!-- ── TOAST NOTIFICATION (replaces loading overlay) ── -->
        <Border x:Name="ToastBorder" Visibility="Collapsed"
                VerticalAlignment="Bottom" HorizontalAlignment="Center"
                Margin="0,0,0,18" Panel.ZIndex="20"
                CornerRadius="8" Padding="14,8,14,8"
                Background="{DynamicResource ToastBgBrush}"
                BorderBrush="{DynamicResource ToastBorderBrush}" BorderThickness="1">
          <!-- no shadow: an Effect here would blur the toast text; the outline separates it -->
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <!-- while something loads: the logo with two opposite segments running around the arc -->
            <local:SmdLogo x:Name="ToastLogo" Width="18" Height="18" Level="0" Margin="0,0,8,0" Visibility="Collapsed" VerticalAlignment="Center"/>
            <TextBlock x:Name="TxtToastIcon" Text="" FontSize="{StaticResource FontSizeM}"
                       VerticalAlignment="Center" Margin="0,0,7,0"/>
            <TextBlock x:Name="TxtLoadingMsg" Text="Loading..."
                       FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
          </StackPanel>
        </Border>

        <!-- ── RESTRICTED MODE INDICATOR (no admin rights) ── -->
        <Border x:Name="RestrictedModeBanner" Visibility="Collapsed"
                VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Panel.ZIndex="20"
                CornerRadius="0" Padding="12,7"
                Background="{DynamicResource WarningBannerBgBrush}"
                BorderThickness="0">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="" FontSize="{StaticResource FontSizeM}" Foreground="White" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="Bold"/>
              <TextBlock Text="Running as User — some features require Administrator. Right-click SMDWin → Run as administrator."
                         FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Grid.Column="1" Content="" Style="{StaticResource CloseIconButtonStyle}"
                    Foreground="White" Click="DismissRestrictedBanner_Click"/>
          </Grid>
        </Border>

        <Rectangle x:Name="GrainTextureOverlay" IsHitTestVisible="False" Visibility="Collapsed" Opacity="0.06">
          <Rectangle.Fill>
            <ImageBrush ImageSource="/Assets/grain_texture.png" TileMode="Tile"
                        Viewport="0,0,128,128" ViewportUnits="Absolute" Stretch="None"/>
          </Rectangle.Fill>
        </Rectangle>

      </Grid>      <!-- /MainContentBorder -->
    </Grid>      <!-- /content columns Grid = root Grid -->
  </Grid>        <!-- /root Grid (Row 0+1) -->
</Window>