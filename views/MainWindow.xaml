              </Border>              <Border Grid.Column="1" x:Name="RowSysMain" Margin="0,0,10,0" Padding="14,12" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
                <StackPanel>
