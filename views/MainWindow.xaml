                    <CheckBox DockPanel.Dock="Right" x:Name="ChkSysMain" Style="{StaticResource ToggleSwitchSmallStyle}" Click="ToggleSysMain_Click" VerticalAlignment="Center"/>
                    <TextBlock Text="SysMain" FontWeight="SemiBold" FontSize="{StaticResource FontSizeM}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                  </DockPanel>
                  <TextBlock Text="Preloads the apps you use often" Style="{StaticResource CompSub}" TextWrapping="Wrap" MinHeight="34"/>
                </StackPanel>
              </Border>              <Border Grid.Column="2" x:Name="RowWinSearch" Margin="0,0,10,0" Padding="14,12" CornerRadius="9" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}">
