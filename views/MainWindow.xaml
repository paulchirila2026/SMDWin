              <Border Style="{StaticResource SegmentTrackStyle}" Tag="SegTrack" VerticalAlignment="Center" Margin="0,0,12,4"><StackPanel Orientation="Horizontal"><ui:Button x:Name="BtnEvt1h" Appearance="Secondary" Tag="1h" Click="EventTimeRange_Click" Height="28" Margin="0,0,2,0" Padding="10,5"
