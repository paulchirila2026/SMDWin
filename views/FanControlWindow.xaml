<Window x:Class="SMDWin.Views.FanControlWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Fan Control"
        Width="540" Height="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                        GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Border CornerRadius="{DynamicResource RadiusCard}" ClipToBounds="True"
          Background="{DynamicResource BgDarkBrush}"
          BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <!-- Title bar -->
      <Grid x:Name="TitleBar" Grid.Row="0" Height="48" Background="Transparent"
            MouseLeftButtonDown="TitleBar_DragMove">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
          <TextBlock Text="🌀" FontSize="{StaticResource FontSizeXXL}" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="Fan Control" FontSize="{StaticResource FontSizeXL}" FontWeight="Bold"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource TextPrimaryBrush}"/>
        </StackPanel>
        <Button x:Name="BtnClose"
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0"
                Style="{StaticResource CaptionCloseBtnStyle}"
                Click="BtnClose_Click" ToolTip="Close">✕</Button>
      </Grid>

      <!-- Global presets + thermal guard -->
      <Border Grid.Row="1" Margin="18,0,18,8" Padding="14,12" CornerRadius="8"
              Background="{DynamicResource BgHoverBrush}">
        <StackPanel>
          <TextBlock Text="Apply to all fans" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="BtnAuto"   Content="Auto"   Style="{StaticResource OutlineButtonStyle}" Padding="14,6" Margin="0,0,8,0" Cursor="Hand" Click="Preset_Click" Tag="auto"/>
            <Button x:Name="BtnSilent" Content="Silent" Style="{StaticResource OutlineButtonStyle}" Padding="14,6" Margin="0,0,8,0" Cursor="Hand" Click="Preset_Click" Tag="silent"/>
            <Button x:Name="BtnMedium" Content="Medium" Style="{StaticResource OutlineButtonStyle}" Padding="14,6" Margin="0,0,8,0" Cursor="Hand" Click="Preset_Click" Tag="medium"/>
            <Button x:Name="BtnTurbo"  Content="Turbo"  Style="{StaticResource OutlineButtonStyle}" Padding="14,6" Cursor="Hand" Click="Preset_Click" Tag="turbo"/>
          </StackPanel>

          <Border Height="0.5" Background="{DynamicResource CardBorderBrush}" Margin="0,12,0,10"/>

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="ChkThermalGuard" Grid.Column="0" IsChecked="True"
                      VerticalAlignment="Center" Cursor="Hand"
                      Click="ThermalGuard_Changed"
                      Foreground="{DynamicResource TextPrimaryBrush}"
                      Content="Thermal safety"/>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                       FontSize="{StaticResource FontSizeXS}" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       Text="Forces 100% if temperature exceeds the limit, overriding the preset."/>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="Limit" FontSize="{StaticResource FontSizeS}" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,6,0"/>
              <TextBox x:Name="TxtGuardLimit" Text="85" Width="38" FontSize="{StaticResource FontSizeS}"
                       TextAlignment="Center" VerticalContentAlignment="Center"/>
              <TextBlock Text="°C" FontSize="{StaticResource FontSizeS}" VerticalAlignment="Center"
                         Foreground="{DynamicResource TextSecondaryBrush}" Margin="3,0,0,0"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>

      <!-- Per-fan list -->
      <ScrollViewer Grid.Row="2" Margin="18,0,18,0" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="FanListPanel"/>
      </ScrollViewer>

      <!-- Footer note -->
      <Border Grid.Row="3" Margin="18,8,18,16" Padding="12,9" CornerRadius="8"
              Background="{DynamicResource BgHoverBrush}">
        <TextBlock x:Name="TxtFooterNote" FontSize="{StaticResource FontSizeXS}" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Manual control is active only while SMD Win is running (including in the system tray). When the app closes, fans return to BIOS control."/>
      </Border>
    </Grid>
  </Border>
</Window>
