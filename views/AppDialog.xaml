<Window x:Class="SMDWin.Views.AppDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="SMD Win"
        SizeToContent="WidthAndHeight"
        MinWidth="352" MaxWidth="552"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
  <Window.Resources>
    <!-- Note: BgCardColor/BgCardBrush etc. are set by ThemeManager at runtime
         and injected via MergedDictionaries in ShowCore() -->
    <!-- The dialog buttons are Wpf.Ui.Controls.Button (Primary/Secondary), created in AppDialog.xaml.cs (AddButton) — the style
         comes from the implicit ui:Button style in Styles.xaml. -->
  </Window.Resources>

  <!-- Outer shadow wrapper. The 16 px margin leaves room for the shadow inside the window: without it the shadow was cut off
       by the window edge, and on Light the white dialog disappeared on the white page. -->
  <Grid Margin="16">
    <!-- the shadow on its own empty layer: an Effect on the element with text would blur the text -->
    <Border CornerRadius="{DynamicResource RadiusCard}" Background="{DynamicResource BgCardBrush}" IsHitTestVisible="False">
      <Border.Effect>
      <DropShadowEffect BlurRadius="22" ShadowDepth="5" Direction="270" Color="#000000" Opacity="0.30"/>
    </Border.Effect>
    </Border>
    <Border CornerRadius="{DynamicResource RadiusCard}"
          Background="{DynamicResource BgCardBrush}"
          BorderBrush="{DynamicResource CardBorderBrush}"
          BorderThickness="1"
          Padding="0">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>  <!-- title bar -->
        <RowDefinition Height="Auto"/>  <!-- body -->
        <RowDefinition Height="Auto"/>  <!-- buttons -->
      </Grid.RowDefinitions>

      <!-- ── Title bar ── -->
      <Grid Grid.Row="0" x:Name="TitleBar"
            MouseLeftButtonDown="TitleBar_MouseDown"
            Cursor="SizeAll"
            Background="Transparent"
            Margin="0">
        <Border CornerRadius="{DynamicResource RadiusCardTop}"
                Background="{DynamicResource BgHoverBrush}"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardBorderBrush}">
          <Grid Margin="18,10,12,10">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <!-- Icon -->
            <Viewbox x:Name="IconViewbox" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">
              <!-- swapped at runtime -->
              <Canvas Width="24" Height="24" x:Name="IconCanvas">
                <!-- info icon (default) -->
                <Ellipse Width="24" Height="24" Fill="{DynamicResource AccentBrush}" Opacity="0.18"/>
                <Path x:Name="IconPath"
                      Fill="{DynamicResource AccentBrush}"
                      Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
              </Canvas>
            </Viewbox>
            <!-- Title text -->
            <TextBlock x:Name="TxtTitle" Grid.Column="1"
                       Text="SMD Win"
                       FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       VerticalAlignment="Center"/>
            <Button Grid.Column="2" Margin="6,0,-6,0"
                    Style="{StaticResource CaptionCloseBtnStyle}"
                    Click="BtnClose_Click"
                    ToolTip="Close">✕</Button>
          </Grid>
        </Border>
      </Grid>

      <!-- ── Message body ── -->
      <Border Grid.Row="1" Padding="22,18,22,10">
        <TextBlock x:Name="TxtMessage"
                   Text="Message"
                   FontSize="{StaticResource FontSizeM}"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   TextWrapping="Wrap"
                   MaxWidth="440"
                   LineHeight="20"/>
      </Border>

      <!-- ── Buttons ── -->
      <Border Grid.Row="2" Padding="22,6,22,18">
        <StackPanel x:Name="ButtonPanel"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">
          <!-- Buttons added at runtime -->
        </StackPanel>
      </Border>

    </Grid>
  </Border>
  </Grid>
</Window>
