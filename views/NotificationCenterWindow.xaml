<Window x:Class="SMDWin.Views.NotificationCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Notifications"
        Width="420" Height="520"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        ShowInTaskbar="False"
        ResizeMode="NoResize">
  <Grid Margin="8">
    <!-- the shadow on its own empty layer: an Effect on the element with text would blur the text -->
    <Border CornerRadius="{DynamicResource RadiusCard}" Background="{DynamicResource BgCardBrush}" IsHitTestVisible="False">
      <Border.Effect>
      <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="3" Opacity="0.22"/>
    </Border.Effect>
    </Border>
    <Border Background="{DynamicResource BgCardBrush}" CornerRadius="{DynamicResource RadiusCard}"
          BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <!-- Header -->
      <Grid Grid.Row="0" Margin="16,14,10,10">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBlock x:Name="TxtNotifTitle" Grid.Column="0" Text="Notifications" FontSize="{StaticResource FontSizeL}"
                   FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Center"/>
        <Button x:Name="BtnClearAll" Grid.Column="1" Content="Clear all" Click="BtnClearAll_Click"
                Style="{StaticResource GhostButtonStyle}" FontSize="{StaticResource FontSizeS}"
                Margin="0,0,6,0" Padding="8,4" Cursor="Hand"/>
        <Button x:Name="BtnClose" Grid.Column="2" Content="✕" Click="BtnClose_Click"
                Style="{StaticResource GhostButtonStyle}" FontSize="{StaticResource FontSizeS}"
                Padding="8,4" Cursor="Hand"/>
      </Grid>

      <!-- List -->
      <Grid Grid.Row="1">
        <TextBlock x:Name="TxtEmptyState" Text="No notifications — everything looks fine."
                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeS}"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="10,0,10,10">
          <ItemsControl x:Name="ListEntries">
            <ItemsControl.GroupStyle>
              <GroupStyle>
                <GroupStyle.HeaderTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Name}" FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,8,0,6"/>
                  </DataTemplate>
                </GroupStyle.HeaderTemplate>
              </GroupStyle>
            </ItemsControl.GroupStyle>
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="{DynamicResource BgInputBrush}" CornerRadius="10" Margin="0,0,0,8"
                        BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" ClipToBounds="True">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="4"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- a bar coloured by severity -->
                    <Border Grid.Column="0">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource StatusWarnBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Severity}" Value="Critical">
                              <Setter Property="Background" Value="{DynamicResource StatusCritBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Severity}" Value="Info">
                              <Setter Property="Background" Value="{DynamicResource StatusInfoBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                    </Border>

                    <Grid Grid.Column="1" Margin="12,10,8,10">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>

                      <!-- the category pictogram -->
                      <Border Grid.Column="0" Width="30" Height="30" CornerRadius="9" Background="{DynamicResource BgCardBrush}"
                              VerticalAlignment="Top" Margin="0,0,10,0">
                        <TextBlock Text="{Binding CategoryIcon}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>

                      <!-- mesaj + categorie / timp -->
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap"
                                   FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock FontSize="{StaticResource FontSizeXS}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,4,0,0">
                          <Run Text="{Binding CategoryLabel, Mode=OneWay}"/>
                          <Run Text=" · "/>
                          <Run Text="{Binding AgeLabel, Mode=OneWay}"/>
                          <Run Text=" · "/>
                          <Run Text="{Binding TimeLabel, Mode=OneWay}"/>
                        </TextBlock>
                      </StackPanel>

                      <!-- deletes a single notification -->
                      <Button Grid.Column="2" Content="✕" Tag="{Binding Id}"
                              Click="BtnClearOne_Click" Style="{StaticResource GhostButtonStyle}"
                              FontSize="10" Padding="6,2"
                              VerticalAlignment="Top" Cursor="Hand" ToolTip="Dismiss"/>
                    </Grid>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Border>
  </Grid>
</Window>
