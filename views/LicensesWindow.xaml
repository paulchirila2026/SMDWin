<Window x:Class="SMDWin.Views.LicensesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Licenses"
        Width="600" Height="660"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                        GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Grid Margin="12">
    <!-- the shadow on its own empty layer: an Effect on the element with text would blur the text -->
    <Border CornerRadius="{DynamicResource RadiusCard}" Background="{DynamicResource BgCardBrush}" IsHitTestVisible="False">
      <Border.Effect>
      <DropShadowEffect BlurRadius="28" ShadowDepth="6" Direction="270" Color="#000000" Opacity="0.35" RenderingBias="Performance"/>
    </Border.Effect>
    </Border>
    <Border CornerRadius="{DynamicResource RadiusCard}" Background="Transparent">
    <Border CornerRadius="{DynamicResource RadiusCard}" ClipToBounds="True"
            Background="{DynamicResource BgDarkBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar: icon + title, close -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="52" Background="Transparent"
              MouseLeftButtonDown="TitleBar_DragMove">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
            <Border Width="30" Height="30" CornerRadius="8" Margin="0,0,10,0">
              <Border.Background><SolidColorBrush Color="{DynamicResource AccentColor}" Opacity="0.14"/></Border.Background>
              <Viewbox Width="16" Height="16"><Canvas Width="24" Height="24">
                <Path Fill="{DynamicResource AccentBrush}" Data="F1 M6.25,2 L13.94,2 C14.4,2 14.85,2.18 15.18,2.51 L19.49,6.82 C19.82,7.15 20,7.6 20,8.06 L20,19.75 A2.25,2.25 0 0 1 17.75,22 L6.25,22 A2.25,2.25 0 0 1 4,19.75 L4,4.25 A2.25,2.25 0 0 1 6.25,2 Z M6.25,3.5 A0.75,0.75 0 0 0 5.5,4.25 L5.5,19.75 C5.5,20.16 5.84,20.5 6.25,20.5 L17.75,20.5 C18.16,20.5 18.5,20.16 18.5,19.75 L18.5,9 L15,9 A1.5,1.5 0 0 1 13.5,7.5 L13.5,3.5 Z M15,4.56 L15,7.5 L17.94,7.5 Z M8.25,12 L15.75,12 A0.75,0.75 0 0 1 15.75,13.5 L8.25,13.5 A0.75,0.75 0 0 1 8.25,12 Z M8.25,15.5 L13.75,15.5 A0.75,0.75 0 0 1 13.75,17 L8.25,17 A0.75,0.75 0 0 1 8.25,15.5 Z"/>
              </Canvas></Viewbox>
            </Border>
            <TextBlock x:Name="TxtWinTitle" Text="Licenses" FontSize="{StaticResource FontSizeXL}" FontWeight="SemiBold"
                       VerticalAlignment="Center" FontFamily="{StaticResource AppFontDisplay}"
                       Foreground="{DynamicResource TextPrimaryBrush}"/>
          </StackPanel>
          <Button x:Name="BtnClose"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,8,0"
                  Style="{StaticResource CaptionCloseBtnStyle}"
                  Click="BtnClose_Click" ToolTip="Close">✕</Button>
        </Grid>

        <ScrollViewer Grid.Row="1" Margin="0,0,0,8" Padding="18,4,18,16" VerticalScrollBarVisibility="Auto">
          <StackPanel>

            <!-- ── The SMD Win license (GPL-3.0) ─────────────────────────────── -->
            <Border Margin="0,0,0,18" Padding="16,14" CornerRadius="12" Background="{DynamicResource CardSurfaceBrush}"
                    BorderBrush="{DynamicResource CardEdgeBrush}" BorderThickness="1">
              <StackPanel>
                <DockPanel Margin="0,0,0,8">
                  <Border DockPanel.Dock="Right" CornerRadius="10" Padding="9,2" VerticalAlignment="Center"
                          BorderThickness="1" BorderBrush="{DynamicResource StatusGoodBrush}">
                    <TextBlock Text="GPL-3.0" FontSize="{StaticResource FontSizeXS}" FontWeight="SemiBold" Foreground="{DynamicResource StatusGoodBrush}"/>
                  </Border>
                  <TextBlock x:Name="TxtAppLicenseTitle" Text="SMD Win — License" FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBlock x:Name="TxtAppLicenseBody" TextWrapping="Wrap" FontSize="{StaticResource FontSizeM}"
                           Foreground="{DynamicResource TextSecondaryBrush}" LineHeight="20"/>
                <TextBlock x:Name="TxtAppLicenseLink" Margin="0,10,0,0" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" Cursor="Hand" Text="Read the full license (gnu.org) ↗"
                           MouseLeftButtonUp="AppLicenseLink_Click"/>
              </StackPanel>
            </Border>

            <!-- ── Third-party list header ────────────────────────────────── -->
            <TextBlock x:Name="TxtThirdPartyHeader" Text="Third-party components" FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="2,0,0,4"/>
            <TextBlock x:Name="TxtThirdPartySub" TextWrapping="Wrap" FontSize="{StaticResource FontSizeS}"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="2,0,0,12"/>

            <ItemsControl x:Name="ItemsThirdParty"/>

          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Border>
  </Border>
  </Grid>
</Window>
