<UserControl x:Class="SMDWin.Views.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:local="clr-namespace:SMDWin.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <!-- The Settings page: all the categories at once, in compact cards on two columns (General, Appearance, Widget | Alerts,
       Sensors, Data); Advanced and About on a second page. One column on a narrow window (LayoutSettingsColumns).
       Logic: MainWindow.Settings*.cs; the named elements are exposed in MainWindow as properties (MainWindow.Pages.cs),
       and the handlers are redirected. -->
        <ScrollViewer x:Name="PanelSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                      SizeChanged="SettingsPage_SizeChanged" IsVisibleChanged="SettingsPage_IsVisibleChanged">
          <StackPanel x:Name="SettingsPageContent" Margin="{StaticResource PageMargin}" MaxWidth="1560">
            <!-- Settings (one page): every category is visible at once, in compact cards on two columns (one column on a narrow window);
                 Advanced and About open on a second page. No tabs. Layout: MainWindow.SettingsTabs.cs → LayoutSettingsColumns / ShowSettingsTab. -->
            <Grid Margin="0,0,0,14">
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <StackPanel Orientation="Horizontal">
                <!-- on the Advanced page: back to all the settings -->
                <Border x:Name="BtnSetBack" Visibility="Collapsed" Cursor="Hand" Background="Transparent" Padding="0,0,10,0" VerticalAlignment="Center" Tag="General" MouseLeftButtonUp="SettingsLink_Click" ToolTip="Back to Settings">
                  <Viewbox Width="16" Height="16"><Path Width="24" Height="24" Fill="{DynamicResource TextPrimaryBrush}" Data="F1 M15.53,4.22 A0.75,0.75 0 0 1 15.53,5.28 L8.81,12 L15.53,18.72 A0.75,0.75 0 1 1 14.47,19.78 L7.22,12.53 A0.75,0.75 0 0 1 7.22,11.47 L14.47,4.22 A0.75,0.75 0 0 1 15.53,4.22"/></Viewbox>
                </Border>
                <TextBlock x:Name="TxtSettingsTitle" Text="Settings" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtSettingsAdvSep" Text="  ›  " Visibility="Collapsed" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="TxtSettingsAdvTitle" Text="Advanced" Visibility="Collapsed" Style="{StaticResource SectionTitleStyle}" Margin="0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
              </StackPanel>
              <TextBlock x:Name="TxtSettingsSubtitle" Grid.Column="1" Text="Changes are saved automatically" Style="{StaticResource PageSubtitleStyle}" Margin="12,0,0,2" VerticalAlignment="Bottom"/>
                <!-- search: matching rows stay bright, the others fade; the first match opens its tab -->
                <!-- hidden: the global search in the sidebar finds the settings too -->
                <Grid Grid.Column="2" Width="240" Margin="16,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                  <TextBox x:Name="TxtSettingsSearch" Style="{StaticResource VanillaTextBoxStyle}" Height="32" Padding="30,0,9,0" VerticalContentAlignment="Center" TextChanged="SettingsSearch_TextChanged"/>
                  <Viewbox Width="13" Height="13" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Opacity="0.6"><Path Width="24" Height="24" Fill="{DynamicResource TextSecondaryBrush}" Data="F1 M16.1,17.16 A8,8 0 1 1 17.16,16.1 L21.78,20.72 A0.75,0.75 0 1 1 20.72,21.78 Z M17.5,11 A6.5,6.5 0 0 0 4.5,11 A6.5,6.5 0 0 0 17.5,11"/></Viewbox>
                  <TextBlock x:Name="TxtSettingsSearchHint" Text="Search settings…" Margin="30,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" FontSize="{StaticResource FontSizeM}" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/>
                </Grid>
            </Grid>

            <Grid x:Name="SetOverview">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <StackPanel x:Name="SetColLeft" Grid.Column="0">
              <StackPanel x:Name="SetPanelGeneral" HorizontalAlignment="Stretch">
                <Border x:Name="SetCardGeneral" Style="{StaticResource SetCard}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                      <Viewbox Width="17" Height="17" Margin="0,0,10,0" VerticalAlignment="Center"><Path Width="24" Height="24" Fill="{DynamicResource TextSecondaryBrush}" Data="F1 M6.75,22 A0.75,0.75 0 0 1 6.65,20.5 L8.5,20.5 L8.5,18 L4.25,18 C3.05,18 2.08,17.08 2.01,15.9 L2,15.76 L2,5.25 C2,4.05 2.93,3.08 4.1,3.01 L4.25,3 L19.75,3 C20.94,3 21.91,3.93 21.99,5.1 L21.99,15.75 C21.99,16.95 21.07,17.92 19.9,18 L15.5,18 L15.5,20.5 L17.25,20.5 A0.75,0.75 0 0 1 17.35,22 L6.75,22 M14,18 L10,18 L10,20.5 L14,20.5 Z M19.75,4.5 L4.25,4.5 C3.87,4.5 3.55,4.78 3.51,5.15 L3.5,5.25 L3.5,15.75 C3.5,16.13 3.78,16.45 4.15,16.5 L19.75,16.5 C20.13,16.5 20.45,16.22 20.49,15.85 L20.49,5.25 C20.49,4.87 20.22,4.55 19.85,4.51 Z"/></Viewbox>
                      <TextBlock Style="{StaticResource SetCardTitle}" Margin="0" FontSize="15" VerticalAlignment="Center" Text="General"/>
                      <TextBlock Style="{StaticResource SetRowDesc}" Margin="12,2,0,0" VerticalAlignment="Center" Text="Startup, language and units"/>
                    </StackPanel>
                  <Border Style="{StaticResource SetRow}" Padding="0,8,0,8">
                    <DockPanel>
                      <Border Style="{StaticResource SetRowControl}"><CheckBox x:Name="ChkStartWithWindows" Style="{StaticResource ToggleSwitchStyle}" ToolTip="Adds SMD Win to the programs that start at sign-in." Checked="Settings_Changed" Unchecked="Settings_Changed"/></Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtStartWinLbl" Style="{StaticResource SetRowTitle}" Text="Start with Windows"/>
                        <TextBlock Style="{StaticResource SetRowDesc}" Text="Launch SMD Win automatically at sign-in"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource SetRow}" Padding="0,8,0,8">
                    <DockPanel>
                      <Border Style="{StaticResource SetRowControl}"><Border Style="{StaticResource SegmentTrackStyle}"><StackPanel Orientation="Horizontal">
                          <RadioButton x:Name="RbCloseTray" Content="Minimize to notification area" Tag="Tray" GroupName="CloseActionGroup" Style="{StaticResource SegmentChipStyle}" Checked="CloseAction_Checked" ToolTip="SMD Win keeps running in the notification area"/>
                          <RadioButton x:Name="RbCloseQuit" Content="Exit" Tag="Quit" GroupName="CloseActionGroup" Style="{StaticResource SegmentChipStyle}" Checked="CloseAction_Checked"/></StackPanel></Border></Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SetRowTitle}" Text="Close button"/>
                        <TextBlock Style="{StaticResource SetRowDesc}" Text="Action when the main window is closed"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource SetRow}" Padding="0,8,0,8">
                    <DockPanel>
                      <Border Style="{StaticResource SetRowControl}"><WrapPanel x:Name="LangPacksPanel" VerticalAlignment="Center"/></Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtLangLabel" Style="{StaticResource SetRowTitle}" Text="Language"/>
                        <TextBlock Style="{StaticResource SetRowDesc}" Text="Interface and report language"/>
                        <TextBlock x:Name="TxtLangImportHint" Visibility="Collapsed" Text=""/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource SetRow}" Padding="0,8,0,8">
                    <DockPanel>
                      <Border Style="{StaticResource SetRowControl}"><Border Style="{StaticResource SegmentTrackStyle}"><StackPanel Orientation="Horizontal">
                          <RadioButton x:Name="RbTempUnitC" Content="°C" Tag="C" GroupName="TempUnitGroup" Style="{StaticResource SegmentChipStyle}" Checked="TempUnitChip_Checked" IsChecked="True"/>
                          <RadioButton x:Name="RbTempUnitF" Content="°F" Tag="F" GroupName="TempUnitGroup" Style="{StaticResource SegmentChipStyle}" Checked="TempUnitChip_Checked"/></StackPanel></Border></Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SetRowTitle}" Text="Temperature unit"/>
                        <TextBlock Style="{StaticResource SetRowDesc}" Text="Applies to all readings and reports"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource SetRow}" Padding="0,8,0,8">
                    <DockPanel>
                      <Border Style="{StaticResource SetRowControl}"><Border Style="{StaticResource SegmentTrackStyle}"><StackPanel Orientation="Horizontal">
                          <RadioButton x:Name="RbBgRecFull" Content="Full" Tag="Full" GroupName="BgRecGroup" Style="{StaticResource SegmentChipStyle}" Checked="BgRecChip_Checked" IsChecked="True"/>
                          <RadioButton x:Name="RbBgRecReduced" Content="Reduced" Tag="Reduced" GroupName="BgRecGroup" Style="{StaticResource SegmentChipStyle}" Checked="BgRecChip_Checked"/>
                          <RadioButton x:Name="RbBgRecOff" Content="Off" Tag="Off" GroupName="BgRecGroup" Style="{StaticResource SegmentChipStyle}" Checked="BgRecChip_Checked"/></StackPanel></Border></Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtBgRecLbl" Style="{StaticResource SetRowTitle}" Text="Background monitoring"/>
                        <TextBlock x:Name="TxtBgRecDesc" Style="{StaticResource SetRowDesc}" Text="Continue collecting data while the window is minimized"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource SetRow}" Padding="0,8,0,8">
                    <DockPanel>
                      <Border Style="{StaticResource SetRowControl}"><CheckBox x:Name="ChkAutoSnapshotStress" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" ToolTip="Saved on the Tools page every time a CPU or GPU stress test stops." Checked="Settings_Changed" Unchecked="Settings_Changed"/></Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SetRowTitle}" Text="Save snapshot after stress test"/>
                        <TextBlock Style="{StaticResource SetRowDesc}" Text="Record system readings before and after each test"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel x:Name="SetPanelAppearance" HorizontalAlignment="Stretch">
                <Border x:Name="SetCardAppearance" Style="{StaticResource SetCard}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                      <Viewbox Width="17" Height="17" Margin="0,0,10,0" VerticalAlignment="Center"><Path Width="24" Height="24" Fill="{DynamicResource TextSecondaryBrush}" Data="F1 M12,22 A10,10 0 0 0 12,2 A10,10 0 0 0 12,22 M12,20.5 L12,3.5 A8.5,8.5 0 0 1 12,20.5"/></Viewbox>
                      <TextBlock Style="{StaticResource SetCardTitle}" Margin="0" FontSize="15" VerticalAlignment="Center" Text="Appearance"/>
                      <TextBlock Style="{StaticResource SetRowDesc}" Margin="12,2,0,0" VerticalAlignment="Center" Text="Theme, density and animations"/>
                    </StackPanel>
                  <Border Style="{StaticResource SetRow}" Padding="0,8,0,8">
                    <DockPanel>
                      <Border Style="{StaticResource SetRowControl}"><StackPanel Orientation="Horizontal">
                                            <RadioButton x:Name="RbThemeLight" Tag="Light" GroupName="ThemeSegGroup" Style="{StaticResource ThumbChipStyle}" Checked="ThemeSeg_Checked">
                          <StackPanel>
                            <Canvas Width="72" Height="44"><Rectangle Width="72" Height="44" RadiusX="4" RadiusY="4" Fill="#F4F2F6" Stroke="#D6D9E0" StrokeThickness="1"/>
                              <Rectangle Canvas.Left="5" Canvas.Top="5" Width="14" Height="34" RadiusX="2" RadiusY="2" Fill="#E3E4EA"/>
                              <Rectangle Canvas.Left="23" Canvas.Top="5" Width="44" Height="14" RadiusX="2.5" RadiusY="2.5" Fill="#FFFFFF"/>
                              <Rectangle Canvas.Left="23" Canvas.Top="23" Width="44" Height="16" RadiusX="2.5" RadiusY="2.5" Fill="#FFFFFF"/>
                              <Rectangle Canvas.Left="27" Canvas.Top="9" Width="18" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#1A6FE0"/></Canvas>
                            <TextBlock Text="Light" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="104" Margin="0,5,0,0"/>
                          </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RbThemeDark" Tag="Dark" GroupName="ThemeSegGroup" Style="{StaticResource ThumbChipStyle}" Checked="ThemeSeg_Checked">
                          <StackPanel>
                            <Canvas Width="72" Height="44"><Rectangle Width="72" Height="44" RadiusX="4" RadiusY="4" Fill="#1C1F26" Stroke="#3A404C" StrokeThickness="1"/>
                              <Rectangle Canvas.Left="5" Canvas.Top="5" Width="14" Height="34" RadiusX="2" RadiusY="2" Fill="#262A33"/>
                              <Rectangle Canvas.Left="23" Canvas.Top="5" Width="44" Height="14" RadiusX="2.5" RadiusY="2.5" Fill="#2D323C"/>
                              <Rectangle Canvas.Left="23" Canvas.Top="23" Width="44" Height="16" RadiusX="2.5" RadiusY="2.5" Fill="#2D323C"/>
                              <Rectangle Canvas.Left="27" Canvas.Top="9" Width="18" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#5B9BFF"/></Canvas>
                            <TextBlock Text="Dark" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="104" Margin="0,5,0,0"/>
                          </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RbThemeAuto" Tag="Auto" GroupName="ThemeSegGroup" Style="{StaticResource ThumbChipStyle}" Checked="ThemeSeg_Checked" ToolTip="Follows the Windows light / dark setting">
                          <StackPanel>
                            <Grid Width="72" Height="44"><Canvas><Rectangle Width="72" Height="44" RadiusX="4" RadiusY="4" Fill="#F4F2F6" Stroke="#D6D9E0" StrokeThickness="1"/>
                              <Rectangle Canvas.Left="5" Canvas.Top="5" Width="14" Height="34" RadiusX="2" RadiusY="2" Fill="#E3E4EA"/>
                              <Rectangle Canvas.Left="23" Canvas.Top="5" Width="44" Height="14" RadiusX="2.5" RadiusY="2.5" Fill="#FFFFFF"/>
                              <Rectangle Canvas.Left="23" Canvas.Top="23" Width="44" Height="16" RadiusX="2.5" RadiusY="2.5" Fill="#FFFFFF"/>
                              <Rectangle Canvas.Left="27" Canvas.Top="9" Width="18" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#1A6FE0"/></Canvas><Canvas><Canvas.Clip><RectangleGeometry Rect="36,0,36,44"/></Canvas.Clip><Rectangle Width="72" Height="44" RadiusX="4" RadiusY="4" Fill="#1C1F26" Stroke="#3A404C" StrokeThickness="1"/>
                              <Rectangle Canvas.Left="5" Canvas.Top="5" Width="14" Height="34" RadiusX="2" RadiusY="2" Fill="#262A33"/>
                              <Rectangle Canvas.Left="23" Canvas.Top="5" Width="44" Height="14" RadiusX="2.5" RadiusY="2.5" Fill="#2D323C"/>
                              <Rectangle Canvas.Left="23" Canvas.Top="23" Width="44" Height="16" RadiusX="2.5" RadiusY="2.5" Fill="#2D323C"/>
                              <Rectangle Canvas.Left="27" Canvas.Top="9" Width="18" Height="3" RadiusX="1.5" RadiusY="1.5" Fill="#5B9BFF"/></Canvas></Grid>
                            <TextBlock Text="System" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="104" Margin="0,5,0,0"/>
                          </StackPanel>
                        </RadioButton>
                      </StackPanel></Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SetRowTitle}" Text="Theme"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource SetRow}" Padding="0,8,0,8">
                    <DockPanel>
                      <Border Style="{StaticResource SetRowControl}"><Border Style="{StaticResource SegmentTrackStyle}"><StackPanel Orientation="Horizontal">
                          <RadioButton x:Name="RbDensityAuto" Content="Auto" Tag="Auto" GroupName="DensitySegGroup" Style="{StaticResource SegmentChipStyle}" Checked="DensitySeg_Checked" ToolTip="Compact on small screens, Standard on larger ones"/>
                          <RadioButton x:Name="RbDensityCompact" Content="Compact" Tag="Compact" GroupName="DensitySegGroup" Style="{StaticResource SegmentChipStyle}" Checked="DensitySeg_Checked"/>
                          <RadioButton x:Name="RbDensityNormal" Content="Standard" Tag="Normal" GroupName="DensitySegGroup" Style="{StaticResource SegmentChipStyle}" Checked="DensitySeg_Checked"/></StackPanel></Border></Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SetRowTitle}" Text="Display density"/>
                        <TextBlock x:Name="TxtDensityDesc" Style="{StaticResource SetRowDesc}" Text="Automatic: adjusts to screen size"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource SetRow}" Padding="0,8,0,8">
                    <DockPanel>
                      <Border Style="{StaticResource SetRowControl}"><CheckBox x:Name="ChkAnimations" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Checked="Settings_Changed" Unchecked="Settings_Changed"/></Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SetRowTitle}" Text="Animations"/>
                        <TextBlock Style="{StaticResource SetRowDesc}" Text="Animate charts and value changes"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource SetRow}" Padding="0,8,0,8">
                    <DockPanel>
                      <Border Style="{StaticResource SetRowControl}"><CheckBox x:Name="ChkAuroraAlert" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" Checked="Settings_Changed" Unchecked="Settings_Changed"/></Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SetRowTitle}" Text="Background reacts to problems"/>
                        <TextBlock Style="{StaticResource SetRowDesc}" Text="A soft red tint slowly appears on Dark when something is critical"/>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
              <StackPanel x:Name="SetPanelWidget" HorizontalAlignment="Stretch">
                <Border x:Name="SetCardWidget" Style="{StaticResource SetCard}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                      <Viewbox Width="17" Height="17" Margin="0,0,10,0" VerticalAlignment="Center"><Path Width="24" Height="24" Fill="{DynamicResource TextSecondaryBrush}" Data="F1 M6.25,4 C5.01,4 4,5 4,6.25 L4,13.75 C4,14.99 5,16 6.25,16 L17.75,16 C18.99,16 20,15 20,13.75 L20,6.25 C20,5.01 19,4 17.75,4 Z M5.5,6.25 C5.5,5.84 5.84,5.5 6.25,5.5 L17.75,5.5 C18.16,5.5 18.5,5.84 18.5,6.25 L18.5,13.75 C18.5,14.16 18.16,14.5 17.75,14.5 L6.25,14.5 A0.75,0.75 0 0 1 5.5,13.75 Z M2.75,17.5 A0.75,0.75 0 0 0 2.75,19 L21.25,19 A0.75,0.75 0 0 0 21.25,17.5 Z"/></Viewbox>
                      <TextBlock Style="{StaticResource SetCardTitle}" Margin="0" FontSize="15" VerticalAlignment="Center" Text="Widget &amp; tray"/>
                      <TextBlock Style="{StaticResource SetRowDesc}" Margin="12,2,0,0" VerticalAlignment="Center" Text="Live readings outside the main window"/>
                    </StackPanel>
                  <Border Style="{StaticResource SetRow}" Padding="0,8,0,8">
                    <StackPanel>
                      <DockPanel>
                        <Border Style="{StaticResource SetRowControl}"><CheckBox x:Name="ChkWidgetEnabled" Style="{StaticResource ToggleSwitchStyle}" ToolTip="Same as the Widget button in the title bar" Click="ChkWidgetEnabled_Changed"/></Border>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock x:Name="TxtCompactWidgetTitle" Style="{StaticResource SetRowTitle}" Text="Desktop widget"/>
                          <TextBlock x:Name="TxtWidgetDesc" Style="{StaticResource SetRowDesc}" Text="Always-on-top window with live readings"/>
                        </StackPanel>
                      </DockPanel>
                      <StackPanel x:Name="PnlCompactMetrics" Visibility="Collapsed" Margin="0,10,0,0">
                        <DockPanel Margin="0,0,0,10">
                          <TextBlock x:Name="TxtWidgetStyleLbl" DockPanel.Dock="Left" Text="Style" Width="70" Style="{StaticResource SetRowDesc}" Margin="0" VerticalAlignment="Center"/>
                          <Border Style="{StaticResource SegmentTrackStyle}"><StackPanel Orientation="Horizontal">
                          <RadioButton x:Name="RbWidgetStyleGauges" Content="Gauges" Tag="Gauges" GroupName="WidgetStyleGroup" Style="{StaticResource SegmentChipStyle}" Checked="WidgetStyle_Click" ToolTip="Small segmented arc per value"/>
                          <RadioButton x:Name="RbWidgetStylePill" Content="Graphs" Tag="Pill" GroupName="WidgetStyleGroup" Style="{StaticResource SegmentChipStyle}" Checked="WidgetStyle_Click" ToolTip="Value with a small history line"/>
                          <RadioButton x:Name="RbWidgetStyleMinimal" Content="Compact" Tag="Minimal" GroupName="WidgetStyleGroup" Style="{StaticResource SegmentChipStyle}" Checked="WidgetStyle_Click" ToolTip="Values only, on one narrow row"/></StackPanel></Border>
                        </DockPanel>
                        <DockPanel>
                          <TextBlock x:Name="TxtCompactMetricsLabel" DockPanel.Dock="Left" Text="Shows" Width="70" Style="{StaticResource SetRowDesc}" Margin="0,1,0,0" VerticalAlignment="Top"/>
                          <UniformGrid x:Name="WidgetMetricChips" Columns="3"/>
                        </DockPanel>
                        <CheckBox Style="{StaticResource VanillaCheckBoxStyle}" x:Name="ChkWidgetAlertOnly" Content="Show only on alert" Margin="70,8,0,0" Click="WidgetAlertOnly_Changed" ToolTip="Hidden while all readings are within limits"/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource SetRow}" Padding="0,8,0,8">
                    <StackPanel>
                      <DockPanel>
                        <Border Style="{StaticResource SetRowControl}"><CheckBox x:Name="ChkTraySensors" Style="{StaticResource ToggleSwitchStyle}" ToolTip="One icon per value, up to 8" Click="ChkTraySensors_Changed"/></Border>
                        <StackPanel VerticalAlignment="Center">
                          <TextBlock x:Name="TxtTraySensorsTitle" Style="{StaticResource SetRowTitle}" Text="Notification area icons"/>
                          <TextBlock x:Name="TxtTraySensorsDesc" Style="{StaticResource SetRowDesc}" Text="Up to 8 readings; hover for details"/>
                        </StackPanel>
                      </DockPanel>
                      <StackPanel x:Name="PnlTrayOptions" Visibility="Collapsed" Margin="0,10,0,0">
                        <!-- the icon preview, as it looks next to the clock (MainWindow.SettingsThumbs.cs → UpdateTrayPreview) -->
                        <Border x:Name="TrayPreviewStrip" Background="#202226" CornerRadius="6" Padding="10,6" Margin="0,0,0,10" HorizontalAlignment="Left" Visibility="Collapsed">
                          <StackPanel x:Name="TrayPreviewIcons" Orientation="Horizontal"/>
                        </Border>
                        <UniformGrid x:Name="TrayMetricChips" Columns="3"/>
                        <TextBlock x:Name="TxtTrayMetricsLabel" Visibility="Collapsed" Text="Icons"/>
                        <TextBlock x:Name="TxtTrayMetricsHint" Visibility="Collapsed" Text=""/>
                      </StackPanel>
                    </StackPanel>
                  </Border>
                  </StackPanel>
                </Border>
              </StackPanel>
              </StackPanel>
              <StackPanel x:Name="SetColRight" Grid.Column="2">
              <StackPanel x:Name="SetPanelAlerts" HorizontalAlignment="Stretch">
                <Border x:Name="SetCardAlerts" Style="{StaticResource SetCard}">
                  <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,8">
                      <Viewbox Width="17" Height="17" Margin="0,0,10,0" VerticalAlignment="Center"><Path Width="24" Height="24" Fill="{DynamicResource TextSecondaryBrush}" Data="F1 M12,2 A7.5,7.5 0 0 1 19.5,9.25 L19.5,13.6 L20.88,16.75 A1.25,1.25 0 0 1 19.73,18.5 L15,18.5 A3,3 0 0 1 9,18.68 L9,18.5 L4.27,18.5 A1.25,1.25 0 0 1 3.13,16.75 L4.5,13.6 L4.5,9.5 C4.5,5.35 7.85,2 12,2 M13.5,18.5 L10.5,18.5 A1.5,1.5 0 0 0 13.5,18.65 Z M12,3.5 C8.68,3.5 6,6.17 6,9.5 L6,13.9 L4.66,17 L19.36,17 L18,13.9 L18,9.29 A6,6 0 0 0 12,3.51"/></Viewbox>
                      <TextBlock Style="{StaticResource SetCardTitle}" Margin="0" FontSize="15" VerticalAlignment="Center" Text="Alerts"/>
                      <TextBlock Style="{StaticResource SetRowDesc}" Margin="12,2,0,0" VerticalAlignment="Center" Text="When SMD Win should warn"/>
                    </StackPanel>
                  <Border Style="{StaticResource SetRow}" Padding="0,8,0,8">
                    <DockPanel>
                      <Border Style="{StaticResource SetRowControl}"><CheckBox x:Name="ChkEnableNotifications" Style="{StaticResource ToggleSwitchStyle}" IsChecked="True" ToolTip="Temperature, drive health, throttling, low space, internet connection lost." Checked="Settings_Changed" Unchecked="Settings_Changed"/></Border>
                      <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TxtSysNotifLbl" Style="{StaticResource SetRowTitle}" Text="Notifications"/>
                        <TextBlock Style="{StaticResource SetRowDesc}" Text="Show Windows notifications for critical events"/>
                        <TextBlock Margin="0,2,0,0"><Hyperlink x:Name="LnkTestNotification" Click="TestNotification_Click" TextDecorations="None" Foreground="{DynamicResource AccentBrush}"><Run Text="Send test notification"/></Hyperlink></TextBlock>
                      </StackPanel>
                    </DockPanel>
                  </Border>
                  <Border Style="{StaticResource SetRow}" Padding="0,8,0,8">
                    <DockPanel>
