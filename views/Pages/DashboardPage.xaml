                                   x:Name="TxtDialGpuTemp" Text="{Binding Text, ElementName=TxtDashGpuTempBig, Converter={StaticResource DashTempConv}, Mode=OneTime}"/>
                      </DockPanel>
                      <!-- in the first seconds the chart is almost empty — a discreet note, until the data is collected -->
                      <TextBlock x:Name="TxtDashGpuCollecting" Grid.Row="1" Text="Collecting data…" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"
                                 Opacity="0.7" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,3,0,0" IsHitTestVisible="False" Visibility="Collapsed"/>
                      <Border x:Name="DashGpuTempChartFrame" Grid.Row="1" Margin="0,3,0,0" BorderThickness="0" SnapsToDevicePixels="True">
                        <Canvas x:Name="DashGpuTempChart" MinHeight="38" ClipToBounds="True" Background="Transparent"
                              SizeChanged="DashGpuTempChart_SizeChanged" MouseMove="DashChart_MouseMove" MouseLeave="DashChart_MouseLeave"
                              ContextMenu="{StaticResource DashChartMenu}"/>
                      </Border>
                      <!-- the two ends of the temperature scale, small, on the left of the chart -->
                      <TextBlock x:Name="DashGpuTempScaleHi" Grid.Row="1" Style="{StaticResource DashChartScaleText}" VerticalAlignment="Top" Margin="2,4,0,0"/>
                      <TextBlock x:Name="DashGpuTempScaleLo" Grid.Row="1" Style="{StaticResource DashChartScaleText}" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                    </Grid></ContentControl>
                  </Grid>
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource CompFootBand}">
                  <UniformGrid Columns="4">
                    <Border Style="{StaticResource CompFootCellFirst}">
                      <StackPanel>
                        <TextBlock Text="VRAM in use" Style="{StaticResource CompFootKey}"/>
                        <TextBlock Text="{Binding Text, ElementName=TxtDashGpuVramInline, Converter={StaticResource DashDash}}" Style="{StaticResource CompFootVal}"/>
                      </StackPanel>
