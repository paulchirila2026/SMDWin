                              ContextMenu="{StaticResource DashChartMenu}"/>
                      </Border>
                      <!-- the two ends of the temperature scale, small, on the left of the chart -->
                      <TextBlock x:Name="DashCpuTempScaleHi" Grid.Row="1" Style="{StaticResource DashChartScaleText}" VerticalAlignment="Top" Margin="2,4,0,0"/>
                      <TextBlock x:Name="DashCpuTempScaleLo" Grid.Row="1" Style="{StaticResource DashChartScaleText}" VerticalAlignment="Bottom" Margin="2,0,0,1"/>
                    </Grid></ContentControl>
                  </Grid>
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource CompFootBand}">
                  <UniformGrid Columns="4">
                    <Border Style="{StaticResource CompFootCellFirst}">
                      <StackPanel>
                        <TextBlock x:Name="TxtDashCpuFoot4K" Text="Clock" Style="{StaticResource CompFootKey}"/>
                        <TextBlock x:Name="TxtDashCpuFoot4V" Text="" Style="{StaticResource CompFootVal}"/>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CompFootCell}">
                      <StackPanel>
                        <TextBlock Text="Package power" Style="{StaticResource CompFootKey}"/>
                        <TextBlock x:Name="TxtDashCpuFoot5V" Text="" Style="{StaticResource CompFootVal}"/>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CompFootCell}">
                      <StackPanel>
                        <TextBlock Text="Hottest core" Style="{StaticResource CompFootKey}"/>
                        <TextBlock x:Name="TxtDashCpuFootHot" Text="" Style="{StaticResource CompFootVal}"/>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CompFootCell}">
                      <StackPanel>
                        <TextBlock Text="Top process" Style="{StaticResource CompFootKey}"/>
                        <TextBlock x:Name="TxtDashCpuFootTop" Text="" Style="{StaticResource CompFootVal}" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Border>
                  </UniformGrid>
                </Border>
              </Grid>
            </Border>

            <Border x:Name="DashGpuCard" Grid.Row="0" Grid.Column="2" Style="{StaticResource CompCardStyle}" MouseLeftButtonUp="DashCpu_Click" ToolTip="{Binding Text, ElementName=TxtDashGpuTooltip}">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8" LastChildFill="True">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- state: a Windows-style mark (tick / ! / i in a filled circle) and the word, no pill behind it -->
                    <Grid VerticalAlignment="Center" Visibility="{Binding Text, ElementName=GpuStatusText, Converter={StaticResource DashFactVis}}">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <local:StatusMark Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Foreground, ElementName=GpuStatusText}"/>
                        <TextBlock Text="{Binding Text, ElementName=GpuStatusText}" Foreground="{Binding Foreground, ElementName=GpuStatusText, Converter={StaticResource NeutralUnlessAlert}}" Style="{StaticResource CompStatusText}"/>
                      </StackPanel>
