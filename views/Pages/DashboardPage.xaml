                  <ToolTip>
                    <StackPanel MinWidth="160">
                      <TextBlock Text="Network" FontWeight="Bold" FontSize="{StaticResource FontSizeS}" Margin="0,0,0,4"/>
                      <TextBlock x:Name="TxtDashNetTooltip2" Text="Loading..." FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </ToolTip>
