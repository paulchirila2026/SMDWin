 L14.85,11.03 L15.23,11.06 L15.47,11.35 Z"/>
                      </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Text, ElementName=TxtGpuDash2}" Style="{StaticResource DashRowName}" Tag="Gpu" Cursor="Hand" MouseLeftButtonUp="DashName_Click" ToolTip="{Binding Text, ElementName=TxtGpuDash2}"/>
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,2,0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                  <Viewbox Style="{StaticResource CompDialBox}">
                    <Grid Style="{StaticResource CompDialGrid}">
                      <local:PercentGauge x:Name="DashGaugeGpu" ShowValue="False" Segments="20"/>
                      <StackPanel Style="{StaticResource CompDialText}">
                        <TextBlock Style="{StaticResource CompDialUnitGhost}"/>
                        <TextBlock Style="{StaticResource CompDialValue}" x:Name="TxtDialGpu" Text="{Binding Text, ElementName=TxtDashGpuPct, Mode=OneTime}"/>
                        <TextBlock Style="{StaticResource CompDialUnit}"/>
                      </StackPanel>
                      <TextBlock Style="{StaticResource CompDialSub}" Text="load"/>
                      <TextBlock x:Name="DashRangeGpu" Style="{StaticResource CompDialRange}"/>
                    </Grid>
                  </Viewbox>
                  <Grid Grid.Column="1" MaxHeight="240" Margin="8,0,0,0">
                    <!-- the load chart is hidden: the dial already shows the load; the temperature chart stays -->
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ContentControl Grid.Column="0" Focusable="False" Visibility="Collapsed"><Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                      <DockPanel Style="{StaticResource DashCompChartHead}">
                        <TextBlock x:Name="DashLoadLabelGpu" Text="Load" Style="{StaticResource DashChartLabel}" VerticalAlignment="Bottom"/>
                      </DockPanel>
                      <Border x:Name="SparkGpuFrame" Grid.Row="1" Margin="0,3,0,0" BorderThickness="0" SnapsToDevicePixels="True">
                        <Canvas x:Name="SparkGpu" MinHeight="38" ClipToBounds="True" Background="Transparent"
                              SizeChanged="SparkGpu_SizeChanged" MouseMove="DashChart_MouseMove" MouseLeave="DashChart_MouseLeave" Loaded="SparkGpu_SizeChanged"
                              ContextMenu="{StaticResource DashChartMenu}"/>
