                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <local:StatusMark Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Foreground, ElementName=CpuStatusText}"/>
                        <TextBlock Text="{Binding Text, ElementName=CpuStatusText}" Foreground="{Binding Foreground, ElementName=CpuStatusText, Converter={StaticResource NeutralUnlessAlert}}" Style="{StaticResource CompStatusText}"/>
                      </StackPanel>
                    </Grid>
                    <Path Style="{StaticResource DashChevron}" Margin="10,0,0,0" ToolTip="Open Temp &amp; Stress"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
