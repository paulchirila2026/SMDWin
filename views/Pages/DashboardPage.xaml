                    <TextBlock x:Name="TxtGlanceTopCpu" Text="—" FontSize="{StaticResource FontSizeXXL}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtGlanceTopCpuPct" Text="" FontSize="{StaticResource FontSizeS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Card 3: Top proces RAM -->
              <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="14,11">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0"
                          Background="{DynamicResource BgHoverBrush}" VerticalAlignment="Center">
                    <Viewbox Width="20" Height="20">
                      <Canvas Width="24" Height="24">
                        <Path Fill="#2E8B57" Data="F1 M21.62,6.88 A3,3 0 0 0 19.5,6 L19.5,3.75 A0.75,0.75 0 0 0 18,3.75 L18,6 L15,6 L15,3.75 A0.75,0.75 0 0 0 13.5,3.75 L13.5,6 L10.5,6 L10.5,3.75 A0.75,0.75 0 0 0 9,3.75 L9,6 L6,6 L6,3.75 A0.75,0.75 0 0 0 4.5,3.75 L4.5,6 A3,3 0 0 0 1.5,9 L1.5,15 A3,3 0 0 0 4.5,18 L4.5,20.25 A0.75,0.75 0 0 0 6,20.25 L6,18 L9,18 L9,20.25 A0.75,0.75 0 0 0 10.5,20.25 L10.5,18 L13.5,18 L13.5,20.25 A0.75,0.75 0 0 0 15,20.25 L15,18 L18,18 L18,20.25 A0.75,0.75 0 0 0 19.5,20.25 L19.5,18 A3,3 0 0 0 22.5,15 L22.5,9 A3,3 0 0 0 21.62,6.88 M21,15 A1.5,1.5 0 0 1 19.5,16.5 L4.5,16.5 A1.5,1.5 0 0 1 3,15 L3,9 A1.5,1.5 0 0 1 4.5,7.5 L19.5,7.5 A1.5,1.5 0 0 1 21,9 Z M18.75,9 L5.25,9 A0.75,0.75 0 0 0 4.5,9.75 L4.5,14.25 A0.75,0.75 0 0 0 5.25,15 L18.75,15 A0.75,0.75 0 0 0 19.5,14.25 L19.5,9.75 A0.75,0.75 0 0 0 18.75,9 M18,13.5 L6,13.5 L6,10.5 L18,10.5 Z"/>
                      </Canvas>
