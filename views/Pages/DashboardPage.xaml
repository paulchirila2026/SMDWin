          <!-- ══════════════════════════════════════════════════════════════════════
               DASHBOARD IN ROWS
               One row per component: [component] [now] [history] [details] [state] [›/↗].
               • the rows share the window height equally (a Grid with 7 "*" rows), the charts stretch over the whole row height;
                 below ~720 px a scroll appears.
               • the texts are bound (Binding ElementName) to the fields of the older dashboard (hidden, DashClassicScroll), filled
                 by the existing code; the 8 charts, the "last update" and the partition list live here with the same names.
               • fixed chart interval of 1 minute (the long history is in Temp & Stress).
               • › = opens the app page · ↗ = opens a new window.
               ══════════════════════════════════════════════════════════════════════ -->
          <ScrollViewer x:Name="DashRowsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Focusable="False" Loaded="DashRows_Loaded" SizeChanged="DashRowsScroll_SizeChanged">
          <!-- height = the visible area MINUS the margins (in code, DashRowsScroll_SizeChanged) -->
          <Grid x:Name="DashRowsGrid" Margin="16,8,16,10" MinHeight="560" SizeChanged="DashRowsGrid_SizeChanged">
            <Grid.Resources>
              <local:DashTempConverter x:Key="DashTempConv"/>
              <local:DashFactVisibilityConverter x:Key="DashFactVis"/>
              <local:DashDashConverter x:Key="DashDash"/>
              <local:DashGatewayDnsConverter x:Key="DashGwDns"/>
              <local:DashShortDateConverter x:Key="DashShortDate"/>
              <local:DashOsVersionConverter x:Key="DashOsVer"/>
              <ContextMenu x:Key="DashChartMenu" x:Shared="False">
                <MenuItem Header="Fill on/off" Click="ChartCtxFill_Click"/>
                <MenuItem Header="Chart color:" IsEnabled="False" FontWeight="SemiBold"/>
                <MenuItem Header="   Blue" IsCheckable="True" Click="ChartCtxColorMode_Click" Tag="Accent" Loaded="ChartColorMenuItem_Loaded"/>
                <MenuItem Header="   Light blue" IsCheckable="True" Click="ChartCtxColorMode_Click" Tag="LightBlue" Loaded="ChartColorMenuItem_Loaded"/>
                <MenuItem Header="   Colorful" IsCheckable="True" Click="ChartCtxColorMode_Click" Tag="Gradient" Loaded="ChartColorMenuItem_Loaded"/>
                <MenuItem Header="   Gray" IsCheckable="True" Click="ChartCtxColorMode_Click" Tag="Gray" Loaded="ChartColorMenuItem_Loaded"/>
                <Separator/>
                <MenuItem Header="Time range:" IsEnabled="False" FontWeight="SemiBold"/>
                <MenuItem Header="   Last 1 min" IsCheckable="True" Click="ChartCtxRange_Click" Tag="60" Loaded="ChartRangeMenuItem_Loaded"/>
                <MenuItem Header="   Last 5 min" IsCheckable="True" Click="ChartCtxRange_Click" Tag="300" Loaded="ChartRangeMenuItem_Loaded"/>
                <MenuItem Header="   Last 15 min" IsCheckable="True" Click="ChartCtxRange_Click" Tag="900" Loaded="ChartRangeMenuItem_Loaded"/>
                <MenuItem Header="   Last 1 h" IsCheckable="True" Click="ChartCtxRange_Click" Tag="3600" Loaded="ChartRangeMenuItem_Loaded"/>
              </ContextMenu>
              <Style TargetType="Image" x:Key="DashRowIcon">
                <Setter Property="Width" Value="18"/>
                <Setter Property="Height" Value="18"/>
                <Setter Property="HorizontalAlignment" Value="Center"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
                <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
              </Style>
              <!-- "›" — opens the app page -->
              <Style TargetType="Path" x:Key="DashChevron">
                <Setter Property="Data" Value="M9,6 L15,12 L9,18"/>
                <Setter Property="Stroke" Value="{DynamicResource TextSecondaryBrush}"/>
                <Setter Property="StrokeThickness" Value="1.8"/>
                <Setter Property="StrokeStartLineCap" Value="Round"/>
                <Setter Property="StrokeEndLineCap" Value="Round"/>
                <Setter Property="StrokeLineJoin" Value="Round"/>
                <Setter Property="Width" Value="14"/>
                <Setter Property="Height" Value="14"/>
                <Setter Property="Stretch" Value="Uniform"/>
                <Setter Property="Opacity" Value="0.6"/>
                <Setter Property="HorizontalAlignment" Value="Right"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
              </Style>
              <!-- "↗" — opens a new window -->
              <Style TargetType="Path" x:Key="DashExternal" BasedOn="{StaticResource DashChevron}">
                <Setter Property="Data" Value="M14,4 H20 V10 M20,4 L11,13 M18,14 V19 A1,1 0 0 1 17,20 H5 A1,1 0 0 1 4,19 V7 A1,1 0 0 1 5,6 H10"/>
                <Setter Property="Opacity" Value="0.75"/>
              </Style>
            </Grid.Resources>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ── Antet: masina (click = Hardware Info ↗), nume · Windows, securitate, LIVE + uptime ── -->
            <Grid Grid.Row="0" Margin="4,0,4,12">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Cursor="Hand" Background="Transparent" HorizontalAlignment="Left"
                            MouseLeftButtonUp="DashHardware_Click" ToolTip="Hardware information — opens a new window">
                  <TextBlock Text="{Binding Text, ElementName=TxtHardwareStripPcName}" FontFamily="{StaticResource NumFont}" FontSize="26" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                  <TextBlock FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.Text>
                      <MultiBinding StringFormat="{}{0}  ·  {1}">
                        <Binding Path="Text" ElementName="TxtDashComputerV"/>
                        <Binding Path="Text" ElementName="TxtHeroOsLine"/>
                      </MultiBinding>
                    </TextBlock.Text>
                  </TextBlock>
                  <!-- LIVE: the dot shows the state of the sensor driver (green = installed and answering, orange = missing or not
                       answering); the tooltip says which. Set from MainWindow.RefreshPawnIoStatus. Five clicks start the self-test. -->
                  <StackPanel x:Name="DashLiveBadge" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" Background="Transparent" MouseLeftButtonUp="LiveBadge_MouseUp" ToolTip="Live data">
                    <Ellipse x:Name="DashLiveDot" Width="6" Height="6" Fill="{DynamicResource StatusOkBrush}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                    <TextBlock x:Name="DashLiveText" Text="LIVE" FontSize="{StaticResource FontSizeS}" FontWeight="Bold" Foreground="{DynamicResource StatusOkBrush}"/>
                  </StackPanel>
                </StackPanel>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Chart interval: chosen from the right-click menu of any chart (DashChartMenu, 1 minute by default); these hidden
                     buttons carry the choice to the existing code. -->
                <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                  <RadioButton x:Name="BtnChartWindow60"   Content="1m"  Tag="60"  IsChecked="True"
                            GroupName="ChartWindowGroup" Style="{StaticResource UnderlineChipStyle}"
                            Checked="ChartWindowBtn_Click" Margin="0,0,4,0"/>
                  <RadioButton x:Name="BtnChartWindow300"  Content="5m"  Tag="300"
                            GroupName="ChartWindowGroup" Style="{StaticResource UnderlineChipStyle}"
                            Checked="ChartWindowBtn_Click" Margin="0,0,4,0"/>
                  <RadioButton x:Name="BtnChartWindow900"  Content="15m" Tag="900"
                            GroupName="ChartWindowGroup" Style="{StaticResource UnderlineChipStyle}"
                            Checked="ChartWindowBtn_Click" Margin="0,0,4,0"/>
                  <RadioButton x:Name="BtnChartWindow3600" Content="60m" Tag="3600"
                            GroupName="ChartWindowGroup" Style="{StaticResource UnderlineChipStyle}"
                            Checked="ChartWindowBtn_Click" Margin="0,0,4,0"/>
                </StackPanel>
                <StackPanel Visibility="Collapsed">
                  <TextBlock x:Name="TxtDashLastUpdate" Text="" FontSize="{StaticResource FontSizeS}"
                             Foreground="{DynamicResource StatusOkBrush}" Opacity="0.7" Margin="6,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </Grid>

            <!-- ═══ Dashboard: a 2-column grid of cards; each card = header (name + state) · body (1/3 dial + value, centred | 2/3
                 charts) · footer (4 facts). ═══ -->
            <Grid x:Name="DashCardsGrid" Grid.Row="1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="DashCardsCol0" Width="*"/>
                <ColumnDefinition x:Name="DashCardsGap" Width="12"/>
                <ColumnDefinition x:Name="DashCardsCol1" Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="*"/><RowDefinition Height="12"/>
                <RowDefinition Height="*"/><RowDefinition Height="12"/>
                <RowDefinition Height="*"/>
                <RowDefinition x:Name="DashBatGapDef" Height="0"/>
                <!-- Battery: 0 on a desktop, "*" when there is a battery (MainWindow.DashRows.cs) -->
                <RowDefinition x:Name="DashBatRowDef" Height="0"/>
              </Grid.RowDefinitions>
            <Border x:Name="DashCpuCard" Grid.Row="0" Grid.Column="0" Style="{StaticResource CompCardStyle}" MouseLeftButtonUp="DashCpu_Click" ToolTip="{Binding Text, ElementName=TxtDashCpuTooltip}">
