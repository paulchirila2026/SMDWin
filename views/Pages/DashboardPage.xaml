<UserControl x:Class="SMDWin.Views.Pages.DashboardPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:local="clr-namespace:SMDWin.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <!-- The page logic is in the MainWindow.*.cs files: the named elements here are exposed in MainWindow as properties
       (MainWindow.Pages.cs), and the handlers are redirected below. -->
        <Grid x:Name="PanelDashboard" Style="{StaticResource PageFadeStyle}">
          <!-- Compat stubs — referenced in C# but not visible -->
          <Grid Visibility="Collapsed">
            <TextBlock x:Name="TxtDashTitle" Text="Dashboard"/>
            <TextBlock x:Name="TxtDashSubtitle" Text="Live overview"/>
            <Border x:Name="DiagnoseDurationBorder"/>
            <TextBlock x:Name="TxtDashClock" Text="--:--:--"/>
            <TextBlock x:Name="TxtDashDate" Text=""/>
            <TextBlock x:Name="TxtOs" Text="—"/>
            <TextBlock x:Name="TxtDashArch" Text="—"/>
            <TextBlock x:Name="TxtMachine" Text="—"/>
            <TextBlock x:Name="TxtDashBios" Text="—"/>
            <TextBlock x:Name="TxtDashDisplay" Text="—"/>
            <TextBlock x:Name="TxtDashDisplaySub" Text="—"/>
            <TextBlock x:Name="TxtUptime" Text="—"/>
            <TextBlock x:Name="TxtDashComputer" Text="—"/>
            <TextBlock x:Name="TxtDashNetStatus2Compat" Visibility="Collapsed" Text="—"/>
            <Border x:Name="DiagnoseProgressBorder"/>
            <TextBlock x:Name="TxtDiagnoseStatus" Text=""/>
            <TextBlock x:Name="TxtDiagnoseTimer" Text=""/>
            <Border x:Name="DashAdminBanner"/>
            <TextBlock x:Name="DashAdminIcon" Text=""/>
            <TextBlock x:Name="TxtDashAdminTitle" Text=""/>
            <TextBlock x:Name="TxtDashAdminSub" Text=""/>
            <Button x:Name="BtnDashAdmin" Content=""/>
            <TextBlock x:Name="TxtDashAdminBtn" Text=""/>
            <TextBlock x:Name="TxtCpuDash" Text=""/>
            <TextBlock x:Name="TxtDashCpuLabelInline" Text=""/>
            <TextBlock x:Name="TxtDashCpuTemp" Text=""/>
            <Border x:Name="DashCpuBar"/>
            <TextBlock x:Name="TxtDashCpuLabel" Text=""/>
            <TextBlock x:Name="TxtDashGpuSub" Text=""/>
            <TextBlock x:Name="TxtDashGpuLabelInline" Text=""/>
            <TextBlock x:Name="TxtDashGpuTempInline" Text=""/>
            <Border x:Name="DashGpuBar"/>
            <TextBlock x:Name="TxtDashGpuLabel" Text=""/>
            <TextBlock x:Name="TxtRamDashSub2Compat" Text=""/>
            <Border x:Name="DashRamBar"/>
            
            <TextBlock x:Name="TxtHealthScore" Text=""/>
            <TextBlock x:Name="TxtHealthLabel" Text=""/>
            <Border x:Name="HealthSectionWrapper"/>
            <Border x:Name="HealthScoreCard"/>
            <Border x:Name="HealthScoreArc"/>
            <TextBlock x:Name="TxtHealthScoreCircle" Text=""/>
            <TextBlock x:Name="TxtHealthLabelCircle" Text=""/>
            <TextBlock x:Name="TxtHealthSubtitle" Text=""/>
            <Border x:Name="HealthBadge"/>
            <TextBlock x:Name="TxtHealthBadge" Text=""/>
            <Grid x:Name="HealthSubScoreGrid"/>
            <Border x:Name="BarCpuTemp"/><TextBlock x:Name="TxtSubCpuTemp" Text=""/>
            <Border x:Name="BarRam"/><TextBlock x:Name="TxtSubRam" Text=""/>
            <Border x:Name="BarDisk"/><TextBlock x:Name="TxtSubDisk" Text=""/>
            <Border x:Name="BarBattery"/><TextBlock x:Name="TxtSubBattery" Text=""/>
            <Border x:Name="BarStability"/><TextBlock x:Name="TxtSubStability" Text=""/>
            <Border x:Name="SpeedDialCard"/>
            <TextBlock x:Name="TxtQuickActionsLabel" Text=""/>
            <Border x:Name="StorageTrack"/>
            <Canvas x:Name="PerfmonQueueCanvas"/>
            <Canvas x:Name="PerfmonPagesCanvas"/>
            <TextBlock x:Name="PerfmonQueueLabel" Text=""/>
            <TextBlock x:Name="PerfmonPagesLabel" Text=""/>
            <Grid x:Name="DashRow1"/><Grid x:Name="DashRow2"/>
            <StackPanel x:Name="DashFixedSections"/>
            <TextBlock x:Name="TxtOsBuild" Text=""/>
            <TextBlock x:Name="TxtRamDash" Text=""/>
            <TextBlock x:Name="TxtDashStorageSummary" Text=""/>
          </Grid>

          <!-- ══════════════════════════════════════════════════════
               Layout:
               Row 0 — Hero verdict bar
               Row 1 — Live cards (CPU|GPU|RAM|DISK)
               Row 2 — Live cards (CPU Temp|GPU Temp|Network|Ping)
               Row 3 — Compact hardware strip
               Row 4 — Storage + System info (2 columns)
               Row 5 — Quick Actions
               ══════════════════════════════════════════════════════ -->
          <!-- The older Dashboard (cards) — HIDDEN, kept for the fields the code fills and that the new rows bind to (see
               DashRowsScroll below). -->
          <ScrollViewer x:Name="DashClassicScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        Focusable="False">
          <Grid Margin="16,6,16,6">
            <Grid.RowDefinitions>
              <RowDefinition Height="0"/>              <RowDefinition Height="*" MinHeight="115"/>  <!-- Row 1 live -->
              <RowDefinition Height="*" MinHeight="115"/>  <!-- Row 2 live -->
              <RowDefinition Height="Auto"/>   <!-- 2×2 sections (Hardware/Storage/Network/Windows) -->
            </Grid.RowDefinitions>

            <!-- ══ ROW 0 — Hero verdict bar ══════════════════════════════════ -->
            <Border Grid.Row="0" x:Name="DashboardSkeleton" CornerRadius="8" Margin="0,0,0,0"
                    Padding="14,10">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
                  <Setter Property="BorderThickness" Value="1"/>
                  <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
                </Style>
              </Border.Style>
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="HeroIconBorder" Width="38" Height="38" CornerRadius="8"
                        Background="{DynamicResource Ok50Brush}" VerticalAlignment="Center" Margin="0,0,14,0"
                        Visibility="Collapsed">
                  <TextBlock x:Name="HeroIcon" Text="&#x2713;" FontSize="{StaticResource FontSizeXXL}" FontWeight="Bold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource StatusOkBrush}"/>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Visibility="Collapsed">
                  <TextBlock x:Name="TxtHeroVerdict" Text="All systems healthy"
                             FontSize="{StaticResource FontSizeXL}" FontWeight="Bold"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
                  <TextBlock x:Name="TxtHeroSub" Text="&#x2014;"
                             FontSize="{StaticResource FontSizeM}" Foreground="{DynamicResource TextSecondaryBrush}"
                             Opacity="0.75" Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                  <StackPanel VerticalAlignment="Center" Margin="0,0,14,0">
                    <TextBlock x:Name="TxtDashComputerV_stub" Text="&#x2014;" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <TextBlock x:Name="TxtHeroOsLine" Text="&#x2014;" FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75"/>
                      <TextBlock Text=" &#xB7; " FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.5"/>
                      <TextBlock x:Name="TxtHeroUptimeLine" Text="&#x2014;" FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75"/>
                    </StackPanel>
                  </StackPanel>
                  <!-- Export Snapshot button -->
                  <Button Click="ExportSnapshot_Click" Margin="0,0,8,0"
                          Background="Transparent" BorderThickness="0" Cursor="Hand"
                          ToolTip="Export current state as JSON (Data › Reports)">
                    <Button.Template>
                      <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                                Padding="9,4" BorderThickness="1"
                                BorderBrush="{DynamicResource CardBorderBrush}">
                          <StackPanel Orientation="Horizontal">
                            <Viewbox Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center">
                              <Canvas Width="24" Height="24">
                                <Path Fill="{DynamicResource TextSecondaryBrush}" Data="F1 M18.25,3.51 A0.75,0.75 0 0 0 18.25,2.01 L5.25,2.01 A0.75,0.75 0 0 0 5.25,3.51 Z M11.65,22 L11.75,22 C12.13,22 12.45,21.72 12.49,21.36 L12.5,21.26 L12.5,7.56 L16.22,11.28 C16.49,11.55 16.9,11.57 17.2,11.35 L17.28,11.28 A0.75,0.75 0 0 0 17.35,10.3 L17.28,10.22 L12.28,5.22 A0.75,0.75 0 0 0 11.31,5.15 L11.22,5.22 L6.22,10.22 A0.75,0.75 0 0 0 7.2,11.35 L7.28,11.28 L11,7.58 L11,21.25 C11,21.63 11.28,21.95 11.65,22"/>
                              </Canvas>
                            </Viewbox>
                            <TextBlock Text="Export" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Button.Template>
                  </Button>

                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                              ToolTip="Time range for the charts on this page only — doesn't affect Temp &amp; Stress or the Ping Monitor window.">
                  </StackPanel>

                  <Border CornerRadius="5" Padding="9,4" MouseLeftButtonUp="LiveBadge_MouseUp"
                          Background="{DynamicResource Ok50Brush}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <Ellipse Width="6" Height="6" Fill="{DynamicResource StatusOkBrush}" VerticalAlignment="Center" Margin="0,0,5,0">
                        <Ellipse.Triggers>
                          <EventTrigger RoutedEvent="Loaded">
                            <BeginStoryboard>
                              <Storyboard RepeatBehavior="Forever">
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="1" To="0.2" Duration="0:0:1" AutoReverse="True"/>
                              </Storyboard>
                            </BeginStoryboard>
                          </EventTrigger>
                        </Ellipse.Triggers>
                      </Ellipse>
                      <TextBlock Text="LIVE" FontSize="{StaticResource FontSizeS}" FontWeight="Bold" Foreground="{DynamicResource StatusOkBrush}"/>

                    </StackPanel>
                  </Border>
                </StackPanel>
              </Grid>
            </Border>
            <!-- ══ ROW 1 — Live cards: CPU · GPU · RAM · DISK ══════════════════ -->
            <Grid Grid.Row="1" Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- ── CPU ── -->
              <Border Grid.Column="0" Style="{StaticResource DashClickCardStyle}"
                      MouseLeftButtonUp="DashCpu_Click">
                <Border.ToolTip>
                  <ToolTip>
                    <StackPanel MinWidth="180">
                      <TextBlock Text="CPU Details" FontWeight="Bold" FontSize="{StaticResource FontSizeS}" Margin="0,0,0,5"/>
                      <TextBlock x:Name="TxtDashCpuTooltip" Text="Loading..." FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </ToolTip>
                </Border.ToolTip>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <!-- TEMPLATE-A Header: name (left) + VALUE (top right) -->
                  <Grid Grid.Row="0" Margin="10,7,10,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Image Width="14" Height="14" Margin="0,0,5,0" Opacity="0.7" Source="{DynamicResource Icon.Cpu}"/>
                      <TextBlock Text="CPU" FontSize="{StaticResource FontSizeS}" FontWeight="Bold" Opacity="0.65"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                      <TextBlock x:Name="TxtDashCpuMaxMhz" Text="" FontSize="{StaticResource FontSizeXS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75"
                                 VerticalAlignment="Center" Margin="5,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock x:Name="TxtDashCpuPct" Text="—" Style="{StaticResource DashHeroValueStyle}"
                                 Foreground="{DynamicResource AccentBrush}"/>
                      <TextBlock Text="%" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" Margin="1,0,0,0"/>
                    </StackPanel>
                  </Grid>
                  <!-- Chart — gets the whole * row (taller) -->

                  <!-- TEMPLATE-A Footer: spec (left) + STATE (bottom right) -->
                  <Grid Grid.Row="2" Margin="10,1,10,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtCpuDashSpec" Text="—" FontSize="{StaticResource FontSizeS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center" Margin="6,0,0,0"
                               Background="{Binding ElementName=CpuStatusText, Path=Foreground, Converter={StaticResource ForegroundToPillBg}}">
                               <TextBlock x:Name="CpuStatusText" Text="Ok" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                                          Foreground="{DynamicResource StatusSuccessBrush}"/>
                             </Border>
                    <!-- stubs kept for code -->
                    <TextBlock x:Name="TxtDashCpuMinMax2" Text="" Visibility="Collapsed"/>
                    <Border x:Name="CpuStatusPill" Visibility="Collapsed"><TextBlock/></Border>
                    <Border x:Name="DashThrottleBadge" Visibility="Collapsed"
                            Background="{DynamicResource StatusCritBgBrush}"
                            CornerRadius="4" Padding="6,2" HorizontalAlignment="Right">
                      <TextBlock x:Name="TxtDashThrottleLabel"
                                 Text="⚠ BD PROCHOT" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource StatusCritBrush}"
                                 ToolTip="CPU throttled."/>
                    </Border>
                  </Grid>
                </Grid>
              </Border>

              <!-- ── GPU ── -->
              <Border Grid.Column="2" Style="{StaticResource DashClickCardStyle}"
                      MouseLeftButtonUp="DashCpu_Click">
                <Border.ToolTip>
                  <ToolTip>
                    <StackPanel MinWidth="180">
                      <TextBlock Text="GPU Details" FontWeight="Bold" FontSize="{StaticResource FontSizeS}" Margin="0,0,0,5"/>
                      <TextBlock x:Name="TxtDashGpuTooltip" Text="Loading..." FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </ToolTip>
                </Border.ToolTip>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid Grid.Row="0" Margin="10,7,10,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Image Width="14" Height="14" Margin="0,0,5,0" Opacity="0.7" Source="{DynamicResource Icon.Gpu}"/>
                      <TextBlock Text="GPU" FontSize="{StaticResource FontSizeS}" FontWeight="Bold" Opacity="0.65"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                      <TextBlock x:Name="TxtGpuVramSpec" Text="" FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75"
                                 VerticalAlignment="Center" Margin="5,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock x:Name="TxtDashGpuPct" Text="—" Style="{StaticResource DashHeroValueStyle}"
                                 Foreground="{DynamicResource AccentBrush}"/>
                      <TextBlock Text="%" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" Margin="1,0,0,0"/>
                    </StackPanel>
                  </Grid>

                  <Grid Grid.Row="2" Margin="10,1,10,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtGpuDash" Text="—" FontSize="{StaticResource FontSizeS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Border Grid.Column="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center" Margin="6,0,0,0"
                               Background="{Binding ElementName=GpuStatusText, Path=Foreground, Converter={StaticResource ForegroundToPillBg}}">
                               <TextBlock x:Name="GpuStatusText" Text="Idle" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                                          Foreground="{DynamicResource TextSecondaryBrush}"/>
                             </Border>
                    <!-- stubs pastrate -->
                    <TextBlock x:Name="TxtDashGpuVram2" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtDashGpuEncode" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtDashGpuDecode" Visibility="Collapsed"/>
                    <Border x:Name="GpuStatusPill" Visibility="Collapsed"><TextBlock/></Border>
                  </Grid>
                </Grid>
              </Border>

              <!-- ── RAM ── -->
              <Border Grid.Column="4" Style="{StaticResource DashClickCardStyle}"
                      MouseLeftButtonUp="DashRam_Click">
                <Border.ToolTip>
                  <ToolTip>
                    <StackPanel MinWidth="180">
                      <TextBlock Text="RAM Details" FontWeight="Bold" FontSize="{StaticResource FontSizeS}" Margin="0,0,0,5"/>
                      <TextBlock x:Name="TxtDashRamTooltip" Text="Loading..." FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </ToolTip>
                </Border.ToolTip>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid Grid.Row="0" Margin="10,7,10,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Image Width="14" Height="14" Margin="0,0,5,0" Opacity="0.7" Source="{DynamicResource Icon.Ram}"/>
                      <TextBlock Text="RAM" FontSize="{StaticResource FontSizeS}" FontWeight="Bold" Opacity="0.65"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                      <TextBlock x:Name="TxtRamTypeLabel" Text="" FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75"
                                 VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock x:Name="TxtDashRamPct" Text="—" Style="{StaticResource DashHeroValueStyle}"
                                 Foreground="{DynamicResource AccentBrush}"/>
                      <TextBlock Text="%" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource AccentBrush}"
                                 VerticalAlignment="Center" Margin="1,0,0,0"/>
                    </StackPanel>
                  </Grid>

                  <Grid Grid.Row="2" Margin="10,1,10,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock x:Name="TxtDashRamUsed" Text="—" FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.80"/>
                      <TextBlock x:Name="TxtRamDashSub" Text=" / 8 GB" FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.80"/>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center" Margin="6,0,0,0"
                               Background="{Binding ElementName=RamStatusText, Path=Foreground, Converter={StaticResource ForegroundToPillBg}}">
                               <TextBlock x:Name="RamStatusText" Text="Ok" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                                          Foreground="{DynamicResource StatusSuccessBrush}"/>
                             </Border>
                    <!-- stubs pastrate -->
                    <TextBlock x:Name="TxtDashRamFreq2" Visibility="Collapsed"/>
                    <Border x:Name="RamStatusPill" Visibility="Collapsed"><TextBlock/></Border>
                  </Grid>
                </Grid>
              </Border>

              <!-- ── DISK I/O ── -->
              <Border Grid.Column="6" Style="{StaticResource DashClickCardStyle}"
                      MouseLeftButtonUp="DashDisk_Click">
                <Border.ToolTip>
                  <ToolTip>
                    <StackPanel MinWidth="160">
                      <TextBlock Text="Disk I/O" FontWeight="Bold" FontSize="{StaticResource FontSizeS}" Margin="0,0,0,4"/>
                      <TextBlock x:Name="TxtDashDiskTooltip" Text="" FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </ToolTip>
                </Border.ToolTip>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid Grid.Row="0" Margin="10,7,10,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Image Width="14" Height="14" Margin="0,0,5,0" Opacity="0.7" Source="{DynamicResource Icon.Disk}"/>
                      <TextBlock Text="DISK I/O" FontSize="{StaticResource FontSizeS}" FontWeight="Bold" Opacity="0.65"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                      <TextBlock x:Name="TxtStorageSub" Text="" FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75"
                                 VerticalAlignment="Center" Margin="5,0,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <!-- Legend removed — R/W now labeled directly in the value text -->
                    <StackPanel Grid.Column="1" Visibility="Collapsed"/>
                    <!-- The main VALUE (top right) = activity -->
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock x:Name="TxtDashDiskR" Text="R —" FontSize="{StaticResource FontSizeXL}" FontWeight="Bold"
                                 Foreground="{DynamicResource ChartGreenBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text=" · " FontSize="{StaticResource FontSizeL}" Opacity="0.5"
                                 Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                      <TextBlock x:Name="TxtDashDiskW" Text="W —" FontSize="{StaticResource FontSizeXL}" FontWeight="Bold"
                                 Foreground="{DynamicResource ChartOrangeBrush}" VerticalAlignment="Center"/>
                      <TextBlock x:Name="TxtDashDiskTotal" Text="—" Visibility="Collapsed"/>
                      <TextBlock x:Name="TxtDashDiskActivity" Text="—" Visibility="Collapsed"/>
                    </StackPanel>
                  </Grid>

                  <Grid Grid.Row="2" Margin="10,1,10,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock x:Name="TxtStorageDash" Text="—" FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75"
                                 TextTrimming="CharacterEllipsis"/>
                      <TextBlock x:Name="TxtDashDiskRLbl" Text="R —" Visibility="Collapsed"/>
                      <TextBlock x:Name="TxtDashDiskWLbl" Text="W —" Visibility="Collapsed"/>
                    </StackPanel>
                    <Border Grid.Column="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center" Margin="6,0,0,0"
                               Background="{Binding ElementName=DiskStatusText, Path=Foreground, Converter={StaticResource ForegroundToPillBg}}">
                               <TextBlock x:Name="DiskStatusText" Text="Idle" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                                          Foreground="{DynamicResource TextSecondaryBrush}"/>
                             </Border>
                    <!-- stubs pastrate -->
                    <TextBlock x:Name="TxtDashDiskPct" Visibility="Collapsed"/>
                    <Border x:Name="DiskStatusPill" Visibility="Collapsed"><TextBlock/></Border>
                  </Grid>
                </Grid>
              </Border>
            </Grid>

            <!-- ══ ROW 2 — Live cards: CPU Temp · GPU Temp · Network · Ping ══════ -->
            <Grid Grid.Row="2" Margin="0,0,0,5">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
