                  <ToolTip>
                    <StackPanel MinWidth="180">
                      <TextBlock Text="GPU Temperature" FontWeight="Bold" FontSize="{StaticResource FontSizeS}" Margin="0,0,0,5"/>
                      <TextBlock x:Name="TxtDashGpuTempTooltip" Text="Loading..." FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </ToolTip>
                </Border.ToolTip>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid Grid.Row="0" Margin="10,7,10,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Image Width="14" Height="14" Margin="0,0,5,0" Opacity="0.7" Source="{DynamicResource Icon.Thermal}"/>
                      <TextBlock Text="GPU TEMP" FontSize="{StaticResource FontSizeS}" FontWeight="Bold" Opacity="0.65"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                      <TextBlock x:Name="TxtDashGpuTempRange" Text="" FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75"
                                 VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock x:Name="TxtDashGpuTempBig" Text="—" Style="{StaticResource DashHeroValueStyle}"
                                 Foreground="{DynamicResource ChartOrangeBrush}"/>
                      <TextBlock Text="{DynamicResource TempUnitSymbol}" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource ChartOrangeBrush}"
                                 VerticalAlignment="Center" Margin="0,0,0,0"/>
