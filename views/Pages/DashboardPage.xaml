                               <TextBlock x:Name="TxtDashPingStatus" Text="—" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                                          Foreground="{DynamicResource StatusSuccessBrush}"/>
                             </Border>
                  </Grid>
