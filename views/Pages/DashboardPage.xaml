                                 VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock x:Name="TxtDashPingMs" Text="—" Style="{StaticResource DashHeroValueStyle}"
