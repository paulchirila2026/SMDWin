                  <ToolTip>
                    <StackPanel MinWidth="180">
                      <TextBlock Text="Ping Statistics" FontWeight="Bold" FontSize="{StaticResource FontSizeS}" Margin="0,0,0,5"/>
                      <TextBlock x:Name="TxtDashPingTooltip" Text="Loading..." FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </ToolTip>
