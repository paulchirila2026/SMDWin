                </Grid>
              </Border>
            </Grid>

            <!-- ══ ROW 3 — Hardware · Storage · Network · Windows ══════════════════ -->
            <!-- The bottom sections in a 2×2 grid — each section breathes, has its own title, easier to scan than 4 cramped columns.
                 Layout: [Hardware | Storage] / [Network | Windows]. -->
            <!-- ═══ DASHBOARD INVENTORY ═══════════════════════
                 Layout 2×2: [Hardware | Storage] / [Network | System].
                 Tipografie unificata (InvSectionHeader / InvGroupLabel / InvRowLabel /
                 InvRowValue) + separatoare subtile → aspect de inventar HWInfo/Speccy. -->
            <Grid Grid.Row="3" Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="6"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- ══════════════ HARDWARE (top left) ══════════════ -->
              <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource DashClickCardStyle}"
                      x:Name="BorderDashHardwareCard" MouseLeftButtonUp="DashHardware_Click" ToolTip="Click for details">
                <StackPanel Margin="14,9,14,9">
                  <!-- Header: icon monitor + titlu + model masina -->
                  <Grid Margin="0,0,0,6">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="24" Height="24" CornerRadius="8"
                              Background="{DynamicResource AccentLightBrush}" Margin="0,0,8,0">
                        <!-- Icon: monitor desktop -->
                        <Path Width="12" Height="12" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Fill="{DynamicResource AccentBrush}" Data="F1 M6.75,22 A0.75,0.75 0 0 1 6.65,20.5 L8.5,20.5 L8.5,18 L4.25,18 C3.05,18 2.08,17.08 2.01,15.9 L2,15.76 L2,5.25 C2,4.05 2.93,3.08 4.1,3.01 L4.25,3 L19.75,3 C20.94,3 21.91,3.93 21.99,5.1 L21.99,15.75 C21.99,16.95 21.07,17.92 19.9,18 L15.5,18 L15.5,20.5 L17.25,20.5 A0.75,0.75 0 0 1 17.35,22 L6.75,22 M14,18 L10,18 L10,20.5 L14,20.5 Z M19.75,4.5 L4.25,4.5 C3.87,4.5 3.55,4.78 3.51,5.15 L3.5,5.25 L3.5,15.75 C3.5,16.13 3.78,16.45 4.15,16.5 L19.75,16.5 C20.13,16.5 20.45,16.22 20.49,15.85 L20.49,5.25 C20.49,4.87 20.22,4.55 19.85,4.51 Z"/>
                      </Border>
                      <TextBlock Text="HARDWARE" Style="{StaticResource InvSectionHeader}"/>
                    </StackPanel>
                    <!-- Machine model, visible and large -->
                    <TextBlock x:Name="TxtHardwareStripPcName" Text="" FontSize="{StaticResource FontSizeXL}" FontWeight="SemiBold"
                               HorizontalAlignment="Right" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               TextTrimming="CharacterEllipsis" MaxWidth="340"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                  </Grid>
                  <Border Style="{StaticResource InvSeparator}" Margin="0,0,0,8"/>

                  <!-- 2 coloane: CPU+Memory | Graphics+Motherboard -->
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="14"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- ─── Left column: Processor + Memory ─── -->
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="PROCESSOR" Style="{StaticResource InvGroupLabel}"/>
                      <TextBlock x:Name="TxtCpuDashSpec2" Text="—" Style="{StaticResource InvPrimaryValue}"/>
