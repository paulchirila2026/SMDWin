                                 Foreground="{DynamicResource WarnAmberBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Grid>

                  <Grid Grid.Row="2" Margin="10,1,10,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- DashNetMiniChart (Height=0, Collapsed) era cod mort —
                         nereferentiat nicaieri in code-behind. Eliminat. -->
                    <TextBlock x:Name="TxtDashNetIp" Text="" Visibility="Collapsed"/>
                    <Border Grid.Column="1" CornerRadius="4" Padding="7,2" VerticalAlignment="Center" Margin="6,0,0,0"
                               Background="{Binding ElementName=TxtDashNetStatus, Path=Foreground, Converter={StaticResource ForegroundToPillBg}}">
                               <TextBlock x:Name="TxtDashNetStatus" Text="—" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                                          Foreground="{DynamicResource StatusSuccessBrush}"/>
                             </Border>
                  </Grid>
                </Grid>
              </Border>

              <!-- ── PING ── -->
              <Border x:Name="DashPingCard" Grid.Column="6" Style="{StaticResource DashClickCardStyle}"
                      MouseLeftButtonUp="DashPing_Click">
