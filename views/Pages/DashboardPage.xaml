                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- Card 2: Top proces CPU -->
              <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14,11">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Border Grid.Column="0" Width="40" Height="40" CornerRadius="8" Margin="0,0,12,0"
                          Background="{DynamicResource BgHoverBrush}" VerticalAlignment="Center">
                    <Viewbox Width="20" Height="20">
                      <Canvas Width="24" Height="24">
                        <Path Fill="#4B7AB5" Data="F1 M15.25,2 C15.63,2 15.95,2.28 15.99,2.65 L16,2.75 L16,5.08 A3.8,3.8 0 0 1 18.93,8 L21.25,8 A0.75,0.75 0 0 1 21.35,9.5 L19,9.5 L19,11.25 L21.25,11.25 C21.63,11.25 21.95,11.53 21.99,11.9 L22,12 C22,12.38 21.72,12.7 21.35,12.74 L21.25,12.75 L19,12.75 L19,14.5 L21.25,14.5 C21.63,14.5 21.95,14.78 21.99,15.15 L22,15.25 C22,15.63 21.72,15.95 21.35,15.99 L21.25,16 L18.92,16 A3.8,3.8 0 0 1 16,18.92 L16,21.25 A0.75,0.75 0 0 1 14.5,21.35 L14.5,19 L12.75,19 L12.75,21.25 C12.75,21.63 12.47,21.95 12.1,21.99 L12,22 A0.75,0.75 0 0 1 11.26,21.35 L11.25,21.25 L11.25,19 L9.5,19 L9.5,21.25 C9.5,21.63 9.22,21.95 8.85,21.99 L8.75,22 A0.75,0.75 0 0 1 8.01,21.35 L8,21.25 L8,18.93 A3.8,3.8 0 0 1 5.08,16 L2.75,16 A0.75,0.75 0 0 1 2.65,14.5 L5,14.5 L5,12.75 L2.75,12.75 A0.75,0.75 0 0 1 2.01,12.1 L2,12 C2,11.62 2.28,11.3 2.65,11.26 L2.75,11.25 L5,11.25 L5,9.5 L2.75,9.5 A0.75,0.75 0 0 1 2.01,8.85 L2,8.75 C2,8.37 2.28,8.05 2.65,8.01 L2.75,8 L5.08,8 A3.8,3.8 0 0 1 8,5.07 L8,2.75 A0.75,0.75 0 0 1 9.5,2.65 L9.5,5 L11.25,5 L11.25,2.75 C11.25,2.37 11.53,2.05 11.9,2.01 L12,2 C12.38,2 12.7,2.28 12.74,2.65 L12.75,2.75 L12.75,5 L14.5,5 L14.5,2.75 C14.5,2.4 14.73,2.11 15.05,2.03 L15.15,2.01 Z M15.25,6.5 L8.75,6.5 C7.51,6.5 6.5,7.5 6.5,8.75 L6.5,15.25 C6.5,16.49 7.5,17.5 8.75,17.5 L15.25,17.5 C16.49,17.5 17.5,16.5 17.5,15.25 L17.5,8.75 C17.5,7.51 16.5,6.5 15.25,6.5 M12,9 A3,3 0 0 1 12,15 A3,3 0 0 1 12,9 M12,10.5 A1.5,1.5 0 0 0 12,13.5 A1.5,1.5 0 0 0 12,10.5"/>
