                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                    <!-- state: a Windows-style mark (tick / ! / i in a filled circle) and the word, no pill behind it -->
                    <Grid VerticalAlignment="Center" Visibility="{Binding Text, ElementName=TxtDashWinCrash, Converter={StaticResource DashFactVis}}">
                      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <local:StatusMark Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Foreground, ElementName=TxtDashWinCrash}"/>
                        <TextBlock Text="{Binding Text, ElementName=TxtDashWinCrash}" Foreground="{Binding Foreground, ElementName=TxtDashWinCrash, Converter={StaticResource NeutralUnlessAlert}}" Style="{StaticResource CompStatusText}"/>
                      </StackPanel>
                    </Grid>
                    <Path Style="{StaticResource DashChevron}" Margin="10,0,0,0" ToolTip="Opens Windows Info in a new window"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <!-- the component icon on a soft tile in the component colour -->
                    <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource CompOsTileBrush}" VerticalAlignment="Center" Margin="0,0,11,0">
                      <Viewbox Width="17" Height="17">
                        <Path Width="24" Height="24" Style="{StaticResource CompIcon}" Fill="{DynamicResource CompOsBrush}" Data="F1 M6.75,22 A0.75,0.75 0 0 1 6.65,20.5 L8.5,20.5 L8.5,18 L4.25,18 C3.05,18 2.08,17.08 2.01,15.9 L2,15.76 L2,5.25 C2,4.05 2.93,3.08 4.1,3.01 L4.25,3 L19.75,3 C20.94,3 21.91,3.93 21.99,5.1 L21.99,15.75 C21.99,16.95 21.07,17.92 19.9,18 L15.5,18 L15.5,20.5 L17.25,20.5 A0.75,0.75 0 0 1 17.35,22 L6.75,22 M14,18 L10,18 L10,20.5 L14,20.5 Z M19.75,4.5 L4.25,4.5 C3.87,4.5 3.55,4.78 3.51,5.15 L3.5,5.25 L3.5,15.75 C3.5,16.13 3.78,16.45 4.15,16.5 L19.75,16.5 C20.13,16.5 20.45,16.22 20.49,15.85 L20.49,5.25 C20.49,4.87 20.22,4.55 19.85,4.51 Z"/>
                      </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Text, ElementName=TxtHeroOsLine}" Style="{StaticResource DashRowName}" ToolTip="System" Tag="Windows" Cursor="Hand" MouseLeftButtonUp="DashName_Click"/>
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,2,0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource CompValue}" FontSize="31" LineHeight="33" HorizontalAlignment="Center" Text="{Binding Text, ElementName=TxtOsBuildV, Converter={StaticResource DashOsVer}, ConverterParameter=ver}"/>
                    <TextBlock Style="{StaticResource CompSub}" HorizontalAlignment="Center" Text="{Binding Text, ElementName=TxtOsBuildV, Converter={StaticResource DashOsVer}, ConverterParameter=build}"/>
                  </StackPanel>
                  <UniformGrid Grid.Column="1" Columns="3" Margin="8,0,0,0" VerticalAlignment="Center">
                    <StackPanel Margin="0,0,16,6" Visibility="{Binding Text, ElementName=TxtDashInstallV, Converter={StaticResource DashFactVis}}">
                      <TextBlock Text="Installed" Style="{StaticResource CompFootKey}"/>
                      <TextBlock Text="{Binding Text, ElementName=TxtDashInstallV, Converter={StaticResource DashShortDate}}" Style="{StaticResource CompInfoVal}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,6" Visibility="{Binding Text, ElementName=TxtDashLastUpdateV, Converter={StaticResource DashFactVis}}">
                      <TextBlock Text="Last update" Style="{StaticResource CompFootKey}"/>
                      <TextBlock Text="{Binding Text, ElementName=TxtDashLastUpdateV, Converter={StaticResource DashShortDate}}" Style="{StaticResource CompInfoVal}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,6" Visibility="{Binding Text, ElementName=TxtUptimeV, Converter={StaticResource DashFactVis}}">
                      <TextBlock Text="Uptime" Style="{StaticResource CompFootKey}"/>
                      <TextBlock Text="{Binding Text, ElementName=TxtUptimeV}" Style="{StaticResource CompInfoVal}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,6" Visibility="{Binding Text, ElementName=TxtDashComputerV, Converter={StaticResource DashFactVis}}">
                      <TextBlock Text="Computer" Style="{StaticResource CompFootKey}"/>
                      <TextBlock Text="{Binding Text, ElementName=TxtDashComputerV}" Style="{StaticResource CompInfoVal}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,6" Visibility="{Binding Text, ElementName=TxtDashWorkgroupV, Converter={StaticResource DashFactVis}}">
                      <TextBlock Text="Workgroup" Style="{StaticResource CompFootKey}"/>
                      <TextBlock Text="{Binding Text, ElementName=TxtDashWorkgroupV}" Style="{StaticResource CompInfoVal}" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                    </StackPanel>
                    <StackPanel Margin="0,0,16,6" Visibility="{Binding Text, ElementName=TxtDashArchV, Converter={StaticResource DashFactVis}}">
                      <TextBlock Text="Architecture" Style="{StaticResource CompFootKey}"/>
                      <TextBlock Text="{Binding Text, ElementName=TxtDashArchV}" Style="{StaticResource CompInfoVal}"/>
                    </StackPanel>
                  </UniformGrid>
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource CompFootBand}">
                  <UniformGrid Columns="4">
                    <Border Style="{StaticResource CompFootCellFirst}">
                      <StackPanel>
                        <TextBlock Text="License" Style="{StaticResource CompFootKey}"/>
                        <TextBlock Text="{Binding Text, ElementName=TxtDashLicenseV}" Foreground="{Binding Foreground, ElementName=TxtDashLicenseV}" Style="{StaticResource CompFootVal}"/>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CompFootCell}">
                      <StackPanel>
                        <TextBlock Text="Boot mode" Style="{StaticResource CompFootKey}"/>
                        <TextBlock Text="{Binding Text, ElementName=TxtDashBootModeV}" Foreground="{Binding Foreground, ElementName=TxtDashBootModeV}" Style="{StaticResource CompFootVal}"/>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CompFootCell}">
                      <StackPanel>
                        <TextBlock Text="Secure Boot" Style="{StaticResource CompFootKey}"/>
                        <TextBlock Text="{Binding Text, ElementName=TxtDashSecureBootV}" Foreground="{Binding Foreground, ElementName=TxtDashSecureBootV}" Style="{StaticResource CompFootVal}"/>
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CompFootCell}">
                      <StackPanel>
                        <TextBlock Text="TPM" Style="{StaticResource CompFootKey}"/>
                        <TextBlock Text="{Binding Text, ElementName=TxtDashTpmV}" Foreground="{Binding Foreground, ElementName=TxtDashTpmV}" Style="{StaticResource CompFootVal}"/>
                      </StackPanel>
                    </Border>
                  </UniformGrid>
                </Border>
              </Grid>
            </Border>

            <!-- Battery: a single strip (laptop only) — percentage, charge bar, 4 facts on the same row -->
            <Border x:Name="DashBatRow" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CompCardStyle}" Padding="18,12,18,12"
                    MouseLeftButtonUp="DashBattery_Click" ToolTip="Open Power" Visibility="Collapsed">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*" MinWidth="120"/>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,22,0">
                  <!-- the component icon on a soft tile in the component colour -->
                  <Border Width="30" Height="30" CornerRadius="9" Background="{DynamicResource CompOsTileBrush}" VerticalAlignment="Center" Margin="0,0,11,0">
                    <Viewbox Width="17" Height="17">
                      <Path Width="24" Height="24" Style="{StaticResource CompIcon}" Fill="{DynamicResource CompOsBrush}" Data="F1 M17,6 A3,3 0 0 1 20,9 L20,10 L21,10 A1,1 0 0 1 22,11 L22,13 A1,1 0 0 1 21,14 L20,14 L20,15 A3,3 0 0 1 17,18 L5,18 A3,3 0 0 1 2,15 L2,9 A3,3 0 0 1 5,6 Z M17,7.5 L5,7.5 C4.22,7.5 3.58,8.1 3.5,8.86 L3.5,15 C3.5,15.78 4.1,16.42 4.86,16.5 L17,16.5 C17.78,16.5 18.42,15.9 18.5,15.14 L18.5,9 C18.5,8.22 17.9,7.58 17.14,7.5 Z"/>
                    </Viewbox>
                  </Border>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtDashBatRowSource" Text="" Style="{StaticResource DashRowName}" ToolTip="Battery" Tag="Battery" Cursor="Hand" MouseLeftButtonUp="DashName_Click"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
                  <TextBlock x:Name="TxtDashBatRowPct" Text="" FontFamily="{StaticResource NumFont}" FontSize="26" FontWeight="SemiBold" VerticalAlignment="Center"/>
                  <TextBlock Text="%" FontFamily="{StaticResource NumFont}" FontSize="15" Margin="1,5,0,0" VerticalAlignment="Center" Foreground="{Binding Foreground, ElementName=TxtDashBatRowPct}"/>
                  <!-- the dial stays for code, it is no longer shown -->
                  <local:PercentGauge x:Name="DashGaugeBat" ShowValue="False" Segments="20" WarnAt="101" CritAt="101" Visibility="Collapsed"/>
                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,22,0">
                  <Grid Height="6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition x:Name="DashBatFillCol" Width="0*"/>
                      <ColumnDefinition x:Name="DashBatRestCol" Width="100*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.ColumnSpan="2" CornerRadius="3" Background="{DynamicResource BorderBrush2}"/>
                    <Border x:Name="DashBatFill" CornerRadius="3" Background="{DynamicResource DataBrush}"/>
                  </Grid>
                  <TextBlock x:Name="TxtDashBatRowTime" Text="" Style="{StaticResource CompSub}" Margin="0,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                  <StackPanel Margin="0,0,22,0" Visibility="{Binding Text, ElementName=TxtDashBatHealth, Converter={StaticResource DashFactVis}}">
                    <TextBlock Text="Health" Style="{StaticResource CompFootKey}"/>
                    <TextBlock Text="{Binding Text, ElementName=TxtDashBatHealth}" Foreground="{Binding Foreground, ElementName=TxtDashBatHealth}" Style="{StaticResource CompFootVal}"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,22,0" Visibility="{Binding Text, ElementName=TxtDashPowerPlan, Converter={StaticResource DashFactVis}}">
                    <TextBlock Text="Power plan" Style="{StaticResource CompFootKey}"/>
                    <!-- written from code (MainWindow.Battery.cs), not bound to the Power page: the pages are separate controls -->
                    <TextBlock x:Name="TxtDashPowerPlan" Text="" Style="{StaticResource CompFootVal}"/>
                  </StackPanel>
                  <StackPanel Margin="0,0,22,0" Visibility="{Binding Text, ElementName=TxtDashBatRowPlug, Converter={StaticResource DashFactVis}}">
                    <TextBlock Text="Power source" Style="{StaticResource CompFootKey}"/>
                    <TextBlock x:Name="TxtDashBatRowPlug" Text="" Style="{StaticResource CompFootVal}"/>
                  </StackPanel>
                  <!-- the remaining time is already under the bar (TxtDashBatRowTime) — here it would appear a second time -->
                  <StackPanel Margin="0,0,22,0" Visibility="Collapsed">
                    <TextBlock Text="Time left" Style="{StaticResource CompFootKey}"/>
                    <TextBlock x:Name="TxtDashBatRowLeft" Text="" Style="{StaticResource CompFootVal}"/>
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                  <local:StatusMark Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Foreground, ElementName=TxtDashBatRowStatus}" Visibility="{Binding Text, ElementName=TxtDashBatRowStatus, Converter={StaticResource HasTextVis}}"/>
                  <TextBlock x:Name="TxtDashBatRowStatus" Text="" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/>
                  <TextBlock Text="{Binding Text, ElementName=TxtDashBatRowStatus}" Foreground="{Binding Foreground, ElementName=TxtDashBatRowStatus, Converter={StaticResource NeutralUnlessAlert}}" Style="{StaticResource CompStatusText}"/>
                  <Path Style="{StaticResource DashChevron}" Margin="10,0,0,0" ToolTip="Open Power"/>
                </StackPanel>
              </Grid>
            </Border>
            </Grid>
            <!-- Fields kept only for code (the former "Activity" row) -->
            <StackPanel Visibility="Collapsed">
              <TextBlock x:Name="TxtDashProcCount"/>
              <StackPanel x:Name="DashTopCpuList"/>
              <StackPanel x:Name="DashTopRamList"/>
              <StackPanel x:Name="DashRamTopList"/>
            </StackPanel>
          </Grid>
          </ScrollViewer>

        </Grid>
</UserControl>
