                               Background="{Binding ElementName=GpuTempPillText, Path=Foreground, Converter={StaticResource ForegroundToPillBg}}">
                               <TextBlock x:Name="GpuTempPillText" Text="—" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                                          Foreground="{DynamicResource TextSecondaryBrush}"/>
                             </Border>
                    <!-- stubs pastrate -->
                    <TextBlock x:Name="TxtCpuCache" Visibility="Collapsed"/>
                    <TextBlock x:Name="TxtDashGpuMinMax" Visibility="Collapsed"/>
                    <Border x:Name="GpuTempPill" Visibility="Collapsed"><TextBlock/></Border>
                  </Grid>
                </Grid>
              </Border>

              <!-- ── NETWORK ── -->
              <Border Grid.Column="4" Style="{StaticResource DashClickCardStyle}"
                      MouseLeftButtonUp="DashNet_Click">
