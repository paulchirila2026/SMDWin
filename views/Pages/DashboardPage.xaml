                  </Grid>

                  <Grid Grid.Row="2" Margin="10,1,10,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtDashPingAvgMax" Text="" FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6"
                               VerticalAlignment="Center"/>
