                      </Viewbox>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="{Binding Text, ElementName=TxtCpuDashSpec2, Converter={StaticResource DashTempConv}, ConverterParameter=cpu}" Style="{StaticResource DashRowName}" Tag="Cpu" Cursor="Hand" MouseLeftButtonUp="DashName_Click" ToolTip="{Binding Text, ElementName=TxtCpuDashSpec2}"/>
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,2,0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                  <Viewbox Style="{StaticResource CompDialBox}">
                    <Grid Style="{StaticResource CompDialGrid}">
                      <local:PercentGauge x:Name="DashGaugeCpu" ShowValue="False" Segments="20"/>
                      <StackPanel Style="{StaticResource CompDialText}">
                        <TextBlock Style="{StaticResource CompDialUnitGhost}"/>
                        <TextBlock Style="{StaticResource CompDialValue}" x:Name="TxtDialCpu" Text="{Binding Text, ElementName=TxtDashCpuPct, Mode=OneTime}"/>
                        <TextBlock Style="{StaticResource CompDialUnit}"/>
                      </StackPanel>
                      <TextBlock Style="{StaticResource CompDialSub}" Text="load"/>
                      <TextBlock x:Name="DashRangeCpu" Style="{StaticResource CompDialRange}"/>
                    </Grid>
                  </Viewbox>
                  <Grid Grid.Column="1" MaxHeight="240" Margin="8,0,0,0">
                    <!-- the load chart is hidden: the dial already shows the load; the temperature chart stays -->
                    <Grid.ColumnDefinitions><ColumnDefinition Width="0"/><ColumnDefinition Width="0"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <ContentControl Grid.Column="0" Focusable="False" Visibility="Collapsed"><Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                      <DockPanel Style="{StaticResource DashCompChartHead}">
                        <TextBlock x:Name="DashLoadLabelCpu" Text="Load" Style="{StaticResource DashChartLabel}" VerticalAlignment="Bottom"/>
                      </DockPanel>
                      <Border x:Name="SparkCpuFrame" Grid.Row="1" Margin="0,3,0,0" BorderThickness="0" SnapsToDevicePixels="True">
                        <Canvas x:Name="SparkCpu" MinHeight="38" ClipToBounds="True" Background="Transparent"
                              SizeChanged="SparkCpu_SizeChanged" MouseMove="DashChart_MouseMove" MouseLeave="DashChart_MouseLeave"
                              ContextMenu="{StaticResource DashChartMenu}"/>
                      </Border>
                    </Grid></ContentControl>
                    <ContentControl Grid.Column="2" Focusable="False"><Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                      <DockPanel Style="{StaticResource DashCompChartHead}">
                        <TextBlock Style="{StaticResource DashChartLabel}" Text="Temperature" VerticalAlignment="Bottom"/>
                        <TextBlock Style="{StaticResource DashCompChartValue}"
                                   Foreground="{Binding Foreground, ElementName=TxtDashCpuTempBig}"
                                   x:Name="TxtDialCpuTemp" Text="{Binding Text, ElementName=TxtDashCpuTempBig, Converter={StaticResource DashTempConv}, Mode=OneTime}"/>
                      </DockPanel>
                      <!-- in the first seconds the chart is almost empty — a discreet note, until the data is collected -->
                      <TextBlock x:Name="TxtDashCpuCollecting" Grid.Row="1" Text="Collecting data…" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"
                                 Opacity="0.7" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,3,0,0" IsHitTestVisible="False" Visibility="Collapsed"/>
                      <Border x:Name="DashCpuTempChartFrame" Grid.Row="1" Margin="0,3,0,0" BorderThickness="0" SnapsToDevicePixels="True">
                        <Canvas x:Name="DashCpuTempChart" MinHeight="38" ClipToBounds="True" Background="Transparent"
