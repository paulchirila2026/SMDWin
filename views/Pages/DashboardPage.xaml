                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock x:Name="TxtDashNetDown" Text="↓ —" FontSize="{StaticResource FontSizeXL}" FontWeight="Bold"
