                  <ToolTip>
                    <StackPanel MinWidth="180">
                      <TextBlock Text="CPU Temperature" FontWeight="Bold" FontSize="{StaticResource FontSizeS}" Margin="0,0,0,5"/>
                      <TextBlock x:Name="TxtDashCpuTempTooltip" Text="Loading..." FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                  </ToolTip>
                </Border.ToolTip>
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                  </Grid.RowDefinitions>
                  <Grid Grid.Row="0" Margin="10,7,10,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Image Width="14" Height="14" Margin="0,0,5,0" Opacity="0.7" Source="{DynamicResource Icon.Thermal}"/>
                      <TextBlock Text="CPU TEMP" FontSize="{StaticResource FontSizeS}" FontWeight="Bold" Opacity="0.65"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                      <TextBlock x:Name="TxtDashCpuTempRange" Text="" FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75"
                                 VerticalAlignment="Center" Margin="5,0,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock x:Name="TxtDashCpuTempBig" Text="N/A" Style="{StaticResource DashHeroValueStyle}"
                                 Foreground="{DynamicResource StatusWarningBrush}"/>
                      <TextBlock Text="{DynamicResource TempUnitSymbol}" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource StatusWarningBrush}"
                                 VerticalAlignment="Center" Margin="0,0,0,0"/>
                    </StackPanel>
                  </Grid>

                  <Grid Grid.Row="2" Margin="10,1,10,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="TxtCpuCores" Text="—" FontSize="{StaticResource FontSizeS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75"
                               VerticalAlignment="Center"/>
