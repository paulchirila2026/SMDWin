                               Background="{Binding ElementName=CpuTempPillText, Path=Foreground, Converter={StaticResource ForegroundToPillBg}}">
                               <TextBlock x:Name="CpuTempPillText" Text="—" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                                          Foreground="{DynamicResource TextSecondaryBrush}"/>
                             </Border>
                    <!-- stubs pastrate -->
                    <TextBlock x:Name="TxtDashCpuMinMax" Visibility="Collapsed"/>
                    <Border x:Name="CpuTempPill" Visibility="Collapsed"><TextBlock/></Border>
                  </Grid>
                </Grid>
              </Border>

              <!-- ── GPU TEMP ── -->
              <Border x:Name="DashGpuTempCard" Grid.Column="2" Style="{StaticResource DashClickCardStyle}"
                      MouseLeftButtonUp="DashCpu_Click">
