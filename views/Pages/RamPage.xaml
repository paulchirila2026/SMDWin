<UserControl x:Class="SMDWin.Views.Pages.RamPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:local="clr-namespace:SMDWin.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <!-- The page logic is in the MainWindow.*.cs files: the named elements here are exposed in MainWindow as properties
       (MainWindow.Pages.cs), and the handlers are redirected below. -->
  <UserControl.Resources>
    <local:DashFactVisibilityConverter x:Key="DashFactVis"/>
  </UserControl.Resources>
        <ScrollViewer x:Name="PanelRamScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      ScrollChanged="PanelRamScroll_ScrollChanged">
        <Grid x:Name="PanelRam" Margin="{StaticResource PageMargin}" Style="{StaticResource PageFadeStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <!-- ═ ROW 0: Page title ═ -->
          <Grid Grid.Row="0" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtRamPageTitle" Text="RAM Memory" Style="{StaticResource SectionTitleStyle}"/>
                <Border x:Name="RamStressIndicator" Visibility="Collapsed"
                        Background="{DynamicResource Lift.Surface}" BorderBrush="{DynamicResource Lift.DangerBorder}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="10,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Lift.DangerText}" VerticalAlignment="Center" Margin="0,0,5,0">
                      <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                          <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.6" AutoReverse="True"/>
                            </Storyboard>
                          </BeginStoryboard>
                        </EventTrigger>
                      </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="STRESS" FontSize="{StaticResource FontSizeXS}" FontWeight="Bold" Foreground="{DynamicResource Lift.DangerText}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtRamStressTimer" Text="" FontSize="{StaticResource FontSizeXS}" FontWeight="Bold" Foreground="{DynamicResource Lift.DangerText}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <TextBlock x:Name="TxtRamPageSubtitle" Text="Modules, channels &amp; live diagnostics" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <ui:Button x:Name="BtnOpenMemDiag" Grid.Column="1" Appearance="Secondary"
                    Click="OpenMemDiag_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                    ToolTip="Open Windows Memory Diagnostic (checks Rowhammer/ECC risk on next restart)">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                  <Canvas Width="24" Height="24">
                    <Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M21.62,6.88 A3,3 0 0 0 19.5,6 L19.5,3.75 A0.75,0.75 0 0 0 18,3.75 L18,6 L15,6 L15,3.75 A0.75,0.75 0 0 0 13.5,3.75 L13.5,6 L10.5,6 L10.5,3.75 A0.75,0.75 0 0 0 9,3.75 L9,6 L6,6 L6,3.75 A0.75,0.75 0 0 0 4.5,3.75 L4.5,6 A3,3 0 0 0 1.5,9 L1.5,15 A3,3 0 0 0 4.5,18 L4.5,20.25 A0.75,0.75 0 0 0 6,20.25 L6,18 L9,18 L9,20.25 A0.75,0.75 0 0 0 10.5,20.25 L10.5,18 L13.5,18 L13.5,20.25 A0.75,0.75 0 0 0 15,20.25 L15,18 L18,18 L18,20.25 A0.75,0.75 0 0 0 19.5,20.25 L19.5,18 A3,3 0 0 0 22.5,15 L22.5,9 A3,3 0 0 0 21.62,6.88 M21,15 A1.5,1.5 0 0 1 19.5,16.5 L4.5,16.5 A1.5,1.5 0 0 1 3,15 L3,9 A1.5,1.5 0 0 1 4.5,7.5 L19.5,7.5 A1.5,1.5 0 0 1 21,9 Z M18.75,9 L5.25,9 A0.75,0.75 0 0 0 4.5,9.75 L4.5,14.25 A0.75,0.75 0 0 0 5.25,15 L18.75,15 A0.75,0.75 0 0 0 19.5,14.25 L19.5,9.75 A0.75,0.75 0 0 0 18.75,9 M18,13.5 L6,13.5 L6,10.5 L18,10.5 Z"/>
                  </Canvas>
                </Viewbox>
                <TextBlock Text="Windows Memory Diagnostic" VerticalAlignment="Center"/>
              </StackPanel>
            </ui:Button>
          </Grid>

<!-- ═ A grid of cards — usage | configuration / modules / tests | processes.
     The minimum height = the visible area (MainWindow.RamPage.cs → PanelRamScroll_SizeChangedCards). ═ -->
          <Grid x:Name="RamCardsGrid" Grid.Row="1" Margin="0,8,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="0.72*" MinWidth="300"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="1.25*"/><RowDefinition Height="12"/><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="1.05*"/>
            </Grid.RowDefinitions>
            <Border Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CompCardStyle}" Cursor="Arrow">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8" LastChildFill="True">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><local:StatusMark Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Foreground, ElementName=TxtRamLiveStatus}" Visibility="{Binding Text, ElementName=TxtRamLiveStatus, Converter={StaticResource HasTextVis}}"/>
                    <TextBlock x:Name="TxtRamLiveStatus" Text="" Foreground="{DynamicResource StatusOkBrush}" Visibility="Collapsed"/>
                    <TextBlock Text="{Binding Text, ElementName=TxtRamLiveStatus}" Foreground="{Binding Foreground, ElementName=TxtRamLiveStatus, Converter={StaticResource NeutralUnlessAlert}}" Style="{StaticResource CompStatusText}"/></StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M21.62,6.88 A3,3 0 0 0 19.5,6 L19.5,3.75 A0.75,0.75 0 0 0 18,3.75 L18,6 L15,6 L15,3.75 A0.75,0.75 0 0 0 13.5,3.75 L13.5,6 L10.5,6 L10.5,3.75 A0.75,0.75 0 0 0 9,3.75 L9,6 L6,6 L6,3.75 A0.75,0.75 0 0 0 4.5,3.75 L4.5,6 A3,3 0 0 0 1.5,9 L1.5,15 A3,3 0 0 0 4.5,18 L4.5,20.25 A0.75,0.75 0 0 0 6,20.25 L6,18 L9,18 L9,20.25 A0.75,0.75 0 0 0 10.5,20.25 L10.5,18 L13.5,18 L13.5,20.25 A0.75,0.75 0 0 0 15,20.25 L15,18 L18,18 L18,20.25 A0.75,0.75 0 0 0 19.5,20.25 L19.5,18 A3,3 0 0 0 22.5,15 L22.5,9 A3,3 0 0 0 21.62,6.88 M21,15 A1.5,1.5 0 0 1 19.5,16.5 L4.5,16.5 A1.5,1.5 0 0 1 3,15 L3,9 A1.5,1.5 0 0 1 4.5,7.5 L19.5,7.5 A1.5,1.5 0 0 1 21,9 Z M18.75,9 L5.25,9 A0.75,0.75 0 0 0 4.5,9.75 L4.5,14.25 A0.75,0.75 0 0 0 5.25,15 L18.75,15 A0.75,0.75 0 0 0 19.5,14.25 L19.5,9.75 A0.75,0.75 0 0 0 18.75,9 M18,13.5 L6,13.5 L6,10.5 L18,10.5 Z"/></Viewbox>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock x:Name="TxtRamLiveName" Text="" Style="{StaticResource DashRowName}" ToolTip="Memory usage"/>
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,4,0,12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                  <Viewbox Style="{StaticResource CompDialBox}">
                    <Grid Style="{StaticResource CompDialGrid}">
                      <local:PercentGauge x:Name="RamPageGauge" ShowValue="False" Segments="20" WarnAt="75" CritAt="90"/>
                      <StackPanel Style="{StaticResource CompDialText}">
                        <TextBlock Style="{StaticResource CompDialUnitGhost}"/>
                        <TextBlock Style="{StaticResource CompDialValue}" x:Name="TxtRamPagePct" Text=""/>
                        <TextBlock Style="{StaticResource CompDialUnit}"/>
                      </StackPanel>
                      <TextBlock Style="{StaticResource CompDialSub}" Text="in use"/>
                    </Grid>
                  </Viewbox>
                  <Grid Grid.Column="1" Margin="8,0,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <DockPanel Style="{StaticResource CompChartHead}">
                        <TextBlock Text="In use" Style="{StaticResource DashChartLabel}" VerticalAlignment="Bottom"/>
                        <TextBlock x:Name="TxtRamLiveInUse" Style="{StaticResource CompChartValue}" FontSize="18" Text=""/>
                      </DockPanel>
                      <local:MiniLineChart x:Name="RamChartInUse" Grid.Row="1" MinHeight="60" Margin="0,3,0,0"/>
                      <TextBlock x:Name="TxtRamLiveInUseNote" Grid.Row="2" Text="" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75" Margin="2,3,0,0"/>
                    </Grid>
                    <ContentControl Grid.Column="2" Focusable="False">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <DockPanel Style="{StaticResource CompChartHead}">
                        <TextBlock Text="Committed" Style="{StaticResource DashChartLabel}" VerticalAlignment="Bottom"/>
                        <TextBlock x:Name="TxtRamLiveCommit" Style="{StaticResource CompChartValue}" FontSize="18" Text=""/>
                      </DockPanel>
                      <local:MiniLineChart x:Name="RamChartCommit" Grid.Row="1" MinHeight="60" Margin="0,3,0,0"/>
                      <TextBlock x:Name="TxtRamLiveCommitNote" Grid.Row="2" Text="" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75" Margin="2,3,0,0"/>
                    </Grid>
                    </ContentControl>
                  </Grid>
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource CompFootBand}">
                  <UniformGrid Columns="4">
                    <Border Style="{StaticResource CompFootCellFirst}"><StackPanel><TextBlock Text="Available" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtRamLiveAvail" Text="" Style="{StaticResource CompFootVal}"/></StackPanel></Border>
                    <Border Style="{StaticResource CompFootCell}"><StackPanel><TextBlock Text="Cached" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtRamLiveCached" Text="" Style="{StaticResource CompFootVal}"/></StackPanel></Border>
                    <Border Style="{StaticResource CompFootCell}"><StackPanel><TextBlock Text="Page file" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtRamLivePageFile" Text="" Style="{StaticResource CompFootVal}"/></StackPanel></Border>
                    <Border Style="{StaticResource CompFootCell}"><StackPanel><TextBlock Text="Hard faults" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtRamLiveFaults" Text="" Style="{StaticResource CompFootVal}" ToolTip="Pages read from disk per second — high values mean RAM is too small for the current load"/></StackPanel></Border>
                  </UniformGrid>
                </Border>
              </Grid>
            </Border>
            <Border Grid.Row="0" Grid.Column="4" Style="{StaticResource CompCardStyle}" Cursor="Arrow">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8" LastChildFill="True">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"></StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M12,2 C12.41,2 12.75,2.34 12.75,2.75 L12.75,4.25 A0.75,0.75 0 0 1 11.25,4.25 L11.25,2.75 C11.25,2.34 11.59,2 12,2 M12,17 A5,5 0 0 0 12,7 A5,5 0 0 0 12,17 M12,15.5 A3.5,3.5 0 0 1 12,8.5 A3.5,3.5 0 0 1 12,15.5 M21.25,12.75 A0.75,0.75 0 0 0 21.25,11.25 L19.75,11.25 A0.75,0.75 0 0 0 19.75,12.75 Z M12,19 C12.41,19 12.75,19.34 12.75,19.75 L12.75,21.25 A0.75,0.75 0 0 1 11.25,21.25 L11.25,19.75 C11.25,19.34 11.59,19 12,19 M4.25,12.75 A0.75,0.75 0 0 0 4.25,11.25 L2.75,11.25 A0.75,0.75 0 0 0 2.75,12.75 Z M4.22,4.22 C4.52,3.92 4.99,3.92 5.28,4.22 L6.78,5.72 A0.75,0.75 0 0 1 5.72,6.78 L4.22,5.28 A0.75,0.75 0 0 1 4.22,4.22 M5.28,19.78 A0.75,0.75 0 1 1 4.22,18.72 L5.72,17.22 A0.75,0.75 0 1 1 6.78,18.28 Z M19.78,4.22 A0.75,0.75 0 0 0 18.72,4.22 L17.22,5.72 A0.75,0.75 0 0 0 18.28,6.78 L19.78,5.28 C20.08,4.98 20.08,4.51 19.78,4.22 M18.72,19.78 A0.75,0.75 0 1 0 19.78,18.72 L18.28,17.22 A0.75,0.75 0 1 0 17.22,18.28 Z"/></Viewbox>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Configuration" Style="{StaticResource DashRowName}" ToolTip="Memory setup"/>
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0,8,0,4" VerticalAlignment="Top">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,14,12"><TextBlock Text="Total" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtRamTotalConf" Text="—" Style="{StaticResource CompInfoVal}"/></StackPanel>
                  <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,14,12" Visibility="{Binding Text, ElementName=TxtRamMaxConf, Converter={StaticResource DashFactVis}}"><TextBlock Text="Max capacity" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtRamMaxConf" Text="—" Cursor="Help" Style="{StaticResource CompInfoVal}"/></StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,14,12"><TextBlock Text="Channel" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtRamChannel" Text="—" Style="{StaticResource CompInfoVal}"/></StackPanel>
                  <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,14,12"><TextBlock Text="Speed" Style="{StaticResource CompFootKey}"/><StackPanel Orientation="Horizontal"><TextBlock x:Name="TxtRamSpeedConf" Text="—" Style="{StaticResource CompInfoVal}"/><TextBlock Text=" MHz " Style="{StaticResource CompInfoVal}"/><TextBlock x:Name="TxtRamSpeedRated" Text="" Style="{StaticResource CompInfoVal}" FontWeight="Normal" Foreground="{DynamicResource TextSecondaryBrush}"/></StackPanel></StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,14,12"><TextBlock Text="Timings" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtRamTimings" Text="—" Style="{StaticResource CompInfoVal}" ToolTip="CL-tRCD-tRP-tRAS — estimated from frequency and memory type (JEDEC); Windows does not expose the real SPD values."/></StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,0,14,12"><TextBlock Text="Voltage" Style="{StaticResource CompFootKey}"/><StackPanel><TextBlock x:Name="TxtRamVoltage" Text="—" Style="{StaticResource CompInfoVal}"/><TextBlock x:Name="TxtRamVoltageRange" Text="" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/></StackPanel></StackPanel>
                  <StackPanel Grid.Row="3" Grid.Column="0" Margin="0,0,14,12"><TextBlock Text="ECC" Style="{StaticResource CompFootKey}"/><Border x:Name="BorderRamEcc" Background="Transparent" HorizontalAlignment="Left"><TextBlock x:Name="TxtRamEcc" Text="—" Style="{StaticResource CompInfoVal}"/></Border></StackPanel>
                  <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,14,12" Visibility="{Binding Text, ElementName=TxtRamXmp, Converter={StaticResource DashFactVis}}"><TextBlock Text="XMP / EXPO" Style="{StaticResource CompFootKey}"/><Border x:Name="BorderRamXmp" Background="Transparent" Visibility="Collapsed" HorizontalAlignment="Left"><TextBlock x:Name="TxtRamXmp" Text="—" Style="{StaticResource CompInfoVal}" TextTrimming="CharacterEllipsis" ToolTip="Estimate — compares the configured speed with the module rated (SPD) speed. Windows does not say directly whether XMP/EXPO is enabled in BIOS."/></Border></StackPanel>
                  <!-- what is worth knowing (XMP off, mixed modules, Windows memory test, corrected errors): RamChecks, filled in code -->
                  <WrapPanel x:Name="RamFindings" Grid.Row="4" Grid.ColumnSpan="2" Margin="0,0,0,4"/>
                </Grid>
                <Border Grid.Row="2" Style="{StaticResource CompFootBand}" Padding="18,9,18,10" Visibility="{Binding Visibility, ElementName=TxtRamChannelAdvice}">
                  <DockPanel>
                    <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Fill="{DynamicResource StatusWarnBrush}" VerticalAlignment="Top" Margin="0,5,8,0"/>
                    <TextBlock x:Name="TxtRamChannelAdvice" Text="" Visibility="Collapsed" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                  </DockPanel>
                </Border>
              </Grid>
            </Border>
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="18,14,18,14">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8" LastChildFill="True">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock x:Name="TxtRamModulesRight" Text="" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.8"/></StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M21.62,6.88 A3,3 0 0 0 19.5,6 L19.5,3.75 A0.75,0.75 0 0 0 18,3.75 L18,6 L15,6 L15,3.75 A0.75,0.75 0 0 0 13.5,3.75 L13.5,6 L10.5,6 L10.5,3.75 A0.75,0.75 0 0 0 9,3.75 L9,6 L6,6 L6,3.75 A0.75,0.75 0 0 0 4.5,3.75 L4.5,6 A3,3 0 0 0 1.5,9 L1.5,15 A3,3 0 0 0 4.5,18 L4.5,20.25 A0.75,0.75 0 0 0 6,20.25 L6,18 L9,18 L9,20.25 A0.75,0.75 0 0 0 10.5,20.25 L10.5,18 L13.5,18 L13.5,20.25 A0.75,0.75 0 0 0 15,20.25 L15,18 L18,18 L18,20.25 A0.75,0.75 0 0 0 19.5,20.25 L19.5,18 A3,3 0 0 0 22.5,15 L22.5,9 A3,3 0 0 0 21.62,6.88 M21,15 A1.5,1.5 0 0 1 19.5,16.5 L4.5,16.5 A1.5,1.5 0 0 1 3,15 L3,9 A1.5,1.5 0 0 1 4.5,7.5 L19.5,7.5 A1.5,1.5 0 0 1 21,9 Z M18.75,9 L5.25,9 A0.75,0.75 0 0 0 4.5,9.75 L4.5,14.25 A0.75,0.75 0 0 0 5.25,15 L18.75,15 A0.75,0.75 0 0 0 19.5,14.25 L19.5,9.75 A0.75,0.75 0 0 0 18.75,9 M18,13.5 L6,13.5 L6,10.5 L18,10.5 Z"/></Viewbox>
                    <StackPanel VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Modules" Style="{StaticResource DashRowName}"/>
                        <TextBlock x:Name="TxtRamModulesSummary" Text="" Style="{StaticResource DashRowInlineSub}"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
                <UniformGrid x:Name="RamSlotTiles" Grid.Row="1" Rows="1" VerticalAlignment="Stretch"/>
              </Grid>
            </Border>
            <Border Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource CompCardStyle}" Cursor="Arrow">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8" LastChildFill="True">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"></StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M8,4.5 L9,4.5 L9,10.74 Q9,11.31 8.73,11.81 L5.14,18.41 A1.75,1.75 0 0 0 6.68,21 L17.32,21 A1.75,1.75 0 0 0 18.86,18.41 L15.27,11.81 Q15,11.31 15,10.74 L15,4.5 L16,4.5 A0.75,0.75 0 0 0 16,3 L8,3 A0.75,0.75 0 0 0 8,4.5 M10.5,10.74 L10.5,4.5 L13.5,4.5 L13.5,10.74 Q13.5,11.69 13.95,12.53 L14.75,14 L9.25,14 L10.05,12.53 Q10.5,11.69 10.5,10.73 M8.43,15.5 L15.57,15.5 L17.54,19.13 A0.25,0.25 0 0 1 17.32,19.5 L6.68,19.5 A0.25,0.25 0 0 1 6.46,19.13 Z"/></Viewbox>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Diagnostics" Style="{StaticResource DashRowName}" ToolTip="Memory tests"/>
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
                <StackPanel Grid.Row="1" Margin="0,8,0,10" VerticalAlignment="Top">
                

                <!-- The results of a test appear in the same row, between the description and the button: the card keeps its height
                     (MinHeight), so the page does not move and no scroll appears after a run. -->
                <Grid Margin="0,0,0,4" MinHeight="46">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                    <StackPanel>
                      <TextBlock x:Name="TxtRamRunAllTitle" Text="Basic test" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <TextBlock x:Name="TxtRamRunAllDesc" Text="Bandwidth, latency, integrity &amp; walking bit — 1-3 minutes"
                                 FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/>
                    </StackPanel>
                    <!-- Summary pill — "4/4 passed" or "3/4 · 1 warning", shown only after the first run (Visibility toggled from code-behind,
                         see UpdateRamSummaryPill). -->
                    <Border x:Name="RamBasicSummaryPill" Visibility="Collapsed" CornerRadius="10"
                            Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource StatusOkBgBrush}">
                      <TextBlock x:Name="TxtRamBasicSummaryPill" Text="" FontSize="{StaticResource FontSizeXS}"
                                 FontWeight="SemiBold" Foreground="{DynamicResource StatusOkBrush}"/>
                    </Border>
                  </StackPanel>
                  <UniformGrid x:Name="RamBasicTileGrid" Grid.Column="1" Rows="1" Visibility="Collapsed" VerticalAlignment="Center" Margin="16,0,12,0"/>
                  <ui:Button x:Name="BtnRamBasic" Grid.Column="2" Appearance="Primary"
                          Click="RunBasicRamTests_Click" Width="90" Height="30" FontSize="{StaticResource FontSizeM}"
                          VerticalAlignment="Center" HorizontalAlignment="Right"
                          ToolTip="Bandwidth + Latency + Integrity + Walking Bit — a few minutes">Run</ui:Button>
                </Grid>
                <ProgressBar x:Name="PbRamBasicSeq" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8"/>

                <Border Height=".5" Background="{DynamicResource BorderBrush2}" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,4" MinHeight="46">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                    <StackPanel>
                      <TextBlock x:Name="TxtRamAdvTitle" Text="Advanced test" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <TextBlock x:Name="TxtRamAdvDesc" Text="All basic tests + full memory scan — longer, depends on free RAM"
                                 FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/>
                    </StackPanel>
                    <Border x:Name="RamAdvSummaryPill" Visibility="Collapsed" CornerRadius="10"
                            Padding="8,3" Margin="10,0,0,0" VerticalAlignment="Center"
                            Background="{DynamicResource StatusOkBgBrush}">
                      <TextBlock x:Name="TxtRamAdvSummaryPill" Text="" FontSize="{StaticResource FontSizeXS}"
                                 FontWeight="SemiBold" Foreground="{DynamicResource StatusOkBrush}"/>
                    </Border>
                  </StackPanel>
                  <UniformGrid x:Name="RamAdvTileGrid" Grid.Column="1" Rows="1" Visibility="Collapsed" VerticalAlignment="Center" Margin="16,0,12,0"/>
                  <ui:Button x:Name="BtnRamAdvanced" Grid.Column="2" Appearance="Secondary"
                          Click="RunAdvancedRamTests_Click" Width="90" Height="30" FontSize="{StaticResource FontSizeM}"
                          VerticalAlignment="Center" HorizontalAlignment="Right"
                          ToolTip="Basic tests + full scan of currently free RAM — can take a few minutes, depends on free memory">Run</ui:Button>
                </Grid>
                <ProgressBar x:Name="PbRamAdvSeq" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,8"/>
                <!-- A distinct banner for real warnings (e.g. a skipped scan — not enough free RAM for a safe test) — visually separate
                     from the normal tiles, not just coloured text among them. -->
                <Border x:Name="RamAdvWarningBanner" Visibility="Collapsed" CornerRadius="6" Padding="10,7" Margin="0,0,0,8"
                        Background="{DynamicResource StatusWarnBgBrush}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#9888;" FontSize="{StaticResource FontSizeM}" Foreground="{DynamicResource StatusWarnBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtRamAdvWarningText" Text="" FontSize="{StaticResource FontSizeS}"
                               Foreground="{DynamicResource StatusWarnBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                  </StackPanel>
                </Border>

                
                </StackPanel>
                <!-- Rowhammer: a theoretical weakness of older memory, not a defect — removed from the page (it scares without reason);
                     the elements stay for the code that fills them -->
                <Border Grid.Row="2" Style="{StaticResource CompFootBand}" Padding="18,9,18,10" Visibility="Collapsed">
                  <StackPanel>
                <StackPanel x:Name="RowhammerRow" Orientation="Horizontal" Cursor="Help">
                  <TextBlock x:Name="TxtRowhammerIcon" Text="&#9881;" FontSize="{StaticResource FontSizeM}" Margin="0,0,6,0" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <TextBlock x:Name="TxtRowhammerStatus" Text="Rowhammer risk: checking..." FontSize="{StaticResource FontSizeS}"
                             FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Explicatie in limbaj simplu -->
                <TextBlock x:Name="TxtRowhammerExplain" Text="" FontSize="{StaticResource FontSizeS}" TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.8" Margin="20,2,0,0"/>
                  </StackPanel>
                </Border>
              </Grid>
            </Border>
            <Border Grid.Row="2" Grid.RowSpan="3" Grid.Column="4" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="18,14,18,14">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,8" LastChildFill="True">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"></StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M8.46,6.8 L11.75,20.43 C11.92,21.16 12.95,21.2 13.19,20.48 L16.45,10.36 L17.03,12.46 C17.13,12.78 17.42,13 17.75,13 L21.25,13 A0.75,0.75 0 0 0 21.25,11.5 L18.32,11.5 L17.22,7.55 A0.75,0.75 0 0 0 15.78,7.52 L12.58,17.48 L9.23,3.58 C9.04,2.82 7.97,2.81 7.77,3.56 L5.67,11.5 L2.75,11.5 A0.75,0.75 0 0 0 2.75,13 L6.25,13 C6.59,13 6.88,12.77 6.97,12.44 Z"/></Viewbox>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Top processes" Style="{StaticResource DashRowName}" ToolTip="By memory"/>
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
                <StackPanel x:Name="RamTopList" Grid.Row="1" VerticalAlignment="Top" Margin="0,6,0,0"/>
              </Grid>
            </Border>
          </Grid>

          <!-- the older content (RamLivePanel dial, drawn slots, the module table) — hidden, kept for code -->
          <StackPanel x:Name="RamLegacyHost" Grid.Row="3" Visibility="Collapsed">
            <Border x:Name="RamLiveContainer"/>
            <TextBlock x:Name="TxtRamTimingsLatency2" Text="" Visibility="Collapsed"/>
            <TextBlock x:Name="TxtRamLatency" Text="—" Visibility="Collapsed"/>
          <!-- ═ DIMM Slots + Module Details — the hardware information before the testing section ═ -->
          <Grid Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="1.3*" MinWidth="330"/>
              <ColumnDefinition Width="8"/>
              <ColumnDefinition Width="3.7*" MaxWidth="820"/>
            </Grid.ColumnDefinitions>

            <!-- DIMM Slots -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="10,8">
              <StackPanel HorizontalAlignment="Stretch">
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="DIMM SLOTS" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold" Opacity="0.55"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             VerticalAlignment="Center"/>
                  <TextBlock x:Name="TxtRamSlots" Text="— / —" Grid.Column="1" FontSize="{StaticResource FontSizeS}"
                             FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center"/>
                </Grid>
                <WrapPanel x:Name="RamSlotsPanel" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                <TextBlock x:Name="TxtRamSlotInfo" Text="" FontSize="{StaticResource FontSizeS}"
                           TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                           TextAlignment="Center"
                           Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/>
                <TextBlock x:Name="TxtRamSlotLabel" Text="" Visibility="Collapsed"/>
              </StackPanel>
            </Border>

            <!-- Module Details moved here (right of DIMM Slots) -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="0">
            <StackPanel ClipToBounds="True" local:CardClipBehavior.Radius="{DynamicResource RadiusCardD}">
              <Border Background="{DynamicResource BgHoverBrush}" CornerRadius="{DynamicResource RadiusCardTop}" Padding="10,6">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Text="Module Details" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                              VerticalAlignment="Center">
                    <TextBlock x:Name="TxtRamTimingsHdr" Text="" FontSize="{StaticResource FontSizeS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- XMP banners preserved for compatibility -->
              <Border x:Name="XmpAlertBanner" Visibility="Collapsed" Padding="10,5" Margin="0,0,0,0"
                      Background="{StaticResource WarnAlpha10Brush}"
                      BorderBrush="{StaticResource WarnAlpha37Brush}" BorderThickness="0,0,0,1">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock x:Name="TxtXmpAlertTitle" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                               Foreground="{DynamicResource StatusWarningBrush}"
                               Text="XMP/EXPO not enabled"/>
                    <TextBlock x:Name="TxtXmpAlertSub" Text="" FontSize="{StaticResource FontSizeS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,1,0,0"/>
                  </StackPanel>
                  <Border Grid.Column="1" CornerRadius="4" Background="{StaticResource WarnAlpha19Brush}"
                          Padding="6,2" VerticalAlignment="Center">
                    <TextBlock Text="BIOS Fix" FontSize="{StaticResource FontSizeS}" FontWeight="Bold"
                               Foreground="{DynamicResource StatusWarningBrush}"/>
                  </Border>
                </Grid>
              </Border>
              <Border x:Name="XmpStatusBadge" Visibility="Collapsed" Padding="10,3">
                <StackPanel Orientation="Horizontal">
                  <Ellipse x:Name="XmpLedDot" Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"/>
                  <TextBlock x:Name="TxtXmpBadgeLabel" Text="XMP/EXPO" FontSize="{StaticResource FontSizeXS}"
                             Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="TxtXmpBadgeState" Text="" FontSize="{StaticResource FontSizeXS}" FontWeight="Bold"
                             Margin="4,0,0,0" VerticalAlignment="Center"/>
                  <ToolTipService.ToolTip>
                    <ToolTip>
                      <StackPanel>
                        <TextBlock x:Name="TxtXmpTooltipTitle" Text="XMP/EXPO" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtXmpTooltipSub" Text="" FontSize="{StaticResource FontSizeS}" Margin="0,3,0,0"/>
                      </StackPanel>
                    </ToolTip>
                  </ToolTipService.ToolTip>
                </StackPanel>
              </Border>
              <!-- RamChannelBanner hidden — channel shown in metrics row -->
              <Border x:Name="RamChannelBanner" Visibility="Collapsed">
                <StackPanel>
                  <TextBlock x:Name="TxtRamChannelTitle" Text="" Visibility="Collapsed"/>
                  <TextBlock x:Name="TxtRamChannelIcon" Text="" Visibility="Collapsed"/>
                </StackPanel>
              </Border>

                <!-- Hidden Memory Map elements — for C# compatibility -->
                <TextBlock x:Name="TxtMemMapUsed"     Visibility="Collapsed"/>
                <TextBlock x:Name="TxtMemMapFree"     Visibility="Collapsed"/>
                <TextBlock x:Name="TxtMemMapCached"   Visibility="Collapsed"/>
                <TextBlock x:Name="TxtMemMapReserved" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtMemMapPercent"  Visibility="Collapsed"/>
                <Border    x:Name="MemMapUsedBar"     Visibility="Collapsed"/>

                <Border local:CardClipBehavior.Radii="0,0,8,8"
                        BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0"
                        Margin="0,4,0,0">
                  <DataGrid Style="{StaticResource VanillaDataGridStyle}" x:Name="RamGrid" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True"
                            BorderThickness="0" MinHeight="90" MaxHeight="220"
                            VerticalScrollBarVisibility="Auto">
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding IsEmpty}" Value="True">
                        <Setter Property="Opacity" Value="0.3"/>
                        <Setter Property="FontStyle" Value="Italic"/>
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Slot" Binding="{Binding SlotLabel}" Width="130" MinWidth="110">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="ToolTip" Value="{Binding SlotLabel}"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Manufacturer" Binding="{Binding Manufacturer}"  Width="1.2*" MinWidth="112">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="ToolTip" Value="{Binding Manufacturer}"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Part Number"  Binding="{Binding PartNumber}"    Width="2.2*"  MinWidth="150">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="ToolTip" Value="{Binding PartNumber}"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="GB"           Binding="{Binding Capacity}"      SortMemberPath="CapacityBytes" Width="64" MinWidth="60">
                        <DataGridTextColumn.ElementStyle>
                          <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,10,0"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Capacity}"/>
                          </Style>
                        </DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                  <DataGridTextColumn Header="MHz"          Binding="{Binding SpeedShort, Mode=OneWay}" SortMemberPath="RatedMHz" Width="72"  MinWidth="64">
                        <DataGridTextColumn.ElementStyle>
                          <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,10,0"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding Speed, Mode=OneWay}"/>
                          </Style>
                        </DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                  <!-- Type: wide enough for any value (DDR3, DDR4, LPDDR5) -->
                  <DataGridTextColumn Header="Type"         Binding="{Binding MemoryType}"    Width="72" MinWidth="66"/>
                  <DataGridTextColumn Header="Form"         Binding="{Binding FormFactor}"    Width="88"  MinWidth="82">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                        <Setter Property="ToolTip" Value="{Binding FormFactor}"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn x:Name="ColRamEcc" Header="ECC"          Binding="{Binding IsEccDisplay}"  Width="48">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextAlignment" Value="Center"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn x:Name="ColRamVoltage" Header="V"            Binding="{Binding VoltageDisplay}" SortMemberPath="VoltageV" Width="75">
                        <DataGridTextColumn.ElementStyle>
                          <Style TargetType="TextBlock">
                            <Setter Property="TextAlignment" Value="Right"/>
                            <Setter Property="Margin" Value="0,0,10,0"/>
                            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                            <Setter Property="ToolTip" Value="{Binding VoltageDisplay}"/>
                          </Style>
                        </DataGridTextColumn.ElementStyle>
                      </DataGridTextColumn>
                </DataGrid.Columns>
              </DataGrid>
                </Border>
            </StackPanel>
          </Border>
          </Grid>


          </StackPanel>


        </Grid>
        </ScrollViewer>
</UserControl>
