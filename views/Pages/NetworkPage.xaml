<UserControl x:Class="SMDWin.Views.Pages.NetworkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:local="clr-namespace:SMDWin.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <!-- The page logic is in the MainWindow.*.cs files: the named elements here are exposed in MainWindow as properties
       (MainWindow.Pages.cs), and the handlers are redirected below. -->
        <Grid x:Name="PanelNetwork" Visibility="Collapsed" Margin="{StaticResource PageMargin}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
          </Grid.RowDefinitions>

          <!-- ── Row 0: Title + action buttons ── -->
          <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <TextBlock x:Name="TxtNetworkTitle" Text="Network"
                         Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,0"/>
              <TextBlock x:Name="TxtNetworkSubtitle" Text="Connection · traffic · adapters · tools"
                         Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
              <WrapPanel.Resources>
                <!-- the page actions: 8 px apart, with room inside (they were packed close together) -->
                <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                  <Setter Property="Margin" Value="8,0,0,4"/>
                  <Setter Property="Padding" Value="12,6"/>
                </Style>
              </WrapPanel.Resources>
              <ui:Button x:Name="BtnNetSettings" Appearance="Secondary" Padding="10,5"
                      Click="OpenNetworkSettings_Click"
                      ToolTip="Open Windows Network Settings">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M12,2 A10,10 0 0 1 12,22 A10,10 0 0 1 12,2 M14.94,16.5 L9.06,16.5 C9.71,18.91 10.85,20.5 12,20.5 C13.15,20.5 14.29,18.91 14.94,16.5 M7.51,16.5 L4.79,16.5 A8.5,8.5 0 0 0 8.88,19.91 Q8.09,18.66 7.61,16.89 Z M19.21,16.5 L16.5,16.5 C16.18,17.83 15.71,19 15.13,19.91 A8.5,8.5 0 0 0 19.03,16.78 Z M7.1,10 L3.74,10 L3.74,10.02 A8.5,8.5 0 0 0 4.04,15 L7.22,15 A20,20 0 0 1 7.09,10 M15.39,10 L8.6,10 A19,19 0 0 0 8.74,15 L15.26,15 A19,19 0 0 0 15.4,10 M20.27,10 L16.92,10 A21,21 0 0 1 16.79,15 L19.97,15 A8.5,8.5 0 0 0 20.27,10 M8.88,4.09 L8.86,4.09 A8.5,8.5 0 0 0 4.25,8.49 L7.3,8.5 C7.61,6.75 8.16,5.22 8.88,4.09 M12,3.49 L11.88,3.5 C10.62,3.62 9.4,5.62 8.83,8.5 L15.17,8.5 C14.61,5.63 13.39,3.63 12.13,3.5 Z M15.12,4.09 L15.22,4.26 A13,13 0 0 1 16.7,8.5 L19.75,8.5 A8.5,8.5 0 0 0 15.41,4.21 Z"/></Canvas></Viewbox>
                  <TextBlock Text="Network Settings" VerticalAlignment="Center"/>
                </StackPanel>
              </ui:Button>
              <ui:Button x:Name="BtnNetAdapters" Appearance="Secondary" Padding="10,5"
                      Click="OpenNetAdapters_Click"
                      ToolTip="Open Network Adapter Settings">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M9.25,7 A0.75,0.75 0 0 1 9.36,8.5 L7,8.5 A3.5,3.5 0 0 0 6.8,15.5 L9.25,15.5 A0.75,0.75 0 0 1 9.36,17 L7,17 A5,5 0 0 1 6.75,7 L9.25,7 M17,7 A5,5 0 0 1 17.25,17 L14.75,17 A0.75,0.75 0 0 1 14.64,15.5 L17,15.5 A3.5,3.5 0 0 0 17.2,8.5 L14.75,8.5 A0.75,0.75 0 0 1 14.64,7 L17,7 M7,11.25 L17,11.25 A0.75,0.75 0 0 1 17.1,12.75 L7,12.75 A0.75,0.75 0 0 1 6.9,11.25 Z L17,11.25 Z"/></Canvas></Viewbox>
                  <TextBlock Text="Adapters" VerticalAlignment="Center"/>
                </StackPanel>
              </ui:Button>
              <ui:Button x:Name="BtnOpenRouter" Appearance="Secondary" Padding="10,5"
                      ToolTip="Open gateway IP in default browser"
                      Click="OpenRouterPage_Click">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M12,3.5 A7.5,7.5 0 0 0 4.5,11 L4.5,11.25 A0.75,0.75 0 0 1 3,11.25 L3,11 A9,9 0 0 1 21,11 L21,11.25 A0.75,0.75 0 0 1 19.5,11.25 L19.5,11 A7.5,7.5 0 0 0 12,3.5 M12,6.5 A4.5,4.5 0 0 0 7.5,11 L7.5,11.25 A0.75,0.75 0 0 1 6,11.25 L6,11 A6,6 0 0 1 18,11 L18,11.25 A0.75,0.75 0 0 1 16.5,11.25 L16.5,11 A4.5,4.5 0 0 0 12,6.5 M12,8 A3,3 0 0 0 11.25,13.9 L11.25,16 L6,16 A3,3 0 0 0 6,22 L18,22 A3,3 0 0 0 18,16 L12.75,16 L12.75,13.9 A3,3 0 0 0 12,8 M10.5,11 A1.5,1.5 0 0 1 13.5,11 A1.5,1.5 0 0 1 10.5,11 M6,17.5 L18,17.5 A1.5,1.5 0 0 1 18,20.5 L6,20.5 A1.5,1.5 0 0 1 6,17.5"/></Canvas></Viewbox>
                  <TextBlock Text="Router Admin" VerticalAlignment="Center"/>
                </StackPanel>
              </ui:Button>
            </WrapPanel>
          </Grid>

          <ScrollViewer x:Name="NetTabOverview" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                        ScrollChanged="NetTabOverview_ScrollChanged">
            <StackPanel>

            <!-- ① The connection chain: PC → adapter → router → DNS → internet -->
            <Border Style="{StaticResource CompCardStyle}" Cursor="Arrow" Margin="0,0,0,12" Padding="18,12,18,10">
              <StackPanel>
                <!-- a fixed-height header: the verdict explanation sits on the second line (a single line, the full text in the tooltip),
                     so a problem appearing does not add a row and the page does not start scrolling -->
                <Grid Margin="0,0,0,8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M17.74,10.75 Q18.64,11.65 19.24,12.82 A0.75,0.75 0 1 1 17.9,13.5 A6.56,6.56 0 0 0 6.19,13.48 A0.75,0.75 0 1 1 4.85,12.81 Q5.42,11.67 6.35,10.75 A8.06,8.06 0 0 1 17.75,10.75 M15.65,13.82 Q16.33,14.52 16.73,15.4 A0.75,0.75 0 1 1 15.35,16 A3.6,3.6 0 0 0 8.75,16 A0.75,0.75 0 1 1 7.38,15.4 Q7.78,14.51 8.44,13.83 A5.1,5.1 0 0 1 15.64,13.83 M20.44,8.29 Q21.23,9.06 21.86,9.99 A0.75,0.75 0 0 1 20.62,10.84 Q20.06,10.02 19.39,9.34 A10.45,10.45 0 0 0 3.39,10.84 A0.75,0.75 0 0 1 2.16,9.98 Q2.81,9.04 3.56,8.28 A11.95,11.95 0 0 1 20.45,8.28 M13.07,16.44 A1.5,1.5 0 1 1 10.95,18.56 A1.5,1.5 0 0 1 13.07,16.44"/></Viewbox>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Text="Connection" Style="{StaticResource DashRowCaption}"/>
                    <TextBlock x:Name="TxtNetChainNote" Text="Each step is checked every 10 seconds" Style="{StaticResource CompSub}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="NetChainDot" Width="8" Height="8" Fill="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock x:Name="TxtNetChainStatus" Text="Checking…" Style="{StaticResource CompStatusText}"/>
                  </StackPanel>
                </Grid>
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="0.45*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="0.45*"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="0.45*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="0.45*"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                <Border x:Name="NetHop0Ring" Width="46" Height="46" CornerRadius="23" BorderThickness="2" HorizontalAlignment="Center"
                        BorderBrush="{DynamicResource BorderBrush2}" Background="{DynamicResource BgHoverBrush}">
                  <Viewbox Width="21" Height="21"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Fill="{DynamicResource TextPrimaryBrush}" Data="F1 M6.75,22 A0.75,0.75 0 0 1 6.65,20.5 L8.5,20.5 L8.5,18 L4.25,18 C3.05,18 2.08,17.08 2.01,15.9 L2,15.76 L2,5.25 C2,4.05 2.93,3.08 4.1,3.01 L4.25,3 L19.75,3 C20.94,3 21.91,3.93 21.99,5.1 L21.99,15.75 C21.99,16.95 21.07,17.92 19.9,18 L15.5,18 L15.5,20.5 L17.25,20.5 A0.75,0.75 0 0 1 17.35,22 L6.75,22 M14,18 L10,18 L10,20.5 L14,20.5 Z M19.75,4.5 L4.25,4.5 C3.87,4.5 3.55,4.78 3.51,5.15 L3.5,5.25 L3.5,15.75 C3.5,16.13 3.78,16.45 4.15,16.5 L19.75,16.5 C20.13,16.5 20.45,16.22 20.49,15.85 L20.49,5.25 C20.49,4.87 20.22,4.55 19.85,4.51 Z"/></Viewbox>
                </Border>
                <TextBlock x:Name="NetHop0Name" Text="This PC" FontWeight="SemiBold" FontSize="{StaticResource FontSizeM}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock x:Name="NetHop0Sub" Text="—" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                <TextBlock x:Name="NetHop0Val" Text="…" FontFamily="{StaticResource NumFont}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
              <Border x:Name="NetLink1" Grid.Column="1" Height="2" VerticalAlignment="Top" Margin="6,23,6,0" Background="{DynamicResource BorderBrush2}"/>
              <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                <Border x:Name="NetHop1Ring" Width="46" Height="46" CornerRadius="23" BorderThickness="2" HorizontalAlignment="Center"
                        BorderBrush="{DynamicResource BorderBrush2}" Background="{DynamicResource BgHoverBrush}">
                  <Viewbox Width="21" Height="21"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Fill="{DynamicResource TextPrimaryBrush}" Data="F1 M17.74,10.75 Q18.64,11.65 19.24,12.82 A0.75,0.75 0 1 1 17.9,13.5 A6.56,6.56 0 0 0 6.19,13.48 A0.75,0.75 0 1 1 4.85,12.81 Q5.42,11.67 6.35,10.75 A8.06,8.06 0 0 1 17.75,10.75 M15.65,13.82 Q16.33,14.52 16.73,15.4 A0.75,0.75 0 1 1 15.35,16 A3.6,3.6 0 0 0 8.75,16 A0.75,0.75 0 1 1 7.38,15.4 Q7.78,14.51 8.44,13.83 A5.1,5.1 0 0 1 15.64,13.83 M20.44,8.29 Q21.23,9.06 21.86,9.99 A0.75,0.75 0 0 1 20.62,10.84 Q20.06,10.02 19.39,9.34 A10.45,10.45 0 0 0 3.39,10.84 A0.75,0.75 0 0 1 2.16,9.98 Q2.81,9.04 3.56,8.28 A11.95,11.95 0 0 1 20.45,8.28 M13.07,16.44 A1.5,1.5 0 1 1 10.95,18.56 A1.5,1.5 0 0 1 13.07,16.44"/></Viewbox>
                </Border>
                <TextBlock x:Name="NetHop1Name" Text="Adapter" FontWeight="SemiBold" FontSize="{StaticResource FontSizeM}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock x:Name="NetHop1Sub" Text="—" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                <TextBlock x:Name="NetHop1Val" Text="…" FontFamily="{StaticResource NumFont}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
              <Border x:Name="NetLink2" Grid.Column="3" Height="2" VerticalAlignment="Top" Margin="6,23,6,0" Background="{DynamicResource BorderBrush2}"/>
              <StackPanel Grid.Column="4" HorizontalAlignment="Center">
                <Border x:Name="NetHop2Ring" Width="46" Height="46" CornerRadius="23" BorderThickness="2" HorizontalAlignment="Center"
                        BorderBrush="{DynamicResource BorderBrush2}" Background="{DynamicResource BgHoverBrush}">
                  <Viewbox Width="21" Height="21"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Fill="{DynamicResource TextPrimaryBrush}" Data="F1 M12,3.5 A7.5,7.5 0 0 0 4.5,11 L4.5,11.25 A0.75,0.75 0 0 1 3,11.25 L3,11 A9,9 0 0 1 21,11 L21,11.25 A0.75,0.75 0 0 1 19.5,11.25 L19.5,11 A7.5,7.5 0 0 0 12,3.5 M12,6.5 A4.5,4.5 0 0 0 7.5,11 L7.5,11.25 A0.75,0.75 0 0 1 6,11.25 L6,11 A6,6 0 0 1 18,11 L18,11.25 A0.75,0.75 0 0 1 16.5,11.25 L16.5,11 A4.5,4.5 0 0 0 12,6.5 M12,8 A3,3 0 0 0 11.25,13.9 L11.25,16 L6,16 A3,3 0 0 0 6,22 L18,22 A3,3 0 0 0 18,16 L12.75,16 L12.75,13.9 A3,3 0 0 0 12,8 M10.5,11 A1.5,1.5 0 0 1 13.5,11 A1.5,1.5 0 0 1 10.5,11 M6,17.5 L18,17.5 A1.5,1.5 0 0 1 18,20.5 L6,20.5 A1.5,1.5 0 0 1 6,17.5"/></Viewbox>
                </Border>
                <TextBlock x:Name="NetHop2Name" Text="Router" FontWeight="SemiBold" FontSize="{StaticResource FontSizeM}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock x:Name="NetHop2Sub" Text="—" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                <TextBlock x:Name="NetHop2Val" Text="…" FontFamily="{StaticResource NumFont}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
              <Border x:Name="NetLink3" Grid.Column="5" Height="2" VerticalAlignment="Top" Margin="6,23,6,0" Background="{DynamicResource BorderBrush2}"/>
              <StackPanel Grid.Column="6" HorizontalAlignment="Center">
                <Border x:Name="NetHop3Ring" Width="46" Height="46" CornerRadius="23" BorderThickness="2" HorizontalAlignment="Center"
                        BorderBrush="{DynamicResource BorderBrush2}" Background="{DynamicResource BgHoverBrush}">
                  <Viewbox Width="21" Height="21"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Fill="{DynamicResource TextPrimaryBrush}" Data="F1 M2,5.75 C2,5.34 2.34,5 2.75,5 L18.25,5 A0.75,0.75 0 0 1 18.25,6.5 L2.75,6.5 A0.75,0.75 0 0 1 2,5.75 M2,18.75 C2,18.34 2.34,18 2.75,18 L13.25,18 A0.75,0.75 0 0 1 13.25,19.5 L2.75,19.5 A0.75,0.75 0 0 1 2,18.75 M2.75,11.5 A0.75,0.75 0 0 0 2.75,13 L21.25,13 A0.75,0.75 0 0 0 21.25,11.5 Z"/></Viewbox>
                </Border>
                <TextBlock x:Name="NetHop3Name" Text="DNS" FontWeight="SemiBold" FontSize="{StaticResource FontSizeM}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock x:Name="NetHop3Sub" Text="—" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                <TextBlock x:Name="NetHop3Val" Text="…" FontFamily="{StaticResource NumFont}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
              <Border x:Name="NetLink4" Grid.Column="7" Height="2" VerticalAlignment="Top" Margin="6,23,6,0" Background="{DynamicResource BorderBrush2}"/>
              <StackPanel Grid.Column="8" HorizontalAlignment="Center">
                <Border x:Name="NetHop4Ring" Width="46" Height="46" CornerRadius="23" BorderThickness="2" HorizontalAlignment="Center"
                        BorderBrush="{DynamicResource BorderBrush2}" Background="{DynamicResource BgHoverBrush}">
                  <Viewbox Width="21" Height="21"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Fill="{DynamicResource TextPrimaryBrush}" Data="F1 M12,2 A10,10 0 0 1 12,22 A10,10 0 0 1 12,2 M14.94,16.5 L9.06,16.5 C9.71,18.91 10.85,20.5 12,20.5 C13.15,20.5 14.29,18.91 14.94,16.5 M7.51,16.5 L4.79,16.5 A8.5,8.5 0 0 0 8.88,19.91 Q8.09,18.66 7.61,16.89 Z M19.21,16.5 L16.5,16.5 C16.18,17.83 15.71,19 15.13,19.91 A8.5,8.5 0 0 0 19.03,16.78 Z M7.1,10 L3.74,10 L3.74,10.02 A8.5,8.5 0 0 0 4.04,15 L7.22,15 A20,20 0 0 1 7.09,10 M15.39,10 L8.6,10 A19,19 0 0 0 8.74,15 L15.26,15 A19,19 0 0 0 15.4,10 M20.27,10 L16.92,10 A21,21 0 0 1 16.79,15 L19.97,15 A8.5,8.5 0 0 0 20.27,10 M8.88,4.09 L8.86,4.09 A8.5,8.5 0 0 0 4.25,8.49 L7.3,8.5 C7.61,6.75 8.16,5.22 8.88,4.09 M12,3.49 L11.88,3.5 C10.62,3.62 9.4,5.62 8.83,8.5 L15.17,8.5 C14.61,5.63 13.39,3.63 12.13,3.5 Z M15.12,4.09 L15.22,4.26 A13,13 0 0 1 16.7,8.5 L19.75,8.5 A8.5,8.5 0 0 0 15.41,4.21 Z"/></Viewbox>
                </Border>
                <TextBlock x:Name="NetHop4Name" Text="Internet" FontWeight="SemiBold" FontSize="{StaticResource FontSizeM}" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                <TextBlock x:Name="NetHop4Sub" Text="—" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170"/>
                <TextBlock x:Name="NetHop4Val" Text="…" FontFamily="{StaticResource NumFont}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,0"/>
              </StackPanel>
                </Grid>
              </StackPanel>
            </Border>

            <!-- ② Traffic (all apps) -->
            <Border Style="{StaticResource CompCardStyle}" Cursor="Arrow" Margin="0,0,0,12" Padding="18,14,18,14">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                <DockPanel Grid.ColumnSpan="2" LastChildFill="False" Margin="0,0,0,10">
                  <Viewbox DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M8.46,6.8 L11.75,20.43 C11.92,21.16 12.95,21.2 13.19,20.48 L16.45,10.36 L17.03,12.46 C17.13,12.78 17.42,13 17.75,13 L21.25,13 A0.75,0.75 0 0 0 21.25,11.5 L18.32,11.5 L17.22,7.55 A0.75,0.75 0 0 0 15.78,7.52 L12.58,17.48 L9.23,3.58 C9.04,2.82 7.97,2.81 7.77,3.56 L5.67,11.5 L2.75,11.5 A0.75,0.75 0 0 0 2.75,13 L6.25,13 C6.59,13 6.88,12.77 6.97,12.44 Z"/></Viewbox>
                  <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Traffic" Style="{StaticResource DashRowName}"/>
                      <TextBlock x:Name="TxtNetTrafficSub" Text="All adapters · last 5 minutes" Style="{StaticResource DashRowInlineSub}"/>
                    </StackPanel>
                  </StackPanel>
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="14" Height="3" CornerRadius="1.5" Background="{DynamicResource DataBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="download" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0"/>
                    <Border Width="14" Height="3" CornerRadius="1.5" Background="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="upload" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  </StackPanel>
                </DockPanel>
                <local:MiniLineChart x:Name="NetTrafficChart" Grid.Row="1" Height="110" Capacity="300" MinSpan="64"/>
                <!-- label | figure (right-aligned) | unit — the figures and the units sit one under another -->
                <Grid Grid.Row="1" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto" MinWidth="64"/><ColumnDefinition Width="Auto" MinWidth="44"/></Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <TextBlock Text="Download" Style="{StaticResource CompFootKey}" VerticalAlignment="Bottom" Margin="0,0,10,11"/>
                  <TextBlock x:Name="TxtNetOverviewDown" Grid.Column="1" Text="—" Style="{StaticResource CompChartValue}" HorizontalAlignment="Right" Margin="0,0,0,6" Foreground="{DynamicResource DataBrush}"/>
                  <TextBlock x:Name="TxtNetOverviewDownUnit" Grid.Column="2" Text="" Style="{StaticResource CompFootKey}" VerticalAlignment="Bottom" Margin="5,0,0,11"/>
                  <TextBlock Grid.Row="1" Text="Upload" Style="{StaticResource CompFootKey}" VerticalAlignment="Bottom" Margin="0,0,10,11"/>
                  <TextBlock x:Name="TxtNetOverviewUp" Grid.Row="1" Grid.Column="1" Text="—" Style="{StaticResource CompChartValue}" HorizontalAlignment="Right" Margin="0,0,0,6"/>
                  <TextBlock x:Name="TxtNetOverviewUpUnit" Grid.Row="1" Grid.Column="2" Text="" Style="{StaticResource CompFootKey}" VerticalAlignment="Bottom" Margin="5,0,0,11"/>
                  <TextBlock x:Name="TxtNetTrafficPeakLbl" Grid.Row="2" Text="Peak (5 min)" Style="{StaticResource CompFootKey}" VerticalAlignment="Bottom" Margin="0,0,10,5"/>
                  <TextBlock x:Name="TxtNetTrafficPeak" Grid.Row="2" Grid.Column="1" Text="—" Style="{StaticResource CompChartValue}" HorizontalAlignment="Right" Margin="0"/>
                  <TextBlock x:Name="TxtNetTrafficPeakUnit" Grid.Row="2" Grid.Column="2" Text="" Style="{StaticResource CompFootKey}" VerticalAlignment="Bottom" Margin="5,0,0,5"/>
                </Grid>
              </Grid>
            </Border>

            <!-- ③ Adapters + ④ Tools -->
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="1.3*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Style="{StaticResource CompCardStyle}" Cursor="Arrow">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                  <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M2,5.75 C2,5.34 2.34,5 2.75,5 L18.25,5 A0.75,0.75 0 0 1 18.25,6.5 L2.75,6.5 A0.75,0.75 0 0 1 2,5.75 M2,18.75 C2,18.34 2.34,18 2.75,18 L13.25,18 A0.75,0.75 0 0 1 13.25,19.5 L2.75,19.5 A0.75,0.75 0 0 1 2,18.75 M2.75,11.5 A0.75,0.75 0 0 0 2.75,13 L21.25,13 A0.75,0.75 0 0 0 21.25,11.5 Z"/></Viewbox>
                    <StackPanel VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Adapters" Style="{StaticResource DashRowName}"/>
                        <TextBlock x:Name="TxtNetAdaptersSub" Text="Network cards on this PC" Style="{StaticResource DashRowInlineSub}"/>
                      </StackPanel>
                    </StackPanel>
                  </StackPanel>
                  <Grid Grid.Row="1" Margin="11,0,11,6" TextElement.FontSize="{StaticResource FontSizeXS}" TextElement.Foreground="{DynamicResource TextSecondaryBrush}">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="115"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                    <TextBlock Text="Adapter" Margin="30,0,0,0"/><TextBlock Grid.Column="1" Text="State"/><TextBlock Grid.Column="2" Text="IP"/><TextBlock Grid.Column="3" Text="Speed" TextAlignment="Right"/>
                  </Grid>
                  <ItemsControl x:Name="AdapterCardsPanel" Grid.Row="2" Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Background="{DynamicResource BgHoverBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,6" ToolTip="{Binding AdapterTooltip}">
                          <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="115"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                            <Viewbox Width="17" Height="17" HorizontalAlignment="Left" VerticalAlignment="Center"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="{Binding TypeIcon}"/></Viewbox>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                              <TextBlock Text="{Binding SubLine}" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                              <Ellipse Width="8" Height="8" Fill="{Binding StateBrush}" Margin="0,0,7,0" VerticalAlignment="Center"/>
                              <TextBlock Text="{Binding StateLabel}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="125" ToolTip="{Binding StateLabel}"/>
                            </StackPanel>
                            <TextBlock Grid.Column="3" Text="{Binding Ip4}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Grid.Column="4" Text="{Binding Speed}" Style="{StaticResource TableNumCell}" FontSize="{StaticResource FontSizeM}" Margin="0"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- footer: how the internet sees this PC -->
                  <Border Grid.Row="3" Style="{StaticResource CompFootBand}">
                    <Grid>
                      <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <Border Style="{StaticResource CompFootCellFirst}">
                        <StackPanel>
                          <StackPanel Orientation="Horizontal"><TextBlock Text="Public IP" Style="{StaticResource CompFootKey}"/>
                            <Border x:Name="PubIpVpnBadge" Margin="6,0,0,0" Visibility="Collapsed"><TextBlock x:Name="TxtPubIpVpnLabel" Text="VPN/Proxy" FontSize="{StaticResource FontSizeXS}" FontWeight="Bold" Foreground="{DynamicResource StatusWarningBrush}"/></Border>
                          </StackPanel>
                          <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtPublicIp" Text="Loading…" Style="{StaticResource CompFootVal}"/>
                            <ui:Button x:Name="BtnCopyPublicIp" Appearance="Transparent" Height="22" Width="22" Padding="2" Margin="6,0,0,0" Click="CopyPublicIp_Click" ToolTip="Copy IP">
                              <Viewbox Width="11" Height="11"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M8.5,8.5 L5.25,8.5 C4.28,8.5 3.5,9.28 3.5,10.25 L3.5,18.75 C3.5,19.72 4.28,20.5 5.25,20.5 L11.25,20.5 C12.22,20.5 13,19.72 13,18.75 L13,18 L14.5,18 L14.5,18.75 C14.5,20.55 13.04,22 11.25,22 L5.25,22 A3.25,3.25 0 0 1 2,18.75 L2,10.25 C2,8.45 3.46,7 5.25,7 L8.5,7 Z M18.75,2 C20.55,2 22,3.46 22,5.25 L22,13.75 C22,15.55 20.54,17 18.75,17 L12.75,17 A3.25,3.25 0 0 1 9.5,13.75 L9.5,5.25 C9.5,3.45 10.96,2 12.75,2 Z M12.75,3.5 C11.78,3.5 11,4.28 11,5.25 L11,13.75 C11,14.72 11.78,15.5 12.75,15.5 L18.75,15.5 C19.72,15.5 20.5,14.72 20.5,13.75 L20.5,5.25 C20.5,4.28 19.72,3.5 18.75,3.5 Z"/></Canvas></Viewbox>
                            </ui:Button>
                            <ui:Button x:Name="BtnRefreshPublicIpVisible" Appearance="Transparent" Height="22" Width="22" Padding="2" Margin="2,0,0,0" Visibility="Collapsed" Click="RefreshPublicIp_Click" ToolTip="Retry">
                              <Viewbox Width="10" Height="10"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M12,4.5 A7.5,7.5 0 1 1 4.58,10.9 C4.65,10.44 4.32,10 3.86,10 C3.49,10 3.16,10.26 3.1,10.62 Q3,11.3 3,12 A9,9 0 1 0 6,5.3 L6,4.24 A0.75,0.75 0 0 0 4.5,4.24 L4.5,7.24 C4.5,7.65 4.84,7.99 5.25,7.99 L8.25,7.99 A0.75,0.75 0 0 0 8.25,6.49 L6.9,6.49 A7.5,7.5 0 0 1 12,4.49"/></Canvas></Viewbox>
                            </ui:Button>
                          </StackPanel>
                        </StackPanel>
                      </Border>
                      <Border Grid.Column="1" Style="{StaticResource CompFootCell}"><StackPanel><TextBlock Text="Provider" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtPublicIsp" Text="Loading…" Style="{StaticResource CompFootVal}"/></StackPanel></Border>
                      <Border Grid.Column="2" Style="{StaticResource CompFootCell}"><StackPanel><TextBlock Text="Location" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtPublicLocation" Text="Loading…" Style="{StaticResource CompFootVal}"/></StackPanel></Border>
                    </Grid>
                  </Border>
                </Grid>
              </Border>

              <Border x:Name="NetTopAppsCard" Grid.Column="2" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="18,14,18,14"/>
            </Grid>

            <!-- older elements kept for code (hidden) -->
            <Grid Visibility="Collapsed">
              <Border x:Name="CardPublicIp"/>
              <TextBlock x:Name="TxtPublicAsn"/><TextBlock x:Name="TxtPublicTimezone"/><TextBlock x:Name="TxtPublicStatus"/>
              <TextBlock x:Name="TxtNetOverviewDownLabel"/><TextBlock x:Name="TxtNetOverviewUpLabel"/>
              <Border x:Name="BorderNetDownChart"><Canvas x:Name="NetOverviewDownCanvas" SizeChanged="NetOverviewDownCanvas_SizeChanged"/></Border>
              <Border x:Name="BorderNetUpChart"><Canvas x:Name="NetOverviewUpCanvas" SizeChanged="NetOverviewUpCanvas_SizeChanged"/></Border>
              <TextBlock x:Name="TxtPublicIpv6"/>
              <Button x:Name="BtnRefreshPublicIp" Click="RefreshPublicIp_Click"/>
              <DataGrid x:Name="NetGrid" AutoGenerateColumns="False"/>
              <DataGrid x:Name="TrafficGrid" AutoGenerateColumns="False"/>
            </Grid>
            </StackPanel>
          </ScrollViewer>

          <!-- Hidden compat stubs (referenced in old code-behind) -->
          <TextBlock x:Name="TxtMtuResult" Visibility="Collapsed"/>
          <TextBlock x:Name="TxtNetUtilStatus" Visibility="Collapsed"/>
          <Button x:Name="BtnLanSpeed" Visibility="Collapsed" Click="OpenLanSpeed_Click"/>
          <Button x:Name="BtnTogglePingSection" Visibility="Collapsed" Click="TogglePingSection_Click"/>
          <Border x:Name="PingSectionContent" Visibility="Collapsed"/>
          <Button x:Name="BtnTogglePortScanSection" Visibility="Collapsed" Click="TogglePortScanSection_Click"/>
          <Border x:Name="PortScanSectionContent" Visibility="Collapsed"/>
          <TextBlock x:Name="TxtPingSectionArrow" Visibility="Collapsed"/>
          <TextBlock x:Name="TxtPortScanSectionArrow" Visibility="Collapsed"/>
          <TextBlock x:Name="TxtPingMonLabel" Visibility="Collapsed"/>
          <TextBlock x:Name="TxtPortScanLabel" Visibility="Collapsed"/>

        </Grid>
</UserControl>
