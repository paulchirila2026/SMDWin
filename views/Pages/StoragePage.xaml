                      <ui:Button MinWidth="104" MinHeight="32" HorizontalContentAlignment="Center" Appearance="Secondary" Padding="10,4" Margin="0,0,8,8" Click="StorageCleanmgr_Click" Content="Disk Cleanup"/>
                      <ui:Button MinWidth="104" MinHeight="32" HorizontalContentAlignment="Center" Appearance="Secondary" Padding="10,4" Margin="0,0,8,8" Click="StorageSettings_Click" Content="Storage settings"/>
                    </WrapPanel>
                  </StackPanel>
                </Border>
                <Border x:Name="ApmPanel" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="18,14,18,14" Margin="6,0,0,0" Visibility="Collapsed">
                  <StackPanel>
                  <DockPanel Margin="0,0,0,10">
                    <Viewbox DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M8.2,4.82 A0.75,0.75 0 0 1 8.84,6.18 A7.51,7.51 0 1 0 15.18,6.18 A0.75,0.75 0 1 1 15.81,4.83 A9,9 0 1 1 8.21,4.82 M12,2.5 C12.38,2.5 12.7,2.78 12.74,3.14 L12.74,10.74 A0.75,0.75 0 0 1 11.26,10.84 L11.25,10.74 L11.25,3.24 C11.25,2.84 11.58,2.5 12,2.5"/></Viewbox>
