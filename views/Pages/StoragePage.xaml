                            MouseLeftButtonUp="SmartDiskWin5m_Click">
                      <TextBlock Text="5m" FontSize="{StaticResource FontSizeXS}" FontWeight="SemiBold" Foreground="{DynamicResource SelBtnFg}"/>
                    </Border>
                    <Border x:Name="SmartDiskWin10m" CornerRadius="0" Padding="10,3"
                            Background="{DynamicResource BgCardBrush}" Cursor="Hand"
                            MouseLeftButtonUp="SmartDiskWin10m_Click">
                      <TextBlock Text="15m" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                      <Border x:Name="SmartDiskWin1h" CornerRadius="0,4,4,0" Padding="10,3"
                              Background="{DynamicResource BgCardBrush}" Cursor="Hand"
                              MouseLeftButtonUp="SmartDiskWin1h_Click">
                        <TextBlock Text="1h" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Read " FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                               Foreground="{DynamicResource ChartGreenBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSmartDiskRead" Text="—" FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                               Margin="0,0,14,0" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" MinWidth="60"/>
                    <TextBlock Text="Write " FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                               Foreground="{DynamicResource ChartOrangeBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSmartDiskWrite" Text="—" FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" MinWidth="60"/>
                    <TextBlock Text="Latency " FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"
