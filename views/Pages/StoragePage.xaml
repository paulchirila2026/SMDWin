                                <TextBlock Text="{Binding DriveLetter}" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding Description}" FontSize="{StaticResource FontSizeS}"
