                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                  <TextBlock x:Name="TxtSmartDiskLabel" Text="Drive:" VerticalAlignment="Center" Margin="0,0,10,0"
                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeM}"/>
                  <local:DropdownSelector Style="{StaticResource DropdownSelectorStyle}" x:Name="CbSmartDisk" Width="300" SelectionChanged="SmartDisk_Changed" Margin="0,0,8,0"/>
                  <ui:Button x:Name="BtnRefreshSmartDisks" Width="30" Height="30" Padding="0" Appearance="Secondary" Click="RefreshDiskCombos_Click"
                          ToolTip="Rescan connected drives (e.g. after plugging in a USB/external disk)">
                    <Viewbox Width="14" Height="14" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M16.25,5.18 C16,5.51 16.06,5.98 16.39,6.23 A7.24,7.24 0 0 1 12.79,19.21 L13.47,18.53 A0.75,0.75 0 0 0 12.49,17.4 L12.41,17.47 L10.41,19.47 A0.75,0.75 0 0 0 10.34,20.45 L10.41,20.53 L12.41,22.53 A0.75,0.75 0 0 0 13.54,21.55 L13.47,21.47 L12.72,20.72 A8.75,8.75 0 0 0 17.3,5.04 A0.75,0.75 0 0 0 16.25,5.18 M10.53,1.47 C10.23,1.77 10.23,2.24 10.53,2.53 L11.28,3.28 A8.75,8.75 0 0 0 6.43,18.75 A0.75,0.75 0 0 0 7.39,17.59 A7.23,7.23 0 0 1 11.2,4.8 L10.52,5.48 A0.75,0.75 0 1 0 11.58,6.54 L13.58,4.54 C13.88,4.24 13.88,3.77 13.58,3.48 L11.58,1.48 A0.75,0.75 0 0 0 10.52,1.48"/></Canvas></Viewbox>
                  </ui:Button>
                </StackPanel>
                <TextBox x:Name="TxtSmartDiskType" Grid.Column="1" Text="" FontSize="{StaticResource FontSizeM}" Style="{StaticResource SelectableTextStyle}"
                         VerticalAlignment="Center" Margin="18,0,12,0" ToolTip="Select to copy"/>
                <!-- self-test: in the disk bar, as in Surface scan / Benchmark -->
                <StackPanel x:Name="SmartSelfTestPanel" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0" Visibility="Collapsed"
                            ToolTip="Self-tests are run by the drive itself; the PC can be used meanwhile">
                  <TextBlock x:Name="TxtSmartSelfTestStatus" Text="" VerticalAlignment="Center" Margin="0,0,10,0" MaxWidth="300" TextTrimming="CharacterEllipsis"
                             FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                  <ProgressBar x:Name="SmartSelfTestProgress" Width="110" Height="5" Minimum="0" Maximum="100" Margin="0,0,10,0" VerticalAlignment="Center"
                               Visibility="Collapsed" Style="{StaticResource AnimatedProgressBarStyle}"/>
                  <ui:Button x:Name="BtnSmartSelfTestShort" Content="Short self-test" Appearance="Primary" Click="SmartSelfTestShort_Click" Margin="0,0,6,0" ToolTip="About 2 minutes"/>
                  <ui:Button x:Name="BtnSmartSelfTestExtended" Content="Extended self-test" Appearance="Secondary" Click="SmartSelfTestExtended_Click" ToolTip="Can take hours on large drives"/>
                  <Button x:Name="BtnSmartSelfTestAbort" Content="Abort" Visibility="Collapsed" Margin="6,0,0,0"
                          Style="{StaticResource RedButtonStyle}" Click="SmartSelfTestAbort_Click"/>
                </StackPanel>
                <!-- the health is already in the Verdict dial below; a large figure without a label was redundant -->
                <TextBlock x:Name="TxtSmartHealthBadge" Visibility="Collapsed" Grid.Column="3" Text="100%" FontSize="{StaticResource FontSizeTitleLg}" FontWeight="Bold"
                           Foreground="{DynamicResource StatusSuccessBrush}" VerticalAlignment="Center"
                           ToolTip="Overall SMART health"/>
                <!-- Compat stub — the text is no longer shown, but C# sets its .Text -->
                <TextBlock x:Name="TxtSmartHealthLabel" Visibility="Collapsed"/>
              </Grid>
            </Border>
            <!-- left the verdict (it shrinks by itself to fit without scrolling — FitSmartVerdict), right the full table -->
            <Grid Grid.Row="2">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="290" MaxWidth="560"/><ColumnDefinition Width="12"/><ColumnDefinition Width="2.4*"/></Grid.ColumnDefinitions>
              <!-- no scrolling: the card fills the column, FitSmartVerdict makes it fit -->
              <ScrollViewer x:Name="SmartVerdictScroll" Grid.Column="0" VerticalScrollBarVisibility="Disabled" SizeChanged="SmartVerdictScroll_SizeChanged">
                <Grid>
                  <Border x:Name="SmartVerdictCard" Style="{StaticResource CompCardStyle}" Cursor="Arrow">
                    <DockPanel LastChildFill="True">
                      <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                          <Ellipse Width="8" Height="8" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Foreground, ElementName=TxtSmartVerdictStatus}"/>
                          <TextBlock x:Name="TxtSmartVerdictStatus" Text="" Style="{StaticResource CompStatusText}" Foreground="{DynamicResource StatusOkBrush}"/>
                        </StackPanel>
                        <DockPanel Margin="0,0,10,0">
                          <Viewbox DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M3,5.75 C3,5.34 3.34,5 3.75,5 Q7.74,5 11.55,2.15 C11.82,1.95 12.18,1.95 12.45,2.15 Q16.26,5 20.25,5 C20.66,5 21,5.34 21,5.75 L21,11 C21,16 18.04,19.68 12.27,21.95 A0.8,0.8 0 0 1 11.73,21.95 C5.96,19.68 3,16 3,11 Z M4.5,6.48 L4.5,11 C4.5,15.26 6.95,18.38 12,20.44 C17.05,18.38 19.5,15.26 19.5,11 L19.5,6.48 A14.4,14.4 0 0 1 12,3.68 A14.4,14.4 0 0 1 4.5,6.48"/></Viewbox>
                          <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtSmartVerdictDisk" Text="" Style="{StaticResource DashRowName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                          </StackPanel>
                        </DockPanel>
                      </DockPanel>
                      <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Viewbox x:Name="SmartVerdictDial" Width="112" Height="101" Margin="0,0,14,0">
                          <Grid Style="{StaticResource CompDialGrid}">
                            <local:PercentGauge x:Name="SmartVerdictGauge" ShowValue="False" Segments="20" WarnAt="101" CritAt="101"/>
                            <StackPanel Style="{StaticResource CompDialText}">
                              <TextBlock Style="{StaticResource CompDialUnitGhost}"/>
                              <TextBlock Style="{StaticResource CompDialValue}" x:Name="TxtSmartVerdictPct" Text=""/>
                              <TextBlock Style="{StaticResource CompDialUnit}"/>
                            </StackPanel>
                            <TextBlock Style="{StaticResource CompDialSub}" Text="health"/>
                          </Grid>
                        </Viewbox>
                        <TextBlock x:Name="TxtSmartVerdictText" Grid.Column="1" Text="" TextWrapping="Wrap" VerticalAlignment="Center"
                                   FontSize="{StaticResource FontSizeM}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </Grid>
                      <Border DockPanel.Dock="Bottom" Style="{StaticResource CompFootBand}">
                        <UniformGrid Columns="2">
                          <Border Style="{StaticResource CompFootCellFirst}"><StackPanel><TextBlock Text="Serial number" Style="{StaticResource CompFootKey}"/><TextBox x:Name="TxtSmartLifeSerial" Text="—" Style="{StaticResource SelectableTextStyle}" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,1,0,0" ToolTip="Select to copy"/></StackPanel></Border>
                          <Border Style="{StaticResource CompFootCell}"><StackPanel><TextBlock Text="Connection" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtSmartLifeBus" Text="—" Style="{StaticResource CompFootVal}"/></StackPanel></Border>
                        </UniformGrid>
                      </Border>
                      <!-- tiles: the figures that matter, then the disk life, in a single 2-column grid that fills the remaining card height
                           (the rows stretch equally; FitSmartVerdict hides what does not fit) -->
                      <UniformGrid x:Name="SmartTilesGrid" Columns="2" Margin="-4,0,-4,12"/>
                    </DockPanel>
                  </Border>
                  <Border x:Name="NvmeDiagPanel" Style="{StaticResource CardStyle}"
                    Margin="0,0,0,8" Padding="12,8" Visibility="Collapsed">
              <StackPanel>
                <TextBlock Text="NVMe Diagnostics" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>
                <WrapPanel>
                  <Border Background="{DynamicResource BgInputBrush}" CornerRadius="8" Padding="12,6" Margin="0,0,6,4">
                    <StackPanel>
                      <TextBlock Text="Available Spare" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                      <TextBlock x:Name="TxtNvmeSpare" Text="—" FontSize="{StaticResource FontSizeXXL}" FontWeight="Bold"
                                 Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <Border Background="{DynamicResource BgInputBrush}" CornerRadius="8" Padding="12,6" Margin="0,0,6,4">
                    <StackPanel>
                      <TextBlock Text="Wear %" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                      <TextBlock x:Name="TxtNvmeWear" Text="—" FontSize="{StaticResource FontSizeXXL}" FontWeight="Bold"
                                 Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <Border Background="{DynamicResource BgInputBrush}" CornerRadius="8" Padding="12,6" Margin="0,0,6,4">
                    <StackPanel>
                      <TextBlock Text="Data Written" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                      <TextBlock x:Name="TxtNvmeWritten" Text="—" FontSize="{StaticResource FontSizeXXL}" FontWeight="Bold"
                                 Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <Border Background="{DynamicResource BgInputBrush}" CornerRadius="8" Padding="12,6" Margin="0,0,6,4">
                    <StackPanel>
                      <TextBlock Text="Power Cycles" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                      <TextBlock x:Name="TxtNvmePowerCycles" Text="—" FontSize="{StaticResource FontSizeXXL}" FontWeight="Bold"
                                 Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <Border Background="{DynamicResource BgInputBrush}" CornerRadius="8" Padding="12,6" Margin="0,0,0,4">
                    <StackPanel>
                      <TextBlock Text="Controller Busy" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                      <TextBlock x:Name="TxtNvmeBusy" Text="—" FontSize="{StaticResource FontSizeXXL}" FontWeight="Bold"
                                 Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                </WrapPanel>
                <TextBlock x:Name="TxtNvmeNote" Text="" FontSize="{StaticResource FontSizeS}" FontStyle="Italic"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,6,0,0"/>
              </StackPanel>
            </Border>
                </Grid>
              </ScrollViewer>
              <Border Grid.Column="2" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="0,14,0,0">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <DockPanel Margin="18,0,18,8">
                    <TextBlock x:Name="BtnSmartShowAll" DockPanel.Dock="Right" Text="Show all" Visibility="Collapsed" Cursor="Hand" VerticalAlignment="Center"
                               FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource AccentBrush}" MouseLeftButtonUp="SmartShowAll_Click"/>
                    <StackPanel Orientation="Horizontal">
                      <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M2,5.75 C2,5.34 2.34,5 2.75,5 L18.25,5 A0.75,0.75 0 0 1 18.25,6.5 L2.75,6.5 A0.75,0.75 0 0 1 2,5.75 M2,18.75 C2,18.34 2.34,18 2.75,18 L13.25,18 A0.75,0.75 0 0 1 13.25,19.5 L2.75,19.5 A0.75,0.75 0 0 1 2,18.75 M2.75,11.5 A0.75,0.75 0 0 0 2.75,13 L21.25,13 A0.75,0.75 0 0 0 21.25,11.5 Z"/></Viewbox>
                      <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="All attributes" Style="{StaticResource DashRowName}"/>
                          <TextBlock x:Name="TxtSmartAttrCount" Text="Values reported by the drive" Style="{StaticResource DashRowInlineSub}" ToolTip="Hover a row to see what the value means"/>
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                  </DockPanel>
                  <ContentControl Grid.Row="1" Focusable="False">
                  <DataGrid Style="{StaticResource VanillaDataGridStyle}" x:Name="SmartGrid" local:CardClipBehavior.Radius="{DynamicResource RadiusCardD}" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="True">
                <DataGrid.RowStyle>
                  <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                    <Setter Property="ToolTip" Value="{Binding AttributeTooltip}"/>
                    <Setter Property="ToolTipService.ShowDuration" Value="15000"/>
                    <Setter Property="Background" Value="{Binding RowBackground}"/>
                  </Style>
                </DataGrid.RowStyle>
                <DataGrid.Columns>
                  <DataGridTextColumn Header="ID" Binding="{Binding IdHex}" Width="58" MinWidth="58"/>
                  <DataGridTemplateColumn Header="Attribute" Width="1.5*" MinWidth="210">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,2">
                          <Ellipse Width="8" Height="8" Fill="{Binding TrafficLightColor, Converter={StaticResource ThemeStatusBrush}}"
                                   VerticalAlignment="Center" Margin="0,0,6,0"/>
                          <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"
                                     FontWeight="SemiBold"/>
                        </StackPanel>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="Value"     Binding="{Binding CurrentValue}" Width="55"  MinWidth="50"/>
                  <DataGridTextColumn Header="Worst"     Binding="{Binding WorstValue}"   Width="55"  MinWidth="50"/>
                  <DataGridTextColumn Header="Limit" Binding="{Binding ThresholdValue}" Width="60" MinWidth="55"/>
                  <DataGridTextColumn Header="Raw"       Binding="{Binding RawDisplay}" Width="100" MinWidth="80"/>
                  <DataGridTemplateColumn Header="Status" Width="95" MinWidth="85">
                    <DataGridTemplateColumn.CellTemplate>
                      <DataTemplate>
                        <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusColor, Converter={StaticResource ThemeStatusBrush}}"
                                   FontWeight="Bold" VerticalAlignment="Center" Margin="4,0"
                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding StatusText}"/>
                      </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTextColumn Header="What it means" Binding="{Binding FriendlyDescription}" Width="2*" MinWidth="180">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="TextWrapping" Value="Wrap"/>
                        <Setter Property="ToolTip" Value="{Binding FriendlyDescription}"/>
                        <Setter Property="VerticalAlignment" Value="Center"/>
                        <Setter Property="Margin" Value="4,3"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                </DataGrid.Columns>
              </DataGrid>
                  </ContentControl>
                </Grid>
              </Border>
            </Grid>
          </Grid>

          <!-- ── Tab: Surface Scan ── -->
          <Grid x:Name="StorageTabSurface" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- Compat elements — referenced in C#, kept hidden -->
            <ProgressBar x:Name="SurfaceProgressBar" Visibility="Collapsed" Minimum="0" Maximum="100"/>
            <TextBlock   x:Name="TxtSurfacePct"      Visibility="Collapsed"/>

            <Border Visibility="Collapsed" Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="16,10">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="100"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" x:Name="TxtDiskActivityTitle3" Text="Disk Activity" FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                    ToolTip="Combined read/write activity across ALL storage devices — not just the drive selected above."
                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtDiskWindowLabel3" Text="Range: " FontSize="{StaticResource FontSizeS}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/>
                    <Border x:Name="SurfaceDiskWin60" CornerRadius="4,0,0,4" Padding="10,3"
                            Background="{DynamicResource BgCardBrush}" Cursor="Hand"
                            MouseLeftButtonUp="SurfaceDiskWin60_Click">
                      <TextBlock Text="60s" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                    <Border x:Name="SurfaceDiskWin5m" CornerRadius="0" Padding="10,3"
                            Background="{DynamicResource SelBtnBg}" Cursor="Hand"
                            MouseLeftButtonUp="SurfaceDiskWin5m_Click">
                      <TextBlock Text="5m" FontSize="{StaticResource FontSizeXS}" FontWeight="SemiBold" Foreground="{DynamicResource SelBtnFg}"/>
                    </Border>
                    <Border x:Name="SurfaceDiskWin10m" CornerRadius="0" Padding="10,3"
                            Background="{DynamicResource BgCardBrush}" Cursor="Hand"
                            MouseLeftButtonUp="SurfaceDiskWin10m_Click">
                      <TextBlock Text="15m" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                      <Border x:Name="SurfaceDiskWin1h" CornerRadius="0,4,4,0" Padding="10,3"
                              Background="{DynamicResource BgCardBrush}" Cursor="Hand"
                              MouseLeftButtonUp="SurfaceDiskWin1h_Click">
                        <TextBlock Text="1h" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Read " FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                               Foreground="{DynamicResource ChartGreenBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSurfaceDiskRead" Text="—" FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,14,0" MinWidth="60"/>
                    <TextBlock Text="Write " FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                               Foreground="{DynamicResource ChartOrangeBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtSurfaceDiskWrite" Text="—" FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" MinWidth="60"/>
                    <TextBlock Text="Latency " FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"
                               Opacity="0.7" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <TextBlock x:Name="TxtSurfaceDiskLatency" Text="—" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.85" VerticalAlignment="Center" MinWidth="40"
                               ToolTip="Average disk access time (latency). High values here even with normal Read/Write speed can mean a slow or failing drive — see the dotted line on the chart."/>
                    <CheckBox x:Name="ChkDiskLatency3" Style="{StaticResource ToggleSwitchSmallStyle}"
                              Click="ToggleDiskLatency_Click" Margin="8,0,0,0" VerticalAlignment="Center"
                              ToolTip="Show/hide the latency overlay on all Disk Activity charts"/>
                  </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid Grid.Column="0" Width="Auto" MinWidth="42" Margin="0,0,4,0">
                    <TextBlock x:Name="TxtDiskSpeedMax3" Text="—" FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.55"
                               VerticalAlignment="Top" HorizontalAlignment="Right"/>
                    <TextBlock Text="0" FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.55"
                               VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                  </Grid>
                  <Canvas x:Name="SurfaceDiskActivityCanvas" Grid.Column="1" ClipToBounds="True"
                          local:CardClipBehavior.Radii="0,0,8,8"
                          Background="Transparent"
                          SizeChanged="SurfaceDiskActivityCanvas_SizeChanged"/>
                  <Grid x:Name="DiskLatencyAxis3" Grid.Column="2" Width="42" Margin="4,0,0,0">
                    <TextBlock x:Name="TxtDiskLatMax3" Text="—" FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.55"
                               VerticalAlignment="Top" HorizontalAlignment="Left"/>
                    <TextBlock Text="0 ms" FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.55"
                               VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                  </Grid>
                </Grid>
              </Grid>
            </Border>

            <!-- Row 1: Controls — a single row (disk selector + Start/Stop + status message).
                 The progress sits in the right column, the first block. -->
            <Border Grid.Row="1" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Margin="0,0,0,8" Padding="14,10">
              <Grid>
                <!-- the selector | the status message | Start / Stop at the right edge (as in Benchmark) -->
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                  <TextBlock Text="Drive:" VerticalAlignment="Center" Margin="0,0,10,0"
                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeM}"/>
                  <local:DropdownSelector Style="{StaticResource DropdownSelectorStyle}" x:Name="CbSurfaceDisk" Width="300" Margin="0,0,8,0"/>
                  <ui:Button x:Name="BtnRefreshSurfaceDisks" Width="30" Height="30" Padding="0" Margin="0,0,14,0" Appearance="Secondary" Click="RefreshDiskCombos_Click"
                          ToolTip="Rescan connected drives (e.g. after plugging in a USB/external disk)">
                    <Viewbox Width="14" Height="14" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M16.25,5.18 C16,5.51 16.06,5.98 16.39,6.23 A7.24,7.24 0 0 1 12.79,19.21 L13.47,18.53 A0.75,0.75 0 0 0 12.49,17.4 L12.41,17.47 L10.41,19.47 A0.75,0.75 0 0 0 10.34,20.45 L10.41,20.53 L12.41,22.53 A0.75,0.75 0 0 0 13.54,21.55 L13.47,21.47 L12.72,20.72 A8.75,8.75 0 0 0 17.3,5.04 A0.75,0.75 0 0 0 16.25,5.18 M10.53,1.47 C10.23,1.77 10.23,2.24 10.53,2.53 L11.28,3.28 A8.75,8.75 0 0 0 6.43,18.75 A0.75,0.75 0 0 0 7.39,17.59 A7.23,7.23 0 0 1 11.2,4.8 L10.52,5.48 A0.75,0.75 0 1 0 11.58,6.54 L13.58,4.54 C13.88,4.24 13.88,3.77 13.58,3.48 L11.58,1.48 A0.75,0.75 0 0 0 10.52,1.48"/></Canvas></Viewbox>
                  </ui:Button>
                </StackPanel>
                <TextBlock Grid.Column="1" x:Name="TxtSurfaceStatus" Text="Ready" FontSize="{StaticResource FontSizeS}"
                           Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"
                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="34"/>
                <ui:Button x:Name="BtnSurfaceStart" Grid.Column="2"
                        ToolTip="Start a disk surface scan (read-only, does not change any data). Click again to stop." Appearance="Primary"
                        Click="SurfaceScan_Start_Click" Margin="14,0,0,0">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0">
                      <Canvas Width="24" Height="24">
                        <Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}" Data="F1 M16.1,17.16 A8,8 0 1 1 17.16,16.1 L21.78,20.72 A0.75,0.75 0 1 1 20.72,21.78 Z M17.5,11 A6.5,6.5 0 0 0 4.5,11 A6.5,6.5 0 0 0 17.5,11"/>
                      </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="TxtSurfaceStartLabel" Text="Start Scan" VerticalAlignment="Center"/>
                  </StackPanel>
                </ui:Button>
              </Grid>
            </Border>

            <!-- ═══ Surface Scan  ═══
                 ① verdict + progress strip  ② block map  ③ response time histogram
                 ④ speed across the disk surface  ⑤ list of problems found.
                 Principle: one glance = one answer; no figure that has to be compared mentally. -->
            <Grid Grid.Row="2" SnapsToDevicePixels="True">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*" MinHeight="200"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!-- ① VERDICT + PROGRES -->
              <Border Grid.Row="0" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="16,10" Margin="0,0,0,8">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" MinWidth="96"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="TxtSurfacePctLabel" Text="0%" FontSize="{StaticResource FontSizeHero}" FontWeight="Bold"
                               FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock x:Name="TxtSurfacePhase" Text="Not started" FontSize="{StaticResource FontSizeS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="1,-3,0,0"/>
                  </StackPanel>
                  <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <!-- The track must stay the direct parent of SurfaceProgressFill -->
                    <Border CornerRadius="5" Background="{DynamicResource BorderBrush2}" Height="10">
                      <Border x:Name="SurfaceProgressFill" HorizontalAlignment="Left" CornerRadius="5" Height="10" Width="0"
                              Background="{DynamicResource DataBrush}"/>
                    </Border>
                    <Grid Margin="0,7,0,0">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <!-- The verdict, as a coloured label (background + text set from code) -->
                      <Border x:Name="SurfaceVerdictPill" CornerRadius="6" Padding="9,3" Background="{DynamicResource BgHoverBrush}">
                        <TextBlock x:Name="TxtSurfaceVerdict" Text="Not scanned yet" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </Border>
                      <TextBlock Grid.Column="2" x:Name="TxtSurfaceScanned" Text="— GB / — GB" FontSize="{StaticResource FontSizeM}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </Grid>
                  </StackPanel>
                  <!-- The current speed — large, next to the remaining time: it is the figure that says the most about the disk state during
                       the scan. -->
                  <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="28,0,0,0" MinWidth="120" Visibility="Collapsed">
                    <TextBlock Text="Read speed now" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <TextBlock x:Name="TxtSurfaceSpeed" Text="—" FontSize="{StaticResource FontSizeHero}" FontWeight="Bold"
                                 FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource AccentBrush}"/>
                      <TextBlock Text=" MB/s" FontSize="{StaticResource FontSizeM}" Foreground="{DynamicResource TextSecondaryBrush}"
                                 VerticalAlignment="Bottom" Margin="0,0,0,5"/>
                    </StackPanel>
                  </StackPanel>
                  <Border Grid.Column="3" Width="1" Background="{DynamicResource BorderBrush2}" Margin="20,4,0,4" HorizontalAlignment="Left" Visibility="Collapsed"/>
                  <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="40,0,0,0" MinWidth="110">
                    <TextBlock Text="Time left" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="TxtSurfaceEta" Text="—" FontSize="{StaticResource FontSizeTitle}" FontWeight="Bold"
                               FontFamily="{DynamicResource MonoFont}" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                      <TextBlock Text="elapsed " FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      <TextBlock x:Name="TxtSurfaceElapsed" Text="—" FontSize="{StaticResource FontSizeS}" FontFamily="{DynamicResource MonoFont}"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                  </StackPanel>
                </Grid>
              </Border>

              <!-- ② BLOCK MAP  +  ③ RESPONSE TIME -->
              <Grid Grid.Row="1" Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="8"/>
                  <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="12,10" SnapsToDevicePixels="True">
                  <Grid>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto"/>
                      <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock x:Name="TxtSurfaceMapTitle" Text="Sector map" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                      <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource StatusOkBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="OK" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource YellowBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Slow" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource RedBrush}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Unreadable" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                        <Rectangle Width="10" Height="10" RadiusX="2" RadiusY="2" Fill="{DynamicResource BorderBrush2}" VerticalAlignment="Center" Margin="0,0,4,0"/>
                        <TextBlock Text="Not scanned" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                      </StackPanel>
                    </Grid>
                    <Grid Grid.Row="1">
                      <local:SectorBlockMap x:Name="SurfaceBlockMap" MinHeight="160"
                                            MouseMove="SurfaceBlockMap_MouseMove"
                                            ToolTipService.InitialShowDelay="150"/>
                      <Border x:Name="SurfaceEmptyState" CornerRadius="8" Padding="16,6" IsHitTestVisible="False"
                              VerticalAlignment="Center">
                        <StackPanel HorizontalAlignment="Center">
                          <Viewbox Width="26" Height="26" Margin="0,0,0,6" Opacity="0.5">
                            <Canvas Width="24" Height="24">
                              <Path Fill="{DynamicResource TextSecondaryBrush}" Data="F1 M16.1,17.16 A8,8 0 1 1 17.16,16.1 L21.78,20.72 A0.75,0.75 0 1 1 20.72,21.78 Z M17.5,11 A6.5,6.5 0 0 0 4.5,11 A6.5,6.5 0 0 0 17.5,11"/>
                            </Canvas>
                          </Viewbox>
                          <TextBlock Text="No scan yet" FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                          <TextBlock Text="Run a surface scan to map bad or slow areas on this drive. The scan only reads — no data is changed."
                                     FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"
                                     Opacity="0.75" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                     Margin="0,4,0,0" MaxWidth="460"/>
                        </StackPanel>
                      </Border>
                    </Grid>
                  </Grid>
                </Border>

                <!-- ③ Response time (histogram) + key figures -->
                <Border Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="16,12" SnapsToDevicePixels="True">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                      <TextBlock Text="Response time" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <TextBlock Text="time needed per MB read" FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8"/>
                      <!-- The histogram rows are built from code (BuildSurfaceHistogram) -->
                      <StackPanel x:Name="SurfaceHistPanel"/>
                      <TextBlock x:Name="TxtSurfaceHistNote" Text="A healthy drive keeps almost everything in the top rows."
                                 FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"
                                 TextWrapping="Wrap" Margin="0,6,0,0" Opacity="0.8"/>

                      <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,12"/>

                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*"/>
                          <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                          <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Unreadable sectors" FontSize="{StaticResource FontSizeM}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TxtSurfaceBad" Text="0" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Row="1" Text="Slow blocks" FontSize="{StaticResource FontSizeM}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="TxtSurfaceSlow" Text="0" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Grid.Row="2" Text="SMART health" FontSize="{StaticResource FontSizeM}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,5"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" x:Name="TxtSurfaceHealth" Text="—" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource StatusSuccessBrush}"/>
                        <TextBlock Grid.Row="3" Text="Temperature" FontSize="{StaticResource FontSizeM}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal">
                          <TextBlock x:Name="TxtSurfaceTemp" Text="—" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                                     Foreground="{DynamicResource TextSecondaryBrush}"/>
                          <TextBlock x:Name="TxtSurfaceTempUnit" Visibility="Collapsed" Text="{DynamicResource TempUnitSymbol}" Margin="3,0,0,0" FontSize="{StaticResource FontSizeM}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                      </Grid>
                      <!-- Compat: the counters per threshold, hidden -->
                      <StackPanel Visibility="Collapsed">
                        <TextBlock x:Name="TxtSlowOrange" Text="0"/>
                        <TextBlock x:Name="TxtSlowYellow" Text="0"/>
                        <TextBlock x:Name="TxtSurfaceLba" Text="—"/>
                      </StackPanel>
                    </StackPanel>
                  </ScrollViewer>
                </Border>
                            <!-- ④ the speed across the disk surface — under the map, as wide as it -->
              <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="14,10" Margin="0,8,0,0">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="120"/>
                  </Grid.RowDefinitions>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                      <TextBlock Text="Read speed along the drive" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                      <TextBlock x:Name="TxtSurfaceSpeedSubtitle" Text="  ·  start → end of the drive" FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <!-- min / average / max are in the shared "Disk activity" card -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                      <TextBlock Text="avg " FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                      <TextBlock x:Name="TxtSurfaceSpeedAvg" Text="—" FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}"
                                 Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="   min " FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                      <TextBlock x:Name="TxtSurfaceSpeedMin" Text="—" FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}"
                                 Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="   max " FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                      <TextBlock x:Name="TxtSurfaceSpeedMax" Text="—" FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold" FontFamily="{DynamicResource MonoFont}"
                                 Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text=" MB/s" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                  </Grid>
                  <local:SpeedCurveChart x:Name="SurfaceSpeedChart" Grid.Row="1" MouseMove="SurfaceSpeedChart_MouseMove"
                                         ToolTipService.InitialShowDelay="100">
                    <local:SpeedCurveChart.ContextMenu>
                      <ContextMenu Opened="SurfaceChartMenu_Opened">
                        <MenuItem Header="Whole drive" Tag="-1" IsCheckable="True" Click="SurfaceChartWindow_Click"/>
                        <MenuItem Header="Everything scanned so far" Tag="0" IsCheckable="True" Click="SurfaceChartWindow_Click"/>
                        <MenuItem Header="Last 15 minutes" Tag="15" IsCheckable="True" Click="SurfaceChartWindow_Click"/>
                        <MenuItem Header="Last 5 minutes" Tag="5" IsCheckable="True" Click="SurfaceChartWindow_Click"/>
                        <MenuItem Header="Last 1 minute" Tag="1" IsCheckable="True" Click="SurfaceChartWindow_Click"/>
                      </ContextMenu>
                    </local:SpeedCurveChart.ContextMenu>
                  </local:SpeedCurveChart>
                </Grid>
              </Border>
              </Grid>

              

              <!-- ⑤ PROBLEMS FOUND (hidden while there are none) + repair for bad sectors -->
              <Border x:Name="SurfaceProblemsCard" Grid.Row="3" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="14,10" Visibility="Collapsed">
                <StackPanel>
                  <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <TextBlock Text="Problems found" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <TextBlock x:Name="TxtSurfaceProblemsCount" Text="" FontSize="{StaticResource FontSizeS}" Margin="8,1,0,0"
                                 Foreground="{DynamicResource TextSecondaryBrush}"/>
                      <TextBlock x:Name="TxtSurfaceProblemsToggle" Text="Show list" FontSize="{StaticResource FontSizeS}" Margin="12,1,0,0"
                                 Foreground="{DynamicResource AccentBrush}" Cursor="Hand" MouseLeftButtonUp="SurfaceProblemsToggle_Click"
                                 ToolTip="Each row is one area; click a row to find it on the sector map"/>
                    </StackPanel>
                    <!-- Repair / export: only when there are unreadable sectors -->
                    <StackPanel x:Name="SurfaceRepairPanel" Grid.Column="1" Orientation="Horizontal" Visibility="Collapsed">
                      <ui:Button x:Name="BtnSurfaceRepair" Appearance="Secondary" Click="SurfaceRepair_Click" Margin="0,0,8,0"
                              ToolTip="Run chkdsk /r to mark unreadable sectors as unusable (logical repair, not physical). Requires a restart and takes 30–90 min.">
                        <TextBlock Text="Repair (chkdsk /r)"/>
                      </ui:Button>
                      <ui:Button x:Name="BtnExportBadSectors" Appearance="Secondary" Click="ExportBadSectors_Click"
                              ToolTip="Save the full list of unreadable sector addresses (LBA) to a text file.">
                        <TextBlock Text="Export list"/>
                      </ui:Button>
                    </StackPanel>
                  </Grid>
                  <TextBlock x:Name="TxtSurfaceRepairInfo" Visibility="Collapsed" FontSize="{StaticResource FontSizeS}" TextWrapping="Wrap"
                             Foreground="{DynamicResource StatusWarningBrush}" Margin="0,0,0,6"/>
                  <!-- the list is collapsed by default: on a disk with many slow zones it would otherwise take half the page -->
                  <ScrollViewer x:Name="SurfaceProblemsScroll" MaxHeight="132" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                    <StackPanel x:Name="SurfaceProblemsList"/>
                  </ScrollViewer>
                </StackPanel>
              </Border>
            </Grid>

            <!-- SurfaceSpeedGraph — compat stub, the mini transfer-rate canvas is not in this layout; the element stays only so the
                 C# code that refers to it does not break. -->
            <Border Visibility="Collapsed">
              <Canvas x:Name="SurfaceSpeedGraph"/>
            </Border>

          </Grid>

          <!-- ── Tab: Benchmark ── -->
          <Grid x:Name="StorageTabBench" Grid.Row="2" Visibility="Collapsed">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ① Disk Activity – always active, at the top, the same source as Overview -->
            <Border Visibility="Collapsed" Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="16,10">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="100"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" x:Name="TxtDiskActivityTitle4" Text="Disk Activity" FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                    ToolTip="Combined read/write activity across ALL storage devices — not just the drive selected above."
                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtDiskWindowLabel4" Text="Range: " FontSize="{StaticResource FontSizeS}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/>
                    <Border x:Name="BenchDiskWin60" CornerRadius="4,0,0,4" Padding="10,3"
                            Background="{DynamicResource BgCardBrush}" Cursor="Hand"
                            MouseLeftButtonUp="BenchDiskWin60_Click">
                      <TextBlock Text="60s" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                    <Border x:Name="BenchDiskWin5m" CornerRadius="0" Padding="10,3"
                            Background="{DynamicResource SelBtnBg}" Cursor="Hand"
                            MouseLeftButtonUp="BenchDiskWin5m_Click">
                      <TextBlock Text="5m" FontSize="{StaticResource FontSizeXS}" FontWeight="SemiBold" Foreground="{DynamicResource SelBtnFg}"/>
                    </Border>
                    <Border x:Name="BenchDiskWin10m" CornerRadius="0" Padding="10,3"
                            Background="{DynamicResource BgCardBrush}" Cursor="Hand"
                            MouseLeftButtonUp="BenchDiskWin10m_Click">
                      <TextBlock Text="15m" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                      <Border x:Name="BenchDiskWin1h" CornerRadius="0,4,4,0" Padding="10,3"
                              Background="{DynamicResource BgCardBrush}" Cursor="Hand"
                              MouseLeftButtonUp="BenchDiskWin1h_Click">
                        <TextBlock Text="1h" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </Border>
                  </StackPanel>
                  <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock Text="Read " FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                               Foreground="{DynamicResource ChartGreenBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBenchDiskRead" Text="—" FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,14,0" MinWidth="60"/>
                    <TextBlock Text="Write " FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                               Foreground="{DynamicResource ChartOrangeBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtBenchDiskWrite" Text="—" FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" MinWidth="60"/>
                    <TextBlock Text="Latency " FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"
                               Opacity="0.7" VerticalAlignment="Center" Margin="14,0,0,0"/>
                    <TextBlock x:Name="TxtBenchDiskLatency" Text="—" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.85" VerticalAlignment="Center" MinWidth="40"
                               ToolTip="Average disk access time (latency). High values here even with normal Read/Write speed can mean a slow or failing drive — see the dotted line on the chart."/>
                    <CheckBox x:Name="ChkDiskLatency4" Style="{StaticResource ToggleSwitchSmallStyle}"
                              Click="ToggleDiskLatency_Click" Margin="8,0,0,0" VerticalAlignment="Center"
                              ToolTip="Show/hide the latency overlay on all Disk Activity charts"/>
                  </StackPanel>
                </Grid>
                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid Grid.Column="0" Width="Auto" MinWidth="42" Margin="0,0,4,0">
                    <TextBlock x:Name="TxtDiskSpeedMax4" Text="—" FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.55"
                               VerticalAlignment="Top" HorizontalAlignment="Right"/>
                    <TextBlock Text="0" FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.55"
                               VerticalAlignment="Bottom" HorizontalAlignment="Right"/>
                  </Grid>
                  <Canvas x:Name="BenchDiskActivityCanvas" Grid.Column="1" ClipToBounds="True"
                          local:CardClipBehavior.Radii="0,0,8,8"
                          Background="Transparent"
                          SizeChanged="BenchDiskActivityCanvas_SizeChanged"/>
                  <Grid x:Name="DiskLatencyAxis4" Grid.Column="2" Width="42" Margin="4,0,0,0">
                    <TextBlock x:Name="TxtDiskLatMax4" Text="—" FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.55"
                               VerticalAlignment="Top" HorizontalAlignment="Left"/>
                    <TextBlock Text="0 ms" FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.55"
                               VerticalAlignment="Bottom" HorizontalAlignment="Left"/>
                  </Grid>
                </Grid>
              </Grid>
            </Border>

            <!-- ② Drive selector + Start/Stop (title on the left, commands on the right) -->
            <Border Grid.Row="1" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Margin="0,0,0,12" Padding="18,12,18,12">
              <StackPanel>
                <DockPanel LastChildFill="False">
                  <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M7.43,2.83 C7.6,2.33 8.07,2 8.6,2 L15.06,2 C15.91,2 16.51,2.84 16.24,3.65 L14.8,8 L18.76,8 C19.86,8 20.43,9.33 19.66,10.12 L8.59,21.54 C7.53,22.62 5.71,21.64 6.04,20.16 L7.31,14.5 L5.75,14.49 C4.54,14.49 3.7,13.29 4.1,12.15 Z M8.78,3.5 L5.52,12.66 C5.46,12.82 5.58,12.99 5.75,12.99 L8.25,13 A0.75,0.75 0 0 1 8.98,13.91 L7.51,20.5 L18.16,9.5 L13.75,9.5 A0.75,0.75 0 0 1 13.04,8.51 L14.7,3.5 Z"/></Viewbox>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Benchmark" Style="{StaticResource DashRowCaption}"/>
                      <TextBlock x:Name="TxtBenchNote" Style="{StaticResource DashRowSub}" TextWrapping="Wrap" MaxWidth="520"
                                 Text="Full benchmark: Sequential Read/Write, Random 4K IOPS, Latency. ~20s per drive."/>
                    </StackPanel>
                  </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                  <TextBlock x:Name="TxtBenchDriveLabel" Text="Drive:" VerticalAlignment="Center" Margin="0,0,10,0"
                             Foreground="{DynamicResource TextSecondaryBrush}" FontSize="{StaticResource FontSizeM}"/>
                  <local:DropdownSelector Style="{StaticResource DropdownSelectorStyle}" x:Name="CbBenchDrive" Width="320" Margin="0,0,8,0"/>
                  <ui:Button x:Name="BtnRefreshBenchDisks" Width="30" Height="30" Padding="0" Margin="0,0,8,0" Appearance="Secondary" Click="RefreshDiskCombos_Click"
                          ToolTip="Rescan connected drives (e.g. after plugging in a USB/external disk)">
                    <Viewbox Width="14" Height="14" Stretch="Uniform"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M16.25,5.18 C16,5.51 16.06,5.98 16.39,6.23 A7.24,7.24 0 0 1 12.79,19.21 L13.47,18.53 A0.75,0.75 0 0 0 12.49,17.4 L12.41,17.47 L10.41,19.47 A0.75,0.75 0 0 0 10.34,20.45 L10.41,20.53 L12.41,22.53 A0.75,0.75 0 0 0 13.54,21.55 L13.47,21.47 L12.72,20.72 A8.75,8.75 0 0 0 17.3,5.04 A0.75,0.75 0 0 0 16.25,5.18 M10.53,1.47 C10.23,1.77 10.23,2.24 10.53,2.53 L11.28,3.28 A8.75,8.75 0 0 0 6.43,18.75 A0.75,0.75 0 0 0 7.39,17.59 A7.23,7.23 0 0 1 11.2,4.8 L10.52,5.48 A0.75,0.75 0 1 0 11.58,6.54 L13.58,4.54 C13.88,4.24 13.88,3.77 13.58,3.48 L11.58,1.48 A0.75,0.75 0 0 0 10.52,1.48"/></Canvas></Viewbox>
                  </ui:Button>
                  <ui:Button x:Name="BtnRunFullBench" ToolTip="Start / Stop benchmark"
                          local:TechTooltip.Text="Runs sequential 1MB block read/write, then random 4K IOPS read/write, then latency P50/P95/P99 — directly against the raw disk (no OS file cache tricks) — for the selected drive, ~20s per phase." Appearance="Primary" Click="RunFullBench_Click" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Viewbox x:Name="IcoBenchStart" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0">
                        <Canvas Width="24" Height="24"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}" Data="F1 M7.6,4.61 A0.75,0.75 0 0 0 6.5,5.27 L6.5,18.73 C6.5,19.29 7.1,19.66 7.6,19.38 L19.97,12.66 A0.75,0.75 0 0 0 19.97,11.34 Z M5,5.27 C5,3.57 6.83,2.48 8.33,3.3 L20.69,10.02 A2.25,2.25 0 0 1 20.69,13.98 L8.33,20.7 A2.25,2.25 0 0 1 5,18.73 Z"/></Canvas>
                      </Viewbox>
                      <Viewbox x:Name="IcoBenchStop" Visibility="Collapsed" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,5,0">
                        <Canvas Width="24" Height="24"><Path Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type ui:Button}}}" Data="F1 M19.25,4.5 C19.39,4.5 19.5,4.61 19.5,4.75 L19.5,19.25 Q19.48,19.48 19.25,19.5 L4.75,19.5 A0.25,0.25 0 0 1 4.5,19.25 L4.5,4.75 C4.5,4.61 4.61,4.5 4.75,4.5 Z M4.75,3 C3.78,3 3,3.78 3,4.75 L3,19.25 C3,20.22 3.78,21 4.75,21 L19.25,21 C20.22,21 21,20.22 21,19.25 L21,4.75 C21,3.78 20.22,3 19.25,3 Z"/></Canvas>
                      </Viewbox>
                      <TextBlock x:Name="TxtBenchStartStop" Text="Start Benchmark" VerticalAlignment="Center"/>
                    </StackPanel>
                  </ui:Button>
                  <CheckBox Style="{StaticResource VanillaCheckBoxStyle}" x:Name="ChkBenchExtended" Visibility="Collapsed" IsChecked="True"/>
                  <Button x:Name="BtnStopFullBench" Visibility="Collapsed" Click="StopFullBench_Click"/>
                </StackPanel>
                </DockPanel>
                <!-- the extra drive tests (real capacity, sustained write, access time), filled in code: MainWindow.StartCards.cs -->
                <WrapPanel x:Name="BenchMoreTests" Margin="31,10,0,0"/>
                <!-- Compat stubs -->
                <TextBlock x:Name="TxtBenchPhase" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtBenchAnimSpeed" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtBenchAnimUnit"  Visibility="Collapsed"/>
                <TextBlock x:Name="TxtBenchLiveSpeed" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtBenchLiveUnit"  Visibility="Collapsed"/>
                <Border x:Name="BenchOpBadge" Visibility="Collapsed"><TextBlock x:Name="TxtBenchOpLabel"/></Border>
              </StackPanel>
            </Border>

            <!-- ③ Results panel -->
            <Grid Grid.Row="2">
              <ScrollViewer x:Name="BenchResultsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="BenchResultsPanel" Margin="0,0,4,0"/>
              </ScrollViewer>
              <Border x:Name="BenchEmptyState" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="30,48"
                      HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                  <Viewbox Width="34" Height="34" Margin="0,0,0,12" Opacity="0.5">
                    <Canvas Width="24" Height="24">
                      <Path Fill="{DynamicResource TextSecondaryBrush}" Data="F1 M7.43,2.83 C7.6,2.33 8.07,2 8.6,2 L15.06,2 C15.91,2 16.51,2.84 16.24,3.65 L14.8,8 L18.76,8 C19.86,8 20.43,9.33 19.66,10.12 L8.59,21.54 C7.53,22.62 5.71,21.64 6.04,20.16 L7.31,14.5 L5.75,14.49 C4.54,14.49 3.7,13.29 4.1,12.15 Z M8.78,3.5 L5.52,12.66 C5.46,12.82 5.58,12.99 5.75,12.99 L8.25,13 A0.75,0.75 0 0 1 8.98,13.91 L7.51,20.5 L18.16,9.5 L13.75,9.5 A0.75,0.75 0 0 1 13.04,8.51 L14.7,3.5 Z"/>
                    </Canvas>
                  </Viewbox>
                  <TextBlock Text="No benchmark results yet" FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                  <TextBlock Text="Run a full benchmark to see sequential read/write speed for this drive."
                             FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"
                             Opacity="0.75" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                             Margin="0,4,0,18" MaxWidth="320"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Viewbox Width="14" Height="14" Margin="0,0,6,0" Opacity="0.6">
                      <Canvas Width="24" Height="24">
                        <Path Fill="{DynamicResource TextSecondaryBrush}" Data="F1 M4.2,10.73 A0.76,0.76 0 0 0 5.3,11.77 L11.25,5.52 L11.25,20.25 A0.75,0.75 0 0 0 12.75,20.25 L12.75,5.52 L18.7,11.77 A0.76,0.76 0 0 0 19.8,10.73 L12.72,3.31 A1,1 0 0 0 11.28,3.31 Z"/>
                      </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="TxtBenchUseAboveHint" Text="Use the Start Benchmark button above" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75"/>
                  </StackPanel>
                </StackPanel>
              </Border>
            </Grid>
          </Grid>

          <!-- ── Tab: Large Files Scanner ── -->
          <!-- Space usage: a page built from code (views/SpaceView.cs) -->
          <Grid x:Name="StorageTabFiles" Grid.Row="2" Visibility="Collapsed">
            <Border x:Name="SpaceHost"/>
          </Grid>
          <!-- no bottom "Reload disks" button: Refresh in the header does the same -->
        </Grid>
</UserControl>
