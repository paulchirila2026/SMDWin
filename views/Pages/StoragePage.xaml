                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TxtHealthIcon" Text="" FontSize="{StaticResource FontSizeXL}"
                                       Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1">
                              <TextBlock x:Name="TxtHealthTitle" Text="" FontSize="{StaticResource FontSizeS}"
                                         FontWeight="Bold" Foreground="White"/>
                              <TextBlock x:Name="TxtHealthDetails" Text="" FontSize="{StaticResource FontSizeS}"
                                         Foreground="{DynamicResource TextPrimaryBrush}"
                                         Margin="0,2,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                          </Grid>
                        </Border>

                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="18,14,18,14" Margin="6,0,6,0">
                  <StackPanel>
                  <DockPanel Margin="0,0,0,10">
                    <Viewbox DockPanel.Dock="Left" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M10,5 L14,5 A2,2 0 0 0 10,5 M8.5,5 A3.5,3.5 0 0 1 15.5,5 L21.25,5 A0.75,0.75 0 0 1 21.25,6.5 L19.93,6.5 L18.76,18.61 A3.75,3.75 0 0 1 15.03,22 L8.97,22 A3.75,3.75 0 0 1 5.24,18.61 L4.07,6.5 L2.75,6.5 A0.75,0.75 0 0 1 2.75,5 Z M10.5,9.75 A0.75,0.75 0 0 0 9,9.75 L9,17.25 A0.75,0.75 0 0 0 10.5,17.25 Z M14.25,9 C14.66,9 15,9.34 15,9.75 L15,17.25 A0.75,0.75 0 0 1 13.5,17.25 L13.5,9.75 C13.5,9.34 13.84,9 14.25,9 M6.73,18.47 A2.25,2.25 0 0 0 8.97,20.5 L15.03,20.5 C16.18,20.5 17.15,19.62 17.27,18.47 L18.42,6.5 L5.58,6.5 Z"/></Viewbox>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Free up space" Style="{StaticResource DashRowName}" ToolTip="Clean up"/>
