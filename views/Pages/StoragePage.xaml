                  </DockPanel>
                    <TextBlock x:Name="TxtStFreeHint" Text="" FontSize="{StaticResource FontSizeM}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>
