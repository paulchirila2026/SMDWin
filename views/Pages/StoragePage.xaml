                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="File system check" Style="{StaticResource DashRowName}" ToolTip="chkdsk /scan"/>
                    </StackPanel>
                  </DockPanel>
                    <DockPanel Margin="0,0,0,8">
                      <ui:Button MinWidth="104" MinHeight="32" HorizontalContentAlignment="Center" x:Name="BtnHealthScan" DockPanel.Dock="Right" Appearance="Secondary" Click="RunPartitionHealth_Click" Padding="10,4" Margin="8,0,0,0"
                              ToolTip="Run chkdsk /scan — does not change anything, no restart needed">
                        <TextBlock x:Name="TxtHealthScanBtn" Text="Scan"/>
