                    <TextBlock x:Name="TxtSmartDiskLatency" Text="—" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.85" VerticalAlignment="Center" MinWidth="40"
                               ToolTip="Average disk access time (latency). High values here even with normal Read/Write speed can mean a slow or failing drive — see the dotted line on the chart."/>
                    <CheckBox x:Name="ChkDiskLatency2" Style="{StaticResource ToggleSwitchSmallStyle}"
