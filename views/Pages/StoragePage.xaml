                                <TextBlock Grid.Column="1" Text="{Binding LevelDisplay}"
                                           FontSize="{StaticResource FontSizeXXL}" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           VerticalAlignment="Center"/>
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="TxtApmNote" Text="" FontSize="{StaticResource FontSizeS}"
