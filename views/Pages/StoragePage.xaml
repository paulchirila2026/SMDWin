<UserControl x:Class="SMDWin.Views.Pages.StoragePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:local="clr-namespace:SMDWin.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <!-- The page logic is in the MainWindow.*.cs files: the named elements here are exposed in MainWindow as properties
       (MainWindow.Pages.cs), and the handlers are redirected below. -->
        <Grid x:Name="PanelDisk" Visibility="Collapsed" Margin="{StaticResource PageMargin}" Style="{StaticResource PageFadeStyle}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="0,0,0,5">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="TxtDiskTitle" Text="Storage" Style="{StaticResource SectionTitleStyle}"/>
                <Border x:Name="DiskStressIndicator" Visibility="Collapsed"
                        Background="{DynamicResource Lift.Surface}" BorderBrush="{DynamicResource Lift.DangerBorder}" BorderThickness="1" CornerRadius="4" Padding="8,3" Margin="10,0,0,0">
                  <StackPanel Orientation="Horizontal">
                    <Ellipse Width="6" Height="6" Fill="{DynamicResource Lift.DangerText}" VerticalAlignment="Center" Margin="0,0,5,0">
                      <Ellipse.Triggers>
                        <EventTrigger RoutedEvent="Loaded">
                          <BeginStoryboard>
                            <Storyboard RepeatBehavior="Forever">
                              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.2" Duration="0:0:0.6" AutoReverse="True"/>
                            </Storyboard>
                          </BeginStoryboard>
                        </EventTrigger>
                      </Ellipse.Triggers>
                    </Ellipse>
                    <TextBlock Text="STRESS" FontSize="{StaticResource FontSizeXS}" FontWeight="Bold" Foreground="{DynamicResource Lift.DangerText}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TxtDiskStressTimer" Text="" FontSize="{StaticResource FontSizeXS}" FontWeight="Bold" Foreground="{DynamicResource Lift.DangerText}" VerticalAlignment="Center" Typography.NumeralAlignment="Tabular"/>
                  </StackPanel>
                </Border>
              </StackPanel>
              <TextBlock x:Name="TxtDiskSubtitle" Text="Health • SMART • Surface Scan • Benchmark" Style="{StaticResource PageSubtitleStyle}"/>
            </StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
              <!-- Auto Clean — a useful shortcut next to the other actions -->
              <ui:Button Appearance="Secondary" HorizontalAlignment="Right" VerticalAlignment="Center"
                      ToolTip="Open internal Auto Clean tool — free disk space (Temp, Prefetch, WinUpdate cache, thumbnails)"
                      Click="ShortcutAutoClean_Click" Margin="0,0,6,4">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                      <Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M22.45,1.92 C22.75,2.22 22.75,2.69 22.45,2.98 L15.52,9.91 A5.75,5.75 0 0 1 15.02,17.48 L14.2,18.31 L11.41,22.49 A0.75,0.75 0 0 1 10.26,22.61 L1.77,14.12 A0.75,0.75 0 0 1 1.88,12.97 L6.07,10.17 L6.9,9.35 A5.75,5.75 0 0 1 14.46,8.85 L21.39,1.92 C21.69,1.63 22.16,1.63 22.45,1.92 M7.6,10.76 L13.61,16.77 L13.97,16.42 A4.25,4.25 0 0 0 7.96,10.41 Z M6.45,11.73 L3.48,13.7 L10.67,20.89 L12.65,17.92 Z"/>
                    </Canvas>
                  </Viewbox>
                  <TextBlock Text="Auto Clean" VerticalAlignment="Center"/>
                </StackPanel>
              </ui:Button>
              <ui:Button x:Name="BtnStorageDevMgr" Appearance="Secondary"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Click="BtnStorageDevMgr_Click" Margin="0,0,6,4"
                      ToolTip="Open Disk Management — create, delete and resize partitions">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Viewbox Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                      <Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M9.25,6 A0.75,0.75 0 0 0 9.25,7.5 L14.75,7.5 A0.75,0.75 0 0 0 14.75,6 Z M8.5,17.75 C8.5,17.34 8.84,17 9.25,17 L14.75,17 A0.75,0.75 0 0 1 14.75,18.5 L9.25,18.5 A0.75,0.75 0 0 1 8.5,17.75 M9.25,14 A0.75,0.75 0 0 0 9.25,15.5 L14.75,15.5 A0.75,0.75 0 0 0 14.75,14 Z M6,5 A3,3 0 0 1 9,2 L15,2 A3,3 0 0 1 18,5 L18,19 A3,3 0 0 1 15,22 L9,22 A3,3 0 0 1 6,19 Z M9,3.5 C8.17,3.5 7.5,4.17 7.5,5 L7.5,19 C7.5,19.83 8.17,20.5 9,20.5 L15,20.5 C15.83,20.5 16.5,19.83 16.5,19 L16.5,5 C16.5,4.17 15.83,3.5 15,3.5 Z"/>
                    </Canvas>
                  </Viewbox>
                  <TextBlock Text="Disk Management" VerticalAlignment="Center"/>
                </StackPanel>
              </ui:Button>
              <ui:Button Appearance="Secondary"
                      HorizontalAlignment="Right" VerticalAlignment="Center"
                      Click="OpenDiskpart_Click" Margin="0,0,0,4"
                      ToolTip="Open Diskpart as Administrator — advanced partition and disk management">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                      <Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M6.78,10.98 C7.02,10.74 7.38,10.74 7.62,10.98 L10.02,13.38 A0.6,0.6 0 0 1 10.02,14.22 L7.62,16.62 A0.6,0.6 0 0 1 6.78,15.78 L8.75,13.8 L6.78,11.82 A0.6,0.6 0 0 1 6.78,10.98 M17.4,15.6 L11.4,15.6 A0.6,0.6 0 0 0 11.4,16.8 L17.4,16.8 A0.6,0.6 0 0 0 17.4,15.6 M3.6,6.6 A3,3 0 0 1 6.6,3.6 L17.4,3.6 A3,3 0 0 1 20.4,6.6 L20.4,17.4 A3,3 0 0 1 17.4,20.4 L6.6,20.4 A3,3 0 0 1 3.6,17.4 Z M19.2,7.2 L19.2,6.6 C19.2,5.6 18.38,4.8 17.4,4.8 L6.6,4.8 C5.6,4.8 4.8,5.6 4.8,6.6 L4.8,7.2 Z M4.8,8.4 L4.8,17.4 C4.8,18.4 5.6,19.2 6.6,19.2 L17.4,19.2 C18.38,19.2 19.2,18.4 19.2,17.4 L19.2,8.4 Z"/>
                    </Canvas>
                  </Viewbox>
                  <TextBlock Text="Diskpart" VerticalAlignment="Center"/>
                </StackPanel>
              </ui:Button>
            </WrapPanel>
          </Grid>

          <!-- The tabs + the shared "Disk activity" card (on Overview, SMART, Surface scan, Benchmark — not on Large files) + the
               "All drives" card on Overview. Data: MainWindow.StoragePage.cs. -->
          <StackPanel Grid.Row="1" Margin="0,0,0,10">
                        <Border Style="{StaticResource SegmentTrackStyle}" Tag="SegTrack"><WrapPanel>
              <ui:Button x:Name="BtnStorageTabOverview" Appearance="Secondary" Background="{DynamicResource SelBtnBg}" BorderBrush="{DynamicResource SelBtnBorderBrush}" BorderThickness="1" FontWeight="SemiBold"
                      Click="StorageTab_Click" Tag="Overview" Margin="0,0,2,0"
                      ToolTip="Disk health and general info">
                <StackPanel Orientation="Horizontal"><Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path x:Name="IconStorageTabOverview" Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M4,6 C4,5.3 4.32,4.7 4.77,4.22 A6,6 0 0 1 6.57,3.02 A14,14 0 0 1 12,2 C14.08,2 16,2.38 17.43,3.02 Q18.53,3.5 19.23,4.22 C19.68,4.71 20,5.31 20,6 L20,18 C20,18.7 19.68,19.3 19.23,19.78 Q18.53,20.5 17.43,20.98 A14,14 0 0 1 12,22 C9.92,22 8,21.62 6.57,20.98 A6,6 0 0 1 4.77,19.78 A2.6,2.6 0 0 1 4,18 Z M5.5,6 C5.5,6.2 5.59,6.46 5.87,6.75 Q6.27,7.21 7.18,7.61 C8.38,8.15 10.08,8.5 12,8.5 C13.92,8.5 15.62,8.15 16.82,7.61 Q17.72,7.21 18.13,6.75 C18.41,6.45 18.5,6.21 18.5,6 C18.5,5.79 18.41,5.54 18.13,5.25 Q17.73,4.79 16.82,4.39 C15.62,3.85 13.92,3.5 12,3.5 C10.08,3.5 8.38,3.85 7.18,4.39 Q6.28,4.79 5.87,5.25 C5.59,5.55 5.5,5.79 5.5,6 M18.5,8.4 A7,7 0 0 1 17.43,8.98 A14,14 0 0 1 12,10 C9.92,10 8,9.62 6.57,8.98 A7,7 0 0 1 5.5,8.4 L5.5,18 C5.5,18.2 5.59,18.46 5.87,18.75 Q6.27,19.21 7.18,19.61 C8.38,20.15 10.08,20.5 12,20.5 C13.92,20.5 15.62,20.15 16.82,19.61 Q17.72,19.21 18.13,18.75 C18.41,18.45 18.5,18.21 18.5,18 Z"/></Canvas></Viewbox><TextBlock x:Name="TxtStorageTabOverviewLbl" Text="Overview" VerticalAlignment="Center"/></StackPanel>
              </ui:Button>
              <ui:Button x:Name="BtnStorageTabSmart" Appearance="Secondary" Background="Transparent" BorderBrush="Transparent"
                      Click="StorageTab_Click" Tag="Smart" Margin="0,0,2,0"
                      ToolTip="SMART health attributes">
                <StackPanel Orientation="Horizontal"><Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path x:Name="IconStorageTabSmart" Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M3,5.75 C3,5.34 3.34,5 3.75,5 Q7.74,5 11.55,2.15 C11.82,1.95 12.18,1.95 12.45,2.15 Q16.26,5 20.25,5 C20.66,5 21,5.34 21,5.75 L21,11 Q21,11.5 20.96,12 A7,7 0 0 0 19.5,11.31 L19.5,6.48 A14.4,14.4 0 0 1 12,3.68 A14.4,14.4 0 0 1 4.5,6.48 L4.5,11 C4.5,15.15 6.83,18.22 11.63,20.28 Q12.03,21.12 12.63,21.8 L12.27,21.95 A0.8,0.8 0 0 1 11.73,21.95 C5.96,19.68 3,16 3,11 Z M23,17.5 A5.5,5.5 0 0 1 12,17.5 A5.5,5.5 0 0 1 23,17.5 M20.85,15.15 A0.5,0.5 0 0 0 20.15,15.15 L16.5,18.79 L14.85,17.15 A0.5,0.5 0 0 0 14.15,17.85 L16.15,19.85 C16.35,20.05 16.65,20.05 16.85,19.85 L20.85,15.85 A0.5,0.5 0 0 0 20.85,15.15"/></Canvas></Viewbox><TextBlock Text="SMART" VerticalAlignment="Center"/></StackPanel>
              </ui:Button>
              <ui:Button x:Name="BtnStorageTabSurface" Appearance="Secondary" Background="Transparent" BorderBrush="Transparent"
                      Click="StorageTab_Click" Tag="Surface" Margin="0,0,2,0"
                      ToolTip="Scan disk surface for bad sectors">
                <StackPanel Orientation="Horizontal"><Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path x:Name="IconStorageTabSurface" Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M16.1,17.16 A8,8 0 1 1 17.16,16.1 L21.78,20.72 A0.75,0.75 0 1 1 20.72,21.78 Z M17.5,11 A6.5,6.5 0 0 0 4.5,11 A6.5,6.5 0 0 0 17.5,11"/></Canvas></Viewbox><TextBlock x:Name="TxtStorageTabSurfaceLbl" Text="Surface Scan" VerticalAlignment="Center"/></StackPanel>
              </ui:Button>
              <ui:Button x:Name="BtnStorageTabBench" Appearance="Secondary" Background="Transparent" BorderBrush="Transparent"
                      Click="StorageTab_Click" Tag="Bench" Margin="0,0,2,0"
                      ToolTip="Disk read/write speed benchmark">
                <StackPanel Orientation="Horizontal"><Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path x:Name="IconStorageTabBench" Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M7.43,2.83 C7.6,2.33 8.07,2 8.6,2 L15.06,2 C15.91,2 16.51,2.84 16.24,3.65 L14.8,8 L18.76,8 C19.86,8 20.43,9.33 19.66,10.12 L8.59,21.54 C7.53,22.62 5.71,21.64 6.04,20.16 L7.31,14.5 L5.75,14.49 C4.54,14.49 3.7,13.29 4.1,12.15 Z M8.78,3.5 L5.52,12.66 C5.46,12.82 5.58,12.99 5.75,12.99 L8.25,13 A0.75,0.75 0 0 1 8.98,13.91 L7.51,20.5 L18.16,9.5 L13.75,9.5 A0.75,0.75 0 0 1 13.04,8.51 L14.7,3.5 Z"/></Canvas></Viewbox><TextBlock x:Name="TxtStorageTabBenchLbl" Text="Benchmark" VerticalAlignment="Center"/></StackPanel>
              </ui:Button>
              <ui:Button x:Name="BtnStorageTabFiles" Appearance="Secondary" Background="Transparent" BorderBrush="Transparent"
                      Click="StorageTab_Click" Tag="Files"
                      ToolTip="Which folders and files use the most space, and what can be cleaned">
                <StackPanel Orientation="Horizontal"><Viewbox Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M3.5,6.25 L3.5,8 L8.13,8 Q8.44,8 8.66,7.78 L10.19,6.25 L8.66,4.72 A0.8,0.8 0 0 0 8.13,4.5 L5.25,4.5 C4.28,4.5 3.5,5.28 3.5,6.25 M2,6.25 C2,4.45 3.46,3 5.25,3 L8.13,3 C8.73,3 9.3,3.24 9.72,3.66 L11.56,5.5 L18.75,5.5 C20.55,5.5 22,6.96 22,8.75 L22,17.75 C22,19.55 20.54,21 18.75,21 L5.25,21 A3.25,3.25 0 0 1 2,17.75 Z M3.5,9.5 L3.5,17.75 C3.5,18.72 4.28,19.5 5.25,19.5 L18.75,19.5 C19.72,19.5 20.5,18.72 20.5,17.75 L20.5,8.75 C20.5,7.78 19.72,7 18.75,7 L11.56,7 L9.72,8.84 C9.3,9.26 8.72,9.5 8.12,9.5 Z"/></Canvas></Viewbox><TextBlock x:Name="TxtStorageTabFilesLbl" Text="Space usage" VerticalAlignment="Center"/></StackPanel>
              </ui:Button>
            </WrapPanel></Border>
            <Grid x:Name="StorageTopRow" Margin="0,10,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <Border x:Name="StorageActivityCard" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="18,14,18,12">
                <Grid>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                  <DockPanel Margin="0,0,0,8" LastChildFill="True">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                      <Border Width="14" Height="3" CornerRadius="1.5" Background="{DynamicResource DataBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBlock Text="read" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
                      <Border Width="14" Height="3" CornerRadius="1.5" Background="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                      <TextBlock Text="write" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,16,0"/>
                      <Border x:Name="StActWin60" Tag="60" CornerRadius="4,0,0,4" Padding="10,3" Cursor="Hand" Background="{DynamicResource BgCardBrush}" MouseLeftButtonUp="StorageActWin_Click"><TextBlock Text="60s" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"/></Border><Border x:Name="StActWin300" Tag="300" CornerRadius="0" Padding="10,3" Cursor="Hand" Background="{DynamicResource BgCardBrush}" MouseLeftButtonUp="StorageActWin_Click"><TextBlock Text="5m" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"/></Border><Border x:Name="StActWin900" Tag="900" CornerRadius="0" Padding="10,3" Cursor="Hand" Background="{DynamicResource BgCardBrush}" MouseLeftButtonUp="StorageActWin_Click"><TextBlock Text="15m" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"/></Border><Border x:Name="StActWin3600" Tag="3600" CornerRadius="0,4,4,0" Padding="10,3" Cursor="Hand" Background="{DynamicResource BgCardBrush}" MouseLeftButtonUp="StorageActWin_Click"><TextBlock Text="1h" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"/></Border>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                      <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M8.46,6.8 L11.75,20.43 C11.92,21.16 12.95,21.2 13.19,20.48 L16.45,10.36 L17.03,12.46 C17.13,12.78 17.42,13 17.75,13 L21.25,13 A0.75,0.75 0 0 0 21.25,11.5 L18.32,11.5 L17.22,7.55 A0.75,0.75 0 0 0 15.78,7.52 L12.58,17.48 L9.23,3.58 C9.04,2.82 7.97,2.81 7.77,3.56 L5.67,11.5 L2.75,11.5 A0.75,0.75 0 0 0 2.75,13 L6.25,13 C6.59,13 6.88,12.77 6.97,12.44 Z"/></Viewbox>
                      <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock Text="Disk activity" Style="{StaticResource DashRowName}"/>
                          <TextBlock x:Name="TxtStActTitle" Text="All drives" Style="{StaticResource DashRowInlineSub}"/>
                        </StackPanel>
                      </StackPanel>
                    </StackPanel>
                  </DockPanel>
                  <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
                    <local:MiniLineChart x:Name="StorageActChart" Height="62" Capacity="300" VerticalAlignment="Center"/>
                    <!-- only on Surface scan: the scan speed (now / min / average / max) -->
                    <StackPanel x:Name="StActScanStats" Grid.Column="1" Width="230" Margin="16,0,0,0" Visibility="Collapsed">
                      <DockPanel Margin="0,0,0,6"><TextBlock Text="Scan speed now" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom"/>
                      <TextBlock x:Name="TxtStActScanNow" Text="—" Style="{StaticResource CompChartValue}" FontSize="20"/></DockPanel>
                      <UniformGrid Columns="3">
                        <StackPanel><TextBlock Text="min" Style="{StaticResource CompFootKey}"/><TextBlock Text="{Binding Text, ElementName=TxtSurfaceSpeedMin, StringFormat='{}{0} MB/s'}" Style="{StaticResource CompFootVal}"/></StackPanel>
                        <StackPanel><TextBlock Text="average" Style="{StaticResource CompFootKey}"/><TextBlock Text="{Binding Text, ElementName=TxtSurfaceSpeedAvg, StringFormat='{}{0} MB/s'}" Style="{StaticResource CompFootVal}"/></StackPanel>
                        <StackPanel><TextBlock Text="max" Style="{StaticResource CompFootKey}"/><TextBlock Text="{Binding Text, ElementName=TxtSurfaceSpeedMax, StringFormat='{}{0} MB/s'}" Style="{StaticResource CompFootVal}"/></StackPanel>
                      </UniformGrid>
                    </StackPanel>
                    <Border Grid.Column="2" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1,0,0,0" Padding="16,0,0,0" Margin="16,0,0,0">
                      <StackPanel VerticalAlignment="Center">
                        <DockPanel Margin="0,0,0,6"><TextBlock Text="Read" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom"/>
                      <TextBlock x:Name="TxtStActRead" Text="—" Style="{StaticResource CompChartValue}" FontSize="20" Foreground="{DynamicResource DataBrush}"/></DockPanel>
                        <DockPanel Margin="0,0,0,6"><TextBlock Text="Write" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom"/>
                      <TextBlock x:Name="TxtStActWrite" Text="—" Style="{StaticResource CompChartValue}" FontSize="20"/></DockPanel>
                        <DockPanel Margin="0,0,0,6"><TextBlock Text="Response time" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom"/>
                      <TextBlock x:Name="TxtStActLat" Text="—" Style="{StaticResource CompChartValue}" FontSize="15"/></DockPanel>
                      </StackPanel>
                    </Border>
                  </Grid>
                </Grid>
              </Border>
            </Grid>
          </StackPanel>

          <!-- ── Tab: Overview ── -->
          <ScrollViewer x:Name="StorageTabOverview" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <!-- at least as tall as the visible area: the drive cards share the free height, the maintenance cards sit at the bottom,
                 so the page has no empty band under them; with more content than fits, the page scrolls as before -->
            <Grid MinHeight="{Binding ViewportHeight, ElementName=StorageTabOverview}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Grid.Row="0">

              <StackPanel Visibility="Collapsed">
                <TextBlock x:Name="TxtStorageActivePct"/>
                <TextBlock x:Name="TxtStorageAvgMs"/>
                <TextBlock x:Name="TxtStorageLiveRead"/>
                <TextBlock x:Name="TxtStorageLiveWrite"/>
              </StackPanel>
                            <Border Visibility="Collapsed" Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="16,10">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="100"/>
                  </Grid.RowDefinitions>
                  <!-- Disk Activity header — a Grid with 3 fixed columns so the time buttons do not move when the read/write values change -->
                  <Grid Grid.Row="0" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto"/>  <!-- Title -->
                      <ColumnDefinition Width="*"/>     <!-- Window buttons — centred, they do not move -->
                      <ColumnDefinition Width="360"/>                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="TxtDiskActivityTitle1" Text="Disk Activity" FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                    ToolTip="Combined read/write activity across ALL storage devices — not just the drive selected above."
                               Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <!-- Time window buttons — centred in the * column -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                      <TextBlock x:Name="TxtDiskWindowLabel1" Text="Range: " FontSize="{StaticResource FontSizeS}" VerticalAlignment="Center"
                                 Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/>
                      <Border x:Name="StorageWin60" CornerRadius="4,0,0,4" Padding="10,3"
                              Background="{DynamicResource BgCardBrush}" Cursor="Hand"
                              MouseLeftButtonUp="StorageWin60_Click">
                        <TextBlock Text="60s" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </Border>
                      <Border x:Name="StorageWin5m" CornerRadius="0" Padding="10,3"
                              Background="{DynamicResource SelBtnBg}" Cursor="Hand"
                              MouseLeftButtonUp="StorageWin5m_Click">
                        <TextBlock Text="5m" FontSize="{StaticResource FontSizeXS}" FontWeight="SemiBold" Foreground="{DynamicResource SelBtnFg}"/>
                      </Border>
                      <Border x:Name="StorageWin10m" CornerRadius="0" Padding="10,3"
                              Background="{DynamicResource BgCardBrush}" Cursor="Hand"
                              MouseLeftButtonUp="StorageWin10m_Click">
                        <TextBlock Text="15m" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                      </Border>
                      <Border x:Name="StorageWin1h" CornerRadius="0,4,4,0" Padding="10,3"
                              Background="{DynamicResource BgCardBrush}" Cursor="Hand"
                              MouseLeftButtonUp="StorageWin1h_Click">
