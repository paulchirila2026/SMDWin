              </UniformGrid>

              <!-- compat stub for shortcut result text — moved to header -->
              <TextBlock x:Name="TxtShortcutResult" Visibility="Collapsed"/>

            </StackPanel>
            </Grid>
          </ScrollViewer>

          <!-- ── Tab: SMART ── -->
          <Grid x:Name="StorageTabSmart" Grid.Row="2" Visibility="Collapsed">
