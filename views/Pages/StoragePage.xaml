                </Grid>
              </Border>
            </StackPanel>
              <!-- one card per drive (MainWindow.StoragePage.cs → BuildStorageDriveRows); one column, the rows share the height -->
              <UniformGrid x:Name="StorageDriveRows" Grid.Row="1" Columns="1"/>
