            <Border Visibility="Collapsed" Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,8" Padding="16,10">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="100"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,6">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="360"/>                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" x:Name="TxtDiskActivityTitle2" Text="Disk Activity" FontSize="{StaticResource FontSizeL}" FontWeight="SemiBold"
                    ToolTip="Combined read/write activity across ALL storage devices — not just the drive selected above."
                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                  <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtDiskWindowLabel2" Text="Range: " FontSize="{StaticResource FontSizeS}" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7"/>
