                      <TextBlock Text="60s" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                    <Border x:Name="SmartDiskWin5m" CornerRadius="0" Padding="10,3"
