                      <StackPanel x:Name="RowBatCycles" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal">
                        <TextBlock x:Name="TxtChargeCyclesLabel" Text="Charge cycles" Style="{StaticResource CompFootKey}" Margin="0,0,14,0"/>
                      </StackPanel>
                      <TextBlock x:Name="TxtBatCycles" Grid.Row="1" Grid.Column="1" Text="" Style="{StaticResource CompFootVal}" HorizontalAlignment="Right"
