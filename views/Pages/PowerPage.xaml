                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="Active plan" Style="{StaticResource DashRowCaption}"/>
                      <TextBlock x:Name="TxtLabelActivePowerPlan" Visibility="Collapsed" Text="ACTIVE POWER PLAN" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75" Margin="0,0,0,2"/><TextBlock x:Name="TxtActivePowerPlan" Text="—" Style="{StaticResource DashRowName}"/>
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
                <!-- the three plans as three cards with an image (leaf · scale · rocket); the content and the marking of the active plan
                     are done from code (MainWindow.PowerPlanCards.cs) -->
                <UniformGrid x:Name="PowerPlanCards" Columns="3" Rows="1" Margin="0,2,0,8">
                  <ui:Button x:Name="BtnPlanPowerSaver" Tag="a1841308-3541-4fab-bc81-f71556f20b4a" Appearance="Secondary" Click="SetPowerPlan_Click"
                             Margin="0,0,6,0" Padding="10,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Top"/>
                  <ui:Button x:Name="BtnPlanBalanced" Tag="381b4222-f694-41f0-9685-ff5bb260df2e" Appearance="Secondary" Click="SetPowerPlan_Click"
                             Margin="3,0,3,0" Padding="10,9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" VerticalContentAlignment="Top"/>
                  <ui:Button x:Name="BtnPlanHighPerf" Tag="8c5e7fda-e8bf-4a96-9a85-a6e23a8c635c" Appearance="Secondary" Click="SetPowerPlan_Click"
