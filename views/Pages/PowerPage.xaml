                </StackPanel>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                  <TextBlock Text="Runtime" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75"/>
                  <TextBlock x:Name="TxtUpsRuntime" Text="—" FontSize="{StaticResource FontSizeL}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
              </Grid>
            </Border>
            <!-- laptop: "When the PC is not used" (on a PC it sits in the top-left card); MainWindow.PowerSimple.cs -->
            <Border x:Name="PowerIdleCard" DockPanel.Dock="Top" Visibility="Collapsed" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="18,14,18,12" Margin="0,0,0,12">
              <StackPanel>
                <TextBlock x:Name="TxtPowerIdleTitle" Text="When the PC is not used" Style="{StaticResource DashRowName}" Margin="0,0,0,8"/>
                <StackPanel x:Name="PowerIdleHostLaptop"/>
              </StackPanel>
            </Border>
            <Border x:Name="PowerSleepCard" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="18,12,18,10" Margin="0">
              <StackPanel>
                <DockPanel Margin="0,0,0,8" LastChildFill="True">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><ui:Button x:Name="BtnPowerDiagRefresh" Appearance="Secondary" Padding="10,4" Margin="10,0,0,0"
                               Click="PowerDiagRefresh_Click" Content="Refresh"/></StackPanel>
                  <StackPanel Orientation="Horizontal">
                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M20.03,17 A10,10 0 0 1 3.13,17.68 A0.75,0.75 0 0 1 3.49,16.55 C7.26,15.2 9.28,13.64 10.45,11.4 C11.68,9.05 12,6.47 11.14,2.94 A0.75,0.75 0 0 1 11.9,2 A10,10 0 0 1 20.03,17 M11.78,12.1 C10.53,14.49 8.47,16.2 4.96,17.6 A8.5,8.5 0 0 0 18.73,16.25 A8.5,8.5 0 0 0 12.83,3.62 C13.47,7.01 13.05,9.67 11.78,12.1"/></Viewbox>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock x:Name="TxtPowerSleepTitle" Text="Sleep" Style="{StaticResource DashRowName}" ToolTip="What keeps the PC awake or wakes it up"/>
                    </StackPanel>
                  </StackPanel>
                </DockPanel>
                <!-- linia de timp a somnului, subtire (MainWindow.PowerPlanCards.cs → UpdateSleepTimeline) -->
                <Grid x:Name="SleepTimeline" Margin="0,2,0,10" Visibility="Collapsed"/>
                <TextBlock x:Name="TxtPowerSleepSummary" Text="Reading…" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock Visibility="Collapsed" Text="{Binding Text, ElementName=TxtSleepStates}" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <StackPanel x:Name="PowerSleepHost" Margin="0,0,0,2"/>
                <Expander x:Name="ExpPowerSleep" IsExpanded="True" Visibility="Collapsed"/>
              </StackPanel>
            </Border>
              </DockPanel>
              <DockPanel x:Name="PowerColRightStack" Grid.Column="2" LastChildFill="True">
            <Border x:Name="BatDrainCard" Style="{StaticResource CompCardStyle}" Cursor="Arrow">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <Viewbox Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M8.46,6.8 L11.75,20.43 C11.92,21.16 12.95,21.2 13.19,20.48 L16.45,10.36 L17.03,12.46 C17.13,12.78 17.42,13 17.75,13 L21.25,13 A0.75,0.75 0 0 0 21.25,11.5 L18.32,11.5 L17.22,7.55 A0.75,0.75 0 0 0 15.78,7.52 L12.58,17.48 L9.23,3.58 C9.04,2.82 7.97,2.81 7.77,3.56 L5.67,11.5 L2.75,11.5 A0.75,0.75 0 0 0 2.75,13 L6.25,13 C6.59,13 6.88,12.77 6.97,12.44 Z"/></Viewbox>
                  <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Top consumers" Style="{StaticResource DashRowCaption}"/>
                    <TextBlock Text="By processor use" Style="{StaticResource DashRowName}"
                               ToolTip="Apps using the processor the most right now — they drain the battery fastest. Updates every 10 seconds."/>
                  </StackPanel>
                </StackPanel>
                <StackPanel x:Name="PowerTopList" Grid.Row="1" VerticalAlignment="Top" Margin="0,6,0,0"/>
                <!-- the older table (list, context menu) — hidden, the code uses it as a source -->
                <Border Grid.Row="1" Visibility="Collapsed">
                <Expander x:Name="ExpAppDrain" IsExpanded="True">
                <Expander.Header>
                  <Grid Margin="0,0,0,0" HorizontalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                      <TextBlock Text="App Power Usage" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextPrimaryBrush}"/>
                      <TextBlock x:Name="TxtAppDrainStatus" FontSize="{StaticResource FontSizeS}"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 Text="Loading..."
                                 Margin="0,2,0,0"/>
                    </StackPanel>
                  </Grid>
                </Expander.Header>
              <StackPanel Margin="0,10,0,0">
                <DataGrid Style="{StaticResource VanillaDataGridStyle}" x:Name="LstAppDrain" AutoGenerateColumns="False" IsReadOnly="True"
                          MaxHeight="205" BorderThickness="0" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{DynamicResource BorderBrush}"
                          RowBackground="Transparent"
                          AlternatingRowBackground="{DynamicResource RowAltBrush}"
                          RowHeight="32" ColumnHeaderHeight="30" FontSize="{StaticResource FontSizeS}"
                          HeadersVisibility="Column"
                          MouseDoubleClick="AppDrainGrid_DoubleClick"
                          CanUserReorderColumns="False" CanUserResizeColumns="True" CanUserSortColumns="False"
                          SelectionMode="Single" SelectionUnit="FullRow">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Application" Binding="{Binding Name}" Width="*"
                                        ElementStyle="{StaticResource DataGridCellTextStyle}"/>
                    <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="110"
                                        ElementStyle="{StaticResource DataGridCellTextStyle}"/>
                    <DataGridTemplateColumn Header="CPU Usage" Width="*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Grid VerticalAlignment="Center" Margin="4,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="44"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Usage}" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                                       Foreground="{Binding BarColor, Converter={StaticResource ThemeStatusBrush}}" VerticalAlignment="Center"/>
                            <Border Grid.Column="1" Height="7" CornerRadius="4" Margin="4,0,6,0"
                                    Background="{DynamicResource BgInputBrush}" VerticalAlignment="Center"
                                    ClipToBounds="True">
                              <Rectangle Height="7" HorizontalAlignment="Left"
                                         Width="{Binding RelativeSource={RelativeSource AncestorType=Border}, Path=ActualWidth}"
                                         Fill="{Binding BarColor, Converter={StaticResource ThemeStatusBrush}}">
                                <Rectangle.RenderTransform>
                                  <ScaleTransform ScaleX="{Binding BarRatio}" ScaleY="1" CenterX="0" CenterY="0"/>
                                </Rectangle.RenderTransform>
                              </Rectangle>
                            </Border>
                          </Grid>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Level" Width="70">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <Border CornerRadius="6" Padding="6,2" Margin="4,0" HorizontalAlignment="Center"
                                  Background="{Binding LevelBg}">
                            <TextBlock Text="{Binding UsageLevel}" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                                       Foreground="{Binding BarColor, Converter={StaticResource ThemeStatusBrush}}" HorizontalAlignment="Center"/>
                          </Border>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                  <DataGrid.ContextMenu>
                    <ContextMenu>
                      <MenuItem Header="View process details" Click="AppDrainDetails_Click"/>
                      <MenuItem Header="Open Task Manager" Click="AppDrainAnalyze_Click"/>
                      <Separator/>
                      <MenuItem Header="Kill process" Click="AppDrainKill_Click"/>
                    </ContextMenu>
                  </DataGrid.ContextMenu>
                </DataGrid>
                <ui:Button x:Name="BtnToggleAppDrainExpand" Click="ToggleAppDrainExpand_Click" Appearance="Secondary" HorizontalAlignment="Left" Margin="4,8,0,0" Padding="10,4">
                  <TextBlock x:Name="TxtToggleAppDrainExpand" Text="Show all" FontSize="{StaticResource FontSizeS}"/>
                </ui:Button>
              </StackPanel>
              </Expander>
                </Border>
              </Grid>
            </Border>
              </DockPanel>
            </Grid>
            <!-- Start-up and shut-down: Fast Startup · Hibernate · sleep type · reset plans (MainWindow.PowerSimple.cs) -->
            <Border x:Name="PowerStartupCard" Grid.Row="4" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="18,12,18,14" Margin="0,12,0,4">
              <StackPanel>
                <TextBlock x:Name="TxtPowerStartupTitle" Text="Start-up and shut-down" Style="{StaticResource DashRowName}" Margin="0,0,0,10"/>
                <UniformGrid x:Name="PowerStartupHost" Rows="1" Columns="4"/>
              </StackPanel>
            </Border>
            <StackPanel Grid.Row="5" Visibility="Collapsed">
              <TextBlock x:Name="TxtBatteryInfo" Visibility="Collapsed"/>
            <Border x:Name="AdvancedPowerCard" Visibility="Collapsed">
              <Expander x:Name="ExpAdvancedPower" IsExpanded="False"
                        Expanded="ExpAdvancedPower_UserToggled" Collapsed="ExpAdvancedPower_UserToggled">
                <Expander.Header>
                  <StackPanel Margin="-4,4,0,4">
                    <TextBlock x:Name="TxtAdvancedPowerTitle" Text="Advanced Power" FontSize="{StaticResource FontSizeM}" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TxtSleepStates" Text="Sleep states available: —" FontSize="{StaticResource FontSizeXS}"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" Opacity="0.8"/>
                  </StackPanel>
                </Expander.Header>
              </Expander>
            </Border>
            </StackPanel>
            </Grid>
          </Grid>
        </ScrollViewer>
</UserControl>
