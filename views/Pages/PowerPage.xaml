                </DockPanel>
                  <Border Grid.Column="3" Background="{DynamicResource CardBorderBrush}" Margin="0,4"/>
                  <StackPanel Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Center" MinWidth="200" Margin="24,0,4,0">
