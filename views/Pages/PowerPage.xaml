                  <UniformGrid x:Name="CpuModeHost" Rows="1" Columns="3"/>
                </Border>
                <TextBlock x:Name="TxtCpuModeExplain" Text="" TextWrapping="Wrap" Margin="0,6,0,8" FontSize="{StaticResource FontSizeS}"
