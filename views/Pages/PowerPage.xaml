                    <Grid x:Name="PowerAdvancedPanel" Width="420" Margin="0,4,12,14">
                      <!-- the shadow sits on its own layer: an effect on the element with text would blur the text -->
                      <Border Background="{DynamicResource BgCardBrush}" CornerRadius="10" Effect="{StaticResource CardShadow}" IsHitTestVisible="False"/>
                      <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16,12,16,10">
                <StackPanel Margin="0,2,0,4">

                <!-- Plugged in / On battery: laptop only (a PC has a single profile) — FitPowerCards -->
                <StackPanel x:Name="PowerProfileRow" Orientation="Horizontal" Margin="0,0,0,8">
                  <TextBlock Text="Profile:" Style="{StaticResource TimeRangeLabelStyle}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                  <Border Style="{StaticResource SegmentTrackStyle}" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                      <RadioButton x:Name="RbPowerProfileAC" Content="Plugged in" Tag="AC" GroupName="PowerProfileGroup" IsChecked="True"
                                   Style="{StaticResource SegmentChipStyle}" Checked="PowerProfileChip_Checked"/>
                      <RadioButton x:Name="RbPowerProfileDC" Content="On battery" Tag="DC" GroupName="PowerProfileGroup"
                                   Style="{StaticResource SegmentChipStyle}" Checked="PowerProfileChip_Checked"/>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <!-- Processor Performance Boost Mode -->
                <Grid Margin="0,2,0,5">
