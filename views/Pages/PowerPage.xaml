                      </Border>
                    </StackPanel>
                    <TextBlock x:Name="TxtDescBoostMode" Text="Turbo gives full speed. Turn it off for less heat and a quieter fan." FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <Grid Grid.Column="1" VerticalAlignment="Center">
                    <ToggleButton x:Name="BtnBoostModeDropdown" Style="{StaticResource DropdownToggleStyle}" Width="170"
