                        <Border Background="{DynamicResource BgCardBrush}" BorderBrush="{DynamicResource CardBorderBrush}"
                              BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" MinWidth="170"
                              Margin="0,4,0,0">
