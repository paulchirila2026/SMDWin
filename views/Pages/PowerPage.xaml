                          <Button x:Name="CmbBoostDisabled" Content="Disabled" Tag="0" Click="BoostModeOption_Click" Style="{StaticResource DropdownItemStyle}"/>
                          <Button x:Name="CmbBoostEnabled" Content="Enabled" Tag="1" Click="BoostModeOption_Click" Style="{StaticResource DropdownItemStyle}"/>
                          <Button x:Name="CmbBoostAggressive" Content="Aggressive" Tag="2" Click="BoostModeOption_Click" Style="{StaticResource DropdownItemStyle}"/>
                          <Button x:Name="CmbBoostEfficientEnabled" Content="Efficient Enabled" Tag="3" Click="BoostModeOption_Click" Style="{StaticResource DropdownItemStyle}"/>
                          <Button x:Name="CmbBoostEfficientAggressive" Content="Efficient Aggressive" Tag="4" Click="BoostModeOption_Click" Style="{StaticResource DropdownItemStyle}"/>
                        </StackPanel>
                      </Border>
                      </Grid>
                    </Popup>
                  </Grid>
                </Grid>

                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Opacity="0.4" Margin="0,3,0,5"/>


                <!-- Min/Max Processor State — a single control with 2 handles -->
                <Grid Margin="0,2,0,4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="0" x:Name="TxtLabelProcStateRange" Text="Processor State Range (Min – Max)" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                  <TextBlock x:Name="TxtProcStateRange" Grid.Column="1" Text="5% – 100%" FontSize="{StaticResource FontSizeM}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" TextAlignment="Right" VerticalAlignment="Center"/>
                </Grid>
                <TextBlock x:Name="TxtDescProcStateRange" Text="Limit the processor speed" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                <Grid x:Name="ProcStateRangeTrack" Height="24" Margin="0,0,0,8" SizeChanged="ProcStateRangeTrack_SizeChanged">
                  <Border Height="4" VerticalAlignment="Center" Background="{DynamicResource TextSecondaryBrush}" Opacity="0.35" CornerRadius="2"/>
                  <Canvas>
                    <Border x:Name="ProcStateRangeFill" Height="4" Canvas.Top="10" Background="{DynamicResource AccentBrush}" CornerRadius="2"/>
                    <Thumb x:Name="ThumbProcStateMin" Width="18" Height="18" Canvas.Top="3"
