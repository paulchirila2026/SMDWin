                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Ellipse Width="18" Height="18" Fill="{DynamicResource AccentBrush}" Stroke="White" StrokeThickness="2"/>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                    <Thumb x:Name="ThumbProcStateMax" Width="18" Height="18" Canvas.Top="3"
                           DragDelta="ThumbProcStateMax_DragDelta" DragCompleted="ThumbProcState_DragCompleted" Cursor="Hand">
                      <Thumb.Template>
                        <ControlTemplate TargetType="Thumb">
                          <Ellipse Width="18" Height="18" Fill="{DynamicResource AccentBrush}" Stroke="White" StrokeThickness="2"/>
                        </ControlTemplate>
                      </Thumb.Template>
                    </Thumb>
                  </Canvas>
                </Grid>

                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Opacity="0.4" Margin="0,3,0,5"/>

                <!-- USB Selective Suspend -->
                <Grid Margin="0,2,0,5">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtLabelUsbSuspend" Text="USB Selective Suspend" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TxtDescUsbSuspend" Text="Saves power on idle USB devices" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <CheckBox x:Name="ChkUsbSelectiveSuspend" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}"
                            Click="UsbSelectiveSuspend_Click"/>
                </Grid>

                <!-- Fast Startup: shown in "Start-up and shut-down" now; kept (hidden) for the code that reads it -->
                <Grid Margin="0,2,0,0" Visibility="Collapsed">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtLabelFastStartup" Text="Fast Startup" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="TxtDescFastStartup" Text="Starts Windows faster, but shutdown is not a full restart" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                  </StackPanel>
                  <CheckBox x:Name="ChkFastStartup" Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource ToggleSwitchStyle}"
                            Click="FastStartup_Click"/>
                </Grid>

              </StackPanel>
                      </Border>
                    </Grid>
                  </Popup>
                </Grid>
              </StackPanel>
            </Border>
              </Grid>
