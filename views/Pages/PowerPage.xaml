                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Border Height="1" Background="{DynamicResource CardBorderBrush}" Margin="0,2,0,8"/>
                <!-- the processor in three simple steps (MainWindow.PowerSimple.cs); the detailed controls are under "Advanced" -->
