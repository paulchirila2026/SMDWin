              <Grid x:Name="BenchResultRows" Grid.Row="2">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="110"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="55"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="24"/>
                  <RowDefinition Height="24"/>
                  <RowDefinition Height="24"/>
                  <RowDefinition Height="24"/>
                </Grid.RowDefinitions>

                <!-- Headers -->
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Component"
                           FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" VerticalAlignment="Center"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="Result"
                           FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Score"
                           FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.7" TextAlignment="Right" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>

                <!-- CPU -->
                <TextBlock Grid.Row="1" Grid.Column="0" Text="CPU" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtBenchCpuVal" Grid.Row="1" Grid.Column="1" Text="—"
                           FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="TxtBenchCpuScore" Grid.Row="1" Grid.Column="2" Text="—"
                           FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" TextAlignment="Right" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>

                <!-- RAM -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="RAM" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtBenchRamVal" Grid.Row="2" Grid.Column="1" Text="—"
                           FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock x:Name="TxtBenchRamScore" Grid.Row="2" Grid.Column="2" Text="—"
                           FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" TextAlignment="Right" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>

                <!-- SSD -->
                <TextBlock Grid.Row="3" Grid.Column="0" Text="SSD" FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtBenchSsdVal" Grid.Row="3" Grid.Column="1" Text="—"
                           FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
                <TextBlock x:Name="TxtBenchSsdScore" Grid.Row="3" Grid.Column="2" Text="—"
                           FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" TextAlignment="Right" Typography.NumeralAlignment="Tabular" VerticalAlignment="Center"/>
              </Grid>
            </Grid>
          </Border>


        </Grid>
</UserControl>
