                  <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,2,0,0" Visibility="Collapsed">
                    <TextBlock Text="Min " FontSize="{StaticResource FontSizeXS}" Opacity="0.55" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtCpuLoadMin_c" Text="—" FontSize="{StaticResource FontSizeXS}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="  Max " FontSize="{StaticResource FontSizeXS}" Opacity="0.55" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtCpuLoadMax_c" Text="—" FontSize="{StaticResource FontSizeXS}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
