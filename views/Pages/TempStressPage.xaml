                    <TextBlock x:Name="TxtGpuTempMaxS" Text="—" FontSize="{StaticResource FontSizeXS}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="  Avg " FontSize="{StaticResource FontSizeXS}" Opacity="0.55" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="TxtGpuTempAvgS" Text="—" FontSize="{StaticResource FontSizeXS}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                  </StackPanel>
                </Grid>

