<UserControl x:Class="SMDWin.Views.Pages.TempStressPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             xmlns:local="clr-namespace:SMDWin.Views"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
  <!-- The page logic is in the MainWindow.*.cs files: the named elements here are exposed in MainWindow as properties
       (MainWindow.Pages.cs), and the handlers are redirected below. -->
        <Grid x:Name="PanelStress" Visibility="Collapsed">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>   <!-- titlu + range + butoane -->
            <RowDefinition Height="*"/>      <!-- table | charts -->
            <RowDefinition Height="Auto"/>   <!-- stress buttons bar -->
            <RowDefinition Height="Auto"/>   <!-- benchmark inline result (collapsed by default) -->
            <RowDefinition Height="Auto"/>   <!-- top procese CPU -->
          </Grid.RowDefinitions>

          <Grid Grid.Row="0" Margin="24,14,24,5">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,8">
              <TextBlock x:Name="TxtStressTitle" Text="Temp &amp; Stress"
                         Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,0"/>
              <TextBlock x:Name="TxtTempSubtitle" Text="Live sensors • Stress tests" Style="{StaticResource PageSubtitleStyle}"/>
              <TextBlock x:Name="TxtTempBackend" Text="" FontSize="{StaticResource FontSizeXS}"
                         Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.6"
                         Visibility="Collapsed"/>
              <Border x:Name="LastAlertBanner" Visibility="Collapsed" Margin="0,6,0,0"
                      Background="{DynamicResource BgInputBrush}" CornerRadius="6" Padding="8,5"
                      HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                  <TextBlock x:Name="TxtLastAlert" Text="" FontSize="{StaticResource FontSizeS}"
                             Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                  <ui:Button Appearance="Transparent" x:Name="BtnDismissLastAlert" Content="✕" Click="DismissLastAlert_Click" Padding="8,0,0,0"
                          FontSize="{StaticResource FontSizeS}"
                          ToolTip="Dismiss"/>
                </StackPanel>
              </Border>
            </StackPanel>
            <!-- the test bar in the order what → intensity → stop after → start; on the right the chart interval and "⋯".
                 Logic: MainWindow.StressPlan.cs. The older buttons (CPU Stress, GPU Stress, Max Load, Long test) stay hidden, for
                 compatibility. -->
            <DockPanel x:Name="StressToolbar" Grid.Row="1" VerticalAlignment="Center" Margin="0,0,0,0" SizeChanged="StressToolbar_SizeChanged">
              <StackPanel x:Name="StressToolbarRight" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="12,0,0,0">
                <!-- the chart interval in a menu (also on right click on the CPU / GPU cards); Reset Min/Max and PDF in "⋯".
                     Logic: MainWindow.StressToolbarMenus.cs -->
                <ui:Button x:Name="BtnStressRangeMenu" Appearance="Secondary" Click="StressRangeMenu_Click" VerticalAlignment="Center" Padding="10,5" Margin="0,0,6,4">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="12" Height="12" Margin="0,0,6,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M3.5,12 A8.5,8.5 0 0 1 20.5,12 A8.5,8.5 0 0 1 3.5,12 M12,2 A10,10 0 0 0 12,22 A10,10 0 0 0 12,2 M12,6.65 A0.75,0.75 0 0 0 10.5,6.75 L10.5,12.85 C10.56,13.22 10.87,13.5 11.25,13.5 L15.35,13.5 A0.75,0.75 0 0 0 15.25,12 L12,12 L12,6.65"/></Canvas></Viewbox>
                    <TextBlock x:Name="TxtStressRangeMenu" Text="1 min" VerticalAlignment="Center"/>
                    <Viewbox Width="9" Height="9" Margin="6,1,0,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M4.22,8.47 C4.52,8.17 4.99,8.17 5.28,8.47 L12,15.19 L18.72,8.47 A0.75,0.75 0 1 1 19.78,9.53 L12.53,16.78 C12.23,17.08 11.76,17.08 11.47,16.78 L4.22,9.53 A0.75,0.75 0 0 1 4.22,8.47"/></Canvas></Viewbox>
                  </StackPanel>
                </ui:Button>
                <ui:Button x:Name="BtnStressMoreMenu" Appearance="Secondary" Click="StressMoreMenu_Click" VerticalAlignment="Center" Padding="10,5" Margin="0,0,0,4"
                           Height="{Binding ActualHeight, ElementName=BtnStressRangeMenu}" MinWidth="{Binding ActualHeight, ElementName=BtnStressRangeMenu}">
                  <Viewbox Width="14" Height="14" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M7.75,12 A1.75,1.75 0 0 1 4.25,12 A1.75,1.75 0 0 1 7.75,12 M13.75,12 A1.75,1.75 0 0 1 10.25,12 A1.75,1.75 0 0 1 13.75,12 M18,13.75 A1.75,1.75 0 0 0 18,10.25 A1.75,1.75 0 0 0 18,13.75"/></Canvas></Viewbox>
                </ui:Button>
                <!-- the older buttons stay hidden: the existing code uses them (the active interval, Reset, PDF disabled during export) -->
                <StackPanel x:Name="StressToolbarLegacy" Orientation="Horizontal" Visibility="Collapsed">
              <TextBlock Text="Range:" Style="{StaticResource TimeRangeLabelStyle}" Margin="0,0,8,4"/>
              <Border Style="{StaticResource SegmentTrackStyle}" VerticalAlignment="Center" Margin="0,0,10,0"><StackPanel Orientation="Horizontal">
<Border x:Name="BtnChartRange1m" CornerRadius="5" Padding="11,3" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource BgCardBrush}" Tag="60"
                      Style="{StaticResource TimeRangeSegmentStyle}"
                      VerticalAlignment="Center"
                      MouseLeftButtonUp="ChartTimeRange_Click">
                <TextBlock Text="1m" Style="{StaticResource TimeRangeSegmentTextStyle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="BtnChartRange5m" CornerRadius="5" Padding="11,3" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Tag="300"
                      Style="{StaticResource TimeRangeSegmentStyle}"
                      VerticalAlignment="Center"
                      MouseLeftButtonUp="ChartTimeRange_Click">
                <TextBlock Text="5m" Style="{StaticResource TimeRangeSegmentTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="BtnChartRange15m" CornerRadius="5" Padding="11,3" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Tag="900"
                      Style="{StaticResource TimeRangeSegmentStyle}"
                      VerticalAlignment="Center"
                      MouseLeftButtonUp="ChartTimeRange_Click">
                <TextBlock Text="15m" Style="{StaticResource TimeRangeSegmentTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="BtnChartRange1h" CornerRadius="5" Padding="11,3" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Tag="3600"
                      Style="{StaticResource TimeRangeSegmentStyle}"
                      VerticalAlignment="Center"
                      MouseLeftButtonUp="ChartTimeRange_Click">
                <TextBlock Text="1h" Style="{StaticResource TimeRangeSegmentTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              </Border>
</StackPanel></Border>
                <Border Width="1" Margin="0,2,10,6" Background="{DynamicResource CardBorderBrush}" Opacity="0.5"/>
                <ui:Button x:Name="BtnResetChart" Appearance="Secondary" Click="ResetChart_Click" VerticalAlignment="Center" Padding="10,5">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M12,4.5 A7.5,7.5 0 1 1 4.58,10.9 C4.65,10.44 4.32,10 3.86,10 C3.49,10 3.16,10.26 3.1,10.62 Q3,11.3 3,12 A9,9 0 1 0 6,5.3 L6,4.24 A0.75,0.75 0 0 0 4.5,4.24 L4.5,7.24 C4.5,7.65 4.84,7.99 5.25,7.99 L8.25,7.99 A0.75,0.75 0 0 0 8.25,6.49 L6.9,6.49 A7.5,7.5 0 0 1 12,4.49"/></Canvas></Viewbox>
                    <TextBlock x:Name="TxtBtnResetChart" Text="Reset" VerticalAlignment="Center"/>
                  </StackPanel>
                </ui:Button>
                <ui:Button x:Name="BtnExportStressPdf" Appearance="Secondary"
                        Click="ExportStressPdf_Click" VerticalAlignment="Center" Margin="6,0,0,0"
                        Padding="10,5" ToolTip="Export stress test report as PDF">
                  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Viewbox Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M6,2 A2,2 0 0 0 4,4 L4,11.5 Q4.71,11.2 5.5,11.08 L5.5,4 C5.5,3.72 5.72,3.5 6,3.5 L12,3.5 L12,8 C12,9.1 12.9,10 14,10 L18.5,10 L18.5,20 A0.5,0.5 0 0 1 18,20.5 L12.27,20.5 A7,7 0 0 1 11.19,22 L18,22 A2,2 0 0 0 20,20 L20,9.83 A2,2 0 0 0 19.41,8.41 L13.6,2.6 A2,2 0 0 0 12.17,2 Z M17.38,8.5 L14,8.5 A0.5,0.5 0 0 1 13.5,8 L13.5,4.62 Z M12,17.5 A5.5,5.5 0 0 1 1,17.5 A5.5,5.5 0 0 1 12,17.5 M7,14.5 A0.5,0.5 0 0 0 6,14.5 L6,19.3 L4.35,17.65 A0.5,0.5 0 0 0 3.65,18.35 L6.15,20.85 C6.35,21.05 6.65,21.05 6.85,20.85 L9.35,18.35 A0.5,0.5 0 0 0 8.65,17.65 L7,19.29 Z"/></Canvas></Viewbox>
                    <TextBlock x:Name="TxtBtnExportPdf" Text="PDF" VerticalAlignment="Center"/>
                  </StackPanel>
                </ui:Button>
                </StackPanel>
              </StackPanel>
              <StackPanel x:Name="StressPlanHost" DockPanel.Dock="Left" Orientation="Vertical">
                <WrapPanel x:Name="StressPlanBar" Orientation="Horizontal">
                  <StackPanel x:Name="StressPlanChoices" Orientation="Horizontal" Margin="0,0,0,4">
                <TextBlock x:Name="TxtStressWhatLabel" Text="Test:" Style="{StaticResource TimeRangeLabelStyle}" Margin="0,0,8,0"/>
                <Border Style="{StaticResource SegmentTrackStyle}" Tag="SegTrack" VerticalAlignment="Center" Margin="0,0,14,0"><StackPanel Orientation="Horizontal">
                  <Border x:Name="BtnStressWhatCpu" CornerRadius="5" Padding="11,3" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Tag="what:cpu"
                          Style="{StaticResource TimeRangeSegmentStyle}" VerticalAlignment="Center" MouseLeftButtonUp="StressPlan_Click">
                    <TextBlock x:Name="TxtStressWhatCpu" Text="CPU" Style="{StaticResource TimeRangeSegmentTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </Border>
                  <Border x:Name="BtnStressWhatGpu" CornerRadius="5" Padding="11,3" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Tag="what:gpu"
                          Style="{StaticResource TimeRangeSegmentStyle}" VerticalAlignment="Center" MouseLeftButtonUp="StressPlan_Click">
                    <TextBlock x:Name="TxtStressWhatGpu" Text="GPU" Style="{StaticResource TimeRangeSegmentTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </Border>
                  <Border x:Name="BtnStressWhatBoth" CornerRadius="5" Padding="11,3" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Tag="what:both"
                          Style="{StaticResource TimeRangeSegmentStyle}" VerticalAlignment="Center" MouseLeftButtonUp="StressPlan_Click">
                    <TextBlock x:Name="TxtStressWhatBoth" Text="CPU + GPU" Style="{StaticResource TimeRangeSegmentTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </Border>
                  <Border x:Name="BtnStressWhatSystem" CornerRadius="5" Padding="11,3" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Tag="what:system"
                          Style="{StaticResource TimeRangeSegmentStyle}" VerticalAlignment="Center" MouseLeftButtonUp="StressPlan_Click">
                    <TextBlock x:Name="TxtStressWhatSystem" Text="System" Style="{StaticResource TimeRangeSegmentTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </Border>
                </StackPanel></Border>
                <TextBlock x:Name="TxtStressIntLabel" Text="Intensity:" Style="{StaticResource TimeRangeLabelStyle}" Margin="0,0,8,0"/>
                <Border Style="{StaticResource SegmentTrackStyle}" Tag="SegTrack" VerticalAlignment="Center" Margin="0,0,14,0"><StackPanel Orientation="Horizontal">
                  <Border x:Name="BtnStressIntLong" CornerRadius="5" Padding="11,3" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Tag="int:long"
                          Style="{StaticResource TimeRangeSegmentStyle}" VerticalAlignment="Center" MouseLeftButtonUp="StressPlan_Click">
                    <TextBlock x:Name="TxtStressIntLong" Text="Endurance" Style="{StaticResource TimeRangeSegmentTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </Border>
                  <Border x:Name="BtnStressIntStd" CornerRadius="5" Padding="11,3" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Tag="int:std"
                          Style="{StaticResource TimeRangeSegmentStyle}" VerticalAlignment="Center" MouseLeftButtonUp="StressPlan_Click">
                    <TextBlock x:Name="TxtStressIntStd" Text="Standard" Style="{StaticResource TimeRangeSegmentTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                  </Border>
                </StackPanel></Border>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" Margin="0,0,14,4">
              <TextBlock x:Name="TxtStressDurLabel" Text="Stop after:" Style="{StaticResource TimeRangeLabelStyle}" Margin="0,0,8,0"/>
              <Border Style="{StaticResource SegmentTrackStyle}" Tag="SegTrack" VerticalAlignment="Center"><StackPanel Orientation="Horizontal">
<Border x:Name="BtnStressDur3m" CornerRadius="5" Padding="11,3" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Tag="3"
                      Style="{StaticResource TimeRangeSegmentStyle}"
                      VerticalAlignment="Center"
                      MouseLeftButtonUp="StressDuration_Click">
                <TextBlock Text="3m" Style="{StaticResource TimeRangeSegmentTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="BtnStressDur10m" CornerRadius="5" Padding="11,3" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Tag="10"
                      Style="{StaticResource TimeRangeSegmentStyle}"
                      VerticalAlignment="Center"
                      MouseLeftButtonUp="StressDuration_Click">
                <TextBlock Text="10m" Style="{StaticResource TimeRangeSegmentTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="BtnStressDur30m" CornerRadius="5" Padding="11,3" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Tag="30"
                      Style="{StaticResource TimeRangeSegmentStyle}"
                      VerticalAlignment="Center"
                      MouseLeftButtonUp="StressDuration_Click">
                <TextBlock Text="30m" Style="{StaticResource TimeRangeSegmentTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="BtnStressDur60m" CornerRadius="5" Padding="11,3" BorderThickness="1" BorderBrush="Transparent" Background="Transparent" Tag="60"
                      Style="{StaticResource TimeRangeSegmentStyle}"
                      VerticalAlignment="Center"
                      MouseLeftButtonUp="StressDuration_Click">
                <TextBlock Text="60m" Style="{StaticResource TimeRangeSegmentTextStyle}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
              </Border>
              <Border x:Name="BtnStressDurInf" CornerRadius="5" Padding="11,3" BorderThickness="1" BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource BgCardBrush}" Tag="0"
                      Style="{StaticResource TimeRangeSegmentStyle}"
                      VerticalAlignment="Center"
                      MouseLeftButtonUp="StressDuration_Click">
                <TextBlock Text="∞" Style="{StaticResource TimeRangeSegmentTextStyle}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
              </Border>
</StackPanel></Border>
                  </StackPanel>
                  <ui:Button x:Name="BtnStressStart" Appearance="Primary" Click="StressStart_Click" Padding="14,6" Margin="0,0,0,4" VerticalAlignment="Center" MinWidth="130">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                      <Viewbox Width="11" Height="11" Margin="0,0,7,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path x:Name="BtnStressStartIcon" Fill="White" Data="F1 M7.6,4.61 A0.75,0.75 0 0 0 6.5,5.27 L6.5,18.73 C6.5,19.29 7.1,19.66 7.6,19.38 L19.97,12.66 A0.75,0.75 0 0 0 19.97,11.34 Z M5,5.27 C5,3.57 6.83,2.48 8.33,3.3 L20.69,10.02 A2.25,2.25 0 0 1 20.69,13.98 L8.33,20.7 A2.25,2.25 0 0 1 5,18.73 Z"/></Canvas></Viewbox>
                      <TextBlock x:Name="TxtBtnStressStart" Text="Start test" VerticalAlignment="Center" FontWeight="SemiBold" Typography.NumeralAlignment="Tabular"/>
                    </StackPanel>
                  </ui:Button>
                </WrapPanel>
                <TextBlock x:Name="TxtStressPlanHint" Text="" FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" Margin="2,2,0,0"/>
              </StackPanel>
              <StackPanel x:Name="StressToolbarLeft" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed">
              <ui:Button x:Name="BtnStressCpu" Appearance="Secondary" Margin="0,0,6,4" Padding="10,5"
                      Click="ToggleCpuStress_Click" ToolTip="Stress test CPU — all cores at 100%"
                      local:TechTooltip.Text="Starts N background threads (BelowNormal priority, one per logical core) that alternate every 20s between an FMA/AVX2 vector kernel and an integer LCG kernel — saturates the FPU and ALU without touching disk/network. Checks for NaN/mismatch every ~100ms slice as a correctness signal.">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Viewbox Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{DynamicResource StatusOkBrush}" Data="F1 M7.6,4.61 A0.75,0.75 0 0 0 6.5,5.27 L6.5,18.73 C6.5,19.29 7.1,19.66 7.6,19.38 L19.97,12.66 A0.75,0.75 0 0 0 19.97,11.34 Z M5,5.27 C5,3.57 6.83,2.48 8.33,3.3 L20.69,10.02 A2.25,2.25 0 0 1 20.69,13.98 L8.33,20.7 A2.25,2.25 0 0 1 5,18.73 Z"/></Canvas></Viewbox>
                  <TextBlock x:Name="TxtBtnStressCpu" Text="CPU Stress" VerticalAlignment="Center" FontSize="{StaticResource FontSizeS}"/>
                </StackPanel>
              </ui:Button>
              <ui:Button x:Name="BtnStressGpu" Appearance="Secondary" Margin="0,0,10,4" Padding="10,5"
                      Click="ToggleGpuStress_Click" ToolTip="GPU stress test with D3D11 compute shaders"
                      local:TechTooltip.Text="Runs a DirectX 11 compute shader in a tight dispatch loop on a background thread — keeps the GPU's shader cores at maximum occupancy. Verifies output correctness after each dispatch batch to catch VRAM/core instability, not just raw load.">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Viewbox Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{DynamicResource StatusOkBrush}" Data="F1 M7.6,4.61 A0.75,0.75 0 0 0 6.5,5.27 L6.5,18.73 C6.5,19.29 7.1,19.66 7.6,19.38 L19.97,12.66 A0.75,0.75 0 0 0 19.97,11.34 Z M5,5.27 C5,3.57 6.83,2.48 8.33,3.3 L20.69,10.02 A2.25,2.25 0 0 1 20.69,13.98 L8.33,20.7 A2.25,2.25 0 0 1 5,18.73 Z"/></Canvas></Viewbox>
                  <TextBlock x:Name="TxtBtnStressGpu" Text="GPU Stress" VerticalAlignment="Center" FontSize="{StaticResource FontSizeS}"/>
                </StackPanel>
              </ui:Button>

              <ui:Button x:Name="BtnMaxLoad" Appearance="Secondary" Margin="0,0,10,4" Padding="10,5"
                      Click="ToggleMaxLoad_Click"
                      ToolTip="Max Load — starts CPU + GPU + RAM + Disk stress simultaneously, for maximum power/PSU load testing"
                      local:TechTooltip.Text="Starts CpuStressor (2 cores reserved for the other loads), GpuStressService (D3D11 compute), and PsuStressService (RAM fill + sequential disk write/read on background threads) at the same time — pulls maximum combined power through the PSU/charger and battery, for stability testing under real worst-case draw.">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Viewbox Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{DynamicResource StatusOkBrush}" Data="F1 M7.43,2.83 C7.6,2.33 8.07,2 8.6,2 L15.06,2 C15.91,2 16.51,2.84 16.24,3.65 L14.8,8 L18.76,8 C19.86,8 20.43,9.33 19.66,10.12 L8.59,21.54 C7.53,22.62 5.71,21.64 6.04,20.16 L7.31,14.5 L5.75,14.49 C4.54,14.49 3.7,13.29 4.1,12.15 Z M8.78,3.5 L5.52,12.66 C5.46,12.82 5.58,12.99 5.75,12.99 L8.25,13 A0.75,0.75 0 0 1 8.98,13.91 L7.51,20.5 L18.16,9.5 L13.75,9.5 A0.75,0.75 0 0 1 13.04,8.51 L14.7,3.5 Z"/></Canvas></Viewbox>
                  <TextBlock x:Name="TxtBtnMaxLoad" Text="Max Load" VerticalAlignment="Center" FontSize="{StaticResource FontSizeS}"/>
                </StackPanel>
              </ui:Button>

              <ui:Button x:Name="BtnEnduranceMode" Appearance="Secondary" Margin="0,0,10,4" Padding="10,5"
                      Click="ToggleEnduranceMode_Click"
                      ToolTip="Endurance mode — runs stress at a sustained 80% instead of 100%, for long-duration stability testing (hours, not minutes) without pushing full thermal/power limits constantly."
                      local:TechTooltip.Text="Changes the duty cycle inside the stress worker loops: instead of 100ms work / 0ms sleep per slice, uses 80ms work / 20ms sleep — same kernels (FMA/integer), sustained lower average load so temperature stabilizes below TjMax instead of triggering thermal throttling during multi-hour runs.">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                  <Viewbox Width="12" Height="12" Margin="0,0,5,0" VerticalAlignment="Center" Effect="{x:Null}"><Canvas Width="24" Height="24"><Path x:Name="BtnEnduranceIcon" Fill="{DynamicResource TextSecondaryBrush}" Data="F1 M3.5,12 A8.5,8.5 0 0 1 20.5,12 A8.5,8.5 0 0 1 3.5,12 M12,2 A10,10 0 0 0 12,22 A10,10 0 0 0 12,2 M12,6.65 A0.75,0.75 0 0 0 10.5,6.75 L10.5,12.85 C10.56,13.22 10.87,13.5 11.25,13.5 L15.35,13.5 A0.75,0.75 0 0 0 15.25,12 L12,12 L12,6.65"/></Canvas></Viewbox>
                  <TextBlock x:Name="TxtBtnEnduranceMode" Text="Long test" ToolTip="Holds the load at 80 % — for tests of 30 minutes or more" VerticalAlignment="Center" FontSize="{StaticResource FontSizeS}"/>
                </StackPanel>
              </ui:Button>


              </StackPanel>
            </DockPanel>
          </Grid>

          <!-- ══ On the left the CPU and GPU cards (dial + large temperature + load | frequency), on the right, full height,
               "All sensors" (now · min · max) and Top processes. Data: MainWindow.StressCards.cs. ═ -->
          <ScrollViewer x:Name="StressScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" SizeChanged="StressScroll_SizeChanged">
          <!-- height = the window (min 640, see StressScroll_SizeChanged): CPU and GPU share the height, the charts grow with it -->
          <Grid x:Name="StressLayoutGrid" Margin="16,0,16,6">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="440"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border x:Name="StCpuCard" Grid.Row="0" Style="{StaticResource CompCardStyle}" Cursor="Arrow" MinHeight="280" ContextMenuOpening="StressCardRange_ContextMenuOpening">
              <Border.ContextMenu><ContextMenu/></Border.ContextMenu>
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,4" LastChildFill="True">
                  <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center"><local:StatusMark Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding Foreground, ElementName=TxtStCpuStatus}"/>
                    <TextBlock x:Name="TxtStCpuStatus" Text="" Foreground="{DynamicResource StatusOkBrush}" Visibility="Collapsed"/>
                    <TextBlock Text="{Binding Text, ElementName=TxtStCpuStatus}" Foreground="{Binding Foreground, ElementName=TxtStCpuStatus, Converter={StaticResource NeutralUnlessAlert}}" Style="{StaticResource CompStatusText}"/></StackPanel>
                  <StackPanel Orientation="Horizontal">
