                  <Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M12,14 A2,2 0 0 0 12,10 A2,2 0 0 0 12,14 M6,12 A6,6 0 0 1 18,12 A6,6 0 0 1 6,12 M12,7.5 A4.5,4.5 0 0 0 12,16.5 A4.5,4.5 0 0 0 12,7.5 M2,12 A10,10 0 0 1 22,12 A10,10 0 0 1 2,12 M12,3.5 A8.5,8.5 0 0 0 12,20.5 A8.5,8.5 0 0 0 12,3.5"/></Canvas></Viewbox>
                  <TextBlock Text="Fan Control" VerticalAlignment="Center"/>
                </StackPanel>
              </ui:Button>


              <!-- Compat stubs -->
