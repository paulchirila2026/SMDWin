                  </StackPanel>
                </Border>
                <ui:Button Grid.Column="3" Appearance="Secondary"
                        Padding="6,3" FontSize="{StaticResource FontSizeS}" Content="✕"
                        Click="BenchClose_Click"/>
              </Grid>

              <!-- Progress bar -->
              <Border x:Name="BenchProgressBg" Grid.Row="1" Height="4" CornerRadius="2"
                      Background="{DynamicResource BgHoverBrush}" Margin="0,0,0,10">
                <Border x:Name="BenchProgressFg" Height="4" CornerRadius="2"
                        Background="{DynamicResource DataBrush}"
                        HorizontalAlignment="Left" Width="0"/>
