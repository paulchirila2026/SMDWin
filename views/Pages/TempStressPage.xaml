                    <Canvas.ContextMenu>
                      <ContextMenu>
                        
                        <MenuItem Header="Vertical gridlines" IsCheckable="True" Click="ChartCtxGridlines_Click" Loaded="ChartGridlinesMenuItem_Loaded"/>
