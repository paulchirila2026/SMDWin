                  <!-- Overlay temp cursors -->
                  <Canvas x:Name="CpuTempChart"    SizeChanged="CpuTempChart_SizeChanged"/>
                  <Canvas x:Name="GpuTempChart"    SizeChanged="GpuTempChart_SizeChanged"/>
                  <Canvas x:Name="GpuLoadChart"    SizeChanged="GpuLoadChart_SizeChanged"/>
                  <Canvas x:Name="CpuUsageChart"   SizeChanged="CpuUsageChart_SizeChanged"/>
                  <Canvas x:Name="CpuFreqChart"    SizeChanged="CpuFreqChart_SizeChanged"/>
                  <TextBlock x:Name="TxtStressCpuTempLive" Text=""/>
                  <TextBlock x:Name="TxtGpuPowerLabel" Text=""/>
                  <TextBlock x:Name="TxtGpuStressFps"  Text=""/>
                  <TextBlock x:Name="TxtGpuStressInfo" Text=""/>
                  <TextBlock x:Name="TxtGpuStressLoad" Text=""/>
                  <TextBlock x:Name="TxtGpuStressStatus" Text=""/>
                  <TextBlock x:Name="TxtGpuStressTemp"  Text=""/>
                  <TextBlock x:Name="TxtGpuStressVram"  Text=""/>
