<Window x:Class="SMDWin.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:SMDWin.Views"
        Title="About SMD Win"
        Width="448" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <!-- The About window: a soft glow at the top, the logo inside a gradient ring, the name, three values (version · build ·
       license), three links (GitHub · Licenses · Updates) and the author. Esc closes; 5 clicks on the version open the debug
       panel. All colours come from the theme (DynamicResource), so it fits Light and Dark. -->
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                        GlassFrameThickness="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- the glow at the top: a slow, barely visible breathing -->
    <Storyboard x:Key="GlowBreathStoryboard" RepeatBehavior="Forever" AutoReverse="True">
      <DoubleAnimation Storyboard.TargetName="HeroGlow" Storyboard.TargetProperty="Opacity"
                       From="0.75" To="1" Duration="0:0:3">
        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
      </DoubleAnimation>
    </Storyboard>

    <Style x:Key="AboutStatKey" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeXS}"/>
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
    </Style>
    <Style x:Key="AboutStatVal" TargetType="TextBlock">
      <Setter Property="FontSize" Value="{StaticResource FontSizeM}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,3,0,0"/>
    </Style>
    <!-- a text link with a small icon in front (GitHub · Licenses · Updates) -->
    <Style x:Key="AboutLink" TargetType="Button">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
      <Setter Property="FontSize" Value="{StaticResource FontSizeS}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="8,0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Bd" Background="Transparent" CornerRadius="8" Padding="8,5">
              <ContentPresenter VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>

  <Grid Margin="14">
    <!-- the shadow on a separate layer, behind the content -->
    <Border CornerRadius="14" Background="{DynamicResource BgDarkBrush}">
      <Border.Effect>
        <DropShadowEffect BlurRadius="30" ShadowDepth="6" Direction="270" Color="Black" Opacity="0.35" RenderingBias="Performance"/>
      </Border.Effect>
    </Border>
    <Border x:Name="Card" CornerRadius="14" ClipToBounds="True"
            Background="{DynamicResource BgDarkBrush}"
            BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1"
            RenderTransformOrigin="0.5,0.5">
      <Border.RenderTransform><ScaleTransform x:Name="CardScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
      <Grid>
        <!-- the soft glow at the top (data colour → its violet end), faded radially -->
        <Ellipse x:Name="HeroGlow" Width="520" Height="300" VerticalAlignment="Top" HorizontalAlignment="Center"
                 Margin="-60,-150,-60,0" IsHitTestVisible="False" Opacity="0.85">
          <Ellipse.Fill>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
              <GradientStop Color="{DynamicResource DataColor}" Offset="0.2"/>
              <GradientStop Color="{DynamicResource DataEndColor}" Offset="0.8"/>
            </LinearGradientBrush>
          </Ellipse.Fill>
          <Ellipse.OpacityMask>
            <RadialGradientBrush>
              <GradientStop Color="#40000000" Offset="0"/>
              <GradientStop Color="#26000000" Offset="0.35"/>
              <GradientStop Color="#0E000000" Offset="0.65"/>
              <GradientStop Color="Transparent" Offset="1"/>
            </RadialGradientBrush>
          </Ellipse.OpacityMask>
        </Ellipse>

        <!-- title bar: drags the window + close button -->
        <Grid x:Name="TitleBar" Height="44" VerticalAlignment="Top" Background="Transparent"
              MouseLeftButtonDown="TitleBar_DragMove">
          <Button x:Name="BtnClose"
                  HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,8,0"
                  Style="{StaticResource CaptionCloseBtnStyle}"
                  Click="BtnClose_Click" ToolTip="Close (Esc)">✕</Button>
        </Grid>

        <StackPanel Margin="26,40,26,16">
          <!-- the logo: the segmented gauge with the pulse (views/SmdLogo.cs). On opening the segments light up from left to right,
               then the pulse is drawn; afterwards a light dot runs along the pulse every few seconds (AboutWindow.xaml.cs). -->
          <local:SmdLogo x:Name="AboutLogo" Width="132" Height="132" HorizontalAlignment="Center" Margin="0,-6,0,-10"/>

          <!-- the name: the same wordmark as in the sidebar and on the splash -->
          <local:SmdWordmark HorizontalAlignment="Center" Margin="0,16,0,0" FontSize="{StaticResource FontSizeHero}"
                             Foreground="{DynamicResource TextPrimaryBrush}"/>
          <TextBlock x:Name="TxtTagline" Text="S Y S T E M   M O N I T O R I N G   &amp;   D I A G N O S T I C S"
                     FontSize="{StaticResource FontSizeXS}" HorizontalAlignment="Center"
                     TextAlignment="Center" Margin="0,6,0,0" TextWrapping="Wrap"
                     Foreground="{DynamicResource TextSecondaryBrush}" Opacity="0.75"/>

          <!-- version · build · license -->
          <Border Margin="0,20,0,0" CornerRadius="12" Background="{DynamicResource CardSurfaceBrush}"
                  BorderBrush="{DynamicResource CardEdgeBrush}" BorderThickness="1">
            <UniformGrid Rows="1">
              <Border Padding="8,11" Background="Transparent" MouseLeftButtonDown="TxtVersion_MouseLeftButtonDown">
                <StackPanel>
                  <TextBlock x:Name="TxtLabelVersion" Text="Version" Style="{StaticResource AboutStatKey}"/>
                  <TextBlock x:Name="TxtVersion" Text="—" Style="{StaticResource AboutStatVal}"/>
                </StackPanel>
              </Border>
              <Border Padding="8,11" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource CardFootLineBrush}"
                      Background="Transparent" MouseLeftButtonDown="TxtVersion_MouseLeftButtonDown">
                <StackPanel>
                  <TextBlock x:Name="TxtLabelBuild" Text="Build" Style="{StaticResource AboutStatKey}"/>
                  <TextBlock x:Name="TxtBuild" Text="—" Style="{StaticResource AboutStatVal}"/>
                </StackPanel>
              </Border>
              <Border Padding="8,11" BorderThickness="1,0,0,0" BorderBrush="{DynamicResource CardFootLineBrush}">
                <StackPanel>
                  <TextBlock x:Name="TxtLabelLicense" Text="License" Style="{StaticResource AboutStatKey}"/>
                  <TextBlock x:Name="TxtLicenseValue" Text="GPL-3.0" Style="{StaticResource AboutStatVal}"
                             Foreground="{DynamicResource StatusGoodBrush}" ToolTip="Free and open source"/>
                </StackPanel>
              </Border>
            </UniformGrid>
          </Border>

          <!-- links -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button x:Name="BtnGitHub" Style="{StaticResource AboutLink}" Click="BtnGitHub_Click">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Canvas Width="24" Height="24">
                  <Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M12,2 C6.48,2 2,6.48 2,12 C2,16.42 4.87,20.17 8.84,21.5 C9.34,21.58 9.5,21.27 9.5,21 L9.5,19.31 C6.73,19.91 6.14,17.97 6.14,17.97 C5.68,16.81 5.03,16.5 5.03,16.5 C4.12,15.88 5.1,15.9 5.1,15.9 C6.1,15.97 6.63,16.93 6.63,16.93 C7.5,18.45 8.97,18 9.54,17.76 C9.63,17.11 9.89,16.67 10.17,16.42 C7.95,16.17 5.62,15.31 5.62,11.5 C5.62,10.39 6,9.5 6.65,8.79 C6.55,8.54 6.2,7.5 6.75,6.15 C6.75,6.15 7.59,5.88 9.5,7.17 C10.29,6.95 11.15,6.84 12,6.84 C12.85,6.84 13.71,6.95 14.5,7.17 C16.41,5.88 17.25,6.15 17.25,6.15 C17.8,7.5 17.45,8.54 17.35,8.79 C18,9.5 18.38,10.39 18.38,11.5 C18.38,15.32 16.04,16.16 13.81,16.41 C14.17,16.72 14.5,17.33 14.5,18.26 L14.5,21 C14.5,21.27 14.66,21.59 15.17,21.5 C19.14,20.16 22,16.42 22,12 A10,10 0 0 0 12,2 Z"/>
                </Canvas></Viewbox>
                <TextBlock x:Name="TxtLinkGitHub" Text="GitHub"/>
              </StackPanel>
            </Button>
            <Button x:Name="BtnLicenses" Style="{StaticResource AboutLink}" Click="BtnLicenses_Click"
                    ToolTip="Third-party components and their licenses">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Canvas Width="24" Height="24">
                  <Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M6.25,2 L13.94,2 C14.4,2 14.85,2.18 15.18,2.51 L19.49,6.82 C19.82,7.15 20,7.6 20,8.06 L20,19.75 A2.25,2.25 0 0 1 17.75,22 L6.25,22 A2.25,2.25 0 0 1 4,19.75 L4,4.25 A2.25,2.25 0 0 1 6.25,2 Z M6.25,3.5 A0.75,0.75 0 0 0 5.5,4.25 L5.5,19.75 C5.5,20.16 5.84,20.5 6.25,20.5 L17.75,20.5 C18.16,20.5 18.5,20.16 18.5,19.75 L18.5,9 L15,9 A1.5,1.5 0 0 1 13.5,7.5 L13.5,3.5 Z M15,4.56 L15,7.5 L17.94,7.5 Z M8.25,12 L15.75,12 A0.75,0.75 0 0 1 15.75,13.5 L8.25,13.5 A0.75,0.75 0 0 1 8.25,12 Z M8.25,15.5 L13.75,15.5 A0.75,0.75 0 0 1 13.75,17 L8.25,17 A0.75,0.75 0 0 1 8.25,15.5 Z"/>
                </Canvas></Viewbox>
                <TextBlock x:Name="TxtLinkViewLicenses" Text="Licenses"/>
              </StackPanel>
            </Button>
            <Button x:Name="BtnUpdates" Style="{StaticResource AboutLink}" Click="BtnUpdates_Click">
              <StackPanel Orientation="Horizontal">
                <Viewbox Width="14" Height="14" Margin="0,0,6,0"><Canvas Width="24" Height="24">
                  <Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M16.5,4.4 A8.5,8.5 0 0 1 20.5,12 A0.75,0.75 0 0 1 19,12 A7,7 0 0 0 7.27,6.84 L9.25,6.84 A0.75,0.75 0 0 1 9.25,8.34 L5.5,8.34 A0.75,0.75 0 0 1 4.75,7.59 L4.75,3.84 A0.75,0.75 0 0 1 6.25,3.84 L6.25,5.66 A8.5,8.5 0 0 1 16.5,4.4 Z M4.25,11.25 A0.75,0.75 0 0 1 5,12 A7,7 0 0 0 16.73,17.16 L14.75,17.16 A0.75,0.75 0 0 1 14.75,15.66 L18.5,15.66 C18.91,15.66 19.25,16 19.25,16.41 L19.25,20.16 A0.75,0.75 0 0 1 17.75,20.16 L17.75,18.34 A8.5,8.5 0 0 1 3.5,12 C3.5,11.59 3.84,11.25 4.25,11.25 Z"/>
                </Canvas></Viewbox>
                <TextBlock x:Name="TxtLinkUpdates" Text="Updates"/>
              </StackPanel>
            </Button>
          </StackPanel>

          <!-- the author (and the platform), close under the links -->
          <!-- 5 clicks on the version, the build or the author open the debug panel (the clicks add up) -->
          <TextBlock x:Name="TxtFooter" HorizontalAlignment="Center" Margin="0,10,0,0" Background="Transparent"
                     MouseLeftButtonDown="TxtVersion_MouseLeftButtonDown"
                     FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}">
            <Run Text="Paul Chirilă" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><Run x:Name="RunPlatform" Text="  ·  Windows 10 / 11 · 64-bit"/>
          </TextBlock>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
