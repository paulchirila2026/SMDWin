<Window x:Class="SMDWin.Views.ProcessAnalyzerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:local="clr-namespace:SMDWin.Views"
        Title="Process Analyzer — SMDWin"
        Height="820" Width="1060"
        MinHeight="500" MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgDarkBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        ResizeMode="CanResize"
        WindowStyle="None"
        FontFamily="{StaticResource AppFont}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SourceInitialized="Window_SourceInitialized">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="6"
                        GlassFrameThickness="-1,-1,-1,-1"
                        UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>

  <Window.Resources>
    <!-- Force dark palette for this window regardless of app theme -->
    <!-- BgDarkBrush inherited from Styles.xaml -->
    <!-- BgCardBrush inherited from Styles.xaml -->
    <!-- BgHoverBrush inherited from Styles.xaml -->
    <!-- TextPrimaryBrush inherited from Styles.xaml -->
    <!-- TextSecondaryBrush inherited from Styles.xaml -->
    <!-- BorderBrush2 inherited from Styles.xaml -->
    <!-- CardBorderBrush inherited from Styles.xaml -->
    <!-- AccentBrush inherited from Styles.xaml -->
  </Window.Resources>

  <Grid Margin="20,14,20,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>   <!-- antet -->
      <RowDefinition Height="1.25*" MinHeight="330"/>   <!-- 4 carduri: CPU, memorie, disc, retea -->
      <RowDefinition Height="*"/>      <!-- module / fire -->
    </Grid.RowDefinitions>

    <!-- Antet: iconita + nume + PID / semnatura, actiuni, inchidere -->
    <Grid Grid.Row="0" Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image x:Name="ImgProcIcon" Width="32" Height="32" Margin="0,0,12,0"
               VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
        <StackPanel VerticalAlignment="Center">
          <TextBlock x:Name="TxtProcName" Text="Process Analyzer" Style="{StaticResource SectionTitleStyle}"/>
          <TextBlock x:Name="TxtProcSubtitle" Text="PID: —  |  Status: monitoring…" Style="{StaticResource PageSubtitleStyle}"/>
        </StackPanel>
      </StackPanel>
      <ui:Button x:Name="BtnPinAsWidget" Grid.Column="1" Appearance="Secondary" Click="PinAsWidget_Click" VerticalAlignment="Center" Margin="0,0,12,0"
              shell:WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Open a floating widget that monitors only this process">
        <StackPanel Orientation="Horizontal"><Viewbox Width="13" Height="13" Margin="0,0,6,0" VerticalAlignment="Center"><Canvas Width="24" Height="24"><Path Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" Data="F1 M16.24,2.93 L21.07,7.76 A2.75,2.75 0 0 1 20.35,12.16 L15.48,14.6 A0.8,0.8 0 0 0 15.11,15.02 L13.67,19.19 A1.25,1.25 0 0 1 11.6,19.67 L8.5,16.57 L4.06,21 L3,21 L3,19.94 L7.44,15.5 L4.34,12.4 C3.68,11.74 3.94,10.63 4.81,10.33 L8.98,8.89 Q9.26,8.79 9.4,8.52 L11.84,3.65 A2.75,2.75 0 0 1 16.24,2.93 M20.01,8.82 L15.18,3.99 C14.58,3.39 13.56,3.55 13.18,4.32 L10.74,9.19 C10.48,9.71 10.02,10.12 9.47,10.31 L5.67,11.61 L12.38,18.32 L13.69,14.53 C13.89,13.98 14.29,13.52 14.81,13.26 L19.68,10.82 C20.45,10.44 20.61,9.42 20.01,8.82"/></Canvas></Viewbox><TextBlock Text="Pin as widget" VerticalAlignment="Center"/></StackPanel>
      </ui:Button>
      <Button Grid.Column="2" Click="CloseBtn_Click" Width="32" Height="32"
              VerticalAlignment="Top" Content="✕" FontSize="{StaticResource FontSizeM}" ToolTip="Close"
              shell:WindowChrome.IsHitTestVisibleInChrome="True"
              Style="{StaticResource CaptionCloseBtnStyle}"/>
    </Grid>

    <!-- 4 cards, each: the current value + a chart + a footer with peak / totals -->
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="12"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border Grid.Column="0" Grid.Row="0" Style="{StaticResource CompCardStyle}" Cursor="Arrow">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel LastChildFill="False" Margin="0,0,0,6">
              <Viewbox DockPanel.Dock="Left" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,9,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M15.25,2 C15.63,2 15.95,2.28 15.99,2.65 L16,2.75 L16,5.08 A3.8,3.8 0 0 1 18.93,8 L21.25,8 A0.75,0.75 0 0 1 21.35,9.5 L19,9.5 L19,11.25 L21.25,11.25 C21.63,11.25 21.95,11.53 21.99,11.9 L22,12 C22,12.38 21.72,12.7 21.35,12.74 L21.25,12.75 L19,12.75 L19,14.5 L21.25,14.5 C21.63,14.5 21.95,14.78 21.99,15.15 L22,15.25 C22,15.63 21.72,15.95 21.35,15.99 L21.25,16 L18.92,16 A3.8,3.8 0 0 1 16,18.92 L16,21.25 A0.75,0.75 0 0 1 14.5,21.35 L14.5,19 L12.75,19 L12.75,21.25 C12.75,21.63 12.47,21.95 12.1,21.99 L12,22 A0.75,0.75 0 0 1 11.26,21.35 L11.25,21.25 L11.25,19 L9.5,19 L9.5,21.25 C9.5,21.63 9.22,21.95 8.85,21.99 L8.75,22 A0.75,0.75 0 0 1 8.01,21.35 L8,21.25 L8,18.93 A3.8,3.8 0 0 1 5.08,16 L2.75,16 A0.75,0.75 0 0 1 2.65,14.5 L5,14.5 L5,12.75 L2.75,12.75 A0.75,0.75 0 0 1 2.01,12.1 L2,12 C2,11.62 2.28,11.3 2.65,11.26 L2.75,11.25 L5,11.25 L5,9.5 L2.75,9.5 A0.75,0.75 0 0 1 2.01,8.85 L2,8.75 C2,8.37 2.28,8.05 2.65,8.01 L2.75,8 L5.08,8 A3.8,3.8 0 0 1 8,5.07 L8,2.75 A0.75,0.75 0 0 1 9.5,2.65 L9.5,5 L11.25,5 L11.25,2.75 C11.25,2.37 11.53,2.05 11.9,2.01 L12,2 C12.38,2 12.7,2.28 12.74,2.65 L12.75,2.75 L12.75,5 L14.5,5 L14.5,2.75 C14.5,2.4 14.73,2.11 15.05,2.03 L15.15,2.01 Z M15.25,6.5 L8.75,6.5 C7.51,6.5 6.5,7.5 6.5,8.75 L6.5,15.25 C6.5,16.49 7.5,17.5 8.75,17.5 L15.25,17.5 C16.49,17.5 17.5,16.5 17.5,15.25 L17.5,8.75 C17.5,7.51 16.5,6.5 15.25,6.5 M12,9 A3,3 0 0 1 12,15 A3,3 0 0 1 12,9 M12,10.5 A1.5,1.5 0 0 0 12,13.5 A1.5,1.5 0 0 0 12,10.5"/></Viewbox>
              <TextBlock DockPanel.Dock="Left" Text="CPU" Style="{StaticResource DashRowCaption}" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtLiveCpu" DockPanel.Dock="Right" Text="—%" Style="{StaticResource CompChartValue}"/>
            </DockPanel>
            <local:MiniLineChart x:Name="CpuChart" Grid.Row="1" MinHeight="70" Margin="0,0,0,10"/>
            <Border Grid.Row="2" Style="{StaticResource CompFootBand}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CompFootCellFirst}"><StackPanel><TextBlock Text="Peak" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtMaxCpu" Text="—" Style="{StaticResource CompFootVal}"/></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource CompFootCell}"><StackPanel><TextBlock Text="Window" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtCpuChartRange" Text="last 60 s" Style="{StaticResource CompFootVal}"/><TextBlock x:Name="TxtAvgCpu" Text="" FontSize="{StaticResource FontSizeXS}" Foreground="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"/></StackPanel></Border>
              </Grid>
            </Border>
          </Grid>
        </Border>
        <Border Grid.Column="2" Grid.Row="0" Style="{StaticResource CompCardStyle}" Cursor="Arrow">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel LastChildFill="False" Margin="0,0,0,6">
              <Viewbox DockPanel.Dock="Left" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,9,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M21.62,6.88 A3,3 0 0 0 19.5,6 L19.5,3.75 A0.75,0.75 0 0 0 18,3.75 L18,6 L15,6 L15,3.75 A0.75,0.75 0 0 0 13.5,3.75 L13.5,6 L10.5,6 L10.5,3.75 A0.75,0.75 0 0 0 9,3.75 L9,6 L6,6 L6,3.75 A0.75,0.75 0 0 0 4.5,3.75 L4.5,6 A3,3 0 0 0 1.5,9 L1.5,15 A3,3 0 0 0 4.5,18 L4.5,20.25 A0.75,0.75 0 0 0 6,20.25 L6,18 L9,18 L9,20.25 A0.75,0.75 0 0 0 10.5,20.25 L10.5,18 L13.5,18 L13.5,20.25 A0.75,0.75 0 0 0 15,20.25 L15,18 L18,18 L18,20.25 A0.75,0.75 0 0 0 19.5,20.25 L19.5,18 A3,3 0 0 0 22.5,15 L22.5,9 A3,3 0 0 0 21.62,6.88 M21,15 A1.5,1.5 0 0 1 19.5,16.5 L4.5,16.5 A1.5,1.5 0 0 1 3,15 L3,9 A1.5,1.5 0 0 1 4.5,7.5 L19.5,7.5 A1.5,1.5 0 0 1 21,9 Z M18.75,9 L5.25,9 A0.75,0.75 0 0 0 4.5,9.75 L4.5,14.25 A0.75,0.75 0 0 0 5.25,15 L18.75,15 A0.75,0.75 0 0 0 19.5,14.25 L19.5,9.75 A0.75,0.75 0 0 0 18.75,9 M18,13.5 L6,13.5 L6,10.5 L18,10.5 Z"/></Viewbox>
              <TextBlock DockPanel.Dock="Left" Text="MEMORY" Style="{StaticResource DashRowCaption}" VerticalAlignment="Center"/>
              <TextBlock x:Name="TxtLiveRam" DockPanel.Dock="Right" Text="—" Style="{StaticResource CompChartValue}"/>
            </DockPanel>
            <local:MiniLineChart x:Name="RamChart" Grid.Row="1" MinHeight="70" Margin="0,0,0,10"/>
            <Border Grid.Row="2" Style="{StaticResource CompFootBand}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CompFootCellFirst}"><StackPanel><TextBlock Text="Peak" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtMaxRam" Text="—" Style="{StaticResource CompFootVal}"/></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource CompFootCell}"><StackPanel><TextBlock Text="Window" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtRamChartRange" Text="last 60 s" Style="{StaticResource CompFootVal}"/></StackPanel></Border>
              </Grid>
            </Border>
          </Grid>
        </Border>
        <Border Grid.Column="0" Grid.Row="2" Style="{StaticResource CompCardStyle}" Cursor="Arrow">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel LastChildFill="False" Margin="0,0,0,6">
              <Viewbox DockPanel.Dock="Left" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,9,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M4,6 C4,5.3 4.32,4.7 4.77,4.22 A6,6 0 0 1 6.57,3.02 A14,14 0 0 1 12,2 C14.08,2 16,2.38 17.43,3.02 Q18.53,3.5 19.23,4.22 C19.68,4.71 20,5.31 20,6 L20,18 C20,18.7 19.68,19.3 19.23,19.78 Q18.53,20.5 17.43,20.98 A14,14 0 0 1 12,22 C9.92,22 8,21.62 6.57,20.98 A6,6 0 0 1 4.77,19.78 A2.6,2.6 0 0 1 4,18 Z M5.5,6 C5.5,6.2 5.59,6.46 5.87,6.75 Q6.27,7.21 7.18,7.61 C8.38,8.15 10.08,8.5 12,8.5 C13.92,8.5 15.62,8.15 16.82,7.61 Q17.72,7.21 18.13,6.75 C18.41,6.45 18.5,6.21 18.5,6 C18.5,5.79 18.41,5.54 18.13,5.25 Q17.73,4.79 16.82,4.39 C15.62,3.85 13.92,3.5 12,3.5 C10.08,3.5 8.38,3.85 7.18,4.39 Q6.28,4.79 5.87,5.25 C5.59,5.55 5.5,5.79 5.5,6 M18.5,8.4 A7,7 0 0 1 17.43,8.98 A14,14 0 0 1 12,10 C9.92,10 8,9.62 6.57,8.98 A7,7 0 0 1 5.5,8.4 L5.5,18 C5.5,18.2 5.59,18.46 5.87,18.75 Q6.27,19.21 7.18,19.61 C8.38,20.15 10.08,20.5 12,20.5 C13.92,20.5 15.62,20.15 16.82,19.61 Q17.72,19.21 18.13,18.75 C18.41,18.45 18.5,18.21 18.5,18 Z"/></Viewbox>
              <TextBlock DockPanel.Dock="Left" Text="I/O" Style="{StaticResource DashRowCaption}" VerticalAlignment="Center" ToolTip="Everything this process reads and writes: files, but also network, pipes and devices — not only the disk"/>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="read " FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                <TextBlock x:Name="TxtLiveDiskRead" Text="—" FontFamily="{StaticResource NumFont}" FontSize="17" FontWeight="SemiBold" Margin="0,0,12,0"/>
                <TextBlock Text="write " FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                <TextBlock x:Name="TxtLiveDisk" Text="—" FontFamily="{StaticResource NumFont}" FontSize="17" FontWeight="SemiBold"/>
              </StackPanel>
            </DockPanel>
            <local:MiniLineChart x:Name="DiskChart" Grid.Row="1" MinHeight="70" Margin="0,0,0,10"/>
            <Border Grid.Row="2" Style="{StaticResource CompFootBand}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CompFootCellFirst}"><StackPanel><TextBlock Text="Read in total" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtTotalDiskRead" Text="—" Style="{StaticResource CompFootVal}"/></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource CompFootCell}"><StackPanel><TextBlock Text="Written in total" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtTotalDiskWrite" Text="—" Style="{StaticResource CompFootVal}"/></StackPanel></Border>
              </Grid>
            </Border>
          </Grid>
        </Border>
        <Border Grid.Column="2" Grid.Row="2" Style="{StaticResource CompCardStyle}" Cursor="Arrow" ToolTip="Total system network traffic (all apps) — Windows does not expose a per-process network counter like it does for CPU/Disk.">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel LastChildFill="False" Margin="0,0,0,6">
              <Viewbox DockPanel.Dock="Left" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,9,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M17.74,10.75 Q18.64,11.65 19.24,12.82 A0.75,0.75 0 1 1 17.9,13.5 A6.56,6.56 0 0 0 6.19,13.48 A0.75,0.75 0 1 1 4.85,12.81 Q5.42,11.67 6.35,10.75 A8.06,8.06 0 0 1 17.75,10.75 M15.65,13.82 Q16.33,14.52 16.73,15.4 A0.75,0.75 0 1 1 15.35,16 A3.6,3.6 0 0 0 8.75,16 A0.75,0.75 0 1 1 7.38,15.4 Q7.78,14.51 8.44,13.83 A5.1,5.1 0 0 1 15.64,13.83 M20.44,8.29 Q21.23,9.06 21.86,9.99 A0.75,0.75 0 0 1 20.62,10.84 Q20.06,10.02 19.39,9.34 A10.45,10.45 0 0 0 3.39,10.84 A0.75,0.75 0 0 1 2.16,9.98 Q2.81,9.04 3.56,8.28 A11.95,11.95 0 0 1 20.45,8.28 M13.07,16.44 A1.5,1.5 0 1 1 10.95,18.56 A1.5,1.5 0 0 1 13.07,16.44"/></Viewbox>
              <TextBlock DockPanel.Dock="Left" Text="NETWORK · WHOLE SYSTEM" Style="{StaticResource DashRowCaption}" VerticalAlignment="Center"/>
              <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBlock Text="↑ " FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                <TextBlock x:Name="TxtLiveNetSend" Text="—" FontFamily="{StaticResource NumFont}" FontSize="17" FontWeight="SemiBold" Margin="0,0,12,0"/>
                <TextBlock Text="↓ " FontSize="{StaticResource FontSizeS}" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>
                <TextBlock x:Name="TxtLiveNetRecv" Text="—" FontFamily="{StaticResource NumFont}" FontSize="17" FontWeight="SemiBold"/>
              </StackPanel>
            </DockPanel>
            <local:MiniLineChart x:Name="NetChart" Grid.Row="1" MinHeight="70" Margin="0,0,0,10"/>
            <Border Grid.Row="2" Style="{StaticResource CompFootBand}">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{StaticResource CompFootCellFirst}"><StackPanel><TextBlock Text="Sent" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtTotalNetSend" Text="—" Style="{StaticResource CompFootVal}"/></StackPanel></Border>
                <Border Grid.Column="1" Style="{StaticResource CompFootCell}"><StackPanel><TextBlock Text="Received" Style="{StaticResource CompFootKey}"/><TextBlock x:Name="TxtTotalNetRecv" Text="—" Style="{StaticResource CompFootVal}"/></StackPanel></Border>
              </Grid>
            </Border>
          </Grid>
        </Border>
    </Grid>

    <!-- Waiting for the first samples -->
    <Border x:Name="LoadingOverlay" Visibility="Visible"
            Grid.Row="1" Panel.ZIndex="10"
            Background="{DynamicResource BgOverlayBrush}"
            CornerRadius="10">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="24,16">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <ProgressBar IsIndeterminate="True" Width="18" Height="18" Margin="0,0,12,0"
                       Style="{StaticResource AnimatedProgressBarStyle}"/>
          <TextBlock Text="Collecting performance data…" FontSize="{StaticResource FontSizeM}" FontWeight="SemiBold"
                     Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </StackPanel>
      </Border>
    </Border>

    <!-- Modules / threads -->
    <Border Grid.Row="2" Style="{StaticResource CompCardStyle}" Cursor="Arrow" Padding="0,12,0,0">
      <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="18,0,18,8" LastChildFill="False">
          <Viewbox DockPanel.Dock="Left" Width="19" Height="19" VerticalAlignment="Center" Margin="0,0,11,0"><Path Width="24" Height="24" Style="{StaticResource CompIcon}" Data="F1 M2,5.75 C2,5.34 2.34,5 2.75,5 L18.25,5 A0.75,0.75 0 0 1 18.25,6.5 L2.75,6.5 A0.75,0.75 0 0 1 2,5.75 M2,18.75 C2,18.34 2.34,18 2.75,18 L13.25,18 A0.75,0.75 0 0 1 13.25,19.5 L2.75,19.5 A0.75,0.75 0 0 1 2,18.75 M2.75,11.5 A0.75,0.75 0 0 0 2.75,13 L21.25,13 A0.75,0.75 0 0 0 21.25,11.5 Z"/></Viewbox>
          <TextBlock DockPanel.Dock="Left" Text="INSIDE THE PROCESS" Style="{StaticResource DashRowCaption}" VerticalAlignment="Center" Margin="0,0,16,0"/>
          <Border Style="{StaticResource SegmentTrackStyle}" Tag="SegTrack" DockPanel.Dock="Left" VerticalAlignment="Center"><StackPanel Orientation="Horizontal"><ui:Button x:Name="BtnTabModules" DockPanel.Dock="Left" Content="Modules" Click="TabModules_Click" Appearance="Secondary" Background="{DynamicResource SelBtnBg}" BorderBrush="{DynamicResource SelBtnBorderBrush}" BorderThickness="1" FontWeight="SemiBold" Padding="12,4" Margin="0,0,6,0"/>
          <ui:Button x:Name="BtnTabThreads" DockPanel.Dock="Left" Content="Threads" Click="TabThreads_Click" Appearance="Secondary" Padding="12,4"/></StackPanel></Border>
          <ui:Button x:Name="BtnRefreshModules" DockPanel.Dock="Right" Content="↺" Click="RefreshModules_Click" Appearance="Secondary" Padding="8,4"
                  FontSize="{StaticResource FontSizeM}" ToolTip="Refresh list"/>
          <TextBlock x:Name="TxtSampleCount" DockPanel.Dock="Right" Text="" Visibility="Collapsed"/>
          <TextBlock x:Name="TxtDiskTotal" Visibility="Collapsed"/><TextBlock x:Name="TxtNetTotal" Visibility="Collapsed"/>
        </DockPanel>
        <DataGrid x:Name="ModulesGrid" Grid.Row="1" Style="{StaticResource VanillaDataGridStyle}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                  CanUserResizeColumns="True" HeadersVisibility="Column" GridLinesVisibility="None"
                  Background="Transparent" BorderThickness="0" FontSize="{StaticResource FontSizeS}"
                  Visibility="Visible">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Module"  Binding="{Binding Name}"     Width="*"   MinWidth="120"/>
            <DataGridTextColumn Header="Version" Binding="{Binding Version}"  Width="Auto"/>
            <DataGridTextColumn Header="Path"    Binding="{Binding Path}"     Width="2*"  MinWidth="160"/>
            <DataGridTextColumn Header="Size"    Binding="{Binding SizeText}" Width="70"/>
          </DataGrid.Columns>
        </DataGrid>
        <DataGrid x:Name="ThreadsGrid" Grid.Row="1" Style="{StaticResource VanillaDataGridStyle}"
                  AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="True"
                  CanUserResizeColumns="True" HeadersVisibility="Column" GridLinesVisibility="None"
                  Background="Transparent" BorderThickness="0" FontSize="{StaticResource FontSizeS}"
                  Visibility="Collapsed">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Thread ID"  Binding="{Binding Id}"          Width="80"/>
            <DataGridTextColumn Header="State"      Binding="{Binding State}"        Width="90"/>
            <DataGridTextColumn Header="Priority"   Binding="{Binding Priority}"     Width="80"/>
            <DataGridTextColumn Header="CPU Time"   Binding="{Binding CpuTimeText}"  Width="90"/>
            <DataGridTextColumn Header="Start"      Binding="{Binding StartTimeText}" Width="140"/>
          </DataGrid.Columns>
        </DataGrid>
      </Grid>
    </Border>
  </Grid>
</Window>
