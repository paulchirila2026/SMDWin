<Window x:Class="SMDWin.Views.PinnedProcessWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Process Widget"
        Width="232"
        SizeToContent="Height"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

  <!-- Outer transparent padding for drop shadow -->
  <Grid>
    <!-- the shadow on its own empty layer: an Effect on the element with text would blur the text -->
    <Border CornerRadius="{DynamicResource RadiusCard}" Background="#0E121C" Margin="12" IsHitTestVisible="False">
      <Border.Effect>
      <DropShadowEffect BlurRadius="20" ShadowDepth="8" Color="#000000" Opacity="0.55"/>
    </Border.Effect>
    </Border>
    <Border Padding="12" Background="Transparent">

    <!-- Card — identical to WidgetWindow shell -->
    <Border x:Name="CardBorder" CornerRadius="{DynamicResource RadiusCard}" ClipToBounds="True"
            BorderThickness="1">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#0E121C" Offset="0"/>
          <GradientStop Color="#0A0D14" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Border.BorderBrush>
        <SolidColorBrush Color="#376499" Opacity="0.22"/>
      </Border.BorderBrush>

      <StackPanel>
        <!-- Header -->
        <Grid Margin="14,10,14,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- Title: the process name + PID / state -->
          <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <TextBlock x:Name="TxtProcessName" Text="—"
                       FontSize="{StaticResource FontSizeS}" FontWeight="SemiBold"
                       Foreground="#E6FFFFFF" TextTrimming="CharacterEllipsis"/>
            <TextBlock x:Name="TxtProcessSub" Text="" FontSize="{StaticResource FontSizeXS}"
                       Foreground="#80FFFFFF" TextTrimming="CharacterEllipsis"/>
          </StackPanel>

          <!-- Only the close button -->
          <Button Grid.Column="1" Content="✕" Click="BtnClose_Click" Width="20" Height="20">
            <Button.Style>
              <Style TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="#55FFFFFF"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="Template">
                  <Setter.Value>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="Bd" Background="Transparent" CornerRadius="4">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="Bd" Property="Background" Value="#37EF4444"/>
                          <Setter Property="Foreground" Value="#FFEF4444"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Setter.Value>
                </Setter>
              </Style>
            </Button.Style>
          </Button>
        </Grid>

        <Grid Margin="14,0,14,12">
          <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="54"/>
            <RowDefinition Height="4"/>
            <RowDefinition Height="54"/>
          </Grid.RowDefinitions>

          <!-- CPU -->
          <Border Grid.Row="0" CornerRadius="6"
                  Background="#12FFFFFF" Padding="8,5">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid>
                <TextBlock FontSize="{StaticResource FontSizeXS}" FontWeight="SemiBold" Foreground="#8060A5FA">
                  <Run Text="CPU"/><Run x:Name="TxtCpuPeak" Text="" FontWeight="Normal"/>
                </TextBlock>
                <TextBlock x:Name="TxtCpuVal" Text="—" FontSize="{StaticResource FontSizeM}" FontWeight="Bold"
                           Foreground="#FF60A5FA" HorizontalAlignment="Right"/>
              </Grid>
              <Canvas x:Name="CpuChart" Grid.Row="1" ClipToBounds="True"/>
            </Grid>
          </Border>

          <!-- RAM -->
          <Border Grid.Row="2" CornerRadius="6"
                  Background="#1234D399" Padding="8,5">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid>
                <TextBlock FontSize="{StaticResource FontSizeXS}" FontWeight="SemiBold" Foreground="#8034D399">
                  <Run Text="RAM"/><Run x:Name="TxtRamPeak" Text="" FontWeight="Normal"/>
                </TextBlock>
                <TextBlock x:Name="TxtRamVal" Text="—" FontSize="{StaticResource FontSizeM}" FontWeight="Bold"
                           Foreground="#FF34D399" HorizontalAlignment="Right"/>
              </Grid>
              <Canvas x:Name="RamChart" Grid.Row="1" ClipToBounds="True"/>
            </Grid>
          </Border>

          <!-- Disk -->
          <Border Grid.Row="4" CornerRadius="6"
                  Background="#12FBBF24" Padding="8,5">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
              </Grid.RowDefinitions>
              <Grid>
                <TextBlock FontSize="{StaticResource FontSizeXS}" FontWeight="SemiBold" Foreground="#80FBBF24">
                  <Run Text="I/O"/><Run x:Name="TxtDiskSplit" Text="" FontWeight="Normal"/>
                </TextBlock>
                <TextBlock x:Name="TxtDiskVal" Text="—" FontSize="{StaticResource FontSizeM}" FontWeight="Bold"
                           Foreground="#FFFBBF24" HorizontalAlignment="Right"/>
              </Grid>
              <Canvas x:Name="DiskChart" Grid.Row="1" ClipToBounds="True"/>
            </Grid>
          </Border>
        </Grid>

      </StackPanel>
    </Border>
  </Border>
  </Grid>
</Window>
