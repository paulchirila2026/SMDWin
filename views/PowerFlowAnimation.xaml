<UserControl x:Class="SMDWin.Views.PowerFlowAnimation"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008">
    <!-- The Power page, a system without a battery (desktop):
           • colours from the theme (Light / Dark);
           • a single horizontal power "rail" (PSU → right) with short vertical branches to the components, 3 above and 3
             below → no line overlaps / intersects;
           • each component shows the real power setting of the active plan (on AC):
             CPU = minimum / maximum processor state + boost, GPU = PCI Express Link State,
             RAM = sleep after X (sleep keeps the RAM powered), Storage = turn off disk after X,
             Display = turn off display after X, USB = selective suspend; PSU = the active plan.
         The dots flowing along the paths are only visual (there is no consumption telemetry on a desktop). -->
    <UserControl.Resources>
        <Style x:Key="TraceLineStyle" TargetType="Path">
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="StrokeDashArray" Value="1.5,3"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
            <Setter Property="StrokeDashCap" Value="Round"/>
        </Style>
        <!-- The "static" trace under the dots: a continuous, thin, faded line -->
        <Style x:Key="TraceBaseStyle" TargetType="Path">
            <Setter Property="StrokeThickness" Value="2"/>
            <Setter Property="Fill" Value="Transparent"/>
            <Setter Property="Opacity" Value="0.22"/>
            <Setter Property="StrokeStartLineCap" Value="Round"/>
            <Setter Property="StrokeEndLineCap" Value="Round"/>
        </Style>
        <Style x:Key="ChipStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1.4"/>
            <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
            <Setter Property="Padding" Value="10,6,10,6"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="66"/>
        </Style>
        <Style x:Key="ChipLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeS}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style x:Key="ChipInfoStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FontSizeS}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
            <Setter Property="MaxHeight" Value="34"/>
        </Style>
        <Style x:Key="JunctionStyle" TargetType="Ellipse">
            <Setter Property="Width" Value="7"/>
            <Setter Property="Height" Value="7"/>
            <Setter Property="Fill" Value="{DynamicResource StatusOkBrush}"/>
        </Style>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Width="660" Height="300" Loaded="RootGrid_Loaded" Unloaded="RootGrid_Unloaded">

        <!-- No background of its own: the diagram sits directly on the card; the chips have a coloured border, so they show on
             both themes -->
        <Canvas x:Name="GridCanvas" Visibility="Collapsed"/>

        <Canvas>
            <!-- ── Paths: the base (continuous, faded) + the flowing dots ────────────────────
                 Rail: y=150, from the PSU (x=128) to the last branch (x=565, Display / USB). Vertical branches at x=225/395/565.
                 Top chips: y=18..84, bottom chips: y=216..282. -->
            <Path Style="{StaticResource TraceBaseStyle}" Stroke="{DynamicResource StatusOkBrush}" Data="M 128,150 L 565,150"/>
            <Path Style="{StaticResource TraceBaseStyle}" Stroke="{DynamicResource AccentBrush}"      Data="M 225,150 L 225,84"/>
            <Path Style="{StaticResource TraceBaseStyle}" Stroke="{DynamicResource GpuAccentBrush}"   Data="M 395,150 L 395,84"/>
            <Path Style="{StaticResource TraceBaseStyle}" Stroke="{DynamicResource PinkAccentBrush}"  Data="M 565,150 L 565,84"/>
            <Path Style="{StaticResource TraceBaseStyle}" Stroke="{DynamicResource CyanAccentBrush}"  Data="M 225,150 L 225,216"/>
            <Path Style="{StaticResource TraceBaseStyle}" Stroke="{DynamicResource AmberAccentBrush}" Data="M 395,150 L 395,216"/>
            <Path Style="{StaticResource TraceBaseStyle}" Stroke="{DynamicResource TextSecondaryBrush}" Data="M 565,150 L 565,216"/>

            <Path x:Name="TraceRail"    Style="{StaticResource TraceLineStyle}" Stroke="{DynamicResource StatusOkBrush}" Data="M 128,150 L 565,150"/>
            <Path x:Name="TraceCpu"     Style="{StaticResource TraceLineStyle}" Stroke="{DynamicResource AccentBrush}"      Data="M 225,150 L 225,84"/>
            <Path x:Name="TraceGpu"     Style="{StaticResource TraceLineStyle}" Stroke="{DynamicResource GpuAccentBrush}"   Data="M 395,150 L 395,84"/>
            <Path x:Name="TraceDisplay" Style="{StaticResource TraceLineStyle}" Stroke="{DynamicResource PinkAccentBrush}"  Data="M 565,150 L 565,84"/>
            <Path x:Name="TraceRam"     Style="{StaticResource TraceLineStyle}" Stroke="{DynamicResource CyanAccentBrush}"  Data="M 225,150 L 225,216"/>
            <Path x:Name="TraceDisk"    Style="{StaticResource TraceLineStyle}" Stroke="{DynamicResource AmberAccentBrush}" Data="M 395,150 L 395,216"/>
            <Path x:Name="TraceUsb"     Style="{StaticResource TraceLineStyle}" Stroke="{DynamicResource TextSecondaryBrush}" Data="M 565,150 L 565,216"/>

            <!-- The nodes on the rail (the branch points) -->
            <Ellipse Style="{StaticResource JunctionStyle}" Canvas.Left="221.5" Canvas.Top="146.5"/>
            <Ellipse Style="{StaticResource JunctionStyle}" Canvas.Left="391.5" Canvas.Top="146.5"/>
            <Ellipse Style="{StaticResource JunctionStyle}" Canvas.Left="561.5" Canvas.Top="146.5"/>

            <!-- ── Motherboard: the CMOS battery (only if the board reports it) ── -->
            <Border x:Name="BoardChip" Style="{StaticResource ChipStyle}" Canvas.Left="18" Canvas.Top="10"
                    Width="110" Height="58" BorderBrush="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed"
                    ToolTip="CMOS battery (keeps BIOS settings and the clock). A new one is ~3.0 V; below ~2.8 V it should be replaced.">
                <StackPanel>
                    <TextBlock Text="Board" Style="{StaticResource ChipLabelStyle}"/>
                    <TextBlock x:Name="TxtCmosInfo" Text="" Style="{StaticResource ChipInfoStyle}"/>
                </StackPanel>
            </Border>

            <!-- ── PSU (power supply) — left, centred on the rail ── -->
            <Border x:Name="PsuChip" Style="{StaticResource ChipStyle}" Canvas.Left="18" Canvas.Top="76"
                    Width="110" Height="148" BorderBrush="{DynamicResource StatusOkBrush}">
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Viewbox Width="14" Height="14" Margin="0,0,5,0" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{DynamicResource StatusOkBrush}" Data="F1 M7.43,2.83 C7.6,2.33 8.07,2 8.6,2 L15.06,2 C15.91,2 16.51,2.84 16.24,3.65 L14.8,8 L18.76,8 C19.86,8 20.43,9.33 19.66,10.12 L8.59,21.54 C7.53,22.62 5.71,21.64 6.04,20.16 L7.31,14.5 L5.75,14.49 C4.54,14.49 3.7,13.29 4.1,12.15 Z M8.78,3.5 L5.52,12.66 C5.46,12.82 5.58,12.99 5.75,12.99 L8.25,13 A0.75,0.75 0 0 1 8.98,13.91 L7.51,20.5 L18.16,9.5 L13.75,9.5 A0.75,0.75 0 0 1 13.04,8.51 L14.7,3.5 Z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="PSU · AC" Style="{StaticResource ChipLabelStyle}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="TxtPsuInfo" Text="" Visibility="Collapsed" Style="{StaticResource ChipInfoStyle}" MaxHeight="17"/>
                    <!-- Measured CPU + GPU (only if there is at least one power sensor) -->
                    <TextBlock x:Name="TxtPsuTotal" Text="" Visibility="Collapsed" Style="{StaticResource ChipInfoStyle}" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <!-- +12 / +5 / +3.3 V (only the lines the board reports plausibly) -->
                    <TextBlock x:Name="TxtPsuRails" Text="" Visibility="Collapsed" Style="{StaticResource ChipInfoStyle}" MaxHeight="48"/>
                </StackPanel>
            </Border>

            <!-- ── Fans (only if there are speed sensors) ── -->
            <Border x:Name="FansChip" Style="{StaticResource ChipStyle}" Canvas.Left="18" Canvas.Top="232"
                    Width="110" Height="58" BorderBrush="{DynamicResource TextSecondaryBrush}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Fans" Style="{StaticResource ChipLabelStyle}"/>
                    <TextBlock x:Name="TxtFansInfo" Text="" Style="{StaticResource ChipInfoStyle}"/>
                </StackPanel>
            </Border>

            <!-- ── Top: CPU / GPU / Display ── -->
            <Border x:Name="CpuChip" Style="{StaticResource ChipStyle}" Canvas.Left="150" Canvas.Top="18"
                    BorderBrush="{DynamicResource AccentBrush}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="TxtCpuW" DockPanel.Dock="Right" Text="" Visibility="Collapsed" Style="{StaticResource ChipLabelStyle}"
                                   Foreground="{DynamicResource AccentBrush}" ToolTip="CPU package power (measured)"/>
                        <TextBlock Text="CPU" Style="{StaticResource ChipLabelStyle}"/>
                    </DockPanel>
                    <TextBlock x:Name="TxtCpuInfo" Text="" Visibility="Collapsed" Style="{StaticResource ChipInfoStyle}"/>
                </StackPanel>
            </Border>
            <Border x:Name="GpuChip" Style="{StaticResource ChipStyle}" Canvas.Left="320" Canvas.Top="18"
                    BorderBrush="{DynamicResource GpuAccentBrush}">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="TxtGpuW" DockPanel.Dock="Right" Text="" Visibility="Collapsed" Style="{StaticResource ChipLabelStyle}"
                                   Foreground="{DynamicResource GpuAccentBrush}" ToolTip="GPU power (measured)"/>
                        <TextBlock Text="GPU · PCIe" Style="{StaticResource ChipLabelStyle}"/>
                    </DockPanel>
                    <TextBlock x:Name="TxtGpuInfo" Text="" Visibility="Collapsed" Style="{StaticResource ChipInfoStyle}"/>
                </StackPanel>
            </Border>
            <Border x:Name="DisplayChip" Style="{StaticResource ChipStyle}" Canvas.Left="490" Canvas.Top="18"
                    BorderBrush="{DynamicResource PinkAccentBrush}">
                <StackPanel>
                    <TextBlock Text="Display" Style="{StaticResource ChipLabelStyle}"/>
                    <TextBlock x:Name="TxtDisplayInfo" Text="" Visibility="Collapsed" Style="{StaticResource ChipInfoStyle}"/>
                </StackPanel>
            </Border>

            <!-- ── Bottom: RAM / Storage / USB ── -->
            <Border x:Name="RamChip" Style="{StaticResource ChipStyle}" Canvas.Left="150" Canvas.Top="216"
                    BorderBrush="{DynamicResource CyanAccentBrush}">
                <StackPanel>
                    <TextBlock Text="RAM · Sleep" Style="{StaticResource ChipLabelStyle}"/>
                    <TextBlock x:Name="TxtRamInfo" Text="" Visibility="Collapsed" Style="{StaticResource ChipInfoStyle}"/>
                </StackPanel>
            </Border>
            <Border x:Name="DiskChip" Style="{StaticResource ChipStyle}" Canvas.Left="320" Canvas.Top="216"
                    BorderBrush="{DynamicResource AmberAccentBrush}">
                <StackPanel>
                    <TextBlock Text="Storage" Style="{StaticResource ChipLabelStyle}"/>
                    <TextBlock x:Name="TxtDiskInfo" Text="" Visibility="Collapsed" Style="{StaticResource ChipInfoStyle}"/>
                </StackPanel>
            </Border>
            <Border x:Name="UsbChip" Style="{StaticResource ChipStyle}" Canvas.Left="490" Canvas.Top="216"
                    BorderBrush="{DynamicResource TextSecondaryBrush}">
                <StackPanel>
                    <TextBlock Text="USB" Style="{StaticResource ChipLabelStyle}"/>
                    <TextBlock x:Name="TxtUsbInfo" Text="" Visibility="Collapsed" Style="{StaticResource ChipInfoStyle}"/>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
