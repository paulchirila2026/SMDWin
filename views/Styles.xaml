  <!-- ═══════════════════════════════════════════════════════════════════════
       LIGHT THEME — Blue Frost gradient effects
       Used by ThemeManager.Apply() on the Light theme.
       They do not affect the Dark theme — the tokens are overridden at runtime.
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- Sidebar gradient Light: pure white → very subtle blue-grey (top→bottom) -->
  <!-- ThemeManager.ApplySidebarGradient() va folosi aceste stopuri -->
  <LinearGradientBrush x:Key="SidebarGradientLightBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0.0"/>
    <GradientStop Color="#F0F4FA" Offset="1.0"/>
  </LinearGradientBrush>

  <!-- Card shadow Light: a soft blue-grey shadow instead of black -->
