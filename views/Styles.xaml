  <SolidColorBrush x:Key="Lift.Surface2"         Color="#292524"/>
  <SolidColorBrush x:Key="Lift.Border"           Color="#3C3633"/>
  <SolidColorBrush x:Key="Lift.Border2"          Color="#57534E"/>
  <SolidColorBrush x:Key="Lift.Text"             Color="#FAFAF9"/>
  <SolidColorBrush x:Key="Lift.TextMuted"        Color="#D6D3D1"/>
  <SolidColorBrush x:Key="Lift.TextSoft"         Color="#A8A29E"/>
  <SolidColorBrush x:Key="Lift.TextDim"          Color="#78716C"/>
  <SolidColorBrush x:Key="Lift.AccentBrush"      Color="#818CF8"/>
  <SolidColorBrush x:Key="Lift.AccentHover"      Color="#A5B4FC"/>
  <SolidColorBrush x:Key="Lift.AccentPress"      Color="#C7D2FE"/>
  <SolidColorBrush x:Key="Lift.PrimaryBg"        Color="#FAFAF9"/>
  <SolidColorBrush x:Key="Lift.PrimaryBgHover"   Color="#E7E5E4"/>
  <SolidColorBrush x:Key="Lift.PrimaryBgPress"   Color="#D6D3D1"/>
  <SolidColorBrush x:Key="Lift.PrimaryFg"        Color="#0C0A09"/>
