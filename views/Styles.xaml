                    BlurRadius="16" ShadowDepth="2" Direction="270"
                    Color="#64748B" Opacity="0.07" RenderingBias="Quality"/>

  <!-- Card hover shadow Light: a slightly stronger blue-grey shadow on hover -->
  <DropShadowEffect x:Key="CardHoverShadowLightEffect" x:Shared="False"
                    BlurRadius="22" ShadowDepth="0" Direction="270"
                    Color="#6B86B8" Opacity="0.12" RenderingBias="Quality"/>

  <!-- Sidebar shadow Light: a subtle shadow on the right, metallic -->
  <DropShadowEffect x:Key="SidebarShadowLightEffect" x:Shared="False"
                    BlurRadius="20" ShadowDepth="2" Direction="270"
                    Color="#000000" Opacity="0.10" RenderingBias="Quality"/>

  <!-- ═══════════════════════════════════════════════════════════════════════
       GLOBAL BASE STYLES — font + background on every control type
       These MUST live here (not in App.xaml) to avoid overriding themed styles.
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- TextBlock — font + rendering -->
  <Style TargetType="TextBlock">
    <Setter Property="FontFamily"                        Value="{StaticResource AppFont}"/>
    <Setter Property="TextOptions.TextRenderingMode"     Value="ClearType"/>
    <Setter Property="Typography.NumeralAlignment"       Value="Tabular"/>
  </Style>

  <!-- TextBox — font (full style defined lower, this ensures no override) -->

  <!-- Button — base font (actual styles defined as named keys below) -->
  <!-- Explicit TargetType Button (not RadioButton/CheckBox) — avoids a WPF warning at start-up -->
  <Style TargetType="{x:Type Button}">
    <Setter Property="FontFamily"         Value="{StaticResource AppFont}"/>
    <Setter Property="FocusVisualStyle"   Value="{StaticResource AppFocusVisual}"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>

  <!-- ListBox — themed background/border, no system chrome -->
  <Style TargetType="ListBox">
    <Setter Property="FontFamily"      Value="{StaticResource AppFont}"/>
    <Setter Property="Background"      Value="{DynamicResource BgCardBrush}"/>
    <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush2}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding"         Value="2"/>
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBox">
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="8" Padding="{TemplateBinding Padding}">
            <ScrollViewer Focusable="False">
              <ItemsPresenter/>
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ListBoxItem — themed hover/select -->
  <Style TargetType="ListBoxItem">
    <Setter Property="Background"       Value="Transparent"/>
    <Setter Property="Foreground"       Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="Padding"          Value="10,7"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Bd" Background="{TemplateBinding Background}"
                  CornerRadius="8" Margin="2,1"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center"
                              TextElement.Foreground="{TemplateBinding Foreground}"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BgHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentBrush}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ItemsControl — transparent background, themed font -->
  <Style TargetType="ItemsControl">
    <Setter Property="FontFamily"  Value="{StaticResource AppFont}"/>
    <Setter Property="Background"  Value="Transparent"/>
    <Setter Property="Foreground"  Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
  </Style>

  <!-- GroupBox — themed -->
  <Style TargetType="GroupBox">
    <Setter Property="Background"      Value="{DynamicResource BgCardBrush}"/>
    <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource BorderBrush2}"/>
    <Setter Property="FontFamily"      Value="{StaticResource AppFont}"/>
    <Setter Property="FontSize"        Value="{StaticResource FontSizeM}"/>
  </Style>

  <!-- Expander — themed -->
  <Style TargetType="Expander">
    <Setter Property="Background"  Value="Transparent"/>
    <Setter Property="Foreground"  Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush2}"/>
    <Setter Property="FontFamily"  Value="{StaticResource AppFont}"/>
    <Setter Property="FontSize"    Value="{StaticResource FontSizeM}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Expander">
          <StackPanel>
            <ToggleButton x:Name="ExpanderToggle" Style="{x:Null}"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                          Cursor="Hand" Focusable="False">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="HeaderRow" Background="Transparent" CornerRadius="8" Padding="6,7">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <Path x:Name="Chevron" Grid.Column="0"
                            Data="M6,4 L11,8 L6,12" Stretch="Uniform" Width="9" Height="9"
                            Stroke="{DynamicResource TextSecondaryBrush}" StrokeThickness="1.8"
                            StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                            VerticalAlignment="Center" Margin="2,0,8,0"
                            RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                          <RotateTransform Angle="0"/>
                        </Path.RenderTransform>
                      </Path>
                      <ContentPresenter Grid.Column="1" ContentSource="Content"
                                         VerticalAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="HeaderRow" Property="Background" Value="{DynamicResource BgHoverBrush}"/>
                      <Setter TargetName="Chevron"   Property="Stroke"     Value="{DynamicResource AccentBrush}"/>
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Chevron" Property="RenderTransform">
                        <Setter.Value>
                          <RotateTransform Angle="90"/>
                        </Setter.Value>
                      </Setter>
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>
              <ContentPresenter ContentSource="Header"/>
            </ToggleButton>
            <ContentPresenter x:Name="ExpandSite" Content="{TemplateBinding Content}"
                               Visibility="Collapsed" Margin="0,4,0,0"/>
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════════
       UNIFIED CARD SYSTEM
       BaseCardStyle      — single source of truth: BgCard bg, CardBorder, radius 12, no shadow (an Effect on an element
                            with text blurs the text; the outline separates the cards)
       CardStyle          — alias for BaseCardStyle (legacy compatibility)
       DashCardStyle      — dashboard metric card (BasedOn BaseCardStyle)
       DashClickCardStyle — clickable dashboard card (BasedOn DashCardStyle, Cursor=Hand)
       SpecCardStyle      — static info card (BasedOn BaseCardStyle)
       ═══════════════════════════════════════════════════════════════════════ -->

  <Style x:Key="BaseCardStyle" TargetType="Border">
    <Setter Property="Background"      Value="{DynamicResource CardSurfaceBrush}"/>
    <Setter Property="BorderBrush"     Value="{DynamicResource CardEdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius"    Value="{DynamicResource RadiusCard}"/>
    <Setter Property="Padding"         Value="14,12"/>
    <!-- no hover highlight on cards (only list rows and buttons react to the mouse) -->
  </Style>

  <!-- Legacy aliases — all existing XAML continues to work without changes -->
  <Style x:Key="CardStyle"          TargetType="Border" BasedOn="{StaticResource BaseCardStyle}"/>
  <Style x:Key="DashCardStyle"      TargetType="Border" BasedOn="{StaticResource BaseCardStyle}">
    <Setter Property="BorderBrush" Value="{DynamicResource CardEdgeBrush}"/>
  </Style>

  <!-- QuickActionStyle — the Quick Actions buttons on the dashboard -->

  <Style x:Key="DashClickCardStyle" TargetType="Border" BasedOn="{StaticResource DashCardStyle}">
    <Setter Property="Cursor"  Value="Hand"/>
    <Setter Property="Padding" Value="0"/>
  </Style>
  <!-- ══ Dashboard in rows ══════════════════════════════
       One row per component: [component] [now] [chart] [details] [state].
       The columns are the same on all rows (fixed widths + chart *), so everything is aligned. -->
  <Style x:Key="DashRowCardStyle" TargetType="Border" BasedOn="{StaticResource DashClickCardStyle}">
    <Setter Property="Padding" Value="16,10,16,10"/>
    <Setter Property="Margin"  Value="0,0,0,8"/>
    <Setter Property="MinHeight" Value="84"/>
    <!-- no hover effect: the hand cursor and the "›" chevron show the row can be opened -->
  </Style>
  <!-- the section label (in "Sentence case", no capitals): "What it means", "All sensors" -->
  <Style x:Key="DashRowCaption" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeS}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style x:Key="DashRowName" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeXL}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="Margin" Value="0,1,0,0"/>
  </Style>
  <Style x:Key="DashRowValue" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeXL}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <!-- the small text next to the card title, on the same line ("Disk activity  All drives") -->
  <Style x:Key="DashRowInlineSub" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeM}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="Margin" Value="10,0,0,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="DashRowSub" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeS}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="DashFactKey" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeXS}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>
  <Style x:Key="DashFactVal" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeS}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="Margin" Value="0,0,10,4"/>
  </Style>
  <Style x:Key="DashChartLabel" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeS}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="Opacity" Value="0.95"/>
    <Setter Property="Margin" Value="2,0,0,2"/>
  </Style>
  <!-- ══ Component card (dashboard) ══════════════════ -->
  <!-- the colours of the DIMM module drawing (RAM page) — an illustration, the same on Light and Dark -->
  <SolidColorBrush x:Key="DimmChipBrush" Color="#1B2536"/>
  <SolidColorBrush x:Key="DimmPinBrush"  Color="#D6A94A"/>
  <SolidColorBrush x:Key="DimmSocketBrush" Color="#6B7380"/>
  <SolidColorBrush x:Key="DimmSocketBodyBrush" Color="#2B2F37"/>  <!-- the socket body of an empty RAM slot -->
  <SolidColorBrush x:Key="DimmPcbBrush" Color="#1E5A3E"/>
  <SolidColorBrush x:Key="DimmPcbEdgeBrush" Color="#16452F"/>
  <SolidColorBrush x:Key="DimmChipMarkBrush" Color="#46536A"/>
  <!-- the colours of the processor drawing (System Information) — the metal lid and the chip; an illustration, the same on
       Light and Dark -->
  <SolidColorBrush x:Key="CpuLidBrush" Color="#C9CED6"/>
  <SolidColorBrush x:Key="CpuLidShadeBrush" Color="#AEB5C0"/>
  <SolidColorBrush x:Key="CpuLidTextBrush" Color="#667080"/>
  <SolidColorBrush x:Key="CpuDieBrush" Color="#26303F"/>
  <SolidColorBrush x:Key="CpuDieShineBrush" Color="#44536E"/>
  <!-- segmented control (Settings): a row of options on a grey track; the chosen one is a white plate with an outline.
       Usage: RadioButtons with the same GroupName in a horizontal StackPanel with the SegmentTrackStyle style. -->
  <!-- ═══ The Settings page (tabs, cards, rows) ═══ -->
  <!-- tab: text + a 2 px line below, in the accent colour -->
  <Style x:Key="SettingsTabStyle" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeL}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
    <Setter Property="Margin" Value="0,0,26,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid Background="Transparent">
            <ContentPresenter Margin="0,8,0,10" VerticalAlignment="Center"/>
            <Border x:Name="Line" Height="2" CornerRadius="1" VerticalAlignment="Bottom" Background="Transparent"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
              <Setter TargetName="Line" Property="Background" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SetCard" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardEdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="18,2,18,4"/>
    <Setter Property="Margin" Value="0,0,0,14"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
  </Style>
  <Style x:Key="SetCardTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeXL}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="Margin" Value="0,14,0,10"/>
  </Style>
  <Style x:Key="SetRow" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="Padding" Value="0,12,0,12"/>
    <Setter Property="Background" Value="Transparent"/>
  </Style>
  <Style x:Key="SetRowIcon" TargetType="Viewbox">
    <Setter Property="Width" Value="20"/>
    <Setter Property="Height" Value="20"/>
    <Setter Property="Margin" Value="0,0,16,0"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="DockPanel.Dock" Value="Left"/>
  </Style>
  <Style x:Key="SetRowTitle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeM}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
  </Style>
  <Style x:Key="SetRowDesc" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeM}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="TextWrapping" Value="Wrap"/>
    <Setter Property="Margin" Value="0,2,0,0"/>
  </Style>
  <Style x:Key="SetRowControl" TargetType="Border">
    <Setter Property="DockPanel.Dock" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="16,0,0,0"/>
  </Style>
  <!-- large preview (theme, density, rate) — variant B: plates on a grey background, the chosen one is lighter, raised -->
  <Style x:Key="SetTileStyle" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Border x:Name="Raised" CornerRadius="8" Background="{DynamicResource SegOnBrush}" Visibility="Hidden">
              <Border.Effect>
                <DropShadowEffect BlurRadius="5" ShadowDepth="1" Direction="270" Opacity="0.20" Color="#000000" RenderingBias="Performance"/>
              </Border.Effect>
            </Border>
            <Border x:Name="Bd" CornerRadius="8" BorderThickness="1" BorderBrush="Transparent" Background="{DynamicResource SegTrackBrush}" Padding="12,10">
              <ContentPresenter/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource BtnNeutralHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Raised" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Bd" Property="Background" Value="Transparent"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SelBorderBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- colour dots for the accent; the colour comes from code (ThemeManager.AccentHex) -->
  <Style x:Key="AccentSwatchStyle" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Width" Value="34"/>
    <Setter Property="Height" Value="34"/>
    <Setter Property="Margin" Value="0,0,12,0"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2"/>
            <Ellipse Margin="5" Fill="{TemplateBinding Background}"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource CardBorderBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- a single kind of choice in the whole app: an outlined track + the chosen button with a background, a blue outline and
       bold text -->
  <Style x:Key="SegmentTrackStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource SegTrackBrush}"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="3"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
  </Style>
  <Style x:Key="SegmentChipStyle" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeS}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Grid>
            <!-- the chosen pill: a lighter background + a fine shadow; the shadow sits on a separate layer, so the text stays sharp -->
            <Border x:Name="Raised" CornerRadius="6" Background="{DynamicResource SegOnBrush}" Visibility="Hidden">
              <Border.Effect>
                <DropShadowEffect BlurRadius="3" ShadowDepth="1" Direction="270" Opacity="0.22" Color="#000000" RenderingBias="Performance"/>
              </Border.Effect>
            </Border>
            <Border x:Name="Bd" CornerRadius="6" Padding="12,4" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" MinWidth="34">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Raised" Property="Visibility" Value="Visible"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource SelBorderBrush}"/>
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- a choice with a thumbnail (Settings › Theme, Close button, Display density). Content = the drawing + the label;
       the chosen one has an accent border (2 px), the rest a fine border. -->
  <Style x:Key="ThumbChipStyle" TargetType="RadioButton">
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeS}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="Margin" Value="0,0,8,0"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Frame" CornerRadius="8" BorderThickness="1" Padding="7,7,7,5" Background="{DynamicResource BgCardBrush}"
                  BorderBrush="{DynamicResource CardBorderBrush}">
            <ContentPresenter HorizontalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="Frame" Property="BorderThickness" Value="2"/>
              <Setter TargetName="Frame" Property="Padding" Value="6,6,6,4"/>
              <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
              <Setter Property="FontWeight" Value="SemiBold"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- text that looks like a TextBlock but can be selected and copied (serials, paths) -->
  <Style x:Key="SelectableTextStyle" TargetType="TextBox">
    <Setter Property="IsReadOnly" Value="True"/>
    <Setter Property="IsReadOnlyCaretVisible" Value="False"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentBrush}"/>
    <Setter Property="Cursor" Value="IBeam"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <ScrollViewer x:Name="PART_ContentHost" Background="Transparent" Focusable="False"
                        HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <FontFamily x:Key="NumFont">Bahnschrift, Segoe UI Variable Display, Segoe UI</FontFamily>
  <Style x:Key="CompCardStyle" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource CardSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardEdgeBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Padding" Value="18,14,18,0"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="SnapsToDevicePixels" Value="True"/>
    <!-- the card can be opened: a faint highlight under the mouse (the Windows way), instead of arrows everywhere -->
    <!-- no hover effect: the hand cursor and the "›" chevron show the card can be opened -->
  </Style>
  <!-- alert glow behind the card (critical values) — a separate Border, with no text in it, so the shadow does not blur the
       content. Added / removed from code: MainWindow.DashRows.cs → ApplyRowAlert -->
  <Style x:Key="CompGlow" TargetType="Border">
    <Setter Property="CornerRadius" Value="8"/>
    <Setter Property="Background" Value="{DynamicResource BgCardBrush}"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <!-- footer band: stuck to the card edges (cancels the side / bottom padding) -->
  <Style x:Key="CompFootBand" TargetType="Border">
    <Setter Property="Margin" Value="-18,0,-18,0"/>
    <Setter Property="Padding" Value="4,9,4,10"/>
    <Setter Property="Background" Value="{DynamicResource CardFootBrush}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource CardFootLineBrush}"/>
    <Setter Property="BorderThickness" Value="0,1,0,0"/>
    <Setter Property="CornerRadius" Value="0,0,7,7"/>
  </Style>
  <Style x:Key="CompFootCell" TargetType="Border">
    <Setter Property="BorderBrush" Value="{DynamicResource CardFootLineBrush}"/>
    <Setter Property="BorderThickness" Value="1,0,0,0"/>
    <Setter Property="Padding" Value="14,0,8,0"/>
  </Style>
  <Style x:Key="CompFootCellFirst" TargetType="Border" BasedOn="{StaticResource CompFootCell}">
    <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style x:Key="CompFootKey" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeS}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="Opacity" Value="0.95"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
  </Style>
  <Style x:Key="CompFootVal" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeM}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="Margin" Value="0,1,0,0"/>
  </Style>
  <Style x:Key="CompInfoVal" TargetType="TextBlock" BasedOn="{StaticResource CompFootVal}">
    <Setter Property="FontSize" Value="{StaticResource FontSizeL}"/>
  </Style>
  <Style x:Key="CompValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
    <Setter Property="FontSize" Value="28"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="LineHeight" Value="30"/>
  </Style>
  <Style x:Key="CompSub" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeM}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="Margin" Value="0,3,0,0"/>
  </Style>
  <!-- the dial with the value in the centre: DialSizer picks it in S / M / L steps by the space in the card.
       Geometry: a 124 × 112 grid → radius 58, the arc centre at y 62; the text (value + sub-value) centred on it. -->
  <Style x:Key="CompDialBox" TargetType="Viewbox">
    <Setter Property="local:DialSizer.Auto" Value="True"/>
    <Setter Property="StretchDirection" Value="DownOnly"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="CompDialGrid" TargetType="Grid">
    <Setter Property="Width" Value="124"/>
    <Setter Property="Height" Value="112"/>
  </Style>
  <!-- the Dashboard dials: the same grid, with an extra row under the arc for the minimum / maximum -->
  <Style x:Key="CompDialGridRange" TargetType="Grid" BasedOn="{StaticResource CompDialGrid}">
    <Setter Property="Height" Value="130"/>
  </Style>
  <!-- Temp & Stress, while a test runs, under the dial: a thin progress line to the chosen stop time + the time left -->
  <Style x:Key="StressRunBox" TargetType="StackPanel">
    <Setter Property="Width" Value="132"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
    <Setter Property="Margin" Value="0,0,0,4"/>
    <Setter Property="Visibility" Value="Collapsed"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <Style x:Key="StressRunTrack" TargetType="Border">
    <Setter Property="Height" Value="4"/>
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="Background" Value="{DynamicResource GaugeTrackBrush}"/>
    <Setter Property="ClipToBounds" Value="True"/>
  </Style>
  <Style x:Key="StressRunFill" TargetType="Border">
    <Setter Property="CornerRadius" Value="2"/>
    <Setter Property="Background" Value="{DynamicResource DataBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Stretch"/>
    <Setter Property="RenderTransformOrigin" Value="0,0.5"/>
  </Style>
  <Style x:Key="StressRunText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeXS}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,5,0,0"/>
    <Setter Property="Typography.NumeralAlignment" Value="Tabular"/>
  </Style>
  <Style x:Key="CompDialRange" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeS}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,108,0,0"/>
  </Style>
  <!-- the value: the figures centred exactly on the arc centre (y 62). "%" is smaller, and has an invisible copy on the
       left — so the number sits in the middle, not pushed left by the percent sign. -->
  <Style x:Key="CompDialText" TargetType="StackPanel">
    <Setter Property="Orientation" Value="Horizontal"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Margin" Value="0,49,0,0"/>
  </Style>
  <!-- the figure inside the dial: large and light, so the numbers are what the eye reads first -->
  <Style x:Key="CompDialValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
    <Setter Property="FontSize" Value="31"/>
    <Setter Property="FontWeight" Value="Light"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="LineHeight" Value="31"/>
    <Setter Property="LineStackingStrategy" Value="BlockLineHeight"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="CompDialUnit" TargetType="TextBlock">
    <Setter Property="Text" Value="%"/>
    <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="FontWeight" Value="Normal"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="Margin" Value="1,4,0,0"/>
  </Style>
  <Style x:Key="CompDialUnitGhost" TargetType="TextBlock" BasedOn="{StaticResource CompDialUnit}">
    <Setter Property="Opacity" Value="0"/>
    <Setter Property="Margin" Value="0,4,1,0"/>
  </Style>
  <Style x:Key="CompDialSub" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeS}"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="HorizontalAlignment" Value="Center"/>
    <Setter Property="VerticalAlignment" Value="Top"/>
    <Setter Property="TextAlignment" Value="Center"/>
    <Setter Property="MaxWidth" Value="80"/>
    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    <Setter Property="Margin" Value="0,84,0,0"/>
  </Style>
  <!-- a chart header: a small label on the left, the large current value on the right (temperature, ping) -->
  <!-- the numeric cell in tables (Process Monitor and the following): Bahnschrift figures, right-aligned -->
  <Style x:Key="TableNumCell" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
    <Setter Property="FontSize" Value="{StaticResource FontSizeL}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="TextAlignment" Value="Right"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="4,0,10,0"/>
  </Style>
  <Style x:Key="CompChartHead" TargetType="DockPanel">
    <Setter Property="LastChildFill" Value="False"/>
    <Setter Property="Height" Value="26"/>
  </Style>
  <Style x:Key="CompChartValue" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
    <Setter Property="FontSize" Value="22"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="VerticalAlignment" Value="Bottom"/>
    <Setter Property="DockPanel.Dock" Value="Right"/>
    <Setter Property="Margin" Value="8,0,2,0"/>
  </Style>
  <!-- the dashboard cards: a lower header and a smaller value, so the chart under it gets the height -->
  <Style x:Key="DashCompChartHead" TargetType="DockPanel" BasedOn="{StaticResource CompChartHead}">
    <Setter Property="Height" Value="22"/>
  </Style>
  <Style x:Key="DashCompChartValue" TargetType="TextBlock" BasedOn="{StaticResource CompChartValue}">
    <Setter Property="FontSize" Value="18"/>
  </Style>
  <!-- the ends of a chart's scale, written small on the chart -->
  <Style x:Key="DashChartScaleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource NumFont}"/>
    <Setter Property="FontSize" Value="10.5"/>
    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="Opacity" Value="0.8"/>
    <Setter Property="HorizontalAlignment" Value="Left"/>
    <Setter Property="IsHitTestVisible" Value="False"/>
  </Style>
  <Style x:Key="CompStatusText" TargetType="TextBlock">
    <Setter Property="FontSize" Value="{StaticResource FontSizeM}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <!-- component icon: a Fluent System Icon (filled outline geometry, see Services/FluentIcons.cs) -->
  <Style x:Key="CompIcon" TargetType="Path">
    <Setter Property="Fill" Value="{DynamicResource TextSecondaryBrush}"/>
  </Style>

  <Style x:Key="DashIconTile" TargetType="Border">
    <Setter Property="Width" Value="36"/>
    <Setter Property="Height" Value="36"/>
    <Setter Property="CornerRadius" Value="9"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
    <Setter Property="Margin" Value="0,0,12,0"/>
    <!-- the background (accent at 12%) is set on each element: a brush with DynamicResource in a style Setter cannot be
         "frozen" and WPF rejects it -->
  </Style>

  <Style x:Key="SpecCardStyle" TargetType="Border" BasedOn="{StaticResource BaseCardStyle}">
    <Setter Property="Padding" Value="0"/>
    <Setter Property="Cursor"  Value="Hand"/>
  </Style>

  <!-- ═══════════════════════════════════════════════════════════════════
       DASHBOARD INVENTORY — a consistent typography system for the Hardware / Storage / Network / System cards.
       All rows use the same sizes & colours → a uniform look.
       ═══════════════════════════════════════════════════════════════════ -->
  <!-- Antet sectiune: "HARDWARE", "STORAGE" etc. -->
  <Style x:Key="InvSectionHeader" TargetType="TextBlock">
    <Setter Property="FontSize"            Value="{StaticResource FontSizeM}"/>
    <Setter Property="FontWeight"          Value="Bold"/>
    <Setter Property="Foreground"          Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="Opacity"             Value="0.85"/>
    <Setter Property="VerticalAlignment"   Value="Center"/>
  </Style>
  <!-- Subtitlu grup in card: "CPU", "GRAPHICS", "MEMORY" -->
  <Style x:Key="InvGroupLabel" TargetType="TextBlock">
    <Setter Property="FontSize"            Value="{StaticResource FontSizeXS}"/>
    <Setter Property="FontWeight"          Value="Bold"/>
    <Setter Property="Foreground"          Value="{DynamicResource AccentTextBrush}"/>
    <Setter Property="Opacity"             Value="1.0"/>
    <Setter Property="Margin"              Value="0,0,0,5"/>
  </Style>
  <!-- Row label (left): "Cores", "Cache", "VRAM" -->
  <Style x:Key="InvRowLabel" TargetType="TextBlock">
    <Setter Property="FontSize"            Value="{StaticResource FontSizeM}"/>
    <Setter Property="Foreground"          Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="Opacity"             Value="0.85"/>
    <Setter Property="VerticalAlignment"   Value="Center"/>
  </Style>
  <!-- Row value (right), right-aligned -->
  <Style x:Key="InvRowValue" TargetType="TextBlock">
    <Setter Property="FontSize"            Value="{StaticResource FontSizeL}"/>
    <Setter Property="FontWeight"          Value="SemiBold"/>
    <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="VerticalAlignment"   Value="Center"/>
    <Setter Property="HorizontalAlignment" Value="Right"/>
    <Setter Property="TextAlignment"       Value="Right"/>
    <Setter Property="TextTrimming"        Value="CharacterEllipsis"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="—">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Opacity"    Value="0.4"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="InvPrimaryValue" TargetType="TextBlock">
    <Setter Property="FontSize"            Value="{StaticResource FontSizeL}"/>
    <Setter Property="FontWeight"          Value="SemiBold"/>
    <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="TextTrimming"        Value="CharacterEllipsis"/>
    <Setter Property="Margin"              Value="0,0,0,5"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="—">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Opacity"    Value="0.4"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <!-- Vertical field label (above the value): "IP", "Gateway", "Build" — a label/value pair -->
  <Style x:Key="InvFieldLabel" TargetType="TextBlock">
    <Setter Property="FontSize"            Value="{StaticResource FontSizeXS}"/>
    <Setter Property="FontWeight"          Value="Normal"/>
    <Setter Property="Foreground"          Value="{DynamicResource TextSecondaryBrush}"/>
    <Setter Property="Opacity"             Value="0.85"/>
    <Setter Property="Margin"              Value="0,2,0,0"/>
  </Style>
  <!-- Vertical field value (under the label) -->
  <Style x:Key="InvFieldValue" TargetType="TextBlock">
    <Setter Property="FontSize"            Value="{StaticResource FontSizeL}"/>
    <Setter Property="FontWeight"          Value="SemiBold"/>
    <Setter Property="Foreground"          Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="TextTrimming"        Value="CharacterEllipsis"/>
    <Setter Property="Margin"              Value="0,0,0,2"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="—">
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="Opacity"    Value="0.4"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>
  <!-- Subtle separator between rows -->
  <Style x:Key="InvSeparator" TargetType="Border">
    <Setter Property="Height"     Value="1"/>
    <Setter Property="Background" Value="{DynamicResource CardBorderBrush}"/>
    <Setter Property="Opacity"    Value="0.25"/>
    <Setter Property="Margin"     Value="0,5,0,5"/>
  </Style>
  <!-- Badge atribut: [DDR3] [1600 MHz] [GPT] -->
  <Style x:Key="InvBadge" TargetType="Border">
    <Setter Property="CornerRadius"      Value="4"/>
    <Setter Property="Padding"           Value="6,1"/>
    <Setter Property="Background"        Value="{DynamicResource AccentLightBrush}"/>
    <Setter Property="Margin"            Value="0,0,4,3"/>
    <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
  <Style x:Key="InvBadgeText" TargetType="TextBlock">
    <Setter Property="FontSize"   Value="{StaticResource FontSizeXS}"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
    <Style.Triggers>
      <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="—">
        <Setter Property="Opacity" Value="0.4"/>
      </DataTrigger>
    </Style.Triggers>
  </Style>

  <!-- NAV BUTTON -->
  <!-- the row has the same height (32) in the wide and the collapsed menu: with the label hidden, the content would drop by 1 px -->
  <!-- the height of a menu button (the same collapsed and expanded, so the buttons keep their places) -->
  <sys:Double x:Key="NavItemHeight">34</sys:Double>
  <Style x:Key="NavButtonStyle" TargetType="Button">
    <Setter Property="Background"                 Value="Transparent"/>
    <Setter Property="Foreground"                 Value="{DynamicResource SidebarTextBrush}"/>
    <Setter Property="BorderThickness"            Value="0"/>
    <Setter Property="Padding"                    Value="10,6"/>
    <Setter Property="FontSize"                   Value="{StaticResource FontSizeL}"/>
    <Setter Property="FontFamily"                 Value="{StaticResource AppFont}"/>
    <Setter Property="Cursor"                     Value="Hand"/>
    <Setter Property="FocusVisualStyle"           Value="{StaticResource AppFocusVisual}"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Bd" Background="Transparent" CornerRadius="5"
                  Margin="6,3,6,3" Height="{StaticResource NavItemHeight}" Padding="{TemplateBinding Padding}"
                  ClipToBounds="False">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center" ClipToBounds="False"/>
          </Border>
          <ControlTemplate.Triggers>
            <!-- hover: only a very faint grey behind it; text and icon stay in the secondary grey -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarHoverBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- active page = the Windows navigation look: a faint neutral background, 5 px corners and the short accent bar on the left
       (ThemeManager: SbItemActiveBase, SbItemActivePillFg; the icon colour SbItemActiveIconBrush is set on the icon by
       HighlightActiveNavIcon). The same size and place as the other buttons, so nothing moves when the page changes or the
       menu collapses. -->
  <Style x:Key="NavButtonActiveStyle" TargetType="Button" BasedOn="{StaticResource NavButtonStyle}">
    <Setter Property="Foreground"       Value="{DynamicResource SbItemActivePillFg}"/>
    <Setter Property="FontWeight"       Value="SemiBold"/>
    <Setter Property="FocusVisualStyle" Value="{StaticResource AppFocusVisual}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Grid Margin="6,3,6,3" Height="{StaticResource NavItemHeight}">
            <Border x:Name="BgBorder" CornerRadius="5" BorderThickness="0"
                    Background="{DynamicResource SbItemActiveBase}" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>
            </Border>
            <!-- the Windows navigation mark: a short rounded accent bar at the left edge -->
            <Border Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Background="{DynamicResource SbItemActiveIconBrush}" IsHitTestVisible="False"/>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="BgBorder" Property="Opacity" Value="0.75"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>


