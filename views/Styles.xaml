<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SMDWin.Views"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

  <!-- ═══════════════════════════════════════════════════════════════════════
       SMDWin — Modern UI v2  |  Windows 7 / 8 / 10 / 11 compatible
       Design: Clean flat, refined cards, sharp typography, no Mica/blur
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- TYPOGRAPHY -->
  <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="AppFontDisplay">Segoe UI Variable Display, Segoe UI Semibold, Segoe UI, sans-serif</FontFamily>
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

  <!-- text scale +1 px (XS…XXL) — the titles stay the same -->
  <sys:Double x:Key="FontSizeXS">12</sys:Double>
  <sys:Double x:Key="FontSizeS">12</sys:Double>
  <sys:Double x:Key="FontSizeM">13</sys:Double>
  <sys:Double x:Key="FontSizeL">14</sys:Double>
  <sys:Double x:Key="FontSizeXL">15</sys:Double>
  <sys:Double x:Key="FontSizeXXL">17</sys:Double>
  <sys:Double x:Key="FontSizeSectionTitle">18</sys:Double>
  <sys:Double x:Key="FontSizeTitle">20</sys:Double>
  <sys:Double x:Key="FontSizeTitleLg">22</sys:Double>
  <sys:Double x:Key="FontSizeHero">28</sys:Double>
  <sys:Double x:Key="FontSizeHeroLg">40</sys:Double>

  <!-- the temperature unit shown next to the figures; ApplyTempUnit changes it to °F from Settings -->
  <sys:String x:Key="TempUnitSymbol">°C</sys:String>

  <sys:Double x:Key="RadiusControlD">4</sys:Double>
  <sys:Double x:Key="RadiusCardD">8</sys:Double>
  <sys:Double x:Key="RadiusDialogD">8</sys:Double>
  <sys:Double x:Key="RadiusPillD">999</sys:Double>
  <CornerRadius x:Key="RadiusControl">4</CornerRadius>

  <Style TargetType="{x:Type ui:Button}">
    <Setter Property="CornerRadius"       Value="{StaticResource RadiusControl}"/>
    <Setter Property="FontWeight"         Value="SemiBold"/>
    <Setter Property="FontSize"           Value="{StaticResource FontSizeM}"/>
    <Setter Property="Cursor"             Value="Hand"/>
    <Setter Property="Padding"            Value="14,7"/>
    <Setter Property="Background"         Value="{DynamicResource BgCardBrush}"/>
    <Setter Property="Foreground"         Value="{DynamicResource TextPrimaryBrush}"/>
    <Setter Property="BorderBrush"        Value="{DynamicResource CardBorderBrush}"/>
    <Setter Property="BorderThickness"    Value="1"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ui:Button}">
          <Border x:Name="Bd"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}"
                  SnapsToDevicePixels="True">
            <ContentPresenter x:Name="Cp" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                               Margin="{TemplateBinding Padding}"
                               RecognizesAccessKey="True"/>
          </Border>
          <ControlTemplate.Triggers>
            <!-- Appearance="Primary" — actiunea principala a unei ferestre/sectiuni -->
            <Trigger Property="Appearance" Value="Primary">
              <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource AccentBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <!-- Appearance="Danger" — actiuni distructive (Clear Temp, Stop etc) -->
            <Trigger Property="Appearance" Value="Danger">
              <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource ActionRedBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ActionRedBrush}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <!-- Appearance="Success" — stari active/pornite (ex. Endurance mode) -->
            <Trigger Property="Appearance" Value="Success">
              <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource ActionGreenBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ActionGreenBrush}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <!-- Appearance="Caution" — warnings (not critical like Danger) -->
            <Trigger Property="Appearance" Value="Caution">
              <Setter TargetName="Bd" Property="Background"  Value="{DynamicResource StatusWarningBrush}"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StatusWarningBrush}"/>
              <Setter Property="Foreground" Value="White"/>
            </Trigger>
            <!-- Appearance="Transparent" — a "ghost" button, without a visible background/border -->
            <Trigger Property="Appearance" Value="Transparent">
              <Setter TargetName="Bd" Property="Background"  Value="Transparent"/>
              <Setter TargetName="Bd" Property="BorderBrush" Value="Transparent"/>
            </Trigger>
            <!-- Hover — the border in the accent colour, whatever the Appearance — subtle, it does not compete with the already
                 coloured Primary/Danger background -->
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Bd" Property="Opacity" Value="0.82"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.5"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <CornerRadius x:Key="RadiusCard">8</CornerRadius>
  <CornerRadius x:Key="RadiusDialog">8</CornerRadius>
  <CornerRadius x:Key="RadiusPill">999</CornerRadius>
  <CornerRadius x:Key="RadiusCardTop">8,8,0,0</CornerRadius>

  <Thickness x:Key="CardPadding">16,14,16,14</Thickness>
  <Thickness x:Key="CardPaddingSm">12,10,12,10</Thickness>
  <Thickness x:Key="ControlPadding">14,8,14,8</Thickness>
  <Thickness x:Key="ChipPadding">10,4,10,4</Thickness>

  <sys:Double x:Key="ChartStrokeThickness">1.5</sys:Double>
  <sys:Double x:Key="ChartFillOpacity">0.18</sys:Double>
  <sys:Double x:Key="ChartGridOpacity">0.4</sys:Double>

  <!-- GLOBAL: kill dotted focus rectangles on common controls -->
  <Style x:Key="NoFocusVisual">
    <Setter Property="Control.FocusVisualStyle" Value="{x:Null}"/>
  </Style>
  <Style TargetType="Window">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>
  <Style TargetType="Grid">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>
  <Style TargetType="StackPanel">
    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
  </Style>

  <Style x:Key="ThemedSecondaryButtonStyle" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
    <Style.Triggers>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
      </Trigger>
    </Style.Triggers>
  </Style>

  <Style x:Key="AppFocusVisual">
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <Border BorderBrush="{DynamicResource AccentBrush}"
                  BorderThickness="2"
                  CornerRadius="{StaticResource RadiusControl}"
                  Margin="-2"
                  SnapsToDevicePixels="True"/>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- EASING FUNCTIONS — defined first so StaticResource can find them anywhere -->
  <QuinticEase x:Key="EaseOut" EasingMode="EaseOut"/>
  <QuadraticEase x:Key="EaseIn" EasingMode="EaseIn"/>

